                        </NavLink>
                        <NavLink class="nav-link text-white nav-subitem" href="/taxes">
                            <span class="fa fa-percent nav-subicon me-2"></span> @Localizer["Menu_Taxes"]
                        </NavLink>
                        <NavLink class="nav-link text-white nav-subitem" href="/estratossociales">
                            <span class="fa fa-layer-group nav-subicon me-2"></span> @Localizer[nameof(Resource.EstratosSociales)]
