<AuthorizeView>
    <Authorized>
        <div class="p-3 auth-links">
            @* Corporacion a la que pertenece el usuario: logo + nombre *@
            <div class="auth-links__corp">
                <AvatarImage Url="@LogoCorp" Icon="fa fa-building" Size="46" Alt="@NameCorp" />
                <span class="auth-links__corp-name">@NameCorp</span>
            </div>

            <div class="auth-links__user">
                <AvatarImage Url="@photoUser" Icon="fa fa-user" Size="72" Alt="@FullName" />
                <div class="auth-links__user-name">@FullName</div>
                <div class="auth-links__user-account">@context.User.Identity!.Name</div>
            </div>

            <div class="d-grid gap-2">
                <button class="btn btn-outline-secondary" @onclick="ShowModalCambiarClave">
                    Change Password <i class="bi bi-shield-lock"></i>
                </button>
                <button class="btn btn-outline-secondary" @onclick="ShowModalLogOut">
                    Sign Out <i class="bi bi-box-arrow-right"></i>
                </button>

            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="p-3">
            <div class="d-grid gap-2">
                <button class="btn btn-outline-secondary" @onclick="ShowModalRecoverPassword">
                    Recover Password <i class="bi bi-lock"></i>
                </button>
                <button class="btn btn-outline-secondary" @onclick="ShowModalLogIn">
                    Sign In <i class="bi bi-box-arrow-in-right"></i>
                </button>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>
