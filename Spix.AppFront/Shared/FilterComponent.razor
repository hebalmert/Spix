<div class="row g-2 align-items-center w-100 ms-auto" style="max-width: @MaxWidth;">

    <!-- Campo de búsqueda -->
    <div class="col-12 col-md">
        <div class="input-group">
            <span class="input-group-text bg-light">
                <i class="fa fa-search text-dark"></i>
            </span>
            <InputText class="form-control" placeholder="Search..." @bind-Value="FilterValue" />
        </div>
    </div>

    <!-- Botón Buscar -->
    <div class="col-auto">
        <button class="btn-gradient-blue" @onclick="OnfilterApply">
            <i class="fa fa-search"></i><span>@Localizer["Search"]</span>
        </button>
    </div>

    <!-- Botón Limpiar -->
    <div class="col-auto">
        <button class="btn-gradient-dark" @onclick="ClearFilter">
            <i class="fa fa-refresh"></i><span>@Localizer["Clear"]</span>
        </button>
    </div>

</div>