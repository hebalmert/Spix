<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Modelo hosted (.NET 10): el fingerprinting de assets (import maps + placeholders
         #[.{fingerprint}]) NO se resuelve al publicar desde el host, y el bootstrapper
         termina pidiendo dotnet.js / assemblies SIN hash que en disco SÍ tienen hash → 404
         en cadena → pantalla "Loading" infinita. Desactivarlo deja nombres estables
         (dotnet.js, dotnet.native.wasm, blazor.webassembly.js, *.wasm) que el runtime
         encuentra directo. Imprescindible para publicar hosted. -->
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <UserSecretsId>2222c29f-80d4-4571-8824-430e337aef4a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="wwwroot\Images\bgCenterImg.jpg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blazored.LocalStorage" Version="4.2.0" />
    <PackageReference Include="BlazorTimerComponents" Version="1.0.0" />
    <PackageReference Include="bootstrap" Version="5.3.8" />
    <PackageReference Include="CurrieTechnologies.Razor.SweetAlert2" Version="5.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spix.AppInfra\Spix.AppInfra.csproj" />
    <ProjectReference Include="..\Spix.Domain\Spix.Domain.csproj" />
    <ProjectReference Include="..\Spix.xHttpService\Spix.xHttpService.csproj" />
    <ProjectReference Include="..\Spix.xLanguage\Spix.xLanguage.csproj" />
    <ProjectReference Include="..\Spix.xNetwork\Spix.xNetwork.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="wwwroot\Images\bgCenterImg.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

</Project>
