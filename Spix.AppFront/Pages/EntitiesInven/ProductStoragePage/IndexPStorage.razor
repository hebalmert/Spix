@page "/productstorages"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator, Auxiliar")]

<div class="container-fluid pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">

        @* Encabezado: el unico titulo de la pantalla *@
        <div class="idx-head">
            <span class="idx-glifo"><i class="fa fa-warehouse"></i></span>
            <div class="idx-head-text">
                <h3>@Localizer[nameof(Resource.Storage)]</h3>
                <p>@Localizer["Storage_Subtitle"]</p>
            </div>

            @if (TotalRecords > 0)
            {
                <div class="idx-head-tools">
                    <span class="idx-count">@Localizer[TotalRecords == 1 ? "Storage_CountOne" : "Storage_CountMany", TotalRecords.ToString("N0")]</span>
                </div>
            }
        </div>

        <div class="idx-bar">
            <ButtonFormNew OnClick="() => ShowModalAsync()" />
            <div class="idx-search">
                <FilterComponent ApplyFilter="SetFilterValue" />
            </div>
        </div>

        <section class="idx-panel">
            <div class="table-responsive">
                <table class="idx-table">
                    <thead>
                        <tr>
                            <th>@Localizer[nameof(Resource.Storage)]</th>
                            <th style="text-align:right">@Localizer["Storage_Products"]</th>
                            <th style="text-align:right">@Localizer["Storage_Units"]</th>
                            <th>@Localizer[nameof(Resource.Status)]</th>
                            <th style="text-align:right">@Localizer["Table_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <GenericList MyList="ProductStorages">
                            <Loading>
                                <tr>
                                    <td colspan="5" class="idx-meta" style="text-align:center">
                                        <span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Table_Loading"]
                                    </td>
                                </tr>
                            </Loading>
                            <NoRecords>
                                <tr>
                                    <td colspan="5" class="idx-meta" style="text-align:center">@Localizer["Table_NoRecords"]</td>
                                </tr>
                            </NoRecords>
                            <Body>
                                @foreach (var item in ProductStorages!)
                                {
                                    <tr>
                                        <td>
                                            <div class="idx-name">@item.StorageName</div>
                                            <div class="idx-meta"><i class="fa fa-location-dot"></i> @item.CityName · @item.StateName</div>
                                        </td>
                                        @* Existencias: lo que hay hoy en la bodega *@
                                        <td style="text-align:right">@item.Products.ToString("N0")</td>
                                        <td style="text-align:right">@item.Units.ToString("#,0.##")</td>
                                        <td>
                                            <span class="idx-pill @(item.Active ? "is-on" : "is-off")">
                                                @(item.Active ? Localizer[nameof(Resource.Active)] : Localizer[nameof(Resource.Inactive)])
                                            </span>
                                        </td>
                                        <td>
                                            <div class="idx-actions">
                                                <ButtonEdit OnClick="() => ShowModalAsync(item.ProductStorageId, true)" />
                                                @* Con existencias no se borra: el backend lo explica si ya tuvo movimientos *@
                                                @if (item.Products == 0)
                                                {
                                                    <ButtonDelete OnClick="() => DeleteAsync(item.ProductStorageId)" />
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </Body>
                        </GenericList>
                    </tbody>
                </table>
            </div>

            @if (ProductStorages is not null)
            {
                <div class="idx-panel-foot">
                    <Pagination CurrentPage="CurrentPage"
                                SelectedPage="SelectedPage"
                                TotalPages="TotalPages" />
                </div>
            }
        </section>
    </div>
</div>
