@inherits ComponentBase

<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1055;">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-create-shadow p-4 position-relative">
            <div class="modal-header d-flex justify-content-between align-items-center mb-3">
                <h5 class="modal-title">@Title</h5>
                <button class="btn-close-modal" @onclick="Return" title="Close">
                    <i class="fa fa-times"></i>
                </button>
            </div>

            @if (IsLoading)
            {
                <div class="d-flex justify-content-center py-5">
                    <Loading />
                </div>
            }
            else if (Supplier is not null)
            {
                <div class="text-center mb-4">
                    <img src="@Supplier.ImageFullPath"
                         alt="@Supplier.Name"
                         width="90"
                         height="90"
                         class="img-thumbnail"
                         onerror="this.src='https://spiximage.blob.core.windows.net/imgwwwroot/NoImage.png'" />
                </div>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="input-group">
                            <span class="input-group-text" style="width: 110px">@Localizer[nameof(Resource.Name)]</span>
                            <input class="form-control" value="@Supplier.Name" readonly />
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="input-group">
                            <span class="input-group-text" style="width: 110px">@Localizer[nameof(Resource.Contact)]</span>
                            <input class="form-control" value="@Supplier.ContactName" readonly />
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="input-group">
                            <span class="input-group-text" style="width: 110px">@Localizer[nameof(Resource.DocumentType)]</span>
                            <input class="form-control" value="@Supplier.DocumentType?.DocumentName" readonly />
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="input-group">
                            <span class="input-group-text" style="width: 110px">@Localizer[nameof(Resource.NroDocuement)]</span>
                            <input class="form-control" value="@Supplier.Document" readonly />
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="input-group">
                            <span class="input-group-text" style="width: 110px">@Localizer[nameof(Resource.Phone)]</span>
                            <input class="form-control" value="@Supplier.PhoneNumber" readonly />
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="input-group">
                            <span class="input-group-text" style="width: 110px">@Localizer[nameof(Resource.Address)]</span>
                            <input class="form-control" value="@Supplier.Address" readonly />
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="input-group">
                            <span class="input-group-text" style="width: 110px">@Localizer[nameof(Resource.State)]</span>
                            <input class="form-control" value="@Supplier.State?.Name" readonly />
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="input-group">
                            <span class="input-group-text" style="width: 110px">@Localizer[nameof(Resource.City)]</span>
                            <input class="form-control" value="@Supplier.City?.Name" readonly />
                        </div>
                    </div>

                    <div class="col-12 col-md-8">
                        <div class="input-group">
                            <span class="input-group-text" style="width: 110px">@Localizer[nameof(Resource.Email)]</span>
                            <input class="form-control" value="@Supplier.Email" readonly />
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="input-group h-100">
                            <span class="input-group-text" style="width: 110px">@Localizer[nameof(Resource.Active)]</span>
                            <div class="form-control d-flex align-items-center">
                                <input type="checkbox" class="form-check-input m-0" checked="@Supplier.Active" disabled />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-center mt-4">
                    <ButtonFormBack OnClick="Return" />
                </div>
            }
        </div>
    </div>
</div>
