@page "/suppliers"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator")]

<div class="container pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">
        @* Encabezado: el unico titulo de la pantalla *@
        <div class="idx-head">
            <span class="idx-glifo"><i class="fa fa-truck"></i></span>
            <div class="idx-head-text">
                <h3>@Localizer[nameof(Resource.Supplier)]</h3>
                <p>Administre sus proveedores, sus datos de contacto y su estado.</p>
            </div>

            @if (TotalRecords > 0)
            {
                <div class="idx-head-tools">
                    <span class="idx-count">@TotalRecords.ToString("N0") proveedores</span>
                </div>
            }
        </div>

        @* Acciones y buscador, fuera del panel de la tabla *@
        <div class="idx-bar">
            <ButtonFormNew OnClick="() => ShowModalAsync()" />

            <div class="idx-search">
                <FilterComponent ApplyFilter="SetFilterValue" />
            </div>
        </div>

        <section class="idx-panel">

            @* La tabla vive afuera del GenericList: el encabezado se pinta siempre,
               aunque no haya registros, y el borde del panel no queda cortado. *@
            <div class="table-responsive">
                <table class="idx-table">
                    <thead>
                        <tr>
                            <th>@Localizer[nameof(Resource.Supplier)]</th>
                            <th>@Localizer[nameof(Resource.Phone)]</th>
                            <th>@Localizer[nameof(Resource.Email)]</th>
                            <th>@Localizer[nameof(Resource.Active)]</th>
                            <th style="text-align:right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* El GenericList solo arma las filas: el cargando y el "sin registros"
                           entran como una fila mas, debajo del encabezado. *@
                        <GenericList MyList="Suppliers">
                            <Loading>
                                <tr>
                                    <td colspan="5" class="idx-meta" style="text-align:center">
                                        <span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Table_Loading"]
                                    </td>
                                </tr>
                            </Loading>
                            <NoRecords>
                                <tr>
                                    <td colspan="5" class="idx-meta" style="text-align:center">@Localizer["Table_NoRecords"]</td>
                                </tr>
                            </NoRecords>
                            <Body>
                                @foreach (var item in Suppliers!)
                                {
                                    <tr>
                                        <td>
                                            <div class="idx-who">
                                                <AvatarImage Url="@item.ImageFullPath" Icon="fa fa-truck" Size="46" Alt="@item.Name" />
                                                <div>
                                                    <div class="idx-name">@item.Name</div>
                                                    <div class="idx-meta">@item.Document</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@item.PhoneNumber</td>
                                        <td>@item.Email</td>
                                        <td>
                                            <span class="idx-pill @(item.Active ? "is-on" : "is-off")">
                                                @(item.Active ? Localizer[nameof(Resource.Active)] : Localizer[nameof(Resource.Inactive)])
                                            </span>
                                        </td>
                                        <td>
                                            <div class="idx-actions">
                                                <ButtonGeneric Icon="fa fa-list" OnClick="() => ShowDetailsAsync(item.SupplierId)" />
                                                <ButtonEdit OnClick="() => ShowModalAsync(item.SupplierId, true)" />
                                                <ButtonDelete OnClick="() => DeleteAsync(item.SupplierId)" />
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </Body>
                        </GenericList>
                    </tbody>
                </table>
            </div>

            <div class="idx-panel-foot">
                <Pagination CurrentPage="CurrentPage"
                            SelectedPage="SelectedPage"
                            TotalPages="TotalPages" />
            </div>
        </section>
    </div>
</div>
