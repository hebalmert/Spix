@page "/purchases/details/{Id:guid}"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator, Auxiliar")]
@using Spix.DomainLogic.EnumTypes

<div class="container-fluid pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">

        @if (Purchase is null)
        {
            <Loading />
        }
        else
        {
            @* Encabezado: que compra es, de quien y a que bodega entra *@
            <div class="idx-head">
                <span class="idx-glifo"><i class="fa fa-file-invoice-dollar"></i></span>
                <div class="idx-head-text">
                    <h3>@Localizer["Purchase_Header", Purchase.NroPurchase] · @Purchase.Supplier?.Name</h3>
                    <p>@Localizer[nameof(Resource.InvoiceNumber)] @Purchase.NroFactura · @Purchase.FacuraDate.ToString("dd/MM/yyyy") · @Localizer[nameof(Resource.Storage)] @Purchase.ProductStorage?.StorageName</p>
                </div>
                <div class="idx-head-tools">
                    <PurchaseStatusBadge Value="@Purchase.Status" />
                </div>
            </div>

            @* Los totales de la factura *@
            <div class="pu-totals">
                <div class="pu-total">
                    <div class="pu-tile-label">@Localizer[nameof(Resource.Subtotal)]</div>
                    <div class="pu-total-value">@Purchase.SubTotalCompra.ToString("N2")</div>
                </div>
                <div class="pu-total">
                    <div class="pu-tile-label">@Localizer[nameof(Resource.Tax)]</div>
                    <div class="pu-total-value">@Purchase.ImpuestoTotalCompra.ToString("N2")</div>
                </div>
                <div class="pu-total is-main">
                    <div class="pu-tile-label">@Localizer[nameof(Resource.Total)]</div>
                    <div class="pu-total-value">@Purchase.TotalCompra.ToString("N2")</div>
                </div>
            </div>

            @* Acciones: cerrar va aparte, a la derecha, para no pulsarlo por error *@
            <div class="pu-actions">
                <a class="btn pu-btn" href="/purchases">
                    <i class="fa fa-arrow-left"></i> @Localizer["Purchase_Back"]
                </a>
                @if (IsOpen)
                {
                    <button class="btn pu-btn" @onclick="() => ShowModalAsync()">
                        <i class="fa fa-plus"></i> @Localizer[nameof(Resource.Product)]
                    </button>
                    <button class="btn pu-btn pu-btn-close" @onclick="ClosePurchaseAsync">
                        <i class="fa fa-lock"></i> @Localizer["Purchase_Close"]
                    </button>
                }
            </div>
        }

        <section class="idx-panel">
            <div class="table-responsive">
                <table class="idx-table">
                    <thead>
                        <tr>
                            <th>@Localizer[nameof(Resource.Product)]</th>
                            <th style="text-align:right">@Localizer[nameof(Resource.Quantity)]</th>
                            <th style="text-align:right">@Localizer[nameof(Resource.UnitCost)]</th>
                            <th style="text-align:right">@Localizer["Purchase_TaxRate"]</th>
                            <th style="text-align:right">@Localizer[nameof(Resource.Subtotal)]</th>
                            <th style="text-align:right">@Localizer[nameof(Resource.Tax)]</th>
                            <th style="text-align:right">@Localizer[nameof(Resource.Total)]</th>
                            <th style="text-align:right">@Localizer["Table_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <GenericList MyList="PurchaseDetails">
                            <Loading>
                                <tr>
                                    <td colspan="8" class="idx-meta" style="text-align:center">
                                        <span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Table_Loading"]
                                    </td>
                                </tr>
                            </Loading>
                            <NoRecords>
                                <tr>
                                    <td colspan="8" class="idx-meta" style="text-align:center">@Localizer["Table_NoRecords"]</td>
                                </tr>
                            </NoRecords>
                            <Body>
                                @foreach (var item in PurchaseDetails!)
                                {
                                    <tr>
                                        <td>
                                            <div class="idx-name">@item.NameProduct</div>
                                            @* Al cerrar, este producto abre su cargue para subir las MAC *@
                                            @if (item.Product?.WithSerials == true)
                                            {
                                                <span class="pu-tag"><i class="fa fa-barcode"></i> @Localizer["Purchase_Serials"]</span>
                                            }
                                        </td>
                                        <td style="text-align:right">@item.Quantity.ToString("#,0.##")</td>
                                        <td style="text-align:right">@item.UnitCost.ToString("N2")</td>
                                        <td style="text-align:right">@item.RateTax.ToString("N2")</td>
                                        <td style="text-align:right">@item.SubTotal.ToString("N2")</td>
                                        <td style="text-align:right">@item.Impuesto.ToString("N2")</td>
                                        <td style="text-align:right"><strong>@item.TotalGeneral.ToString("N2")</strong></td>
                                        <td>
                                            <div class="idx-actions">
                                                @if (IsOpen)
                                                {
                                                    <ButtonEdit OnClick="() => ShowModalAsync(item.PurchaseDetailId, true)" />
                                                    <ButtonDelete OnClick="() => DeleteAsync(item.PurchaseDetailId)" />
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </Body>
                        </GenericList>
                    </tbody>
                </table>
            </div>

            @if (PurchaseDetails is not null)
            {
                <div class="idx-panel-foot">
                    <Pagination CurrentPage="CurrentPage"
                                SelectedPage="SelectedPage"
                                TotalPages="TotalPages" />
                </div>
            }
        </section>
    </div>
</div>
