@page "/cargues/details/{Id:guid}"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator, Auxiliar")]
@using Spix.DomainLogic.EnumTypes
@using Spix.DomainLogic.EntitiesInvenDTO

<div class="container-fluid pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">

        @if (Progress is null)
        {
            <Loading />
        }
        else
        {
            @* Encabezado: que compra es y como va *@
            <div class="idx-head">
                <span class="idx-glifo"><i class="fa fa-barcode"></i></span>
                <div class="idx-head-text">
                    <h3>@Progress.ProductName</h3>
                    <p>#@Progress.ControlCargue · @Localizer["Cargue_Invoice"] @Progress.NroFactura · @Progress.DateCargue.ToLocalTime().ToString("dd/MM/yyyy")</p>
                </div>
                <div class="idx-head-tools">
                    <a class="btn cg-btn" href="/cargues">
                        <i class="bi bi-arrow-left"></i> @Localizer["Cargue_Back"]
                    </a>
                    @* Solo para cargues viejos que quedaron completos sin cerrar: hoy se cierran solos *@
                    @if (Progress.Status == CargueType.Pendiente && Missing == 0)
                    {
                        <button class="btn cg-btn" @onclick="CloseCargueAsync">
                            <i class="bi bi-check-square"></i> @Localizer["Cargue_Close"]
                        </button>
                    }
                </div>
            </div>

            @* El avance del cargue y como estan sus seriales *@
            <div class="cg-progress-card">
                <div class="cg-progress-text">
                    <span><strong>@Progress.Uploaded</strong> @Localizer["Cargue_Of"] @Progress.CantToUp.ToString("N0")</span>
                    @if (Missing > 0)
                    {
                        <span>@Localizer["Cargue_Missing"] @Missing</span>
                    }
                    else
                    {
                        <span class="cg-pill is-done">@Localizer["Cargue_Done"]</span>
                    }
                </div>
                <div class="cg-bar">
                    <div class="cg-bar-fill @(Missing == 0 ? "is-done" : null)" style="width:@Percent%"></div>
                </div>
                <div class="cg-chips">
                    <span class="cg-chip is-free">@Localizer["Cargue_Available"] <b>@Progress.Available</b></span>
                    <span class="cg-chip is-used">@Localizer["Cargue_Installed"] <b>@Progress.Installed</b></span>
                    <span class="cg-chip is-bad">@Localizer["Cargue_Damaged"] <b>@Progress.Damaged</b></span>
                </div>
            </div>
        }

        @* Una sola linea: a la izquierda el escaner agrega, a la derecha el buscador busca *@
        <div class="cg-tools">
            @if (Progress?.Status == CargueType.Pendiente && Missing > 0)
            {
                <form class="cg-scan" @onsubmit="ScanAsync">
                    <i class="fa fa-barcode cg-scan-icon"></i>
                    <input class="form-control cg-scan-input"
                           placeholder="@Localizer["Cargue_ScanHint"]"
                           value="@ScanMac"
                           @oninput="ScanChanged"
                           @ref="ScanInput"
                           disabled="@IsSaving"
                           autocomplete="off" />
                    <button type="submit" class="btn cg-btn" disabled="@IsSaving">
                        <i class="fa fa-plus"></i> @Localizer["Cargue_Add"]
                    </button>
                </form>
            }
            <div class="idx-search">
                <FilterComponent ApplyFilter="SetFilterValue" />
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ScanMessage))
        {
            <div class="cg-scan-msg @(ScanOk ? "is-ok" : "is-bad")">
                <i class="fa @(ScanOk ? "fa-check-circle" : "fa-exclamation-circle")"></i> @ScanMessage
            </div>
        }

        <section class="idx-panel">
            <div class="table-responsive">
                <table class="idx-table">
                    <thead>
                        <tr>
                            <th>@Localizer[nameof(Resource.MAC)]</th>
                            <th>@Localizer[nameof(Resource.Status)]</th>
                            <th>@Localizer["Cargue_InstalledIn"]</th>
                            <th>@Localizer[nameof(Resource.Comment)]</th>
                            <th style="text-align:right">@Localizer["Table_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <GenericList MyList="Serials">
                            <Loading>
                                <tr>
                                    <td colspan="5" class="idx-meta" style="text-align:center">
                                        <span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Table_Loading"]
                                    </td>
                                </tr>
                            </Loading>
                            <NoRecords>
                                <tr>
                                    <td colspan="5" class="idx-meta" style="text-align:center">@Localizer["Table_NoRecords"]</td>
                                </tr>
                            </NoRecords>
                            <Body>
                                @foreach (var item in Serials!)
                                {
                                    <tr>
                                        <td>
                                            <div class="idx-name cg-mac">@item.MacWlan</div>
                                            <div class="idx-meta">@item.DateCargue?.ToString("dd/MM/yyyy HH:mm")</div>
                                        </td>
                                        <td>
                                            <span class="cg-pill @StatusCss(item.Status)">@item.Status</span>
                                        </td>
                                        <td>
                                            @* Sale del contrato que tiene asignada la MAC *@
                                            @if (item.ControlContrato is not null)
                                            {
                                                <div class="idx-name">@item.InstalledClient</div>
                                                <div class="idx-meta">#@item.ControlContrato</div>
                                            }
                                            else
                                            {
                                                <span class="idx-meta">—</span>
                                            }
                                        </td>
                                        <td class="idx-meta">@item.Comment</td>
                                        <td>
                                            <div class="idx-actions">
                                                @* El backend solo deja corregir mientras el cargue esta abierto *@
                                                @if (Progress?.Status == CargueType.Pendiente)
                                                {
                                                    <ButtonEdit OnClick="() => ShowEditAsync(item.CargueDetailId)" />
                                                    <ButtonDelete OnClick="() => DeleteAsync(item.CargueDetailId)" />
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </Body>
                        </GenericList>
                    </tbody>
                </table>
            </div>

            @if (Serials is not null)
            {
                <div class="idx-panel-foot">
                    <Pagination CurrentPage="CurrentPage"
                                SelectedPage="SelectedPage"
                                TotalPages="TotalPages" />
                </div>
            }
        </section>
    </div>
</div>
