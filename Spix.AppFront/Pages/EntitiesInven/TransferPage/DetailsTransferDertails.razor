@page "/transfers/details/{Id:guid}"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator")]
@using Spix.DomainLogic.EnumTypes

@* El detalle del traslado, con el mismo molde que el detalle de Compras:
   encabezado, de que bodega a cual va, acciones y la tabla de productos.
   Un traslado cerrado ya movio el inventario: no se le agregan ni se le tocan lineas. *@
<div class="container-fluid pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">

        @if (Transfer is null)
        {
            <Loading />
        }
        else
        {
            <div class="idx-head">
                <span class="idx-glifo"><i class="fa fa-right-left"></i></span>
                <div class="idx-head-text">
                    <h3>@Localizer["Transfer_Header", Transfer.NroTransfer]</h3>
                    <p>@Transfer.DateTransfer.ToString("dd/MM/yyyy") · @Transfer.NombreUsuario</p>
                </div>
                <div class="idx-head-tools">
                    <TransferStatusBadge Value="@(Transfer.Status ?? TransferType.Pendiente)" />
                </div>
            </div>

            @* De donde sale y a donde entra, con los mismos cards de linea lateral que
               usan los demas index (.idx-board / .idx-tile de app.css). *@
            <div class="idx-board">
                <div class="idx-tile is-amber">
                    <div class="idx-tile-label">@Localizer[nameof(Resource.FromProductStorage)]</div>
                    <div class="idx-tile-value">@Transfer.FromStorageName</div>
                </div>
                <div class="idx-tile is-green">
                    <div class="idx-tile-label">@Localizer[nameof(Resource.ToProductStorage)]</div>
                    <div class="idx-tile-value">@Transfer.ToStorageName</div>
                </div>
            </div>

            @* Acciones: cerrar va aparte, a la derecha, para no pulsarlo por error *@
            <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
                @* Sin TooTip: el boton dice "Volver" por defecto, que es lo que hace *@
                <AnchorFormBack Href="/transfers" />
                @if (Transfer.Status == TransferType.Pendiente)
                {
                    <ButtonFormNew OnClick="() => ShowModalAsync()" TooTip="@Localizer[nameof(Resource.Product)]" />

                    <div class="ms-auto">
                        <ButtonFormGreen OnClick="() => ClosePurchaseAsync(Transfer.TransferId)"
                                         Icon="fa fa-lock"
                                         TooTip="@Localizer["Transfer_Close"]" />
                    </div>
                }
            </div>
        }

        <section class="idx-panel">
            <div class="table-responsive">
                <table class="idx-table">
                    <thead>
                        <tr>
                            <th>@Localizer[nameof(Resource.Product)]</th>
                            <th>@Localizer[nameof(Resource.Category)]</th>
                            <th style="text-align:right">@Localizer[nameof(Resource.Quantity)]</th>
                            <th style="text-align:right">@Localizer["Table_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <GenericList MyList="TransferDetails">
                            <Loading>
                                <tr>
                                    <td colspan="4" class="idx-meta" style="text-align:center">
                                        <span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Table_Loading"]
                                    </td>
                                </tr>
                            </Loading>
                            <NoRecords>
                                <tr>
                                    <td colspan="4" class="idx-meta" style="text-align:center">@Localizer["Table_NoRecords"]</td>
                                </tr>
                            </NoRecords>
                            <Body>
                                @foreach (var item in TransferDetails!)
                                {
                                    <tr>
                                        <td>
                                            <div class="idx-name">@item.Product?.ProductName</div>
                                        </td>
                                        <td>@item.Product?.ProductCategory?.Name</td>
                                        <td style="text-align:right">@item.Quantity.ToString("#,0.##")</td>
                                        <td>
                                            <div class="idx-actions">
                                                @* Los equipos que viajaron. Solo en los productos que llevan
                                                   serial: en los demas no hay nada que mostrar. *@
                                                @if (item.Product?.WithSerials == true)
                                                {
                                                    <ButtonGeneric OnClick="() => ShowSerialsAsync(item)"
                                                                   TooTip="@Localizer["Transfer_MovedSerials"]"
                                                                   Icon="fa fa-barcode" />
                                                }

                                                @* Con el traslado cerrado los renglones no se tocan *@
                                                @if (Transfer?.Status == TransferType.Pendiente)
                                                {
                                                    <ButtonEdit OnClick="() => ShowModalAsync(item.TransferDetailsId, true)" />
                                                    <ButtonDelete OnClick="() => DeleteAsync(item.TransferDetailsId)" />
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </Body>
                        </GenericList>
                    </tbody>
                </table>
            </div>

            @if (TransferDetails is not null)
            {
                <div class="idx-panel-foot">
                    <Pagination CurrentPage="CurrentPage"
                                SelectedPage="SelectedPage"
                                TotalPages="TotalPages" />
                </div>
            }
        </section>
    </div>
</div>
