@page "/transfers"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator")]
@using Spix.DomainLogic.EnumTypes

@* Traslados de inventario: mueven stock de una bodega a otra.
   Mismo molde que Compras, que es su gemelo: encabezado, barra, tabla y paginacion.
   Un traslado cerrado ya movio el inventario, asi que no se edita ni se borra. *@
<div class="container-fluid pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">

        @* Encabezado: el unico titulo de la pantalla *@
        <div class="idx-head">
            <span class="idx-glifo"><i class="fa fa-right-left"></i></span>
            <div class="idx-head-text">
                <h3>@Localizer["Transfer_Title"]</h3>
                <p>@Localizer["Transfer_Subtitle"]</p>
            </div>
        </div>

        <div class="idx-bar">
            <ButtonFormNew OnClick="() => ShowModalAsync()" />
            <div class="idx-search">
                <FilterComponent ApplyFilter="SetFilterValue" />
            </div>
        </div>

        <section class="idx-panel">
            <div class="table-responsive">
                <table class="idx-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Localizer[nameof(Resource.FromProductStorage)]</th>
                            <th>@Localizer[nameof(Resource.ToProductStorage)]</th>
                            <th>@Localizer[nameof(Resource.User)]</th>
                            <th>@Localizer[nameof(Resource.Status)]</th>
                            <th style="text-align:right">@Localizer["Table_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <GenericList MyList="Transfers">
                            <Loading>
                                <tr>
                                    <td colspan="6" class="idx-meta" style="text-align:center">
                                        <span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Table_Loading"]
                                    </td>
                                </tr>
                            </Loading>
                            <NoRecords>
                                <tr>
                                    <td colspan="6" class="idx-meta" style="text-align:center">@Localizer["Table_NoRecords"]</td>
                                </tr>
                            </NoRecords>
                            <Body>
                                @foreach (var item in Transfers!)
                                {
                                    <tr class="row-dbl" @ondblclick="() => ShowDetailsAsync(item.TransferId)">
                                        <td>
                                            <div class="idx-name">@item.NroTransfer</div>
                                            <div class="idx-meta">@item.DateTransfer.ToString("dd/MM/yyyy")</div>
                                        </td>
                                        <td>@item.FromStorageName</td>
                                        <td>@item.ToStorageName</td>
                                        <td>@item.NombreUsuario</td>
                                        <td><TransferStatusBadge Value="@(item.Status ?? TransferType.Pendiente)" /></td>
                                        <td @ondblclick:stopPropagation>
                                            <div class="idx-actions">
                                                <ButtonGeneric OnClick="() => ShowDetailsAsync(item.TransferId)" TooTip="@Localizer["Transfer_Details"]" Icon="fa fa-table-list" />
                                                @* Un traslado cerrado ya movio inventario: no se edita ni se borra *@
                                                @if (item.Status == TransferType.Pendiente)
                                                {
                                                    <ButtonEdit OnClick="() => ShowModalAsync(item.TransferId, true)" />
                                                    <ButtonDelete OnClick="() => DeleteAsync(item.TransferId)" />
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </Body>
                        </GenericList>
                    </tbody>
                </table>
            </div>

            @if (Transfers is not null)
            {
                <div class="idx-panel-foot">
                    <Pagination CurrentPage="CurrentPage"
                                SelectedPage="SelectedPage"
                                TotalPages="TotalPages" />
                </div>
            }
        </section>
    </div>
</div>
