@* Una linea del traslado: que producto se mueve y cuanto.
   Los cuatro campos con el mismo molde del resto del sistema: input-group con su rotulo
   gris a la izquierda y todos del mismo ancho. *@
<EditForm Model="TransferDetails" OnValidSubmit="OnSubmit">
    <DataAnnotationsValidator />

    <div class="mb-2">
        <GenericSelectWrapper Tmodel="ProductCategory" Items="Categories">
            <Body>
            <div class="input-group">
                <span class="input-group-text" style="width: 150px">@Localizer[nameof(Resource.Category)]</span>
                <select class="form-select" value="@SelectedCategoryId" @onchange="CategoryChanged">
                    @foreach (var item in Categories!)
                    {
                        <option value="@item.ProductCategoryId">@item.Name</option>
                    }
                </select>
            </div>
            </Body>
        </GenericSelectWrapper>
    </div>

    <div class="mb-2">
        <GenericSelectWrapper Tmodel="Product" Items="Products">
            <Body>
            <div class="input-group">
                <span class="input-group-text" style="width: 150px">@Localizer[nameof(Resource.Product)]</span>
                <select class="form-select" value="@TransferDetails.ProductId" @onchange="ProductsChanged">
                    @foreach (var item in Products!)
                    {
                        <option value="@item.ProductId">@item.ProductName</option>
                    }
                </select>
            </div>
            </Body>
        </GenericSelectWrapper>
    </div>

    @* Lo que hay del producto en la bodega de ORIGEN: es el techo de la cantidad *@
    <div class="mb-2">
        <div class="input-group">
            <span class="input-group-text" style="width: 150px">@Localizer["Transfer_Available"]</span>
            <InputNumber class="form-control" @bind-Value="StockAvaible" readonly />
        </div>
    </div>

    <div class="mb-2">
        <div class="input-group">
            <span class="input-group-text" style="width: 150px">@Localizer["Transfer_Quantity"]</span>
            <InputNumber class="form-control"
                         @bind-Value="TransferDetails.Quantity"
                         @oninput="@(e => CalculoTotalCant(decimal.TryParse(e.Value?.ToString(), out var valor) ? valor : 0))" />
        </div>
    </div>
    <ValidationMessage For="@(() => TransferDetails.Quantity)" />

    <!-- Botones -->
    <div class="d-flex justify-content-center gap-3 mt-4">
        <ButtonFormBack OnClick="ReturnAction" />
        <ButtonFormSave />
    </div>
</EditForm>
