@page "/schedule"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator, Technician")]
@using Spix.AppFront.GenericModel
@using Spix.AppFront.Helper

<PageTitle>@Localizer["Schedule"]</PageTitle>

<div class="container-fluid pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">

        @* El titulo vive DENTRO del card: sobre el fondo azul no se leia *@
        <div class="idx-head">
            <span class="idx-glifo"><i class="fa fa-calendar-days"></i></span>
            <div class="idx-head-text">
                <h3>@Localizer["Schedule"]</h3>
                <p>@Localizer["Schedule_Subtitle"]</p>
            </div>

            <div class="idx-head-tools">
                <GenericSelectWrapper Tmodel="IntItemModel" Items="Statuses">
                    <Body>
                        <div class="input-group" style="width:230px">
                            <span class="input-group-text"><i class="fa fa-filter"></i></span>
                            <select class="form-select" value="@StatusFilter" @onchange="StatusChanged">
                                @foreach (var item in Statuses!)
                                {
                                    <option value="@item.Value">@item.Name</option>
                                }
                            </select>
                        </div>
                    </Body>
                </GenericSelectWrapper>
            </div>
        </div>

        @* Leyenda: que significa cada color del calendario *@
        @if (Statuses is not null)
        {
            <div class="sch-legend">
                @foreach (var item in Statuses.Where(x => x.Value > 0))
                {
                    <span class="sch-chip">
                        <span class="sch-dot" style="background:@ScheduleColors.Get(item.Value)"></span>
                        @item.Name
                    </span>
                }
            </div>
        }

        <SpixCalendar @ref="_calendar" />
    </div>
</div>
