@page "/nodes"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator")]

<div class="container pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">
        @* Encabezado: el unico titulo de la pantalla *@
        <div class="idx-head">
            <span class="idx-glifo"><i class="fa fa-tower-broadcast"></i></span>
            <div class="idx-head-text">
                <h3>Nodos de Acceso</h3>
                <p>Puntos de acceso de la red, su zona, su IP y su ubicacion en el mapa.</p>
            </div>

            @if (TotalRecords > 0)
            {
                <div class="idx-head-tools">
                    <span class="idx-count">@TotalRecords.ToString("N0") nodos</span>
                </div>
            }
        </div>

        @* Acciones y buscador, fuera del panel de la tabla *@
        <div class="idx-bar">
            <ButtonFormNew OnClick="() => ShowModalAsync()" />

            <div class="idx-search">
                <FilterComponent ApplyFilter="SetFilterValue" />
            </div>
        </div>

        <section class="idx-panel">

            @* La tabla vive afuera del GenericList: el encabezado se pinta siempre,
               aunque no haya registros, y el borde del panel no queda cortado. *@
            <div class="table-responsive">
                <table class="idx-table">
                    <thead>
                        <tr>
                            <th>SSID</th>
                            <th>Type</th>
                            <th>Zona</th>
                            <th>IP</th>
                            <th>Activa</th>
                            <th style="text-align:right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* El GenericList solo arma las filas: el cargando y el "sin registros"
                           entran como una fila mas, debajo del encabezado. *@
                        <GenericList MyList="Nodes">
                            <Loading>
                                <tr>
                                    <td colspan="6" class="idx-meta" style="text-align:center">
                                        <span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Table_Loading"]
                                    </td>
                                </tr>
                            </Loading>
                            <NoRecords>
                                <tr>
                                    <td colspan="6" class="idx-meta" style="text-align:center">@Localizer["Table_NoRecords"]</td>
                                </tr>
                            </NoRecords>
                            <Body>
                                @foreach (var item in Nodes!)
                                {
                                    <tr>
                                        <td><span class="idx-name">@item.NodesName</span></td>
                                        <td>@item.Operation!.OperationName</td>
                                        <td>@item.Zone!.ZoneName</td>
                                        <td>@item.IpNetwork!.Ip</td>
                                        <td>
                                            <span class="idx-pill @(item.Active ? "is-on" : "is-off")">
                                                @(item.Active ? Localizer[nameof(Resource.Active)] : Localizer[nameof(Resource.Inactive)])
                                            </span>
                                        </td>
                                        <td>
                                            <div class="idx-actions">
                                                <ButtonGeneric OnClick="() => ShowMapAsync(item)"
                                                               TooTip="Mapa"
                                                               Icon="fa fa-map-location-dot" />
                                                <ButtonEdit OnClick="() => ShowModalAsync(item.NodeId, true)" />
                                                <ButtonDelete OnClick="() => DeleteAsync(item.NodeId)" />
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </Body>
                        </GenericList>
                    </tbody>
                </table>
            </div>

            <div class="idx-panel-foot">
                <Pagination CurrentPage="CurrentPage"
                            SelectedPage="SelectedPage"
                            TotalPages="TotalPages" />
            </div>
        </section>
    </div>
</div>
