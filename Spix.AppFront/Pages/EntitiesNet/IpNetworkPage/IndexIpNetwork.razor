@page "/ipnetworks"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator")]

<div class="container-fluid pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">
        @* Encabezado: el unico titulo de la pantalla *@
        <div class="idx-head">
            <span class="idx-glifo"><i class="fa fa-project-diagram"></i></span>
            <div class="idx-head-text">
                <h3>@Localizer["IpNetwork_Title"]</h3>
                <p>@Localizer["IpNetwork_Subtitle"]</p>
            </div>

            @if (TotalRecords > 0)
            {
                <div class="idx-head-tools">
                    <span class="idx-count">@Localizer[TotalRecords == 1 ? "Ip_CountOne" : "Ip_CountMany", TotalRecords.ToString("N0")]</span>
                </div>
            }
        </div>

        @* El tablero: lo cuenta la base, sobre todas las direcciones *@
        @if (Summary is not null)
        {
            <div class="ip-board">
                <div class="ip-tile">
                    <div class="ip-tile-label">@Localizer["Ip_Total"]</div>
                    <div class="ip-tile-value">@Summary.Total.ToString("N0")</div>
                </div>
                <div class="ip-tile is-free">
                    <div class="ip-tile-label">@Localizer["Ip_Free"]</div>
                    <div class="ip-tile-value">@Summary.Free.ToString("N0")</div>
                </div>
                <div class="ip-tile is-used">
                    <div class="ip-tile-label">@Localizer["Ip_Assigned"]</div>
                    <div class="ip-tile-value">@Summary.Assigned.ToString("N0")</div>
                </div>
                <div class="ip-tile is-off">
                    <div class="ip-tile-label">@Localizer["Ip_Excluded"]</div>
                    <div class="ip-tile-value">@Summary.Excluded.ToString("N0")</div>
                </div>
            </div>
        }

        @* Acciones y buscador, fuera del panel de la tabla *@
        <div class="idx-bar">
            <ButtonFormNew OnClick="() => ShowModalAsync()" />
            <ButtonFormDark OnClick="ShowPoolModalAsync" TooTip="@Localizer["Ip_PoolNew"]" />
            <ButtonFormRed OnClick="ShowDeletePoolModalAsync" TooTip="@Localizer["Ip_PoolDelete"]" />

            <div class="idx-search">
                <FilterComponent ApplyFilter="SetFilterValue" />
            </div>
        </div>

        <section class="idx-panel">

            @* La tabla vive afuera del GenericList: el encabezado se pinta siempre,
               aunque no haya registros, y el borde del panel no queda cortado. *@
            <div class="table-responsive">
                <table class="idx-table">
                    <thead>
                        <tr>
                            <th>@Localizer["Ip_Address"]</th>
                            <th>@Localizer[nameof(Resource.Description)]</th>
                            <th class="text-center">@Localizer["Ip_ColActive"]</th>
                            <th class="text-center">@Localizer["Ip_ColAssigned"]</th>
                            <th class="text-center">@Localizer["Ip_ColExcluded"]</th>
                            <th style="text-align:right">@Localizer["Table_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* El GenericList solo arma las filas: el cargando y el "sin registros"
                           entran como una fila mas, debajo del encabezado. *@
                        <GenericList MyList="IpNetworks">
                            <Loading>
                                <tr>
                                    <td colspan="6" class="idx-meta" style="text-align:center">
                                        <span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Table_Loading"]
                                    </td>
                                </tr>
                            </Loading>
                            <NoRecords>
                                <tr>
                                    <td colspan="6" class="idx-meta" style="text-align:center">@Localizer["Table_NoRecords"]</td>
                                </tr>
                            </NoRecords>
                            <Body>
                                @foreach (var item in IpNetworks!)
                                {
                                    <tr>
                                        <td><span class="idx-name">@item.Ip</span></td>
                                        <td>@item.Description</td>
                                        <td class="text-center">
                                            <i class="idx-flag @(item.Active ? "fa fa-circle-check is-on" : "fa fa-minus is-off")"></i>
                                        </td>
                                        <td class="text-center">
                                            <i class="idx-flag @(item.Assigned ? "fa fa-circle-check is-on" : "fa fa-minus is-off")"></i>
                                        </td>
                                        <td class="text-center">
                                            <i class="idx-flag @(item.Excluded ? "fa fa-circle-check is-on" : "fa fa-minus is-off")"></i>
                                        </td>
                                        <td>
                                            <div class="idx-actions">
                                                <ButtonEdit OnClick="() => ShowModalAsync(item.IpNetworkId, true)" />
                                                <ButtonDelete OnClick="() => DeleteAsync(item.IpNetworkId)" />
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </Body>
                        </GenericList>
                    </tbody>
                </table>
            </div>

            <div class="idx-panel-foot">
                <Pagination CurrentPage="CurrentPage"
                            SelectedPage="SelectedPage"
                            TotalPages="TotalPages" />
            </div>
        </section>
    </div>
</div>
