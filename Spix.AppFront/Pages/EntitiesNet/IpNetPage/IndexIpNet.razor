@page "/ipnets"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator")]

<div class="container pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">
        @* Encabezado: el unico titulo de la pantalla *@
        <div class="idx-head">
            <span class="idx-glifo"><i class="fa fa-laptop"></i></span>
            <div class="idx-head-text">
                <h3>IP Address Clientes</h3>
                <p>Direcciones IP que se asignan a los clientes. Puede cargarlas y borrarlas por pool.</p>
            </div>

            @if (TotalRecords > 0)
            {
                <div class="idx-head-tools">
                    <span class="idx-count">@TotalRecords.ToString("N0") direcciones</span>
                </div>
            }
        </div>

        @* Acciones y buscador, fuera del panel de la tabla. Tabla grande: la busqueda
           se dispara con Enter o con la lupa, no en cada tecla. *@
        <div class="idx-bar">
            <ButtonFormNew OnClick="() => ShowModalAsync()" />
            <ButtonFormDark OnClick="ShowPoolModalAsync" TooTip="Pool Nuevo" />
            <ButtonFormRed OnClick="ShowDeletePoolModalAsync" TooTip="Borra Pool" />

            <div class="idx-search">
                <FilterComponent ApplyFilter="SetFilterValue" />
            </div>
        </div>

        <section class="idx-panel">

            <GenericList MyList="IpNets">
                <Body>
                    <div class="table-responsive">
                        <table class="idx-table">
                            <thead>
                                <tr>
                                    <th>Ip</th>
                                    <th>Descripcion</th>
                                    <th class="text-center">Activa</th>
                                    <th class="text-center">Asignada</th>
                                    <th class="text-center">Excluida</th>
                                    <th style="text-align:right">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in IpNets!)
                                {
                                    <tr>
                                        <td><span class="idx-name">@item.Ip</span></td>
                                        <td>@item.Description</td>
                                        <td class="text-center">
                                            <i class="idx-flag @(item.Active ? "fa fa-circle-check is-on" : "fa fa-minus is-off")"></i>
                                        </td>
                                        <td class="text-center">
                                            <i class="idx-flag @(item.Assigned ? "fa fa-circle-check is-on" : "fa fa-minus is-off")"></i>
                                        </td>
                                        <td class="text-center">
                                            <i class="idx-flag @(item.Excluded ? "fa fa-circle-check is-on" : "fa fa-minus is-off")"></i>
                                        </td>
                                        <td>
                                            <div class="idx-actions">
                                                <ButtonEdit OnClick="() => ShowModalAsync(item.IpNetId, true)" />
                                                <ButtonDelete OnClick="() => DeleteAsync(item.IpNetId)" />
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </Body>
            </GenericList>

            <div class="idx-panel-foot">
                <Pagination CurrentPage="CurrentPage"
                            SelectedPage="SelectedPage"
                            TotalPages="TotalPages" />
            </div>
        </section>
    </div>
</div>
