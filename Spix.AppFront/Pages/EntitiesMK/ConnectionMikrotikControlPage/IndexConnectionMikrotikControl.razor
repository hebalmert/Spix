@page "/connectionmikrotikcontrols"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator, Auxiliar")]

<div class="container pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">
        @* Encabezado: el unico titulo de la pantalla *@
        <div class="idx-head">
            <span class="idx-glifo"><i class="fa fa-network-wired"></i></span>
            <div class="idx-head-text">
                <h3>Control Mikrotik</h3>
                <p>Define como se conecta el sistema a los equipos Mikrotik de la corporacion.</p>
            </div>

            @if (TotalRecords > 0)
            {
                <div class="idx-head-tools">
                    <span class="idx-count">@TotalRecords.ToString("N0") registros</span>
                </div>
            }
        </div>

        @* Acciones y buscador, fuera del panel de la tabla *@
        <div class="idx-bar">
            <ButtonFormNew OnClick="() => ShowModalAsync()" />
        </div>

        <section class="idx-panel">

            @* La tabla vive afuera del GenericList: el encabezado se pinta siempre,
               aunque no haya registros, y el borde del panel no queda cortado. *@
            <div class="table-responsive">
                <table class="idx-table">
                    <thead>
                        <tr>
                            <th>Corporacion</th>
                            <th>Tipo Control</th>
                            <th style="text-align:right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* El GenericList solo arma las filas: el cargando y el "sin registros"
                           entran como una fila mas, debajo del encabezado. *@
                        <GenericList MyList="ConnectionMikrotikControls">
                            <Loading>
                                <tr>
                                    <td colspan="3" class="idx-meta" style="text-align:center">
                                        <span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Table_Loading"]
                                    </td>
                                </tr>
                            </Loading>
                            <NoRecords>
                                <tr>
                                    <td colspan="3" class="idx-meta" style="text-align:center">@Localizer["Table_NoRecords"]</td>
                                </tr>
                            </NoRecords>
                            <Body>
                                @foreach (var item in ConnectionMikrotikControls!)
                                {
                                    <tr>
                                        <td><span class="idx-name">@item.Corporation?.Name</span></td>
                                        <td>@item.MikrotikControlType</td>
                                        <td>
                                            <div class="idx-actions">
                                                <ButtonEdit OnClick="() => ShowModalAsync(item.ConnectionMikrotikControlId, true)" />
                                                <ButtonDelete OnClick="() => DeleteAsync(item.ConnectionMikrotikControlId)" />
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </Body>
                        </GenericList>
                    </tbody>
                </table>
            </div>

            <div class="idx-panel-foot">
                <Pagination CurrentPage="CurrentPage"
                            SelectedPage="SelectedPage"
                            TotalPages="TotalPages" />
            </div>
        </section>
    </div>
</div>
