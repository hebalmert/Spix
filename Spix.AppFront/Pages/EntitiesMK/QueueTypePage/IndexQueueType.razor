@page "/queuetypes"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator, Auxiliar")]

<div class="container pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">
        @* Encabezado: el unico titulo de la pantalla *@
        <div class="idx-head">
            <span class="idx-glifo"><i class="fa fa-gauge-high"></i></span>
            <div class="idx-head-text">
                <h3>Queue Types</h3>
                <p>Tipos de cola que se aplican a los planes de servicio en el Mikrotik.</p>
            </div>

            @if (TotalRecords > 0)
            {
                <div class="idx-head-tools">
                    <span class="idx-count">@TotalRecords.ToString("N0") tipos</span>
                </div>
            }
        </div>

        @* Acciones y buscador, fuera del panel de la tabla *@
        <div class="idx-bar">
            <ButtonFormNew OnClick="() => ShowModalAsync()" />
        </div>

        <section class="idx-panel">

            @* La tabla vive afuera del GenericList: el encabezado se pinta siempre,
               aunque no haya registros, y el borde del panel no queda cortado. *@
            <div class="table-responsive">
                <table class="idx-table">
                    <thead>
                        <tr>
                            <th>Queue Type</th>
                            <th class="text-center">Down</th>
                            <th class="text-center">Up</th>
                            <th class="text-center">Activo</th>
                            <th style="text-align:right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* El GenericList solo arma las filas: el cargando y el "sin registros"
                           entran como una fila mas, debajo del encabezado. *@
                        <GenericList MyList="QueueTypes">
                            <Loading>
                                <tr>
                                    <td colspan="5" class="idx-meta" style="text-align:center">
                                        <span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Table_Loading"]
                                    </td>
                                </tr>
                            </Loading>
                            <NoRecords>
                                <tr>
                                    <td colspan="5" class="idx-meta" style="text-align:center">@Localizer["Table_NoRecords"]</td>
                                </tr>
                            </NoRecords>
                            <Body>
                                @foreach (var item in QueueTypes!)
                                {
                                    <tr>
                                        <td><span class="idx-name">@item.TypeName</span></td>
                                        <td class="text-center">
                                            <i class="idx-flag @(item.Down ? "fa fa-circle-check is-on" : "fa fa-minus is-off")"></i>
                                        </td>
                                        <td class="text-center">
                                            <i class="idx-flag @(item.Up ? "fa fa-circle-check is-on" : "fa fa-minus is-off")"></i>
                                        </td>
                                        <td class="text-center">
                                            <span class="idx-pill @(item.Active ? "is-on" : "is-off")">
                                                @(item.Active ? "Activo" : "Inactivo")
                                            </span>
                                        </td>
                                        <td>
                                            <div class="idx-actions">
                                                <ButtonEdit OnClick="() => ShowModalAsync(item.QueueTypeId, true)" />
                                                <ButtonDelete OnClick="() => DeleteAsync(item.QueueTypeId)" />
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </Body>
                        </GenericList>
                    </tbody>
                </table>
            </div>

            <div class="idx-panel-foot">
                <Pagination CurrentPage="CurrentPage"
                            SelectedPage="SelectedPage"
                            TotalPages="TotalPages" />
            </div>
        </section>
    </div>
</div>
