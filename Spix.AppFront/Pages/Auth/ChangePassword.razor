@* El mismo cascaron de los demas modales: fondo oscuro, cabecera con el titulo y la X,
   etiquetas de 150px y los botones compartidos de la familia Shared. *@
<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1055;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-create-shadow p-4 position-relative">
            <div class="modal-header d-flex justify-content-between align-items-center mb-3">
                <h5 class="modal-title">@Localizer[nameof(Resource.PasswordChangeTitle)]</h5>
                <button class="btn-close-modal" @onclick="ReturnAction" title="Close">
                    <i class="fa fa-times"></i>
                </button>
            </div>

            <EditForm Model="changePasswordDTO" OnValidSubmit="ChangePasswordAsync">
                <DataAnnotationsValidator />

                <div class="mb-2">
                    <div class="input-group">
                        <span class="input-group-text" style="width:150px">
                            @Localizer[nameof(Resource.PasswordCurrent)]
                        </span>
                        <InputText type="@CurrentPasswordInputType"
                                   class="form-control"
                                   autocomplete="current-password"
                                   @bind-Value="changePasswordDTO.CurrentPassword" />
                        <button type="button" class="btn btn-outline-secondary" @onclick="ToggleCurrentPassword">
                            <i class="fa @(showCurrentPassword ? "fa-eye-slash" : "fa-eye")"></i>
                        </button>
                    </div>
                    <ValidationMessage For="@(() => changePasswordDTO.CurrentPassword)" />
                </div>

                <div class="mb-2">
                    <div class="input-group">
                        <span class="input-group-text" style="width:150px">
                            @Localizer[nameof(Resource.PasswordNew)]
                        </span>
                        <input type="@NewPasswordInputType"
                               class="form-control"
                               autocomplete="new-password"
                               value="@changePasswordDTO.NewPassword"
                               @oninput="NewPasswordChanged" />
                        <button type="button" class="btn btn-outline-secondary" @onclick="ToggleNewPassword">
                            <i class="fa @(showNewPassword ? "fa-eye-slash" : "fa-eye")"></i>
                        </button>
                    </div>
                    <ValidationMessage For="@(() => changePasswordDTO.NewPassword)" />
                </div>

                <div class="mb-2">
                    <div class="input-group">
                        <span class="input-group-text" style="width:150px">
                            @Localizer[nameof(Resource.PasswordConfirm)]
                        </span>
                        <input type="@ConfirmPasswordInputType"
                               class="form-control"
                               autocomplete="new-password"
                               value="@changePasswordDTO.Confirm"
                               @oninput="ConfirmPasswordChanged" />
                        <button type="button" class="btn btn-outline-secondary" @onclick="ToggleConfirmPassword">
                            <i class="fa @(showConfirmPassword ? "fa-eye-slash" : "fa-eye")"></i>
                        </button>
                    </div>
                    @* Aviso en vivo: se sabe antes de guardar si las dos claves son la misma *@
                    @if (ShowPasswordMatch)
                    {
                        <div class="form-text @(PasswordsMatch ? "text-success" : "text-danger")">
                            <i class="fa @(PasswordsMatch ? "fa-check-circle" : "fa-times-circle") me-1"></i>
                            @(PasswordsMatch
                                ? Localizer[nameof(Resource.PasswordsMatch)]
                                : Localizer[nameof(Resource.PasswordsDontMatch)])
                        </div>
                    }
                    <ValidationMessage For="@(() => changePasswordDTO.Confirm)" />
                </div>

                <div class="d-flex justify-content-center gap-3 mt-4">
                    <ButtonFormSave />
                    <ButtonFormBack TooTip="@Localizer[nameof(Resource.ButtonCancel)]"
                                    OnClick="ReturnAction" />
                </div>
            </EditForm>
        </div>
    </div>
</div>
