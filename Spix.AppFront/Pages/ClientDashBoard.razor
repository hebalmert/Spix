@page "/client-dashboard"
@attribute [Authorize(Roles = "Client")]
@layout MainLayout

<PageTitle>Client Dashboard</PageTitle>

<section class="client-dashboard">
    <div class="client-dashboard__header">
        <div>
            <p class="client-dashboard__eyebrow">Portal Cliente</p>
            <h1>Mi Servicio</h1>
        </div>
        <span class="client-dashboard__status">
            <i class="fa fa-circle-check"></i>
            Activo
        </span>
    </div>

    <div class="client-dashboard__grid">
        <div class="client-card client-card--service">
            <div class="client-card__content">
                <span class="client-card__label">Plan contratado</span>
                <h2>Servicio principal</h2>
                <p>Resumen del plan, velocidad y estado general del servicio.</p>
            </div>
            <i class="fa fa-wifi client-card__icon"></i>
        </div>

        @* Facturacion: sus facturas, que se le cobro y cuanto debe *@
        <div class="client-card client-card--billing" @onclick="GoToBills" role="button">
            <div class="client-card__content">
                <span class="client-card__label">Facturacion</span>
                <h2>
                    Mis facturas
                    @if (pendingBills > 0)
                    {
                        <span class="client-card__badge">@pendingBills</span>
                    }
                </h2>
                <p>
                    @if (pendingBills > 0)
                    {
                        <text>Tiene facturas por pagar. Entre para ver que se le cobro y cuanto debe.</text>
                    }
                    else
                    {
                        <text>Esta al dia. Entre para ver sus facturas y lo que se le cobro.</text>
                    }
                </p>
            </div>
            <i class="fa fa-file-invoice-dollar client-card__icon"></i>
        </div>

        @* Documentos para firmar: entra directo al portal de firma *@
        <div class="client-card client-card--sign" @onclick="GoToSignatures" role="button">
            <div class="client-card__content">
                <span class="client-card__label">Documentos</span>
                <h2>
                    Firmar documentos
                    @if (pendingSignatures > 0)
                    {
                        <span class="client-card__badge">@pendingSignatures</span>
                    }
                </h2>
                <p>
                    @if (pendingSignatures > 0)
                    {
                        <text>Tiene documentos pendientes por firmar. Entre para revisarlos y firmarlos.</text>
                    }
                    else
                    {
                        <text>Consulte y descargue los documentos de su contrato.</text>
                    }
                </p>
            </div>
            <i class="fa fa-file-signature client-card__icon"></i>
        </div>

        @* Soporte: pedir una visita tecnica y seguir como va *@
        <div class="client-card client-card--support" @onclick="GoToRequests" role="button">
            <div class="client-card__content">
                <span class="client-card__label">Soporte</span>
                <h2>
                    Solicitudes de servicio
                    @if (openRequests > 0)
                    {
                        <span class="client-card__badge">@openRequests</span>
                    }
                </h2>
                <p>
                    @if (openRequests > 0)
                    {
                        <text>Tiene solicitudes en proceso. Entre para ver como van.</text>
                    }
                    else
                    {
                        <text>Pida una visita tecnica y siga como quedo.</text>
                    }
                </p>
            </div>
            <i class="fa fa-headset client-card__icon"></i>
        </div>
    </div>

    <div class="client-dashboard__panel">
        <div>
            <h2>Actividad reciente</h2>
            <p>Este bloque queda listo para mostrar notificaciones, mantenimientos, pagos o cambios del servicio.</p>
        </div>
        <i class="fa fa-bell"></i>
    </div>
</section>
