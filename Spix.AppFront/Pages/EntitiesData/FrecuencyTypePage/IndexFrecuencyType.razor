@page "/frecuencytypes"
@layout MainLayout
@attribute [Authorize(Roles = "Admin")]


<div class="container pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">
        <div class="idx-head">
            <span class="idx-glifo"><i class="fa fa-tower-broadcast"></i></span>
            <div class="idx-head-text">
                <h3>@Localizer[nameof(Resource.FrecuencyType_Title)]</h3>
                <p>@Localizer[nameof(Resource.FrecuencyType_Subtitle)]</p>
            </div>
        </div>

        <!-- Botón + Filtro -->
        <div class="row align-items-center mb-3">
            <div class="col-md-3 d-flex justify-content-start">
                <ButtonFormNew OnClick="() => ShowModalAsync()" />
            </div>
            <div class="col-md-9 d-flex justify-content-end">
                <FilterComponent ApplyFilter="SetFilterValue" />
            </div>
        </div>

        <hr />
        <GenericList MyList="FrecuencyTypes">
            <Body>
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>@Localizer[nameof(Resource.FrecuencyType)]</th>
                                <th>@Localizer[nameof(Resource.Active)]</th>
                                <th></th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in FrecuencyTypes!)
                            {
                                <tr class="row-dbl" @ondblclick="() => ShowModalAsync(item.FrecuencyTypeId, true)">
                                    <td>@item.TypeName</td>
                                    <td>
                                        <input type="checkbox" class="form-check-input" checked="@item.Active" disabled />
                                    </td>
                                    <td @ondblclick:stopPropagation style="width:1px;">
                                        <ButtonEdit OnClick="() => ShowModalAsync(item.FrecuencyTypeId, true)" />
                                    </td>
                                    <td style="width:1px;">
                                        <ButtonGeneric OnClick="() => ShowModalDetailsAsync(item.FrecuencyTypeId)" TooTip="@Localizer[nameof(Resource.Frecuency)]"
                                                       Icon="fa fa-wifi" />
                                    </td>
                                    <td style="width:1px;">
                                        <ButtonDelete OnClick="() => DeleteAsync(item.FrecuencyTypeId)" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </Body>
        </GenericList>
        <!-- Tabla -->
        <hr />
        @if (FrecuencyTypes is not null)
        {
            <!-- Paginación -->
            <Pagination CurrentPage="CurrentPage"
                        SelectedPage="SelectedPage"
                        TotalPages="TotalPages" />
        }
    </div>
</div>


