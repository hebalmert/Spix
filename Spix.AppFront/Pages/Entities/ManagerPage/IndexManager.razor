@page "/managers"
@layout MainLayout
@attribute [Authorize(Roles = "Admin")]


<div class="container pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">
        <div class="idx-head">
            <span class="idx-glifo"><i class="fa fa-user-tie"></i></span>
            <div class="idx-head-text">
                <h3>@Localizer[nameof(Resource.ManagerIdx_Title)]</h3>
                <p>@Localizer[nameof(Resource.ManagerIdx_Subtitle)]</p>
            </div>
        </div>

        <!-- Botón + Filtro -->
        <div class="row align-items-center mb-3">
            <div class="col-md-3 d-flex justify-content-start">
                <ButtonFormNew OnClick="() => ShowModalAsync()" />
            </div>
            <div class="col-md-9 d-flex justify-content-end">
                <FilterComponent ApplyFilter="SetFilterValue" />
            </div>
        </div>

        <hr />
        <GenericList MyList="Managers">
            <Body>
                @if (Managers is not null)
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>Foto</th>
                                    <th>@Localizer[nameof(Resource.FullName)]</th>
                                    <th>@Localizer[nameof(Resource.Corporation)]</th>
                                    <th>@Localizer[nameof(Resource.Job)]</th>
                                    <th>@Localizer[nameof(Resource.Active)]</th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Managers!)
                                {
                                    <tr class="row-dbl" @ondblclick="() => ShowModalAsync(item.ManagerId, true)">
                                        <td>
                                            <AvatarImage Url="@item.ImageFullPath" Icon="fa fa-user-tie" Size="90" />
                                        </td>
                                        <td>
                                            @item.FirstName @item.LastName
                                        </td>
                                        <td>
                                            @item.Corporation!.Name
                                        </td>
                                        <td>
                                            @item.Job
                                        </td>
                                        <td>
                                            <input type="checkbox" class="form-check-input" checked="@item.Active" disabled />
                                        </td>
                                        <td style="width:1px;">
                                            @if (item.Active)
                                            {
                                                <ButtonGeneric OnClick="() => ResendActivationEmailAsync(item.ManagerId)"
                                                               TooTip="Re-Email"
                                                               Icon="fa fa-envelope" />
                                            }
                                        </td>
                                        <td @ondblclick:stopPropagation style="width:1px;">
                                            <ButtonEdit OnClick="() => ShowModalAsync(item.ManagerId, true)" />
                                        </td>
                                        <td style="width:1px;">
                                            <ButtonDelete OnClick="() => DeleteAsync(item.ManagerId)" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </Body>
        </GenericList>
        <!-- Tabla -->
        <hr />
        @if (Managers is not null)
        {
            <!-- Paginación -->
            <Pagination CurrentPage="CurrentPage"
                        SelectedPage="SelectedPage"
                        TotalPages="TotalPages" />
        }
    </div>
</div>

