@page "/not-found"
@layout MainLayout
@inject IStringLocalizer<Resource> Localizer

<PageTitle>@Localizer["App_NotFoundTitle"]</PageTitle>

<section class="route-not-found" role="alert">
    <div class="route-not-found__icon"><i class="fa fa-compass"></i></div>
    <span class="route-not-found__code">404</span>
    <h1>@Localizer["App_NotFoundTitle"]</h1>
    <p>@Localizer["App_NotFoundMessage"]</p>
    <a class="btn btn-gradient-primary" href="/dashboard"><i class="fa fa-house me-2"></i>@Localizer["App_BackToDashboard"]</a>
</section>
