@inherits ComponentBase
@using Spix.Domain.EntitiesSchedule

@* Cargar una foto de la visita: se elige si es del antes o del despues y se trae
   de la camara o del disco. Una foto por vez. *@
<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1055;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-create-shadow p-4 position-relative">
            <div class="modal-header d-flex justify-content-between align-items-center mb-3">
                <h5 class="modal-title"><i class="fa fa-camera me-2"></i>@Localizer["Photo_Add"]</h5>
                <button class="btn-close-modal" @onclick="Return" title="Close">
                    <i class="fa fa-times"></i>
                </button>
            </div>

            <div class="up-type">
                <button type="button" class="up-chip @(PhotoType == ServicePhotoType.Before ? "is-on" : null)"
                        @onclick="() => PhotoType = ServicePhotoType.Before">
                    @Localizer["Photo_Before"]
                </button>
                <button type="button" class="up-chip @(PhotoType == ServicePhotoType.After ? "is-on" : null)"
                        @onclick="() => PhotoType = ServicePhotoType.After">
                    @Localizer["Photo_After"]
                </button>
            </div>

            <InputImageIDfront ImageSelected="ImageSelected" Label="@Localizer["Photo_Add"]" />

            <hr />
            <div class="d-flex justify-content-center gap-3">
                <ButtonFormSaveOnClick OnClick="SaveAsync" IsSaving="IsSaving" TooTip="@Localizer[nameof(Resource.ButtonSave)]" />
                <ButtonFormBack OnClick="Return" />
            </div>
        </div>
    </div>
</div>
