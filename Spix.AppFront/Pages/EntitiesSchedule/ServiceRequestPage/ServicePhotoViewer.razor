@inherits ComponentBase
@using Spix.Domain.EntitiesSchedule

@* Las fotos de la visita, una por una, con flechas para pasarlas *@
<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1055;">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-create-shadow p-4 position-relative">
            <div class="modal-header d-flex justify-content-between align-items-center mb-3">
                <h5 class="modal-title">
                    <i class="fa fa-camera me-2"></i>@Localizer["Photo_Title"]
                    <span class="pv-tag @(Current.PhotoType == ServicePhotoType.After ? "is-after" : null)">
                        @(Current.PhotoType == ServicePhotoType.After ? Localizer["Photo_After"] : Localizer["Photo_Before"])
                    </span>
                </h5>
                <button class="btn-close-modal" @onclick="Return" title="Close">
                    <i class="fa fa-times"></i>
                </button>
            </div>

            <div class="pv-stage">
                @if (Photos.Count > 1)
                {
                    <button type="button" class="pv-nav" @onclick="Previous"><i class="fa fa-chevron-left"></i></button>
                }

                <img src="@Current.ImageFullPath" alt="@Current.PhotoType" />

                @if (Photos.Count > 1)
                {
                    <button type="button" class="pv-nav is-next" @onclick="Next"><i class="fa fa-chevron-right"></i></button>
                }
            </div>

            <div class="pv-meta">
                @Current.DateCreated.ToLocalTime().ToString("dd/MM/yyyy HH:mm") &middot; @Current.UserByName
            </div>

            @if (Photos.Count > 1)
            {
                <div class="pv-dots">
                    @for (var i = 0; i < Photos.Count; i++)
                    {
                        var index = i;
                        <button type="button" class="pv-dot @(index == CurrentIndex ? "is-on" : null)" @onclick="() => CurrentIndex = index"></button>
                    }
                </div>
            }

            <hr />
            <div class="d-flex justify-content-center">
                <ButtonFormBack OnClick="Return" />
            </div>
        </div>
    </div>
</div>
