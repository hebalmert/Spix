@page "/my-servicerequests"
@layout MainLayout
@attribute [Authorize(Roles = "Client")]
@using Spix.Domain.EntitiesSchedule
@using Spix.AppFront.SharedEnumColor

@* Lo que el cliente ve de sus visitas: en que van y como quedaron.
   Sin montos ni detalle de lo cobrado: eso le llega en su factura. *@
<div class="container-fluid pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">

        <div class="idx-head">
            <span class="idx-glifo"><i class="fa fa-tools"></i></span>
            <div class="idx-head-text">
                <h3>@Localizer["MyRequest_Title"]</h3>
                <p>@Localizer["MyRequest_Subtitle"]</p>
            </div>

            <div class="idx-head-tools">
                <ButtonFormNew OnClick="ShowModalAsync" TooTip="@Localizer["MyRequest_Button"]" />
            </div>
        </div>

        <section class="idx-panel">
            <div class="table-responsive">
                <table class="idx-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Localizer["Table_Contract"]</th>
                            <th>Motivo</th>
                            <th>@Localizer["Table_Scheduled"]</th>
                            <th>@Localizer[nameof(Resource.Status)]</th>
                            <th style="text-align:right">@Localizer["Table_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <GenericList MyList="Requests">
                            <Loading>
                                <tr>
                                    <td colspan="6" class="idx-meta" style="text-align:center">
                                        <span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Table_Loading"]
                                    </td>
                                </tr>
                            </Loading>
                            <NoRecords>
                                <tr>
                                    <td colspan="6" class="idx-meta" style="text-align:center">@Localizer["Table_NoRecords"]</td>
                                </tr>
                            </NoRecords>
                            <Body>
                                @foreach (var item in Requests!)
                                {
                                    <tr>
                                        <td>
                                            <div class="idx-name">@item.RequestNumber</div>
                                            <div class="idx-meta">@item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                        </td>
                                        <td>
                                            <div class="idx-name">@item.ControlContrato</div>
                                            <div class="idx-meta">@item.Address</div>
                                        </td>
                                        <td>@item.ClientReason</td>
                                        <td>
                                            @if (item.ScheduledAtUtc.HasValue)
                                            {
                                                <div>@item.ScheduledAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                                <div class="idx-meta">@item.ScheduledAtUtc.Value.ToLocalTime().ToString("HH:mm")</div>
                                            }
                                            else
                                            {
                                                <span class="idx-meta">@Localizer["When_Unassigned"]</span>
                                            }
                                        </td>
                                        <td><ScheduleStatusBadge Value="@item.ScheduleStatus" /></td>
                                        <td>
                                            <div class="idx-actions">
                                                @if (!string.IsNullOrWhiteSpace(item.TechnicianComment) ||
                                                     !string.IsNullOrWhiteSpace(item.Recommendation))
                                                {
                                                    <ButtonGeneric Icon="fa fa-circle-info"
                                                                   TooTip="@Localizer["MyRequest_Result"]"
                                                                   OnClick="() => ShowResultAsync(item)" />
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </Body>
                        </GenericList>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
