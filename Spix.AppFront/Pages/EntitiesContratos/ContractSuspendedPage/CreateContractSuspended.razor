@inherits ComponentBase
@using Spix.DomainLogic.EntitiesContractDTO

@* Suspender un contrato. Se escribe el nombre o la cedula, se elige el contrato activo
   y el backend hace todo: MikroTik a regular, estado Suspendido y registro de la suspension. *@
<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1055;">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-create-shadow p-4 position-relative">
            <div class="modal-header d-flex justify-content-between align-items-center mb-3">
                <h5 class="modal-title"><i class="fa fa-ban me-2"></i>Suspender contrato</h5>
                <button class="btn-close-modal" @onclick="Return" title="Close">
                    <i class="fa fa-times"></i>
                </button>
            </div>

            <div class="input-group mb-2">
                <span class="input-group-text" style="width:150px">@Localizer[nameof(Resource.Client)]</span>
                <input class="form-control" placeholder="Escriba el nombre o la cedula..."
                       value="@SearchText" @oninput="SearchAsync" />
            </div>

            @if (IsSearching)
            {
                <div class="cs-hint"><span class="spinner-border spinner-border-sm me-2"></span>Buscando...</div>
            }
            else if (Candidates is not null && Candidates.Count == 0 && SearchText.Trim().Length >= 3)
            {
                <div class="cs-hint">No hay contratos activos que coincidan.</div>
            }

            @if (Candidates is not null && Candidates.Count > 0)
            {
                <div class="cs-list">
                    @foreach (var item in Candidates)
                    {
                        <button type="button"
                                class="cs-item @(Selected?.ContractClientId == item.ContractClientId ? "is-selected" : null)"
                                @onclick="() => Select(item)">
                            <div>
                                <div class="cs-name">#@item.ControlContrato &middot; @item.ClientName</div>
                                <div class="cs-meta">@item.ClientDocument &middot; @item.Address</div>
                            </div>
                            <div class="cs-plan">
                                <div>@item.PlanName</div>
                                <div class="cs-meta">@item.PlanAmount.ToString("N2")</div>
                            </div>
                        </button>
                    }
                </div>
            }

            @if (Selected is not null)
            {
                <div class="cs-selected">
                    <i class="fa fa-circle-check me-2"></i>
                    <b>#@Selected.ControlContrato &middot; @Selected.ClientName</b>
                    <span class="cs-meta ms-2">@Selected.PlanName &middot; @Selected.PlanAmount.ToString("N2")</span>
                </div>

                <div class="input-group mt-3">
                    <span class="input-group-text" style="width:150px">@Localizer["ContractState_Reason"]</span>
                    <InputTextArea class="form-control" rows="2" maxlength="200" @bind-Value="Motivo" />
                </div>
            }

            <hr />
            <div class="d-flex justify-content-center gap-3">
                @if (Selected is not null)
                {
                    <ButtonFormSaveOnClick OnClick="SaveAsync" IsSaving="IsSaving" TooTip="Suspender" ProgressText="Suspendiendo..." Icon="fa fa-ban" />
                }
                <ButtonFormBack OnClick="Return" />
            </div>
        </div>
    </div>
</div>
