@page "/contractclients"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator, Auxiliar")]
@using Spix.DomainLogic.EnumTypes

<div class="container pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">

        @* Encabezado: el unico titulo de la pantalla *@
        <div class="idx-head">
            <span class="idx-glifo"><i class="fa fa-file-contract"></i></span>
            <div class="idx-head-text">
                <h3>@Localizer[nameof(Resource.Control_Contracts)]</h3>
                <p>Contratos de los clientes: documentos, fotos del ID, firmas y estado.</p>
            </div>

            @if (TotalRecords > 0)
            {
                <div class="idx-head-tools">
                    <span class="idx-count">@TotalRecords.ToString("N0") contratos</span>
                </div>
            }
        </div>

        @* Acciones, filtro de estado y buscador, fuera del panel de la tabla *@
        <div class="idx-bar">
            <ButtonFormNew OnClick="() => ShowModalAsync()" />

            @* Filtro por estado: muestra solo los contratos del estado elegido (del mas nuevo al mas viejo) *@
            <div class="input-group" style="width:240px; min-width:200px;">
                <span class="input-group-text bg-light">
                    <i class="fa fa-filter text-dark"></i>
                </span>
                <select class="form-select" value="@StatusFilter" @onchange="StatusFilterChanged">
                    <option value="0">Todos los estados</option>
                    <option value="@((int)ContractState.Draft)">@Localizer[nameof(Resource.ContractState_Draft)]</option>
                    <option value="@((int)ContractState.PendingApproval)">@Localizer[nameof(Resource.ContractState_PendingApproval)]</option>
                    <option value="@((int)ContractState.InProgress)">@Localizer[nameof(Resource.ContractState_InProgress)]</option>
                </select>
            </div>

            <div class="idx-search">
                <FilterComponent ApplyFilter="SetFilterValue" />
            </div>
        </div>

        <section class="idx-panel">

            @* La tabla vive afuera del GenericList: el encabezado se pinta siempre,
               aunque no haya registros, y el borde del panel no queda cortado. *@
            <div class="table-responsive">
                <table class="idx-table">
                    <thead>
                        <tr>
                            <th>@Localizer["Table_Contract"]</th>
                            <th>@Localizer[nameof(Resource.Client)]</th>
                            <th>@Localizer[nameof(Resource.Contractor)]</th>
                            <th class="text-center">@Localizer["Table_Stratum"]</th>
                            <th class="text-center">@Localizer[nameof(Resource.Equipment)]</th>
                            <th class="text-center">@Localizer[nameof(Resource.Invoice)]</th>
                            <th>@Localizer[nameof(Resource.Status)]</th>
                            <th style="text-align:right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* El GenericList solo arma las filas: el cargando y el "sin registros"
                           entran como una fila mas, debajo del encabezado. *@
                        <GenericList MyList="ContractClients">
                            <Loading>
                                <tr>
                                    <td colspan="8" class="idx-meta" style="text-align:center">
                                        <span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Table_Loading"]
                                    </td>
                                </tr>
                            </Loading>
                            <NoRecords>
                                <tr>
                                    <td colspan="8" class="idx-meta" style="text-align:center">@Localizer["Table_NoRecords"]</td>
                                </tr>
                            </NoRecords>
                            <Body>
                                @foreach (var item in ContractClients!)
                                {
                                    <tr>
                                        <td><span class="idx-name">@item.ControlContrato</span></td>
                                        <td>@item.Client!.FirstName @item.Client.LastName</td>
                                        <td>
                                            <span class="idx-tip" data-tip="@($"{item.Contractor!.FirstName} {item.Contractor.LastName}")">@item.Contractor!.FirstName</span>
                                        </td>
                                        <td class="text-center">@GetEstratoNumber(item.EstratoSocial?.EstratoSocialName)</td>
                                        <td class="text-center">
                                            <i class="idx-flag @(item.EquipoEmpres ? "fa fa-circle-check is-on" : "fa fa-minus is-off")"></i>
                                        </td>
                                        <td class="text-center">
                                            <i class="idx-flag @(item.EnvoiceClient ? "fa fa-circle-check is-on" : "fa fa-minus is-off")"></i>
                                        </td>
                                        <td>
                                            <StatusBadge Value="@item.ContractState" />
                                        </td>
                                        <td>
                                            <div class="idx-actions">
                                                @* Los datos de auditoria no ocupan columna: se consultan aqui *@
                                                <ButtonGeneric Icon="fa fa-clock-rotate-left"
                                                               TooTip="@Localizer["Audit_Tip"]"
                                                               OnClick="() => ShowAuditAsync(item)" />
                                                @* Aprobar: solo en Pending Approval y con fotos + Consentimiento + Contrato firmados *@
                                                @if (item.ContractState == ContractState.PendingApproval && item.RequirementsComplete)
                                                {
                                                    <ButtonGeneric OnClick="() => ApproveAsync(item.ContractClientId)"
                                                                   TooTip="Aprobar: pasar a In Progress"
                                                                   Icon="fa fa-circle-check"
                                                                   Style="font-size:17px;color:#0DCAF0;" />
                                                }

                                                @* Solicitud de firma: solo mientras falte firmar el Consentimiento o el Contrato *@
                                                @if (!item.SignaturesComplete)
                                                {
                                                    <ButtonGeneric OnClick="() => SendSignatureRequestAsync(item.ContractClientId)"
                                                                   TooTip="Enviar solicitud de firma al cliente"
                                                                   Icon="fa fa-paper-plane"
                                                                   Style="font-size:17px;color:#6f42c1;" />
                                                }

                                                @if (item.TieneIDPic)
                                                {
                                                    <ButtonGeneric OnClick="() => ShowModalidpicsAsync(item.ContractClientId, item.ContractIDPic!.ContractIDPicId)"
                                                                   TooTip="@Localizer[nameof(Resource.Edit_IDPics)]"
                                                                   Icon="fa fa-id-card" />
                                                }
                                                else
                                                {
                                                    <ButtonGeneric OnClick="() => ShowModalidpicsAsync(item.ContractClientId, null)"
                                                                   TooTip="@Localizer[nameof(Resource.Create_IDPics)]"
                                                                   Icon="fa fa-id-card" />
                                                }

                                                <ButtonGeneric OnClick="() => ShowContractDocumentAsync(item.ContractClientId, ContractDocumentType.ConsentData)"
                                                               TooTip="Consentimiento"
                                                               Icon="fa fa-file-signature"
                                                               Style="font-size:17px;color:#198754;" />

                                                <ButtonGeneric OnClick="() => ShowContractDocumentAsync(item.ContractClientId, ContractDocumentType.Contract)"
                                                               TooTip="Contrato"
                                                               Icon="fa fa-file-contract"
                                                               Style="font-size:17px;color:#0d6efd;" />

                                                <ButtonEdit OnClick="() => ShowModalAsync(item.ContractClientId, true)" />
                                                <ButtonDelete OnClick="() => DeleteAsync(item.ContractClientId)" />
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </Body>
                        </GenericList>
                    </tbody>
                </table>
            </div>

            @if (ContractClients is not null)
            {
                <div class="idx-panel-foot">
                    <Pagination CurrentPage="CurrentPage"
                                SelectedPage="SelectedPage"
                                TotalPages="TotalPages" />
                </div>
            }
        </section>
    </div>
</div>
