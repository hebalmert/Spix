@* Contrato del cliente. Mismos campos y mismos eventos de siempre; solo se agrupan por bloques
   para que no queden encimados el estrato, los interruptores y el estatus. *@
<EditForm Model="ContractClient">
    <DataAnnotationsValidator />

    @* ---------- 1. Contrato ---------- *@
    <p class="cc-section">@Localizer[nameof(Resource.Commercial)]</p>
    <div class="row g-2">
        <div class="col-12 col-md-6">
            <GenericSelectWrapper Tmodel="GuidItemModel" Items="Contractors">
                <Body>
                    <div class="input-group">
                        <span class="input-group-text" style="width:150px">@Localizer[nameof(Resource.Contractor)]</span>
                        <select class="form-select" value="@ContractClient.ContractorId" @onchange="ContractorChanged">
                            @foreach (var item in Contractors!)
                            {
                                <option value="@item.Value">@item.Name</option>
                            }
                        </select>
                    </div>
                </Body>
            </GenericSelectWrapper>
        </div>

        <div class="col-12 col-md-6">
            <AutoCompleteGuidSelect Label="Cliente"
                                    ApiUrl="/api/v1/combosData/ComboClients"
                                    MinLength="3"
                                    Value="@Value"
                                    ValueText="@ValueText"
                                    OnSelected="OnClientSelected" />
        </div>

        @* El plan: categoria y plan anidados, porque el plan cuelga de una categoria.
           Es una condicion COMERCIAL, por eso vive aqui y no en el detalle tecnico. *@
        <div class="col-12">
            <div class="cc-plan-box">
                <div class="row g-2">
                    <div class="col-12 col-md-6">
                        <GenericSelectWrapper Tmodel="PlanCategory" Items="PlanCategories">
                            <Body>
                                <div class="input-group">
                                    <span class="input-group-text cc-label-sm">@Localizer[nameof(Resource.PlanCategory)]</span>
                                    <select class="form-select" value="@ContractClient.PlanCategoryId" @onchange="PlanCategoryChanged">
                                        @foreach (var item in PlanCategories!)
                                        {
                                            <option value="@item.PlanCategoryId">@item.PlanCategoryName</option>
                                        }
                                    </select>
                                </div>
                            </Body>
                        </GenericSelectWrapper>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="input-group">
                            <span class="input-group-text cc-label-sm">@Localizer[nameof(Resource.Plan)]</span>
                            <select class="form-select" value="@ContractClient.PlanId" @onchange="PlanChanged">
                                @foreach (var item in Plans!)
                                {
                                    <option value="@item.PlanId">@item.PlanName</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                @if (SelectedPlan is not null)
                {
                    <div class="cc-plan-facts">
                        <span><i class="fa fa-gauge-high"></i> @SelectedPlan.VelocidadTotal</span>
                        <span><i class="fa fa-money-bill"></i> @SelectedPlan.PrecioconImpuesto</span>
                        <span><i class="fa fa-users"></i> @Localizer[nameof(Resource.TasaRehuso)] @SelectedPlan.TasaReuso</span>
                    </div>
                }

                @if (PlanMissing)
                {
                    <div class="text-danger small mt-1">@Localizer[nameof(Resource.Select_Plan)]</div>
                }
            </div>
        </div>
    </div>

    @* ---------- 2. Contacto ---------- *@
    <p class="cc-section">@Localizer[nameof(Resource.Contact)]</p>
    <div class="row g-2">
        @* Los dos telefonos, uno al lado del otro. Las tres cajitas caben de sobra a
           media columna. *@
        <div class="col-12 col-md-6">
            <div class="input-group">
                <span class="input-group-text" style="width: 150px">
                    @Localizer[nameof(Resource.Phone)]
                </span>
                <InputText class="form-control" style="max-width: 80px" placeholder="+57" @bind-Value="ContractClient!.CodeCountry" />
                <InputText class="form-control" style="max-width: 80px" placeholder="300" @bind-Value="ContractClient!.CodeNumber" />
                <InputText class="form-control" placeholder="3675815" @bind-Value="ContractClient!.PhoneNumber" />
            </div>
            <ValidationMessage For="@(() => ContractClient.CodeCountry)" />
            <ValidationMessage For="@(() => ContractClient.CodeNumber)" />
            <ValidationMessage For="@(() => ContractClient.PhoneNumber)" />
        </div>

        <div class="col-12 col-md-6">
            <div class="input-group">
                <span class="input-group-text" style="width: 150px">
                    @Localizer[nameof(Resource.Phone2)]
                </span>
                <InputText class="form-control" style="max-width: 80px" placeholder="+57" @bind-Value="ContractClient!.CodeCountry2" />
                <InputText class="form-control" style="max-width: 80px" placeholder="300" @bind-Value="ContractClient!.CodeNumber2" />
                <InputText class="form-control" placeholder="3675815" @bind-Value="ContractClient!.PhoneNumber2" />
            </div>
            <ValidationMessage For="@(() => ContractClient.PhoneNumber2)" />
        </div>

        <div class="col-12 col-md-6">
            <div class="input-group">
                <span class="input-group-text" style="width: 150px">
                    @Localizer[nameof(Resource.Email)]
                </span>
                <input class="form-control" value="@ClientEmail" readonly />
            </div>
            <div class="cc-hint">@Localizer[nameof(Resource.Email)] del cliente: es a donde llega la solicitud de firma</div>
        </div>

        <div class="col-12">
            <div class="input-group">
                <span class="input-group-text" style="width: 150px">
                    @Localizer[nameof(Resource.Address)]
                </span>
                <InputTextArea class="form-control cc-address" placeholder="" @bind-Value="ContractClient!.Address" />
            </div>
            <ValidationMessage For="@(() => ContractClient.Address)" />
        </div>
    </div>

    @* ---------- 3. Ubicacion ---------- *@
    <p class="cc-section">@Localizer[nameof(Resource.Location)]</p>
    <div class="row g-2">
        <div class="col-12 col-md-4">
            <GenericSelectWrapper Tmodel="State" Items="States">
                <Body>
                    <div class="input-group">
                        <span class="input-group-text cc-label-sm">@Localizer[nameof(Resource.State)]</span>
                        <select class="form-select" value="@ContractClient.StateId" @onchange="StateChanged">
                            @foreach (var item in States!)
                            {
                                <option value="@item.StateId">@item.Name</option>
                            }
                        </select>
                    </div>
                </Body>
            </GenericSelectWrapper>
        </div>

        <div class="col-12 col-md-4">
            <GenericSelectWrapper Tmodel="City" Items="Cities">
                <Body>
                    <div class="input-group">
                        <span class="input-group-text cc-label-sm">@Localizer[nameof(Resource.City)]</span>
                        <select class="form-select" value="@ContractClient?.CityId" @onchange="CityChanged">
                            @foreach (var item in Cities!)
                            {
                                <option value="@item.CityId">@item.Name</option>
                            }
                        </select>
                    </div>
                </Body>
            </GenericSelectWrapper>
        </div>

        <div class="col-12 col-md-4">
            <GenericSelectWrapper Tmodel="Zone" Items="Zones">
                <Body>
                    <div class="input-group">
                        <span class="input-group-text cc-label-sm">@Localizer[nameof(Resource.Zone)]</span>
                        <select class="form-select" value="@ContractClient!.ZoneId" @onchange="ZoneChanged">
                            @foreach (var item in Zones!)
                            {
                                <option value="@item.ZoneId">@item.ZoneName</option>
                            }
                        </select>
                    </div>
                </Body>
            </GenericSelectWrapper>
        </div>
    </div>

    @* ---------- 4. Condiciones del servicio ---------- *@
    <p class="cc-section">@Localizer[nameof(Resource.Status)]</p>
    <div class="row g-2">
        <div class="col-12 col-md-6">
            <GenericSelectWrapper Tmodel="GuidItemModel" Items="EstratosSociales">
                <Body>
                    <div class="input-group">
                        <span class="input-group-text cc-label-sm">
                            @Localizer[nameof(Resource.EstratoSocial)]
                        </span>
                        <select class="form-select" value="@ContractClient.EstratoSocialId" @onchange="EstratoSocialChanged">
                            @foreach (var item in EstratosSociales!)
                            {
                                <option value="@item.Value">@item.Name</option>
                            }
                        </select>
                    </div>
                </Body>
            </GenericSelectWrapper>
        </div>

        <div class="col-12 col-md-6">
            @if (StatusEditable)
            {
                @* Value trae el estado del modelo (0 = [Select Status], que viene del backend)
                   y OnChange lo actualiza. Las opciones salen del combo, nada escrito a mano. *@
                <GenericSelectWrapper Tmodel="IntItemModel" Items="WorkStatuses">
                    <Body>
                        <div class="input-group">
                            <span class="input-group-text cc-label-sm">@Localizer[nameof(Resource.Status)]</span>
                            <select class="form-select" value="@StatusValue" @onchange="StatusChanged">
                                @foreach (var item in WorkStatuses!)
                                {
                                    <option value="@item.Value">@item.Name</option>
                                }
                            </select>
                        </div>
                        @if (StatusMissing)
                        {
                            <div class="cc-error">@Localizer["Validation_SelectStatus"]</div>
                        }
                    </Body>
                </GenericSelectWrapper>
            }
            else
            {
                @* Contrato ya operativo: el estado se ve, pero se cambia desde Control de Contratos *@
                <div class="input-group">
                    <span class="input-group-text cc-label-sm">@Localizer[nameof(Resource.Status)]</span>
                    <span class="form-control d-flex align-items-center">
                        <StatusBadge Value="@ContractClient.ContractState" />
                    </span>
                </div>
                <div class="cc-hint-sm">@Localizer["ContractState_OnlyFromControl"]</div>
            }
        </div>

        @* Los dos interruptores, cada uno en su tarjeta, para que no queden pegados a los combos *@
        <div class="col-12 col-md-6">
            <label class="cc-switch">
                <span>@Localizer[nameof(Resource.Equipment_Compnay)]</span>
                <span class="form-check form-switch m-0">
                    <InputCheckbox @bind-Value="ContractClient!.EquipoEmpres" class="form-check-input" />
                </span>
            </label>
        </div>

        <div class="col-12 col-md-6">
            <label class="cc-switch">
                <span>@Localizer[nameof(Resource.Invoice_Client)]</span>
                <span class="form-check form-switch m-0">
                    <InputCheckbox @bind-Value="ContractClient!.EnvoiceClient" class="form-check-input" />
                </span>
            </label>
        </div>
    </div>

    <hr class="cc-divider" />

    <div class="mb-2 d-flex justify-content-center gap-2">
        <ButtonFormSaveOnClick IsSaving="IsSaving" OnClick="HandleSubmitAsync" />
        <ButtonFormBack OnClick="ReturnAction" />
    </div>

</EditForm>
