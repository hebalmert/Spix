@page "/detailscontractcontrol/{Id:guid}"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator")]

<div class="container-fluid contract-detail-page py-4">
    @if (ContractClient is null)
    {
        <Loading />
    }
    else
    {
        <div class="detail-layout">

            @* ===== Izquierda: ficha del contrato, progreso y acciones ===== *@
            <aside class="detail-card detail-side">
                <p class="side-caption">@Localizer[nameof(Resource.Contract)]</p>
                <div class="side-number">#@ContractClient.ControlContrato</div>
                <p class="side-client">@ContractClient.Client!.FirstName @ContractClient.Client.LastName</p>

                <div class="side-kv">
                    <i class="fa fa-id-card" title="@Localizer[nameof(Resource.Document)]"></i>
                    <span>@ContractClient.Client.DocumentType?.DocumentName @ContractClient.Client.Document</span>

                    <i class="fa fa-phone" title="@Localizer[nameof(Resource.Phone)]"></i>
                    <span>@ContractClient.PhoneNumber</span>

                    <i class="fa fa-envelope" title="@Localizer[nameof(Resource.Email)]"></i>
                    <span>@ContractClient.Client.Email</span>

                    <i class="fa fa-location-dot" title="@Localizer[nameof(Resource.Address)]"></i>
                    <span>@ContractClient.Address · @ContractClient.Zone?.City?.Name · @Localizer[nameof(Resource.Zone)] @ContractClient.Zone?.ZoneName</span>

                    <i class="fa fa-user-gear" title="@Localizer[nameof(Resource.Contractor)]"></i>
                    <span>@ContractClient.Contractor?.FirstName @ContractClient.Contractor?.LastName</span>

                    <i class="fa fa-calendar" title="@Localizer[nameof(Resource.Created)]"></i>
                    <span>@ContractClient.DateCreado.ToString("dd/MM/yyyy")</span>
                </div>

                <div class="side-state">
                    <StatusBadge Value="@ContractClient.ContractState" />
                </div>
                <div class="side-flags">
                    <span class="side-flag"><i class="fa @(ContractClient.EquipoEmpres ? "fa-check" : "fa-xmark")"></i> Equipo empresa</span>
                    <span class="side-flag"><i class="fa @(ContractClient.EnvoiceClient ? "fa-check" : "fa-xmark")"></i> Invoice</span>
                </div>

                <hr class="side-divider" />

                @* Anillo de avance: el porcentaje entra por la variable --p *@
                <div class="progress-ring-wrap">
                    <div class="progress-ring @(MissingItems.Count == 0 ? "is-done" : null)" style="--p:@(ProgressPercent)%">
                        <span>@DoneItems/@TotalItems</span>
                    </div>
                    <b class="progress-caption">Configuracion</b>
                </div>
                @if (MissingItems.Count > 0)
                {
                    <ul class="missing-list">
                        @foreach (var item in MissingItems)
                        {
                            <li><i class="fa fa-circle-exclamation"></i>Falta @item</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="all-ready"><i class="fa fa-circle-check"></i>Todo configurado</p>
                }

                <div class="side-actions">
                    @if (CanActivateContract)
                    {
                        <button type="button" class="side-btn side-btn-activate" @onclick="ActivateContractAsync">
                            <i class="fa fa-circle-check"></i>Activar contrato
                        </button>
                    }
                    <div class="side-actions-row">
                        <a href="/contractcontrol" class="side-btn">
                            <i class="fa fa-arrow-left"></i>Volver
                        </a>
                        <button type="button" class="side-btn" @onclick="() => ShowEditContractClient(ContractClient!.ContractClientId)">
                            <i class="fa fa-pen-to-square"></i>@Localizer[nameof(Resource.Edit)]
                        </button>
                    </div>
                    @* Unico punto donde se cambia el estado del contrato: aqui tambien se administra
                       el MikroTik, asi que no puede quedar suspendido y con servicio. *@
                    <button type="button" class="side-btn side-btn-danger" @onclick="ShowChangeStateAsync">
                        <i class="fa fa-arrows-rotate"></i>@Localizer["ContractState_ChangeTitle"]
                    </button>
                </div>
            </aside>

            @* ===== Derecha: configuracion del servicio ===== *@
            <section class="detail-card detail-main">
                <div class="main-head">
                    <h2>Configuracion del servicio</h2>
                    <div class="main-legend">
                        <span><span class="legend-dot legend-ok"></span>Configurado</span>
                        <span><span class="legend-dot legend-missing"></span>Falta</span>
                        <span><i class="fa fa-lock"></i> Bloqueado: primero quite Queue / IpBinding</span>
                    </div>
                </div>

                @* ----- 1. Red ----- *@
                <div class="cc-group">
                    <p class="cc-group-title"><span class="cc-group-num">1</span>Red</p>
                    <div class="cc-grid">

                        <div class="cc-item @StateClass(HasServer)">
                            <div class="cc-item-top">
                                <div class="cc-ico"><i class="fa fa-server"></i></div>
                                <div class="cc-info">
                                    <div class="cc-name">Servidor Gateway <span class="cc-state"><i class="@StateIcon(HasServer)"></i> @StateText(HasServer)</span></div>
                                    @if (HasServer)
                                    {
                                        <div class="cc-data">@ContractServer!.Server?.ServerName</div>
                                    }
                                    else
                                    {
                                        <div class="cc-data cc-empty">Sin servidor asignado</div>
                                    }
                                </div>
                                <div class="cc-acts">
                                    @if (!HasServer)
                                    {
                                        <button type="button" class="cc-btn cc-btn-add" @onclick="() => ShowContractServersAsyn(ContractClient!.ContractClientId)">
                                            <i class="fa fa-plus"></i>Agregar
                                        </button>
                                    }
                                    else if (HasHotSpotDependencies)
                                    {
                                        <button type="button" class="cc-btn cc-btn-lock" disabled title="Elimine Queues Velocidad e IpBinding Acceso primero">
                                            <i class="fa fa-lock"></i>Quitar
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="cc-btn cc-btn-del" @onclick="() => DeleteContractServerAsync(ContractServer!.ContractServerId)">
                                            <i class="fa fa-trash"></i>Quitar
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="cc-item @StateClass(HasIp)">
                            <div class="cc-item-top">
                                <div class="cc-ico"><i class="fa fa-ethernet"></i></div>
                                <div class="cc-info">
                                    <div class="cc-name">IP Cliente <span class="cc-state"><i class="@StateIcon(HasIp)"></i> @StateText(HasIp)</span></div>
                                    @if (HasIp)
                                    {
                                        <div class="cc-data">@ContractIp!.IpNet?.Ip</div>
                                    }
                                    else
                                    {
                                        <div class="cc-data cc-empty">Sin IP asignada</div>
                                    }
                                </div>
                                <div class="cc-acts">
                                    @if (!HasIp)
                                    {
                                        <button type="button" class="cc-btn cc-btn-add" @onclick="() => ShowContractIpsAsyn(ContractClient!.ContractClientId)">
                                            <i class="fa fa-plus"></i>Agregar
                                        </button>
                                    }
                                    else if (HasHotSpotDependencies)
                                    {
                                        <button type="button" class="cc-btn cc-btn-lock" disabled title="Elimine Queues Velocidad e IpBinding Acceso primero">
                                            <i class="fa fa-lock"></i>Quitar
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="cc-btn cc-btn-del" @onclick="() => DeleteContractIpAsync(ContractIp!.ContractIpId)">
                                            <i class="fa fa-trash"></i>Quitar
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="cc-item cc-full @StateClass(HasNode)">
                            <div class="cc-item-top">
                                <div class="cc-ico"><i class="fa fa-tower-broadcast"></i></div>
                                <div class="cc-info">
                                    <div class="cc-name">Nodo Acceso <span class="cc-state"><i class="@StateIcon(HasNode)"></i> @StateText(HasNode)</span></div>
                                    @if (!HasNode)
                                    {
                                        <div class="cc-data cc-empty">Sin nodo asignado</div>
                                    }
                                </div>
                                <div class="cc-acts">
                                    @if (!HasNode)
                                    {
                                        <button type="button" class="cc-btn cc-btn-add" @onclick="() => ShowContractNodesAsyn(ContractClient!.ContractClientId)">
                                            <i class="fa fa-plus"></i>Agregar nodo
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="cc-btn cc-btn-del" @onclick="() => DeleteContractNodeAsync(ContractNode!.ContractNodeId)">
                                            <i class="fa fa-trash"></i>Quitar
                                        </button>
                                    }
                                </div>
                            </div>
                            @if (HasNode)
                            {
                                <div class="cc-facts cc-facts-2">
                                    <div class="cc-fact"><small>Nodo</small><b>@ContractNode!.Node?.NodesName</b></div>
                                    <div class="cc-fact"><small>IP de red</small><b>@ContractNode.Node?.IpNetwork?.Ip</b></div>
                                </div>
                            }
                        </div>

                    </div>
                </div>

                @* ----- 2. Servicio y equipo ----- *@
                <div class="cc-group">
                    <p class="cc-group-title"><span class="cc-group-num">2</span>Servicio y equipo</p>
                    <div class="cc-grid">

                        <div class="cc-item cc-full @StateClass(HasPlan)">
                            <div class="cc-item-top">
                                <div class="cc-ico"><i class="fa fa-gauge-high"></i></div>
                                <div class="cc-info">
                                    <div class="cc-name">Plan Cliente <span class="cc-state"><i class="@StateIcon(HasPlan)"></i> @StateText(HasPlan)</span></div>
                                    @if (!HasPlan)
                                    {
                                        <div class="cc-data cc-empty">Sin plan asignado</div>
                                    }
                                </div>
                                <div class="cc-acts">
                                    @if (!HasPlan)
                                    {
                                        <button type="button" class="cc-btn cc-btn-add" @onclick="() => ShowContractPlansAsyn(ContractClient!.ContractClientId)">
                                            <i class="fa fa-plus"></i>Agregar plan
                                        </button>
                                    }
                                    else if (HasHotSpotDependencies)
                                    {
                                        <button type="button" class="cc-btn cc-btn-lock" disabled title="Elimine Queues Velocidad e IpBinding Acceso primero">
                                            <i class="fa fa-lock"></i>Quitar
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="cc-btn cc-btn-del" @onclick="() => DeleteContractPlanAsync(ContractPlan!.ContractPlanId)">
                                            <i class="fa fa-trash"></i>Quitar
                                        </button>
                                    }
                                </div>
                            </div>
                            @if (HasPlan)
                            {
                                <div class="cc-facts cc-facts-3">
                                    <div class="cc-fact"><small>Plan</small><b>@ContractPlan!.Plan?.PlanName</b></div>
                                    <div class="cc-fact"><small>Velocidad total</small><b>@ContractPlan.Plan?.VelocidadTotal</b></div>
                                    <div class="cc-fact"><small>Precio con impuesto</small><b>@ContractPlan.Plan?.PrecioconImpuesto?.ToString("N2")</b></div>
                                </div>
                                @if (HasHotSpotDependencies)
                                {
                                    <div class="cc-hint"><i class="fa fa-circle-info"></i> Para cambiar el plan: quite primero Queue e IpBinding, luego Quitar y Agregar el nuevo.</div>
                                }
                            }
                        </div>

                        <div class="cc-item @StateClass(HasMac)">
                            <div class="cc-item-top">
                                <div class="cc-ico"><i class="fa fa-gears"></i></div>
                                <div class="cc-info">
                                    <div class="cc-name">Mac Equipo <span class="cc-state"><i class="@StateIcon(HasMac)"></i> @StateText(HasMac)</span></div>
                                    @if (HasMac)
                                    {
                                        <div class="cc-data">@ContractMac!.CargueDetail?.MacWlan</div>
                                    }
                                    else
                                    {
                                        <div class="cc-data cc-empty">Sin MAC asignada</div>
                                    }
                                </div>
                                <div class="cc-acts">
                                    @if (!HasMac)
                                    {
                                        <button type="button" class="cc-btn cc-btn-add" @onclick="() => ShowContractMacsAsyn(ContractClient!.ContractClientId)">
                                            <i class="fa fa-plus"></i>Agregar
                                        </button>
                                    }
                                    else if (HasContractBind)
                                    {
                                        <button type="button" class="cc-btn cc-btn-lock" disabled title="Elimine IpBinding Acceso primero">
                                            <i class="fa fa-lock"></i>Quitar
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="cc-btn cc-btn-del" @onclick="() => DeleteContractMacAsync(ContractMac!.ContractMacId)">
                                            <i class="fa fa-trash"></i>Quitar
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="cc-item @StateClass(HasMap)">
                            <div class="cc-item-top">
                                <div class="cc-ico"><i class="fa fa-map-location-dot"></i></div>
                                <div class="cc-info">
                                    <div class="cc-name">Ubicacion <span class="cc-state"><i class="@StateIcon(HasMap)"></i> @StateText(HasMap)</span></div>
                                    @if (HasMap)
                                    {
                                        <div class="cc-data">@ContractMap!.Latitude, @ContractMap.Longitude</div>
                                    }
                                    else
                                    {
                                        <div class="cc-data cc-empty">Sin coordenadas</div>
                                    }
                                </div>
                                <div class="cc-acts">
                                    @if (!HasMap)
                                    {
                                        <button type="button" class="cc-btn cc-btn-add" @onclick="() => ShowContractMapAsyn(ContractClient!.ContractClientId)">
                                            <i class="fa fa-plus"></i>Agregar
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="cc-btn cc-btn-view" @onclick="() => ShowContractMapViewAsync(ContractMap)">
                                            <i class="fa fa-map"></i>Ver mapa
                                        </button>
                                        <button type="button" class="cc-btn cc-btn-edit" @onclick="() => ShowContractMapEditAsync(ContractMap)">
                                            <i class="fa fa-pen-to-square"></i>Editar
                                        </button>
                                        <button type="button" class="cc-btn cc-btn-del" @onclick="() => DeleteContractMapAsync(ContractMap!.ContractMapId)">
                                            <i class="fa fa-trash"></i>Quitar
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                @* ----- 3. MikroTik HotSpot (solo si la corporacion usa HotSpot) ----- *@
                @if (UseHotSpotControl)
                {
                    <div class="cc-group">
                        <p class="cc-group-title"><span class="cc-group-num">3</span>MikroTik HotSpot</p>
                        <div class="cc-grid">

                            <div class="cc-item cc-full @StateClass(HasContractQue)">
                                <div class="cc-item-top">
                                    <div class="cc-ico"><i class="fa fa-sliders"></i></div>
                                    <div class="cc-info">
                                        <div class="cc-name">Queue de Velocidad <span class="cc-state"><i class="@StateIcon(HasContractQue)"></i> @StateText(HasContractQue)</span></div>
                                        @if (!HasContractQue)
                                        {
                                            <div class="cc-requires">Necesita: Servidor @CheckText(HasServer) · IP @CheckText(HasIp) · Plan @CheckText(HasPlan)</div>
                                        }
                                    </div>
                                    <div class="cc-acts">
                                        @if (!HasContractQue)
                                        {
                                            <button type="button" class="cc-btn cc-btn-add" @onclick="() => ShowContractQuesAsyn(ContractClient!.ContractClientId)">
                                                <i class="fa fa-plus"></i>Crear queue
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="cc-btn cc-btn-del" @onclick="() => DeleteContractQueAsync(ContractQue!.ContractQueId)">
                                                <i class="fa fa-trash"></i>Quitar
                                            </button>
                                        }
                                    </div>
                                </div>
                                @if (HasContractQue)
                                {
                                    <div class="cc-facts cc-facts-5">
                                        <div class="cc-fact"><small>Servidor</small><b>@(ContractQue!.ServerName ?? ContractQue.Server?.ServerName)</b></div>
                                        <div class="cc-fact"><small>IP cliente</small><b>@(ContractQue.IpCliente ?? ContractQue.IpNet?.Ip)</b></div>
                                        <div class="cc-fact"><small>Plan</small><b>@(ContractQue.PlanName ?? ContractQue.Plan?.PlanName)</b></div>
                                        <div class="cc-fact"><small>Velocidad</small><b>@(ContractQue.TotalVelocidad ?? ContractQue.Plan?.VelocidadTotal)</b></div>
                                        <div class="cc-fact"><small>Id MikroTik</small><b>@ContractQue.MikrotikId</b></div>
                                    </div>
                                }
                            </div>

                            <div class="cc-item cc-full @StateClass(HasContractBind)">
                                <div class="cc-item-top">
                                    <div class="cc-ico"><i class="fa fa-link"></i></div>
                                    <div class="cc-info">
                                        <div class="cc-name">IpBinding Acceso <span class="cc-state"><i class="@StateIcon(HasContractBind)"></i> @StateText(HasContractBind)</span></div>
                                        @if (!HasContractBind)
                                        {
                                            <div class="cc-requires">Necesita: Servidor @CheckText(HasServer) · IP @CheckText(HasIp) · MAC @CheckText(HasMac)</div>
                                        }
                                    </div>
                                    <div class="cc-acts">
                                        @if (!HasContractBind)
                                        {
                                            <button type="button" class="cc-btn cc-btn-add" @onclick="() => ShowContractBindsAsyn(ContractClient!.ContractClientId)">
                                                <i class="fa fa-plus"></i>Crear IpBinding
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="cc-btn cc-btn-edit" @onclick="() => ShowContractBindEditAsync(ContractBind)">
                                                <i class="fa fa-pen-to-square"></i>Editar
                                            </button>
                                            <button type="button" class="cc-btn cc-btn-del" @onclick="() => DeleteContractBindAsync(ContractBind!.ContractBindId)">
                                                <i class="fa fa-trash"></i>Quitar
                                            </button>
                                        }
                                    </div>
                                </div>
                                @if (HasContractBind)
                                {
                                    <div class="cc-facts cc-facts-5">
                                        <div class="cc-fact"><small>Servidor</small><b>@(ContractBind!.ServerName ?? ContractBind.Server?.ServerName)</b></div>
                                        <div class="cc-fact"><small>IP cliente</small><b>@(ContractBind.IpCliente ?? ContractBind.IpNet?.Ip)</b></div>
                                        <div class="cc-fact"><small>MAC</small><b>@(ContractBind.MacCliente ?? ContractBind.CargueDetail?.MacWlan)</b></div>
                                        <div class="cc-fact"><small>Tipo</small><b>@ContractBind.HotSpotType?.TypeName</b></div>
                                        <div class="cc-fact"><small>Id MikroTik</small><b>@ContractBind.MikrotikId</b></div>
                                    </div>
                                }
                            </div>

                        </div>
                    </div>
                }
            </section>
        </div>
    }
</div>
