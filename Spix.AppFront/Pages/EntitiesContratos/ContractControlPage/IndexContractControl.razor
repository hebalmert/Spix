@page "/contractcontrol"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator, Auxiliar")]
@using Spix.DomainLogic.EnumTypes

<div class="container pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">

        @* Encabezado: el unico titulo de la pantalla *@
        <div class="idx-head">
            <span class="idx-glifo"><i class="fa fa-clipboard-list"></i></span>
            <div class="idx-head-text">
                <h3>@Localizer[nameof(Resource.Control_Contracts)]</h3>
                <p>Seguimiento de los contratos y el detalle de cada uno.</p>
            </div>

            @if (TotalRecords > 0)
            {
                <div class="idx-head-tools">
                    <span class="idx-count">@TotalRecords.ToString("N0") contratos</span>
                </div>
            }
        </div>

        @* Acciones y buscador, fuera del panel de la tabla *@
        <div class="idx-bar">
            <ButtonFormNew OnClick="() => ShowModalAsync()" />

            @* Filtro por estado. Esta pantalla solo maneja contratos ya operativos,
               por eso no aparecen Borrador, Por Aprobacion, Anulado ni Terminado. *@
            <div class="input-group" style="width:240px; min-width:200px;">
                <span class="input-group-text bg-light">
                    <i class="fa fa-filter text-dark"></i>
                </span>
                <select class="form-select" value="@StatusFilter" @onchange="StatusFilterChanged">
                    <option value="0">Todos los estados</option>
                    <option value="@((int)ContractState.InProgress)">@Localizer[nameof(Resource.ContractState_InProgress)]</option>
                    <option value="@((int)ContractState.Active)">@Localizer[nameof(Resource.ContractState_Active)]</option>
                    <option value="@((int)ContractState.Exempt)">@Localizer[nameof(Resource.ContractState_Exempt)]</option>
                    <option value="@((int)ContractState.Suspended)">@Localizer[nameof(Resource.ContractState_Suspended)]</option>
                </select>
            </div>

            <div class="idx-search">
                <FilterComponent ApplyFilter="SetFilterValue" />
            </div>
        </div>

        <section class="idx-panel">

            <GenericList MyList="ContractClients">
                <Body>
                    <div class="table-responsive">
                        <table class="idx-table">
                            <thead>
                                <tr>
                                    <th>@Localizer["Table_Contract"]</th>
                                    <th>@Localizer[nameof(Resource.Client)]</th>
                                    <th>@Localizer[nameof(Resource.Contractor)]</th>
                                    <th class="text-center">@Localizer["Table_Stratum"]</th>
                                    <th class="text-center">@Localizer[nameof(Resource.Equipment)]</th>
                                    <th class="text-center">@Localizer[nameof(Resource.Invoice)]</th>
                                    <th>@Localizer[nameof(Resource.Status)]</th>
                                    <th style="text-align:right">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in ContractClients!)
                                {
                                    <tr>
                                        <td><span class="idx-name">@item.ControlContrato</span></td>
                                        <td>@item.Client!.FirstName @item.Client.LastName</td>
                                        <td>
                                            <span class="idx-tip" data-tip="@($"{item.Contractor!.FirstName} {item.Contractor.LastName}")">@item.Contractor!.FirstName</span>
                                        </td>
                                        <td class="text-center">@GetEstratoNumber(item.EstratoSocial?.EstratoSocialName)</td>
                                        <td class="text-center">
                                            <i class="idx-flag @(item.EquipoEmpres ? "fa fa-circle-check is-on" : "fa fa-minus is-off")"></i>
                                        </td>
                                        <td class="text-center">
                                            <i class="idx-flag @(item.EnvoiceClient ? "fa fa-circle-check is-on" : "fa fa-minus is-off")"></i>
                                        </td>
                                        <td>
                                            <StatusBadge Value="@item.ContractState" />
                                        </td>
                                        <td>
                                            <div class="idx-actions">
                                                <ButtonGeneric OnClick="() => ShowModaDetailsAsync(item.ContractClientId)"
                                                               TooTip="@Localizer[nameof(Resource.Create_IDPics)]"
                                                               Icon="fa fa-id-card" />

                                                <ButtonEdit OnClick="() => ShowModalAsync(item.ContractClientId, true)" />
                                                <ButtonDelete OnClick="() => DeleteAsync(item.ContractClientId)" />
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </Body>
            </GenericList>

            @if (ContractClients is not null)
            {
                <div class="idx-panel-foot">
                    <Pagination CurrentPage="CurrentPage"
                                SelectedPage="SelectedPage"
                                TotalPages="TotalPages" />
                </div>
            }
        </section>
    </div>
</div>
