@inherits ComponentBase

@* Cambio de estado del contrato. Es el unico punto donde se cambia, porque esta pantalla
   es la que administra el MikroTik. Las opciones y las reglas las pone el backend. *@
<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1055;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-create-shadow p-4 position-relative">
            <div class="modal-header d-flex justify-content-between align-items-center mb-3">
                <h5 class="modal-title"><i class="fa fa-arrows-rotate me-2"></i>@Localizer["ContractState_ChangeTitle"]</h5>
                <button class="btn-close-modal" @onclick="Return" title="Close">
                    <i class="fa fa-times"></i>
                </button>
            </div>

            <div class="mb-3">
                <span class="text-muted">@Localizer[nameof(Resource.Status)]:</span>
                <StatusBadge Value="@CurrentState" />
            </div>

            <GenericSelectWrapper Tmodel="IntItemModel" Items="States">
                <Body>
                    @if (States!.Count <= 1)
                    {
                        <div class="alert alert-secondary mb-0">@Localizer["ContractState_NoTransitions"]</div>
                    }
                    else
                    {
                        <div class="input-group">
                            <span class="input-group-text" style="width:150px">@Localizer["ContractState_ChangeTitle"]</span>
                            <select class="form-select" value="@NewState" @onchange="StateChanged">
                                @foreach (var item in States!)
                                {
                                    <option value="@item.Value">@item.Name</option>
                                }
                            </select>
                        </div>
                    }
                </Body>
            </GenericSelectWrapper>

            @* El motivo queda guardado en el registro de suspension *@
            @if (NewState == (int)ContractState.Suspended)
            {
                <div class="input-group mt-3">
                    <span class="input-group-text" style="width:150px">@Localizer["ContractState_Reason"]</span>
                    <InputTextArea class="form-control" rows="2" maxlength="200" @bind-Value="Motivo" />
                </div>
            }

            <hr />
            <div class="d-flex justify-content-center gap-3">
                @if (States is not null && States.Count > 1)
                {
                    <ButtonFormSaveOnClick OnClick="SaveAsync" IsSaving="IsSaving" TooTip="@Localizer["ContractState_ChangeTitle"]" Icon="fa fa-arrows-rotate" />
                }
                <ButtonFormBack OnClick="Return" />
            </div>
        </div>
    </div>
</div>
