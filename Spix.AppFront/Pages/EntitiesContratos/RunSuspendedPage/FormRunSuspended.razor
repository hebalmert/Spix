<EditForm Model="RunSuspended" OnValidSubmit="OnSubmit">
    <DataAnnotationsValidator />

    <div class="row mb-3">
        <div class="col-12 col-md-6 mb-2">
            <div class="input-group">
                <span class="input-group-text" style="width:120px">Ano</span>
                <input type="number"
                       class="form-control"
                       value="@RunSuspended.YearNumber"
                       disabled="@IsReadOnly"
                       @onchange="YearChanged" />
            </div>
        </div>
        <div class="col-12 col-md-6 mb-2">
            <GenericSelectWrapper Tmodel="IntItemModel" Items="Months">
                <Body>
                    <div class="input-group">
                        <span class="input-group-text" style="width:120px">Mes</span>
                        <select class="form-select"
                                value="@((int)RunSuspended.MonthType)"
                                disabled="@IsReadOnly"
                                @onchange="MonthChanged">
                            @foreach (var item in Months!)
                            {
                                <option value="@item.Value">@item.Name</option>
                            }
                        </select>
                    </div>
                </Body>
            </GenericSelectWrapper>
        </div>
    </div>

    <hr />

    @if (ShowButtons)
    {
        <div class="d-flex justify-content-center gap-3 mt-5">
            @if (!IsReadOnly)
            {
                <ButtonFormSave IsSaving="IsSaving" />
            }
            <ButtonFormBack OnClick="ReturnAction" />
        </div>
    }
</EditForm>
