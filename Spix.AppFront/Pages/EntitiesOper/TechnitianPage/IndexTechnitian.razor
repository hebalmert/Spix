@page "/technitians"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator")]

<div class="container pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">
        @* Encabezado: el unico titulo de la pantalla *@
        <div class="idx-head">
            <span class="idx-glifo"><i class="fa fa-user-gear"></i></span>
            <div class="idx-head-text">
                <h3>@Localizer[nameof(Resource.Control_Technitian)]</h3>
                <p>Administre sus tecnicos, sus datos de contacto y su acceso al sistema.</p>
            </div>

            @if (TotalRecords > 0)
            {
                <div class="idx-head-tools">
                    <span class="idx-count">@TotalRecords.ToString("N0") tecnicos</span>
                </div>
            }
        </div>

        @* Acciones y buscador, fuera del panel de la tabla *@
        <div class="idx-bar">
            <ButtonFormNew OnClick="() => ShowModalAsync()" />

            <div class="idx-search">
                <FilterComponent ApplyFilter="SetFilterValue" />
            </div>
        </div>

        <section class="idx-panel">

            <GenericList MyList="Technicians">
                <Body>
                    <div class="table-responsive">
                        <table class="idx-table">
                            <thead>
                                <tr>
                                    <th>@Localizer[nameof(Resource.Name)]</th>
                                    <th>@Localizer[nameof(Resource.Phone)]</th>
                                    <th>@Localizer[nameof(Resource.Email)]</th>
                                    <th>@Localizer[nameof(Resource.Active)]</th>
                                    <th style="text-align:right">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Technicians!)
                                {
                                    <tr>
                                        <td>
                                            <div class="idx-who">
                                                <AvatarImage Url="@item.ImageFullPath" Icon="fa fa-user-gear" Size="46" Alt="@($"{item.FirstName} {item.LastName}")" />
                                                <div>
                                                    <div class="idx-name">@item.FirstName @item.LastName</div>
                                                    <div class="idx-meta">@item.UserName</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@item.PhoneNumber</td>
                                        <td>@item.Email</td>
                                        <td>
                                            <span class="idx-pill @(item.Active ? "is-on" : "is-off")">
                                                @(item.Active ? Localizer[nameof(Resource.Active)] : Localizer[nameof(Resource.Inactive)])
                                            </span>
                                        </td>
                                        <td>
                                            <div class="idx-actions">
                                                @if (item.Active)
                                                {
                                                    <ButtonGeneric OnClick="() => ResendActivationEmailAsync(item.TechnicianId)"
                                                                   TooTip="Re-Email"
                                                                   Icon="fa fa-envelope" />
                                                }
                                                <ButtonEdit OnClick="() => ShowModalAsync(item.TechnicianId, true)" />
                                                <ButtonDelete OnClick="() => DeleteAsync(item.TechnicianId)" />
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </Body>
            </GenericList>

            <div class="idx-panel-foot">
                <Pagination CurrentPage="CurrentPage"
                            SelectedPage="SelectedPage"
                            TotalPages="TotalPages" />
            </div>
        </section>
    </div>
</div>
