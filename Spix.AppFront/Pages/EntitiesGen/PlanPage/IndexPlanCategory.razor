@page "/plancategories"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator, Auxiliar")]

<div class="container-fluid pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">
        <h3 class="mb-1">@Localizer[nameof(Resource.PlanCategory)]</h3>
        <p class="pc-sub">Elija una categoria a la izquierda y trabaje sus planes a la derecha.</p>

        @* Resumen de la categoria seleccionada *@
        <div class="pc-kpis">
            <div class="pc-kpi">
                <small>@Localizer[nameof(Resource.Category)]</small>
                <b>@(PlanCategories?.Count ?? 0)</b>
            </div>
            <div class="pc-kpi">
                <small>@Localizer[nameof(Resource.Plans)]</small>
                <b>@SelectedPlans.Count</b>
            </div>
            <div class="pc-kpi">
                <small>@Localizer[nameof(Resource.Active)]</small>
                <b>@ActivePlansCount</b>
            </div>
            <div class="pc-kpi is-warn">
                <small>@Localizer[nameof(Resource.Inactive)]</small>
                <b>@InactivePlansCount</b>
            </div>
        </div>

        <div class="pc-layout">

            @* ================= Categorias ================= *@
            <section class="pc-panel">
                <header class="pc-panel-head">
                    <b>@Localizer[nameof(Resource.Category)]</b>
                    <ButtonFormNew OnClick="() => ShowModalAsync()"
                                   TooTip="@Localizer[nameof(Resource.New)]"
                                   Style="width:120px" />
                </header>

                <div class="pc-search">
                    <AutoCompleteFilter ApplyFilter="SetFilterValue" Placeholder="Buscar categoria..." />
                </div>

                <GenericList MyList="PlanCategories">
                    <Body>
                        @foreach (var item in PlanCategories!)
                        {
                            <div class="pc-cat @(SelectedPlanCategoryId == item.PlanCategoryId ? "is-selected" : null)"
                                 @onclick="() => SelectCategoryAsync(item.PlanCategoryId)">
                                <div>
                                    <div class="pc-cat-name">@item.PlanCategoryName</div>
                                    <div class="pc-cat-meta">
                                        @item.PlanesNumer @Localizer[nameof(Resource.Plans)]
                                        <span class="pc-pill @(item.Active ? "is-on" : "is-off")">
                                            @(item.Active ? Localizer[nameof(Resource.Active)] : Localizer[nameof(Resource.Inactive)])
                                        </span>
                                    </div>
                                </div>
                                <div class="pc-cat-tools">
                                    <ButtonEdit OnClick="() => ShowModalAsync(item.PlanCategoryId, true)" />
                                    <ButtonDelete OnClick="() => DeleteAsync(item.PlanCategoryId)" />
                                </div>
                            </div>
                        }
                    </Body>
                </GenericList>

                <div class="pc-panel-foot">
                    <Pagination CurrentPage="CurrentPage"
                                SelectedPage="SelectedPage"
                                TotalPages="TotalPages" />
                </div>
            </section>

            @* ================= Planes de la categoria ================= *@
            <section class="pc-panel">
                <header class="pc-panel-head">
                    <b>
                        <i class="fa fa-wifi"></i>
                        @(SelectedCategory?.PlanCategoryName ?? Localizer[nameof(Resource.Plans)])
                    </b>
                    @if (SelectedPlanCategoryId is not null)
                    {
                        <ButtonFormNew OnClick="() => ShowModalPlanAsync(SelectedPlanCategoryId!.Value)"
                                       TooTip="@($"{Localizer[nameof(Resource.New)]} {Localizer[nameof(Resource.Plan)]}")"
                                       Style="width:170px" />
                    }
                </header>

                @if (SelectedPlanCategoryId is null)
                {
                    <div class="pc-empty">
                        <span class="pc-empty-glyph"><i class="fa fa-hand-pointer"></i></span>
                        <strong>Elija una categoria</strong>
                        <span>@Localizer[nameof(Resource.Accordion_EmptyHint)]</span>
                    </div>
                }
                else
                {
                    <div class="pc-toolbar">
                        <div class="pc-chips">
                            <button type="button" class="pc-chip @(PlanChip == "all" ? "is-on" : null)" @onclick="@(() => SetPlanChip("all"))">Todos</button>
                            <button type="button" class="pc-chip @(PlanChip == "active" ? "is-on" : null)" @onclick="@(() => SetPlanChip("active"))">@Localizer[nameof(Resource.Active)]</button>
                            <button type="button" class="pc-chip @(PlanChip == "inactive" ? "is-on" : null)" @onclick="@(() => SetPlanChip("inactive"))">@Localizer[nameof(Resource.Inactive)]</button>
                        </div>
                        <div class="pc-inline-search">
                            <AutoCompleteFilter ApplyFilter="SetPlanFilter" Placeholder="Buscar plan..." />
                        </div>
                    </div>

                    @if (LoadingPlanCategoryIds.Contains(SelectedPlanCategoryId.Value))
                    {
                        <div class="pc-empty">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">@Localizer["Loading"]</span>
                            </div>
                            <span>@Localizer["Loading"] @Localizer[nameof(Resource.Plans)]...</span>
                        </div>
                    }
                    else if (FilteredPlans.Any())
                    {
                        <div class="table-responsive">
                            <table class="pc-table">
                                <thead>
                                    <tr>
                                        <th>@Localizer[nameof(Resource.Plan)]</th>
                                        <th style="width: 11rem;">@Localizer[nameof(Resource.Speed)]</th>
                                        <th style="width: 8rem;">@Localizer[nameof(Resource.Price)]</th>
                                        <th style="width: 7rem;">@Localizer[nameof(Resource.Active)]</th>
                                        <th style="width: 16rem;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var plan in FilteredPlans)
                                    {
                                        <tr>
                                            <td>
                                                <div class="pc-item-name">@plan.PlanName</div>
                                            </td>
                                            <td>
                                                <span class="pc-chip">@plan.SpeedDown @plan.SpeedDownType / @plan.SpeedUp @plan.SpeedUpType</span>
                                            </td>
                                            <td>
                                                <span class="pc-item-name">@plan.Price.ToString("N2")</span>
                                            </td>
                                            <td>
                                                <span class="pc-pill @(plan.Active ? "is-on" : "is-off")">
                                                    @(plan.Active ? Localizer[nameof(Resource.Active)] : Localizer[nameof(Resource.Inactive)])
                                                </span>
                                            </td>
                                            <td>
                                                <div class="pc-actions">
                                                    <ButtonRowText OnClick="() => ShowModalPlanAsync(SelectedPlanCategoryId!.Value, plan.PlanId, true)"
                                                                   Icon="fa fa-pen-to-square"
                                                                   Text="@Localizer[nameof(Resource.ButtonEdit)]" />
                                                    <ButtonRowText OnClick="() => DeletePlanAsync(SelectedPlanCategoryId!.Value, plan.PlanId)"
                                                                   Icon="fa fa-trash"
                                                                   Text="@Localizer[nameof(Resource.ButtonDelete)]"
                                                                   CssClass="btn-row-text is-danger" />
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="pc-empty" role="alert">
                            <span class="pc-empty-glyph"><i class="fa fa-wifi"></i></span>
                            <strong>@Localizer["NoRecordsFound"]</strong>
                            <span>@Localizer[nameof(Resource.Accordion_EmptyHint)]</span>
                        </div>
                    }

                    <div class="pc-panel-foot pc-count">
                        @FilteredPlans.Count / @SelectedPlans.Count @Localizer[nameof(Resource.Plans)]
                    </div>
                }
            </section>

        </div>
    </div>
</div>
