@page "/plancategories"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator, Auxiliar")]

<div class="container-fluid pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">
        <h3 class="mb-4">@Localizer[nameof(Resource.PlanCategory)]</h3>

        <!-- Botón + Filtro -->
        <div class="row align-items-center mb-3">
            <div class="col-md-3 d-flex justify-content-start">
                <button class="btn btn-gradient-primary d-flex align-items-center gap-2" style="width:130px" @onclick="() => ShowModalAsync()">
                    <i class="fa fa-plus-circle"></i> @Localizer[nameof(Resource.New)]
                </button>
            </div>
            <div class="col-md-9 d-flex justify-content-end">
                <FilterComponent ApplyFilter="SetFilterValue" />
            </div>
        </div>

        <hr />
        <GenericList MyList="PlanCategories">
            <Body>
                <div class="table-responsive">
                    <table class="table align-middle acc-table">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 3rem;"></th>
                                <th>@Localizer[nameof(Resource.Category)]</th>
                                <th style="width: 9rem;">@Localizer[nameof(Resource.Plans)]</th>
                                <th style="width: 9rem;">@Localizer[nameof(Resource.Active)]</th>
                                <th style="width: 7rem;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in PlanCategories!)
                            {
                                <tr class="acc-row @(ExpandedPlanCategoryId == item.PlanCategoryId ? "is-open" : null)">
                                    <td class="acc-toggle" @onclick="() => ToggleExpandedPlanCategory(item.PlanCategoryId)">
                                        <button class="acc-disc" type="button" title="@Localizer[nameof(Resource.Plans)]">
                                            <i class="fa fa-chevron-right"></i>
                                        </button>
                                    </td>
                                    <td>
                                        <span class="acc-name">@item.PlanCategoryName</span>
                                    </td>
                                    <td>
                                        <span class="acc-count @(item.PlanesNumer == 0 ? "is-zero" : null)">@item.PlanesNumer</span>
                                    </td>
                                    <td>
                                        <span class="acc-pill @(item.Active ? "is-on" : "is-off")">
                                            @(item.Active ? Localizer[nameof(Resource.Active)] : Localizer[nameof(Resource.Inactive)])
                                        </span>
                                    </td>
                                    <td>
                                        <div class="acc-actions">
                                            <ButtonEdit OnClick="() => ShowModalAsync(item.PlanCategoryId, true)" />
                                            <ButtonDelete OnClick="() => DeleteAsync(item.PlanCategoryId)" />
                                        </div>
                                    </td>
                                </tr>

                                @if (ExpandedPlanCategoryId == item.PlanCategoryId)
                                {
                                    <tr class="acc-expanded">
                                        <td colspan="5">
                                            <section class="acc-panel">
                                                <div class="acc-card card-floating-section">
                                                    <div class="acc-card-bar">
                                                        <button class="btn btn-sm btn-gradient-primary d-flex align-items-center gap-2" @onclick="() => ShowModalPlanAsync(item.PlanCategoryId)">
                                                            <i class="fa fa-plus"></i> @Localizer[nameof(Resource.New)] @Localizer[nameof(Resource.Plan)]
                                                        </button>
                                                    </div>

                                                    @if (LoadingPlanCategoryIds.Contains(item.PlanCategoryId))
                                                    {
                                                        <div class="acc-empty">
                                                            <div class="spinner-border text-primary" role="status">
                                                                <span class="visually-hidden">@Localizer["Loading"]</span>
                                                            </div>
                                                            <span>@Localizer["Loading"] @Localizer[nameof(Resource.Plans)]...</span>
                                                        </div>
                                                    }

                                                    @if (!LoadingPlanCategoryIds.Contains(item.PlanCategoryId) && PlansByCategoryId.ContainsKey(item.PlanCategoryId))
                                                    {
                                                        @if (PlansByCategoryId[item.PlanCategoryId].Any())
                                                        {
                                                            <table class="acc-list">
                                                                <thead>
                                                                    <tr>
                                                                        <th>@Localizer[nameof(Resource.Plan)]</th>
                                                                        <th class="acc-center" style="width: 10rem;">@Localizer[nameof(Resource.Speed)]</th>
                                                                        <th class="acc-center" style="width: 8rem;">@Localizer[nameof(Resource.Price)]</th>
                                                                        <th class="acc-center" style="width: 8rem;">@Localizer[nameof(Resource.Active)]</th>
                                                                        <th style="width: 7rem;"></th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var plan in PlansByCategoryId[item.PlanCategoryId])
                                                                    {
                                                                        <tr>
                                                                            <td>
                                                                                <div class="acc-item-name">@plan.PlanName</div>
                                                                            </td>
                                                                            <td class="acc-center">
                                                                                <span class="acc-chip">@plan.SpeedDown @plan.SpeedDownType / @plan.SpeedUp @plan.SpeedUpType</span>
                                                                            </td>
                                                                            <td class="acc-center">
                                                                                <span class="acc-num">@plan.Price.ToString("N2")</span>
                                                                            </td>
                                                                            <td class="acc-center">
                                                                                <span class="acc-pill @(plan.Active ? "is-on" : "is-off")">
                                                                                    @(plan.Active ? Localizer[nameof(Resource.Active)] : Localizer[nameof(Resource.Inactive)])
                                                                                </span>
                                                                            </td>
                                                                            <td>
                                                                                <div class="acc-actions">
                                                                                    <ButtonEdit OnClick="() => ShowModalPlanAsync(item.PlanCategoryId, plan.PlanId, true)" />
                                                                                    <ButtonDelete OnClick="() => DeletePlanAsync(item.PlanCategoryId, plan.PlanId)" />
                                                                                </div>
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                        else
                                                        {
                                                            <div class="acc-empty" role="alert">
                                                                <span class="acc-empty-glyph"><i class="fa fa-wifi"></i></span>
                                                                <strong>@Localizer["NoRecordsFound"]</strong>
                                                                <span>@Localizer[nameof(Resource.Accordion_EmptyHint)]</span>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            </section>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </Body>
        </GenericList>

        <hr />
        <Pagination CurrentPage="CurrentPage"
                    SelectedPage="SelectedPage"
                    TotalPages="TotalPages" />
    </div>
</div>
