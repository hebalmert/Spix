<EditForm Model="EstratoSocial" OnValidSubmit="OnSubmit">
    <DataAnnotationsValidator />

    <div class="row">
        <div class="col-md-12 mb-2">
            <div class="input-group">
                <span class="input-group-text" style="width: 150px">
                    @Localizer[nameof(Resource.Name)]
                </span>
                <InputText class="form-control" @bind-Value="EstratoSocial.EstratoSocialName" />
            </div>
            <ValidationMessage For="@(() => EstratoSocial.EstratoSocialName)" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 mb-2">
            <div class="input-group">
                <span class="input-group-text" style="width: 150px">
                    @Localizer[nameof(Resource.ApplyTax)]
                </span>
                <div class="d-flex align-items-center ps-3">
                    <InputCheckbox @bind-Value="EstratoSocial.ApplyTax" class="form-check-input me-2" />
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-center gap-3 mt-5">
        <ButtonFormSave IsSaving="IsSaving" />
        <ButtonFormBack OnClick="ReturnAction" />
    </div>
</EditForm>
