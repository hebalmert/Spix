@page "/taxes"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator, Auxiliar")]


<div class="container pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">
        <div class="idx-head">
            <span class="idx-glifo"><i class="fa fa-percent"></i></span>
            <div class="idx-head-text">
                <h3>@Localizer[nameof(Resource.Tax_Title)]</h3>
                <p>@Localizer[nameof(Resource.Tax_Subtitle)]</p>
            </div>
        </div>

        <!-- Botón + Filtro -->
        <div class="row align-items-center mb-3">
            <div class="col-md-3 d-flex justify-content-start">
                <ButtonFormNew OnClick="() => ShowModalAsync()" />
            </div>
            <div class="col-md-9 d-flex justify-content-end">
                <FilterComponent ApplyFilter="SetFilterValue" />
            </div>
        </div>

        <hr />
        <GenericList MyList="Taxes">
            <Body>
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Nombre</th>
                                <th>Tasa</th>
                                <th>Activo</th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Taxes!)
                            {
                                <tr class="row-dbl" @ondblclick="() => ShowModalAsync(item.TaxId, true)">
                                    <td>@item.TaxName</td>
                                    <td>@item.Rate</td>
                                    <td>
                                        <input type="checkbox" class="form-check-input" checked="@item.Active" disabled />
                                    </td>
                                    <td @ondblclick:stopPropagation style="width:1px;">
                                        <ButtonEdit OnClick="() => ShowModalAsync(item.TaxId, true)" />
                                    </td>
                                    <td style="width:1px;">
                                        <ButtonDelete OnClick="() => DeleteAsync(item.TaxId)" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </Body>
        </GenericList>

        <hr />
        <Pagination CurrentPage="CurrentPage"
                    SelectedPage="SelectedPage"
                    TotalPages="TotalPages" />
    </div>
</div>



