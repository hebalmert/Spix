@page "/marks/detailed"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator, Auxiliar")]

<div class="container-fluid pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">
        <h3 class="mb-4">@Localizer[nameof(Resource.MarkEquipment)]</h3>

        <div class="row align-items-center mb-3">
            <div class="col-md-3 d-flex justify-content-start">
                <button class="btn btn-gradient-primary d-flex align-items-center gap-2" style="width:130px" @onclick="() => ShowModalCreateMarkAsync()">
                    <i class="fa fa-plus-circle"></i> @Localizer[nameof(Resource.New)]
                </button>
            </div>
            <div class="col-md-9 d-flex justify-content-end">
                <FilterComponent ApplyFilter="SetFilterValue" />
            </div>
        </div>

        <hr />
        <GenericList MyList="Marks">
            <Body>
                <div class="table-responsive">
                    <table class="table align-middle acc-table">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 3rem;"></th>
                                <th>@Localizer[nameof(Resource.MarkEquipment)]</th>
                                <th style="width: 9rem;">@Localizer[nameof(Resource.Models)]</th>
                                <th style="width: 9rem;">@Localizer[nameof(Resource.Active)]</th>
                                <th style="width: 7rem;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Marks!)
                            {
                                <tr class="acc-row @(ExpandedMarkId == item.MarkId ? "is-open" : null)">
                                    <td class="acc-toggle" @onclick="() => ToggleExpandedMark(item.MarkId)">
                                        <button class="acc-disc" type="button" title="@Localizer[nameof(Resource.Models)]">
                                            <i class="fa fa-chevron-right"></i>
                                        </button>
                                    </td>
                                    <td>
                                        <span class="acc-name">@item.MarkName</span>
                                    </td>
                                    <td>
                                        @if (MarkModelsByMarkId.ContainsKey(item.MarkId))
                                        {
                                            <span class="acc-count @(MarkModelsByMarkId[item.MarkId].Count == 0 ? "is-zero" : null)">@MarkModelsByMarkId[item.MarkId].Count</span>
                                        }
                                        else
                                        {
                                            <span class="acc-count is-zero">&ndash;</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="acc-pill @(item.Active ? "is-on" : "is-off")">
                                            @(item.Active ? Localizer[nameof(Resource.Active)] : Localizer[nameof(Resource.Inactive)])
                                        </span>
                                    </td>
                                    <td>
                                        <div class="acc-actions">
                                            <ButtonEdit OnClick="() => ShowModalEditMarkAsync(item)" />
                                            <ButtonDelete OnClick="() => DeleteMarkAsync(item.MarkId)" />
                                        </div>
                                    </td>
                                </tr>

                                @if (ExpandedMarkId == item.MarkId)
                                {
                                    <tr class="acc-expanded">
                                        <td colspan="5">
                                            <section class="acc-panel">
                                                <div class="acc-card card-floating-section">
                                                    <div class="acc-card-bar">
                                                        <button class="btn btn-sm btn-gradient-primary d-flex align-items-center gap-2" @onclick="() => ShowModalCreateMarkModelAsync(item.MarkId)">
                                                            <i class="fa fa-plus"></i> @Localizer[nameof(Resource.New)] @Localizer[nameof(Resource.Model)]
                                                        </button>
                                                    </div>

                                                    @if (LoadingMarkIds.Contains(item.MarkId))
                                                    {
                                                        <div class="acc-empty">
                                                            <div class="spinner-border text-primary" role="status">
                                                                <span class="visually-hidden">@Localizer["Loading"]</span>
                                                            </div>
                                                            <span>@Localizer["Loading"] @Localizer[nameof(Resource.Models)]...</span>
                                                        </div>
                                                    }

                                                    @if (!LoadingMarkIds.Contains(item.MarkId) && MarkModelsByMarkId.ContainsKey(item.MarkId))
                                                    {
                                                        @if (MarkModelsByMarkId[item.MarkId].Any())
                                                        {
                                                            <table class="acc-list">
                                                                <thead>
                                                                    <tr>
                                                                        <th>@Localizer[nameof(Resource.Models)]</th>
                                                                        <th class="acc-center" style="width: 8rem;">@Localizer[nameof(Resource.Active)]</th>
                                                                        <th style="width: 7rem;"></th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var model in MarkModelsByMarkId[item.MarkId])
                                                                    {
                                                                        <tr>
                                                                            <td>
                                                                                <div class="acc-item-name">@model.MarkModelName</div>
                                                                            </td>
                                                                            <td class="acc-center">
                                                                                <span class="acc-pill @(model.Active ? "is-on" : "is-off")">
                                                                                    @(model.Active ? Localizer[nameof(Resource.Active)] : Localizer[nameof(Resource.Inactive)])
                                                                                </span>
                                                                            </td>
                                                                            <td>
                                                                                <div class="acc-actions">
                                                                                    <ButtonEdit OnClick="() => ShowModalEditMarkModelAsync(model)" />
                                                                                    <ButtonDelete OnClick="() => DeleteMarkModelAsync(model.MarkModelId)" />
                                                                                </div>
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                        else
                                                        {
                                                            <div class="acc-empty" role="alert">
                                                                <span class="acc-empty-glyph"><i class="fa fa-tags"></i></span>
                                                                <strong>@Localizer["NoRecordsFound"]</strong>
                                                                <span>@Localizer[nameof(Resource.Accordion_EmptyHint)]</span>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            </section>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </Body>
        </GenericList>

        <hr />
        <Pagination CurrentPage="CurrentPage"
                    SelectedPage="SelectedPage"
                    TotalPages="TotalPages" />
    </div>
</div>
