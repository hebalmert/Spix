@page "/productcategories"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator, Auxiliar")]

<div class="container-fluid pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">
        <h3 class="mb-4">@Localizer[nameof(Resource.ProductCategory)]</h3>

        <div class="row align-items-center mb-3">
            <div class="col-md-3 d-flex justify-content-start">
                <button class="btn btn-gradient-primary d-flex align-items-center gap-2" style="width:130px" @onclick="() => ShowModalAsync()">
                    <i class="fa fa-plus-circle"></i> @Localizer[nameof(Resource.New)]
                </button>
            </div>
            <div class="col-md-9 d-flex justify-content-end">
                <FilterComponent ApplyFilter="SetFilterValue" />
            </div>
        </div>

        <hr />
        <GenericList MyList="ProductCategories">
            <Body>
                <div class="table-responsive">
                    <table class="table align-middle acc-table">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 3rem;"></th>
                                <th>@Localizer[nameof(Resource.ProductCategory)]</th>
                                <th style="width: 9rem;">@Localizer[nameof(Resource.Product)]</th>
                                <th style="width: 9rem;">@Localizer[nameof(Resource.Active)]</th>
                                <th style="width: 7rem;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in ProductCategories!)
                            {
                                <tr class="acc-row @(ExpandedProductCategoryId == item.ProductCategoryId ? "is-open" : null)">
                                    <td class="acc-toggle" @onclick="() => ToggleExpandedProductCategory(item.ProductCategoryId)">
                                        <button class="acc-disc" type="button" title="@Localizer[nameof(Resource.Product)]">
                                            <i class="fa fa-chevron-right"></i>
                                        </button>
                                    </td>
                                    <td>
                                        <span class="acc-name">@item.Name</span>
                                    </td>
                                    <td>
                                        <span class="acc-count @(item.ProductsNumer == 0 ? "is-zero" : null)">@item.ProductsNumer</span>
                                    </td>
                                    <td>
                                        <span class="acc-pill @(item.Active ? "is-on" : "is-off")">
                                            @(item.Active ? Localizer[nameof(Resource.Active)] : Localizer[nameof(Resource.Inactive)])
                                        </span>
                                    </td>
                                    <td>
                                        <div class="acc-actions">
                                            <ButtonEdit OnClick="() => ShowModalAsync(item.ProductCategoryId, true)" />
                                            <ButtonDelete OnClick="() => DeleteAsync(item.ProductCategoryId)" />
                                        </div>
                                    </td>
                                </tr>

                                @if (ExpandedProductCategoryId == item.ProductCategoryId)
                                {
                                    <tr class="acc-expanded">
                                        <td colspan="5">
                                            <section class="acc-panel">
                                                <div class="acc-card card-floating-section">
                                                    <div class="acc-card-bar">
                                                        <button class="btn btn-sm btn-gradient-primary d-flex align-items-center gap-2" @onclick="() => ShowModalProductAsync(item.ProductCategoryId)">
                                                            <i class="fa fa-plus"></i> @Localizer[nameof(Resource.New)] @Localizer[nameof(Resource.Product)]
                                                        </button>
                                                    </div>

                                                    @if (LoadingProductCategoryIds.Contains(item.ProductCategoryId))
                                                    {
                                                        <div class="acc-empty">
                                                            <div class="spinner-border text-primary" role="status">
                                                                <span class="visually-hidden">@Localizer["Loading"]</span>
                                                            </div>
                                                            <span>@Localizer["Loading"] @Localizer[nameof(Resource.Product)]...</span>
                                                        </div>
                                                    }

                                                    @if (!LoadingProductCategoryIds.Contains(item.ProductCategoryId) && ProductsByCategoryId.ContainsKey(item.ProductCategoryId))
                                                    {
                                                        @if (ProductsByCategoryId[item.ProductCategoryId].Any())
                                                        {
                                                            <table class="acc-list">
                                                                <thead>
                                                                    <tr>
                                                                        <th>@Localizer[nameof(Resource.Product)]</th>
                                                                        <th class="acc-center" style="width: 6rem;">@Localizer[nameof(Resource.Stock)]</th>
                                                                        <th class="acc-center" style="width: 8rem;">@Localizer[nameof(Resource.WithSerials)]</th>
                                                                        <th class="acc-center" style="width: 8rem;">@Localizer[nameof(Resource.Active)]</th>
                                                                        <th style="width: 9rem;"></th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var product in ProductsByCategoryId[item.ProductCategoryId])
                                                                    {
                                                                        <tr>
                                                                            <td>
                                                                                <div class="acc-item-name">@product.ProductName</div>
                                                                                @if (!string.IsNullOrWhiteSpace(product.Mark?.MarkName) || !string.IsNullOrWhiteSpace(product.MarkModel?.MarkModelName))
                                                                                {
                                                                                    <div class="acc-item-meta">@product.Mark?.MarkName @(string.IsNullOrWhiteSpace(product.MarkModel?.MarkModelName) ? null : "· " + product.MarkModel!.MarkModelName)</div>
                                                                                }
                                                                            </td>
                                                                            <td class="acc-center">
                                                                                <span class="acc-num @(product.TotalInventario == 0 ? "is-none" : product.TotalInventario <= 15 ? "is-low" : null)">@product.TotalInventario</span>
                                                                            </td>
                                                                            <td class="acc-center">
                                                                                <span class="acc-chip @(product.WithSerials ? null : "is-muted")">
                                                                                    @(product.WithSerials ? Localizer[nameof(Resource.Yes)] : Localizer[nameof(Resource.No)])
                                                                                </span>
                                                                            </td>
                                                                            <td class="acc-center">
                                                                                <span class="acc-pill @(product.Active ? "is-on" : "is-off")">
                                                                                    @(product.Active ? Localizer[nameof(Resource.Active)] : Localizer[nameof(Resource.Inactive)])
                                                                                </span>
                                                                            </td>
                                                                            <td>
                                                                                <div class="acc-actions">
                                                                                    <ButtonGeneric OnClick="() => ShowModalStockAsync(product.ProductId)" TooTip="@Localizer[nameof(Resource.Stock)]" Icon="fa fa-warehouse" />
                                                                                    <ButtonEdit OnClick="() => ShowModalProductAsync(product.ProductCategoryId, product.ProductId, true)" />
                                                                                    <ButtonDelete OnClick="() => DeleteProductAsync(product.ProductCategoryId, product.ProductId)" />
                                                                                </div>
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                        else
                                                        {
                                                            <div class="acc-empty" role="alert">
                                                                <span class="acc-empty-glyph"><i class="fa fa-box-open"></i></span>
                                                                <strong>@Localizer["NoRecordsFound"]</strong>
                                                                <span>@Localizer[nameof(Resource.Accordion_EmptyHint)]</span>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            </section>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </Body>
        </GenericList>

        <hr />
        <Pagination CurrentPage="CurrentPage"
                    SelectedPage="SelectedPage"
                    TotalPages="TotalPages" />
    </div>
</div>
