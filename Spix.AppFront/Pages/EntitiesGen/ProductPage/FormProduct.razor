@using Spix.Domain.EntitiesGen

<EditForm Model="Product" OnValidSubmit="OnSubmit">
    <DataAnnotationsValidator />

    <div class="mb-2">
        <div class="input-group">
            <span class="input-group-text" style="width: 150px">
                @Localizer[nameof(Resource.Product)]
            </span>
            <InputText class="form-control" @bind-Value="Product.ProductName" />
        </div>
        <ValidationMessage For="@(() => Product.ProductName)" />
    </div>

    <div class="row">
        <div class="col-12 col-md-6 mb-2">
            <GenericSelectWrapper Tmodel="Mark" Items="Marks">
                <Body>
                    <div class="input-group">
                        <span class="input-group-text" style="width: 150px">@Localizer[nameof(Resource.Mark)]</span>
                        <select class="form-select" value="@Product.MarkId" @onchange="MarkChanged">
                            @foreach (var item in Marks!)
                            {
                                <option value="@item.MarkId">@item.MarkName</option>
                            }
                        </select>
                    </div>
                    <ValidationMessage For="@(() => Product.MarkId)" />
                </Body>
            </GenericSelectWrapper>
        </div>

        <div class="col-12 col-md-6 mb-2">
            <GenericSelectWrapper Tmodel="MarkModel" Items="MarkModels">
                <Body>
                    <div class="input-group">
                        <span class="input-group-text" style="width: 150px">@Localizer[nameof(Resource.Model)]</span>
                        <select class="form-select" value="@Product.MarkModelId" @onchange="MarkModelChanged">
                            @foreach (var item in MarkModels!)
                            {
                                <option value="@item.MarkModelId">@item.MarkModelName</option>
                            }
                        </select>
                    </div>
                    <ValidationMessage For="@(() => Product.MarkModelId)" />
                </Body>
            </GenericSelectWrapper>
        </div>
    </div>

    <div class="mb-2">
        <div class="input-group">
            <span class="input-group-text" style="width: 150px">
                @Localizer[nameof(Resource.Description)]
            </span>
            <InputTextArea class="form-control" @bind-Value="Product.Description" />
        </div>
        <ValidationMessage For="@(() => Product.Description)" />
    </div>

    <div class="mb-2">
        <div class="input-group">
            <span class="input-group-text" style="width: 150px">
                @Localizer[nameof(Resource.Cost)]
            </span>
            <InputNumber class="form-control" @bind-Value="Product.Costo" />
        </div>
        <ValidationMessage For="@(() => Product.Costo)" />
    </div>

    <div class="mb-2">
        <GenericSelectWrapper Tmodel="GuidItemModel" Items="Taxes">
            <Body>
            <div class="input-group">
                <span class="input-group-text" style="width: 150px">@Localizer[nameof(Resource.Tax)]</span>
                <select class="form-select" value="@Product.TaxId" @onchange="TaxChanged">
                    @foreach (var item in Taxes)
                    {
                        <option value="@item.Value">@item.Name</option>
                    }
                </select>
            </div>
            </Body>
        </GenericSelectWrapper>
    </div>

    <div class="mb-2">
        <div class="input-group">
            <span class="input-group-text" style="width: 150px">
                @Localizer[nameof(Resource.Price)]
            </span>
            <InputNumber class="form-control" @bind-Value="Product.Price" />
        </div>
        <ValidationMessage For="@(() => Product.Price)" />
    </div>
    <div class="mb-2">
        <div class="input-group">
            <span class="input-group-text" style="width: 150px">
                @Localizer[nameof(Resource.WithSerials)]
            </span>
            <div class="d-flex align-items-center ps-3">
                <InputCheckbox @bind-Value="Product.WithSerials" class="form-check-input me-2" />
            </div>
        </div>
    </div>

    <div class="mb-3">
        <div class="input-group">
            <span class="input-group-text" style="width: 150px">
                @Localizer[nameof(Resource.Active)]
            </span>
            <div class="d-flex align-items-center ps-3 form-control">
                <InputCheckbox @bind-Value="Product.Active" class="form-check-input me-2" />
            </div>
        </div>
    </div>

    <!-- Botones -->
    <div class="d-flex justify-content-center gap-3 mt-5">
        <ButtonFormSave IsSaving="IsSaving" />
        <ButtonFormBack OnClick="ReturnAction" />
    </div>
</EditForm>
