@page "/servicecategories"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator, Auxiliar")]

<div class="container-fluid pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">
        <h3 class="mb-1">@Localizer[nameof(Resource.Service)]</h3>
        <p class="pc-sub">Elija una categoria a la izquierda y trabaje sus servicios a la derecha.</p>

        @* Resumen de la categoria seleccionada *@
        <div class="pc-kpis">
            <div class="pc-kpi">
                <small>@Localizer[nameof(Resource.Category)]</small>
                <b>@(ServiceCategories?.Count ?? 0)</b>
            </div>
            <div class="pc-kpi">
                <small>@Localizer[nameof(Resource.Service)]</small>
                <b>@SelectedServices.Count</b>
            </div>
            <div class="pc-kpi">
                <small>@Localizer[nameof(Resource.Active)]</small>
                <b>@ActiveServicesCount</b>
            </div>
            <div class="pc-kpi is-warn">
                <small>@Localizer[nameof(Resource.Inactive)]</small>
                <b>@InactiveServicesCount</b>
            </div>
        </div>

        <div class="pc-layout">

            @* ================= Categorias ================= *@
            <section class="pc-panel">
                <header class="pc-panel-head">
                    <b>@Localizer[nameof(Resource.Category)]</b>
                    <ButtonFormNew OnClick="() => ShowModalAsync()"
                                   TooTip="@Localizer[nameof(Resource.New)]"
                                   Style="width:120px" />
                </header>

                <div class="pc-search">
                    <AutoCompleteFilter ApplyFilter="SetFilterValue" Placeholder="Buscar categoria..." />
                </div>

                <GenericList MyList="ServiceCategories">
                    <Body>
                        @foreach (var item in ServiceCategories!)
                        {
                            <div class="pc-cat @(SelectedServiceCategoryId == item.ServiceCategoryId ? "is-selected" : null)"
                                 @onclick="() => SelectCategoryAsync(item.ServiceCategoryId)">
                                <div>
                                    <div class="pc-cat-name">@item.Name</div>
                                    <div class="pc-cat-meta">
                                        @item.ServicesNumer @Localizer[nameof(Resource.Service)]
                                        <span class="pc-pill @(item.Active ? "is-on" : "is-off")">
                                            @(item.Active ? Localizer[nameof(Resource.Active)] : Localizer[nameof(Resource.Inactive)])
                                        </span>
                                    </div>
                                </div>
                                <div class="pc-cat-tools">
                                    <ButtonEdit OnClick="() => ShowModalAsync(item.ServiceCategoryId, true)" />
                                    <ButtonDelete OnClick="() => DeleteAsync(item.ServiceCategoryId)" />
                                </div>
                            </div>
                        }
                    </Body>
                </GenericList>

                <div class="pc-panel-foot">
                    <Pagination CurrentPage="CurrentPage"
                                SelectedPage="SelectedPage"
                                TotalPages="TotalPages" />
                </div>
            </section>

            @* ================= Servicios de la categoria ================= *@
            <section class="pc-panel">
                <header class="pc-panel-head">
                    <b>
                        <i class="fa fa-concierge-bell"></i>
                        @(SelectedCategory?.Name ?? Localizer[nameof(Resource.Service)])
                    </b>
                    @if (SelectedServiceCategoryId is not null)
                    {
                        <ButtonFormNew OnClick="() => ShowModalServiceClientAsync(SelectedServiceCategoryId!.Value)"
                                       TooTip="@($"{Localizer[nameof(Resource.New)]} {Localizer[nameof(Resource.Service)]}")"
                                       Style="width:170px" />
                    }
                </header>

                @if (SelectedServiceCategoryId is null)
                {
                    <div class="pc-empty">
                        <span class="pc-empty-glyph"><i class="fa fa-hand-pointer"></i></span>
                        <strong>Elija una categoria</strong>
                        <span>@Localizer[nameof(Resource.Accordion_EmptyHint)]</span>
                    </div>
                }
                else
                {
                    <div class="pc-toolbar">
                        <div class="pc-chips">
                            <button type="button" class="pc-chip @(ServiceChip == "all" ? "is-on" : null)" @onclick="@(() => SetServiceChip("all"))">Todos</button>
                            <button type="button" class="pc-chip @(ServiceChip == "active" ? "is-on" : null)" @onclick="@(() => SetServiceChip("active"))">@Localizer[nameof(Resource.Active)]</button>
                            <button type="button" class="pc-chip @(ServiceChip == "inactive" ? "is-on" : null)" @onclick="@(() => SetServiceChip("inactive"))">@Localizer[nameof(Resource.Inactive)]</button>
                        </div>
                        <div class="pc-inline-search">
                            <AutoCompleteFilter ApplyFilter="SetServiceFilter" Placeholder="Buscar servicio..." />
                        </div>
                    </div>

                    @if (LoadingServiceCategoryIds.Contains(SelectedServiceCategoryId.Value))
                    {
                        <div class="pc-empty">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">@Localizer["Loading"]</span>
                            </div>
                            <span>@Localizer["Loading"] @Localizer[nameof(Resource.Service)]...</span>
                        </div>
                    }
                    else if (FilteredServices.Any())
                    {
                        <div class="table-responsive">
                            <table class="pc-table">
                                <thead>
                                    <tr>
                                        <th>@Localizer[nameof(Resource.Service)]</th>
                                        <th style="width: 8rem;">@Localizer[nameof(Resource.Cost)]</th>
                                        <th style="width: 8rem;">@Localizer[nameof(Resource.Price)]</th>
                                        <th style="width: 7rem;">@Localizer[nameof(Resource.Active)]</th>
                                        <th style="width: 16rem;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var service in FilteredServices)
                                    {
                                        <tr>
                                            <td>
                                                <div class="pc-item-name">@service.ServiceName</div>
                                                @if (!string.IsNullOrWhiteSpace(service.Description))
                                                {
                                                    <div class="pc-item-meta">@service.Description</div>
                                                }
                                            </td>
                                            <td>
                                                <span class="pc-item-meta">@service.Costo.ToString("N2")</span>
                                            </td>
                                            <td>
                                                <span class="pc-item-name">@service.Price.ToString("N2")</span>
                                            </td>
                                            <td>
                                                <span class="pc-pill @(service.Active ? "is-on" : "is-off")">
                                                    @(service.Active ? Localizer[nameof(Resource.Active)] : Localizer[nameof(Resource.Inactive)])
                                                </span>
                                            </td>
                                            <td>
                                                <div class="pc-actions">
                                                    <ButtonRowText OnClick="() => ShowModalServiceClientAsync(SelectedServiceCategoryId!.Value, service.ServiceClientId, true)"
                                                                   Icon="fa fa-pen-to-square"
                                                                   Text="@Localizer[nameof(Resource.ButtonEdit)]" />
                                                    <ButtonRowText OnClick="() => DeleteServiceClientAsync(SelectedServiceCategoryId!.Value, service.ServiceClientId)"
                                                                   Icon="fa fa-trash"
                                                                   Text="@Localizer[nameof(Resource.ButtonDelete)]"
                                                                   CssClass="btn-row-text is-danger" />
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="pc-empty" role="alert">
                            <span class="pc-empty-glyph"><i class="fa fa-concierge-bell"></i></span>
                            <strong>@Localizer["NoRecordsFound"]</strong>
                            <span>@Localizer[nameof(Resource.Accordion_EmptyHint)]</span>
                        </div>
                    }

                    <div class="pc-panel-foot pc-count">
                        @FilteredServices.Count / @SelectedServices.Count @Localizer[nameof(Resource.Service)]
                    </div>
                }
            </section>

        </div>
    </div>
</div>
