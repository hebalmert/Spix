@page "/registers"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator, Auxiliar")]

<div class="container pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">
        <div class="idx-head">
            <span class="idx-glifo"><i class="fa fa-hashtag"></i></span>
            <div class="idx-head-text">
                <h3>@Localizer[nameof(Resource.Register_Title)]</h3>
                <p>@Localizer[nameof(Resource.Register_Subtitle)]</p>
            </div>
        </div>

        <!-- Botón + Filtro -->
        <div class="row align-items-center mb-3">
            <div class="col-md-3 d-flex justify-content-start">
                <ButtonFormNew OnClick="() => ShowModalAsync()" />
            </div>
            <div class="col-md-9 d-flex justify-content-end">
                <FilterComponent ApplyFilter="SetFilterValue" />
            </div>
        </div>

        <hr />
        <GenericList MyList="Registers">
            <Body>
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Contratos</th>
                                <th>Solicitudes</th>
                                <th>Cargue</th>
                                <th>Egresos</th>
                                <th>Adelantado</th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Registers!)
                            {
                                <tr class="row-dbl" @ondblclick="() => ShowModalAsync(item.RegisterId, true)">
                                    <td>@item.Contratos</td>
                                    <td>@item.Solicitudes</td>
                                    <td>@item.Cargue</td>
                                    <td>@item.Egresos</td>
                                    <td>@item.Adelantado</td>
                                    <td @ondblclick:stopPropagation style="width:1px;">
                                        <ButtonEdit OnClick="() => ShowModalAsync(item.RegisterId, true)" />
                                    </td>
                                    <td style="width:1px;">
                                        <ButtonDelete OnClick="() => DeleteAsync(item.RegisterId)" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </Body>
        </GenericList>

        <hr />
        <Pagination CurrentPage="CurrentPage"
                    SelectedPage="SelectedPage"
                    TotalPages="TotalPages" />
    </div>
</div>
