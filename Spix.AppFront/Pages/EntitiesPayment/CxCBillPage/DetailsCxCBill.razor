@inherits ComponentBase
@using Spix.Domain.EntitiesBilling
@using Spix.Domain.EntitiesPayment

<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1055;">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-create-shadow p-4 position-relative">
            <div class="modal-header d-flex justify-content-between align-items-center mb-3">
                <h5 class="modal-title">@Title</h5>
                <button class="btn-close-modal" @onclick="Return" title="Close">
                    <i class="fa fa-times"></i>
                </button>
            </div>

            @if (isLoading || Model is null)
            {
                <div class="loading-overlay">
                    <Loading />
                </div>
            }
            else
            {
                <div class="cx-head">
                    <div>
                        <div class="cx-name">@Model.Client?.FirstName @Model.Client?.LastName</div>
                        <div class="cx-meta">
                            @Localizer[nameof(Resource.Contract)] #@Model.ContractClient?.ControlContrato ·
                            @MonthName @Model.YearNumber · @Model.DateNote.ToString("dd/MM/yyyy")
                        </div>
                    </div>
                    <div class="cx-note">@Model.CollectionNote</div>
                </div>

                @* De que se compone: el plan del mes y los servicios tecnicos facturados *@
                <div class="table-responsive">
                    <table class="idx-table">
                        <thead>
                            <tr>
                                <th>@Localizer["Sell_Concept"]</th>
                                <th style="text-align:right">@Localizer[nameof(Resource.Subtotal)]</th>
                                <th style="text-align:right">@Localizer[nameof(Resource.Tax)]</th>
                                <th style="text-align:right">@Localizer[nameof(Resource.Total)]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Sell?.SellDetails ?? new List<SellDetail>())
                            {
                                <tr>
                                    <td>
                                        <div class="cx-line">@item.Concept</div>
                                        <div class="cx-meta">@OriginName(item.Origin)</div>
                                    </td>
                                    <td style="text-align:right">@item.UnitPrice.ToString("N2")</td>
                                    <td style="text-align:right">@item.TaxAmount.ToString("N2")</td>
                                    <td style="text-align:right"><strong>@item.Price.ToString("N2")</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* El cruce: lo que debia, lo que ya habia pagado adelantado y lo exonerado *@
                <div class="cx-cross">
                    <div class="cx-tile">
                        <div class="cx-tile-label">@Localizer["CxC_Debt"]</div>
                        <div class="cx-tile-value">@Model.Total.ToString("N2")</div>
                    </div>
                    <div class="cx-tile is-paid">
                        <div class="cx-tile-label">@Localizer["CxC_PrePayment"]</div>
                        <div class="cx-tile-value">@Payment.ToString("N2")</div>
                    </div>
                    <div class="cx-tile is-discount">
                        <div class="cx-tile-label">@Localizer["CxC_Discount"]</div>
                        <div class="cx-tile-value">@Discount.ToString("N2")</div>
                    </div>
                    <div class="cx-tile is-balance">
                        <div class="cx-tile-label">@Localizer["CxC_Balance"]</div>
                        <div class="cx-tile-value">@Model.Balance.ToString("N2")</div>
                    </div>
                </div>

                <div class="d-flex justify-content-center mt-4">
                    <ButtonFormBack OnClick="Return" />
                </div>
            }
        </div>
    </div>
</div>
