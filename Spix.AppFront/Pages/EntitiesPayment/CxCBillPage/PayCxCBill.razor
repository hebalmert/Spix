@inherits ComponentBase

<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1055;">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-create-shadow p-4 position-relative">
            <div class="modal-header d-flex justify-content-between align-items-center mb-3">
                <h5 class="modal-title">@Title</h5>
                <button class="btn-close-modal" @onclick="Return" title="Close">
                    <i class="fa fa-times"></i>
                </button>
            </div>

            @if (isLoading || Model is null)
            {
                <div class="loading-overlay">
                    <Loading />
                </div>
            }
            else
            {
                <EditForm Model="Payment" OnValidSubmit="PayAsync">
                    <DataAnnotationsValidator />

                    @* A quien se le cobra y por cual nota *@
                    <div class="pay-head">
                        <div>
                            <div class="pay-name">@Model.Client?.FirstName @Model.Client?.LastName</div>
                            <div class="pay-meta">
                                @Localizer[nameof(Resource.Contract)] #@Model.ContractClient?.ControlContrato ·
                                @Model.DateNote.ToString("dd/MM/yyyy")
                            </div>
                        </div>
                        <div class="pay-note">@Model.CollectionNote</div>
                    </div>

                    @* Las cuentas del recaudo, que se mueven con el descuento *@
                    <div class="pay-board">
                        <div class="pay-tile">
                            <div class="pay-tile-label">@Localizer["Pay_Debt"]</div>
                            <div class="pay-tile-value">@Debt.ToString("N2")</div>
                        </div>
                        <div class="pay-tile is-discount">
                            <div class="pay-tile-label">@Localizer["Pay_Discount"]</div>
                            <div class="pay-tile-value">@DiscountAmount.ToString("N2")</div>
                        </div>
                        <div class="pay-tile is-money">
                            <div class="pay-tile-label">@Localizer["Pay_Receive"]</div>
                            <div class="pay-tile-value">@PaymentAmount.ToString("N2")</div>
                        </div>
                        <div class="pay-tile is-balance">
                            <div class="pay-tile-label">@Localizer["Pay_Balance"]</div>
                            <div class="pay-tile-value">@Balance.ToString("N2")</div>
                        </div>
                    </div>

                    @* Modo de pago: una tarjeta por modo, se elige con un click *@
                    <div class="pay-field">
                        <div class="pay-label">@Localizer["Pay_Mode"]</div>
                        <div class="pay-options">
                            @foreach (var mode in PaymentModes)
                            {
                                <button type="button"
                                        class="pay-chip @(Payment.PaymentMode == mode.Key ? "is-on" : "")"
                                        @onclick="() => SetPaymentMode(mode.Key)">
                                    <i class="@mode.Icon"></i> @Localizer[mode.Label]
                                </button>
                            }
                        </div>
                    </div>

                    @* Descuento: cambia lo que se recibe, por eso pide motivo *@
                    <div class="pay-field">
                        <div class="pay-label">@Localizer["Pay_Discount"]</div>
                        <div class="pay-options">
                            @foreach (var item in DiscountOptions)
                            {
                                <button type="button"
                                        class="pay-chip @(Payment.DiscountPercent == item ? "is-warn" : "")"
                                        @onclick="() => SetDiscount(item)">
                                    @(item == 0 ? Localizer["Pay_NoDiscount"] : $"{item}%")
                                </button>
                            }
                        </div>
                    </div>

                    <div class="pay-field">
                        <div class="pay-label">@Localizer["Pay_Detail"]</div>
                        <textarea class="form-control" rows="2" placeholder="@Localizer["Pay_DetailHint"]" @bind="Payment.Detail"></textarea>
                    </div>

                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <ButtonFormSave IsSaving="IsSaving" />
                        <ButtonFormBack OnClick="Return" />
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>
