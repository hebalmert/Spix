@inherits ComponentBase

@using Spix.Domain.EntitiesPayment

<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1055;">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-create-shadow p-4 position-relative">
            <div class="modal-header d-flex justify-content-between align-items-center mb-3">
                <h5 class="modal-title">@Title</h5>
                <button class="btn-close-modal" @onclick="Return" title="Close">
                    <i class="fa fa-times"></i>
                </button>
            </div>

            @if (IsLoading || Model is null)
            {
                <div class="loading-overlay">
                    <Loading />
                </div>
            }
            else
            {
                @* A quien se le paga y por cual cuenta *@
                <div class="cc-headnote">
                    <div>
                        <div class="cc-name">@Model.Contractor?.FirstName @Model.Contractor?.LastName</div>
                        <div class="idx-meta">@Model.DateNote.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="cc-note">@Model.NoteNumber</div>
                </div>

                <div class="cc-cross">
                    <div class="cc-tile">
                        <div class="cc-tile-label">@Localizer[nameof(Resource.Total)]</div>
                        <div class="cc-tile-value">@Model.Total.ToString("N2")</div>
                    </div>
                    <div class="cc-tile is-money">
                        <div class="cc-tile-label">@Localizer["CxCContractor_Amount"]</div>
                        <div class="cc-tile-value">@Payment.ToString("N2")</div>
                    </div>
                    <div class="cc-tile is-debt">
                        <div class="cc-tile-label">@Localizer["CxC_Balance"]</div>
                        <div class="cc-tile-value">@Rest.ToString("N2")</div>
                    </div>
                </div>

                @* El monto: libre, sin pasarse del saldo *@
                <div class="cc-field">
                    <div class="cc-label">@Localizer["CxCContractor_Amount"]</div>
                    <div class="input-group">
                        <input type="number" step="0.01" min="0" max="@Model.Balance"
                               class="form-control text-end"
                               value="@Payment"
                               @onchange="PaymentChanged" />
                        <button type="button" class="cc-chip" @onclick="PayAll">
                            <i class="fa fa-equals"></i> @Localizer["CxCContractor_All"]
                        </button>
                    </div>
                </div>

                <div class="cc-field">
                    <div class="cc-label">@Localizer["Pay_Mode"]</div>
                    <div class="cc-options">
                        @foreach (var mode in PaymentModes)
                        {
                            <button type="button"
                                    class="cc-chip @(Model is not null && PaymentMode == mode.Key ? "is-on" : "")"
                                    @onclick="() => SetPaymentMode(mode.Key)">
                                <i class="@mode.Icon"></i> @Localizer[mode.Label]
                            </button>
                        }
                    </div>
                </div>

                <div class="cc-field">
                    <div class="cc-label">@Localizer["CxCContractor_Reference"]</div>
                    <input class="form-control" maxlength="50" @bind="Reference" />
                </div>

                <div class="cc-field">
                    <div class="cc-label">@Localizer["Pay_Detail"]</div>
                    <textarea class="form-control" rows="2" @bind="Detail"></textarea>
                </div>

                <div class="d-flex justify-content-center gap-3 mt-4">
                    <ButtonFormSaveOnClick OnClick="PayAsync" IsSaving="IsSaving" />
                    <ButtonFormBack OnClick="Return" />
                </div>
            }
        </div>
    </div>
</div>
