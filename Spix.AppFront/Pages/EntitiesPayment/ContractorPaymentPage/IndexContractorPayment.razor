@page "/contractor-payments"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator")]

@using Spix.Domain.EntitiesPayment

<div class="container pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h3 class="mb-0">Pagos a Contratistas</h3>
            @if (SelectedAccountPayableIds.Count > 0)
            {
                <button class="btn btn-success" @onclick="ShowPayAsync">
                    <i class="fa fa-money-bill-transfer me-2"></i>Pagar seleccionadas (@SelectedAccountPayableIds.Count)
                </button>
            }
        </div>

        <div class="row g-2 align-items-end mb-3">
            <div class="col-12 col-md-8">
                <div class="input-group">
                    <span class="input-group-text" style="width:125px">Buscar</span>
                    <input class="form-control"
                           placeholder="Contratista, contrato o cuenta por cobrar"
                           value="@Filter"
                           @oninput="FilterChanged" />
                </div>
            </div>
            <div class="col-12 col-md-4 d-flex justify-content-end">
                <ButtonGeneric OnClick="ClearFilterAsync"
                               Icon="fa fa-rotate"
                               TooTip="Limpiar"
                               CssClass="btn-mini"
                               Style="font-size:17px;" />
            </div>
        </div>

        <GenericList MyList="AccountPayables">
            <Body>
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th style="width:1px;"></th>
                                <th>Fecha</th>
                                <th>Contratista</th>
                                <th>Contrato</th>
                                <th>CxC</th>
                                <th class="text-end">Base recibida</th>
                                <th class="text-end">%</th>
                                <th class="text-end">Comisión</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in AccountPayables!)
                            {
                                <tr>
                                    <td>
                                        @if (!item.Paid && item.Balance > 0)
                                        {
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   checked="@SelectedAccountPayableIds.Contains(item.ContractorAccountPayableId)"
                                                   @onchange="args => ToggleAccountPayableAsync(item, args)" />
                                        }
                                    </td>
                                    <td>@item.DateCreated.ToString("dd/MM/yyyy")</td>
                                    <td>@($"{item.Contractor?.FirstName} {item.Contractor?.LastName}")</td>
                                    <td>@item.ContractClient?.ControlContrato</td>
                                    <td>@item.CxCBill?.CollectionNote</td>
                                    <td class="text-end">@item.BaseAmount.ToString("N2")</td>
                                    <td class="text-end">@item.Rate.ToString("N2")%</td>
                                    <td class="text-end">@item.Total.ToString("N2")</td>
                                    <td>
                                        @if (item.Paid)
                                        {
                                            <span class="text-success fw-bold">Pagado</span>
                                        }
                                        else
                                        {
                                            <span class="text-warning fw-bold">Pendiente</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </Body>
        </GenericList>

        <hr />
        <Pagination CurrentPage="CurrentPage"
                    SelectedPage="SelectedPage"
                    TotalPages="TotalPages" />
    </div>
</div>
