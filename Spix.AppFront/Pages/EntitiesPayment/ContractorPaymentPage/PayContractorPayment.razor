@inherits ComponentBase

<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1055;">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-create-shadow p-4 position-relative">
            <div class="modal-header d-flex justify-content-between align-items-center mb-3">
                <h5 class="modal-title">@Title</h5>
                <button class="btn-close-modal" @onclick="Return" title="Close">
                    <i class="fa fa-times"></i>
                </button>
            </div>

            <EditForm Model="Payment" OnValidSubmit="PayAsync">
                <DataAnnotationsValidator />

                <div class="row g-2 mb-3">
                    <div class="col-12 col-md-8">
                        <div class="input-group">
                            <span class="input-group-text" style="width:125px">Contratista</span>
                            <input class="form-control" value="@ContractorName" disabled />
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="input-group">
                            <span class="input-group-text" style="width:105px">Total</span>
                            <input class="form-control text-end" value="@Total.ToString("N2")" disabled />
                        </div>
                    </div>
                </div>

                <div class="input-group mb-3">
                    <span class="input-group-text" style="width:125px">Modo pago</span>
                    <div class="form-control d-flex flex-wrap gap-3">
                        <label><input type="radio" name="paymentMode" value="Cash" checked="@(Payment.PaymentMode == "Cash")" @onchange="PaymentModeChanged" /> Efectivo</label>
                        <label><input type="radio" name="paymentMode" value="Transfer" checked="@(Payment.PaymentMode == "Transfer")" @onchange="PaymentModeChanged" /> Transferencia</label>
                        <label><input type="radio" name="paymentMode" value="Check" checked="@(Payment.PaymentMode == "Check")" @onchange="PaymentModeChanged" /> Cheque</label>
                    </div>
                </div>

                <div class="input-group mb-3">
                    <span class="input-group-text" style="width:125px">Referencia</span>
                    <input class="form-control" @bind="Payment.Reference" />
                </div>

                <div class="input-group mb-3">
                    <span class="input-group-text" style="width:125px">Detalle</span>
                    <textarea class="form-control" rows="3" @bind="Payment.Detail"></textarea>
                </div>

                <hr />
                <div class="d-flex justify-content-center gap-3 mt-4">
                    <ButtonFormSave IsSaving="IsSaving" ProgressText="@Localizer[nameof(Resource.ButtonSending)]" />
                    <ButtonFormBack OnClick="Return" />
                </div>
            </EditForm>
        </div>
    </div>
</div>
