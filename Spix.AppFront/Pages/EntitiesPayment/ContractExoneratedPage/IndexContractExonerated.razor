@page "/contractexonerateds"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator")]

@using Spix.Domain.EntitiesPayment

<div class="container-fluid pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">

        @* Encabezado: el unico titulo de la pantalla *@
        <div class="idx-head">
            <span class="idx-glifo"><i class="fa fa-percent"></i></span>
            <div class="idx-head-text">
                <h3>@Localizer["Exonerated_Title"]</h3>
                <p>@Localizer["Exonerated_Subtitle"]</p>
            </div>
        </div>

        @* El tablero: lo cuenta la base *@
        @if (Summary is not null)
        {
            <div class="ex-board">
                <div class="ex-tile is-open">
                    <div class="ex-tile-label">@Localizer["Exonerated_Pending"]</div>
                    <div class="ex-tile-value">@Summary.Pending.ToString("N0")</div>
                </div>
                <div class="ex-tile is-money">
                    <div class="ex-tile-label">@Localizer["Exonerated_PendingTotal"]</div>
                    <div class="ex-tile-value">@Summary.PendingTotal.ToString("N2")</div>
                </div>
                <div class="ex-tile">
                    <div class="ex-tile-label">@Localizer["Exonerated_Contracts"]</div>
                    <div class="ex-tile-value">@Summary.Contracts.ToString("N0")</div>
                </div>
                <div class="ex-tile is-billed">
                    <div class="ex-tile-label">@Localizer["Exonerated_BilledMonth"]</div>
                    <div class="ex-tile-value">@Summary.BilledMonthTotal.ToString("N2")</div>
                </div>
            </div>
        }

        <div class="idx-bar">
            <ButtonFormNew OnClick="ShowModalAsync" />
            <div class="idx-search">
                <FilterComponent ApplyFilter="SetFilterValue" />
            </div>
        </div>

        <section class="idx-panel">
            <div class="table-responsive">
                <table class="idx-table">
                    <thead>
                        <tr>
                            <th>@Localizer[nameof(Resource.Client)]</th>
                            <th>@Localizer["Exonerated_Period"]</th>
                            <th>@Localizer[nameof(Resource.Plan)]</th>
                            <th>@Localizer[nameof(Resource.Status)]</th>
                            <th style="text-align:right">@Localizer["Exonerated_Amount"]</th>
                            <th style="text-align:right">@Localizer["Table_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <GenericList MyList="ContractExonerateds">
                            <Loading>
                                <tr>
                                    <td colspan="6" class="idx-meta" style="text-align:center">
                                        <span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Table_Loading"]
                                    </td>
                                </tr>
                            </Loading>
                            <NoRecords>
                                <tr>
                                    <td colspan="6" class="idx-meta" style="text-align:center">@Localizer["Table_NoRecords"]</td>
                                </tr>
                            </NoRecords>
                            <Body>
                                @foreach (var item in ContractExonerateds!)
                                {
                                    <tr>
                                        <td>
                                            <div class="idx-name">@item.Client?.FirstName @item.Client?.LastName</div>
                                            <div class="idx-meta">@Localizer[nameof(Resource.Contract)] #@item.ContractClient?.ControlContrato</div>
                                        </td>
                                        <td>
                                            <span class="ex-period">@GetMonthName(item.MonthType) @item.YearNumber</span>
                                            <div class="idx-meta">@item.DateExonerated.ToString("dd/MM/yyyy")</div>
                                        </td>
                                        <td>@item.Plan?.PlanName</td>
                                        <td>
                                            @if (item.Billed)
                                            {
                                                <span class="idx-pill is-on">@Localizer["Exonerated_Applied"]</span>
                                            }
                                            else
                                            {
                                                <span class="idx-pill is-off">@Localizer["Exonerated_Scheduled"]</span>
                                            }
                                        </td>
                                        <td style="text-align:right"><strong>@item.PriceWithTax.ToString("N2")</strong></td>
                                        <td>
                                            <div class="idx-actions">
                                                @* Quien la registro y cuando no ocupan columna: se consultan aqui *@
                                                <ButtonGeneric Icon="fa fa-clock-rotate-left"
                                                               TooTip="@Localizer["Audit_Tip"]"
                                                               OnClick="() => ShowAuditAsync(item)" />
                                                @if (!item.Billed)
                                                {
                                                    <ButtonEdit OnClick="() => ShowEditAsync(item.ContractExoneratedId)" />
                                                    <ButtonDelete OnClick="() => DeleteAsync(item.ContractExoneratedId)" />
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </Body>
                        </GenericList>
                    </tbody>
                </table>
            </div>

            @if (ContractExonerateds is not null)
            {
                <div class="idx-panel-foot">
                    <Pagination CurrentPage="CurrentPage"
                                SelectedPage="SelectedPage"
                                TotalPages="TotalPages" />
                </div>
            }
        </section>
    </div>
</div>
