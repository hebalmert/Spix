@page "/prepayments"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator")]
@using Spix.Domain.EntitiesPayment

<div class="container-fluid pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">

        @* Encabezado: el unico titulo de la pantalla *@
        <div class="idx-head">
            <span class="idx-glifo"><i class="fa fa-hand-holding-dollar"></i></span>
            <div class="idx-head-text">
                <h3>@Localizer["PrePayment_Title"]</h3>
                <p>@Localizer["PrePayment_Subtitle"]</p>
            </div>
        </div>

        @* El tablero: lo cuenta la base *@
        @if (Summary is not null)
        {
            <div class="pp-board">
                <div class="pp-tile is-open">
                    <div class="pp-tile-label">@Localizer["PrePayment_Pending"]</div>
                    <div class="pp-tile-value">@Summary.Pending.ToString("N0")</div>
                </div>
                <div class="pp-tile is-money">
                    <div class="pp-tile-label">@Localizer["PrePayment_PendingTotal"]</div>
                    <div class="pp-tile-value">@Summary.PendingTotal.ToString("N2")</div>
                </div>
                <div class="pp-tile">
                    <div class="pp-tile-label">@Localizer["PrePayment_Contracts"]</div>
                    <div class="pp-tile-value">@Summary.Contracts.ToString("N0")</div>
                </div>
                <div class="pp-tile is-billed">
                    <div class="pp-tile-label">@Localizer["PrePayment_BilledMonth"]</div>
                    <div class="pp-tile-value">@Summary.BilledMonthTotal.ToString("N2")</div>
                </div>
            </div>
        }

        <div class="idx-bar">
            <ButtonFormNew OnClick="ShowModalAsync" />
            <div class="idx-search">
                <FilterComponent ApplyFilter="SetFilterValue" />
            </div>
        </div>

        <section class="idx-panel">
            <div class="table-responsive">
                <table class="idx-table">
                    <thead>
                        <tr>
                            <th>@Localizer[nameof(Resource.Client)]</th>
                            <th>@Localizer["PrePayment_Period"]</th>
                            <th>@Localizer[nameof(Resource.Plan)]</th>
                            <th>@Localizer["PrePayment_DatePaid"]</th>
                            <th style="text-align:right">@Localizer[nameof(Resource.Total)]</th>
                            <th style="text-align:right">@Localizer["Table_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <GenericList MyList="PrePayments">
                            <Loading>
                                <tr>
                                    <td colspan="6" class="idx-meta" style="text-align:center">
                                        <span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Table_Loading"]
                                    </td>
                                </tr>
                            </Loading>
                            <NoRecords>
                                <tr>
                                    <td colspan="6" class="idx-meta" style="text-align:center">@Localizer["Table_NoRecords"]</td>
                                </tr>
                            </NoRecords>
                            <Body>
                                @foreach (var item in PrePayments!)
                                {
                                    <tr>
                                        <td>
                                            <div class="idx-name">@item.Client?.FirstName @item.Client?.LastName</div>
                                            <div class="idx-meta">@Localizer[nameof(Resource.Contract)] #@item.ContractClient?.ControlContrato</div>
                                        </td>
                                        <td>
                                            <span class="pp-period">@GetMonthName(item.MonthType) @item.YearNumber</span>
                                        </td>
                                        <td>
                                            <div>@item.Plan?.PlanName</div>
                                            @* Si ademas del plan trae servicios, se avisa aqui *@
                                            @if (ServiceLines(item) > 0)
                                            {
                                                <div class="idx-meta"><i class="fa fa-screwdriver-wrench"></i> @Localizer["PrePayment_WithServices", ServiceLines(item)]</div>
                                            }
                                        </td>
                                        <td>@item.DatePayment.ToString("dd/MM/yyyy")</td>
                                        <td style="text-align:right"><strong>@item.PriceWithTax.ToString("N2")</strong></td>
                                        <td>
                                            <div class="idx-actions">
                                                <ButtonEdit OnClick="() => ShowEditAsync(item.PrePaymentId)" />
                                                <ButtonDelete OnClick="() => DeleteAsync(item.PrePaymentId)" />
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </Body>
                        </GenericList>
                    </tbody>
                </table>
            </div>

            @if (PrePayments is not null)
            {
                <div class="idx-panel-foot">
                    <Pagination CurrentPage="CurrentPage"
                                SelectedPage="SelectedPage"
                                TotalPages="TotalPages" />
                </div>
            }
        </section>
    </div>
</div>
