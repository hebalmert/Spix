@inherits ComponentBase
@using Spix.Domain.EntitiesBilling

<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1055;">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-create-shadow p-4 position-relative">
            <div class="modal-header d-flex justify-content-between align-items-center mb-3">
                <h5 class="modal-title">@Title</h5>
                <button class="btn-close-modal" @onclick="Return" title="Close">
                    <i class="fa fa-times"></i>
                </button>
            </div>

            @if (isLoading || Model is null)
            {
                <div class="loading-overlay">
                    <Loading />
                </div>
            }
            else
            {
                <FormBillingNote BillingNote="Model"
                                 Months="Months"
                                 ShowCreated="true"
                                 IsReadOnly="true"
                                 ShowButtons="false"
                                 OnSubmit="Return"
                                 ReturnAction="Return" />

                @* Lo que encontro la revision: se hace sola al pulsar Lanzar *@
                @if (Checks is not null)
                {
                    <div class="bn-check">
                        <div class="bn-check-head">
                            <b><i class="fa fa-clipboard-check"></i> @Localizer["Billing_CheckTitle"]</b>
                            <span class="bn-meta">@Localizer["Billing_CheckSummary", Checks.Count, Incomplete.Count, Checks.Count(x => x.AlreadyBilled)]</span>
                        </div>

                        @if (Incomplete.Count == 0)
                        {
                            <div class="bn-ok"><i class="fa fa-circle-check"></i> @Localizer["Billing_CheckAllGood"]</div>
                        }
                        else
                        {
                            <div class="bn-check-list">
                                @foreach (var item in Incomplete)
                                {
                                    <div class="bn-check-row">
                                        <div>
                                            <div class="bn-name">#@item.ControlContrato @item.ClientFullName</div>
                                            <div class="bn-meta">@item.ZoneName</div>
                                        </div>
                                        <div class="bn-tags">
                                            @foreach (var falta in Missing(item))
                                            {
                                                <span class="bn-tag @(falta.Blocks ? "is-bad" : null)">@falta.Name</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @* El avance real: cada lote que termina mueve la barra *@
                @if (IsLaunching || Processed > 0)
                {
                    <div class="bn-progress">
                        <div class="bn-progress-text">
                            <span>@Localizer["Billing_Progress", Processed, ToProcess]</span>
                            <span>@Percent%</span>
                        </div>
                        <div class="bn-bar">
                            <div class="bn-bar-fill" style="width:@Percent%"></div>
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-center gap-3 mt-4">
                    @if (!Model.Created)
                    {
                        <ButtonFormSaveOnClick OnClick="LaunchNotes"
                                               TooTip="@Localizer["Billing_Launch"]"
                                               Icon="fa fa-list-check"
                                               Style="width:160px"
                                               IsSaving="IsLaunching" />
                    }
                    <ButtonFormBack OnClick="Return" />
                </div>
            }
        </div>
    </div>
</div>
