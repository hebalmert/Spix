@page "/billingnoteones"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator")]

@using Spix.Domain.EntitiesBilling

<div class="container-fluid pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">

        @* Encabezado: el unico titulo de la pantalla *@
        <div class="idx-head">
            <span class="idx-glifo"><i class="fa fa-user-clock"></i></span>
            <div class="idx-head-text">
                <h3>@Localizer["BillingNoteOne_Title"]</h3>
                <p>@Localizer["BillingNoteOne_Subtitle"]</p>
            </div>
        </div>

        @* El tablero: lo cuenta la base *@
        @if (Summary is not null)
        {
            <div class="b1-board">
                <div class="b1-tile">
                    <div class="b1-tile-label">@Localizer["BillingNote_Year", Summary.YearNumber]</div>
                    <div class="b1-tile-value">@Summary.Notes.ToString("N0")</div>
                </div>
                <div class="b1-tile is-done">
                    <div class="b1-tile-label">@Localizer["BillingNote_Launched"]</div>
                    <div class="b1-tile-value">@Summary.Launched.ToString("N0")</div>
                </div>
                <div class="b1-tile is-open">
                    <div class="b1-tile-label">@Localizer["BillingNote_PendingNotes"]</div>
                    <div class="b1-tile-value">@Summary.Pending.ToString("N0")</div>
                </div>
                <div class="b1-tile is-money">
                    <div class="b1-tile-label">@Localizer["BillingNoteOne_Billed", Summary.YearNumber]</div>
                    <div class="b1-tile-value">@Summary.Billed.ToString("N2")</div>
                </div>
            </div>
        }

        <div class="idx-bar">
            <ButtonFormNew OnClick="ShowModalAsync" />
            <div class="idx-search">
                <FilterComponent ApplyFilter="SetFilterValue" />
            </div>
        </div>

        <section class="idx-panel">
            <div class="table-responsive">
                <table class="idx-table">
                    <thead>
                        <tr>
                            <th>@Localizer[nameof(Resource.Client)]</th>
                            <th>@Localizer["BillingNote_Period"]</th>
                            <th>@Localizer[nameof(Resource.Status)]</th>
                            <th style="text-align:right">@Localizer["Table_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <GenericList MyList="BillingNoteOnes">
                            <Loading>
                                <tr>
                                    <td colspan="4" class="idx-meta" style="text-align:center">
                                        <span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Table_Loading"]
                                    </td>
                                </tr>
                            </Loading>
                            <NoRecords>
                                <tr>
                                    <td colspan="4" class="idx-meta" style="text-align:center">@Localizer["Table_NoRecords"]</td>
                                </tr>
                            </NoRecords>
                            <Body>
                                @foreach (var item in BillingNoteOnes!)
                                {
                                    <tr>
                                        <td>
                                            <div class="idx-name">@item.Client?.FirstName @item.Client?.LastName</div>
                                            <div class="idx-meta">
                                                @Localizer[nameof(Resource.Contract)] #@item.ContractClient?.ControlContrato ·
                                                @item.DateBill.ToString("dd/MM/yyyy")
                                            </div>
                                        </td>
                                        <td>
                                            <span class="b1-period">@GetMonthName(item.MonthType) @item.YearNumber</span>
                                        </td>
                                        <td>
                                            @if (item.Created)
                                            {
                                                <span class="idx-pill is-on">@Localizer["BillingNote_Launched"]</span>
                                                <div class="idx-meta">@item.DateCreated?.ToString("dd/MM/yyyy")</div>
                                            }
                                            else
                                            {
                                                <span class="idx-pill is-off">@Localizer["BillingNote_Pending"]</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="idx-actions">
                                                <ButtonGeneric OnClick="() => ShowDetailsAsync(item.BillingNoteOneId)"
                                                               TooTip="@Localizer["CxC_Details"]"
                                                               Icon="fa fa-list-alt" />
                                                @if (!item.Created)
                                                {
                                                    <ButtonEdit OnClick="() => ShowEditAsync(item.BillingNoteOneId)" />
                                                    <ButtonDelete OnClick="() => DeleteAsync(item.BillingNoteOneId)" />
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </Body>
                        </GenericList>
                    </tbody>
                </table>
            </div>

            @if (BillingNoteOnes is not null)
            {
                <div class="idx-panel-foot">
                    <Pagination CurrentPage="CurrentPage"
                                SelectedPage="SelectedPage"
                                TotalPages="TotalPages" />
                </div>
            }
        </section>
    </div>
</div>
