@page "/my-bills"
@layout MainLayout
@attribute [Authorize(Roles = "Client")]

@using Spix.Domain.EntitiesBilling

@* Lo que el cliente ve de su cuenta: sus facturas, cuanto debe y que se le cobro.
   El backend solo le entrega las suyas. *@
<div class="container-fluid pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">

        <div class="idx-head">
            <span class="idx-glifo"><i class="fa fa-file-invoice-dollar"></i></span>
            <div class="idx-head-text">
                <h3>@Localizer["MyBill_Title"]</h3>
                <p>@Localizer["MyBill_Subtitle"]</p>
            </div>
        </div>

        @* Lo que debe hoy: lo primero que quiere saber *@
        @if (Summary is not null)
        {
            <div class="mb-board">
                <div class="mb-tile @(Summary.Pending > 0 ? "is-due" : "is-clear")">
                    <div class="mb-tile-label">@Localizer["MyBill_Balance"]</div>
                    <div class="mb-tile-value">@Summary.Balance.ToString("N2")</div>
                </div>
                <div class="mb-tile">
                    <div class="mb-tile-label">@Localizer["MyBill_PendingBills"]</div>
                    <div class="mb-tile-value">@Summary.Pending.ToString("N0")</div>
                </div>
            </div>
        }

        <section class="idx-panel">
            <div class="table-responsive">
                <table class="idx-table">
                    <thead>
                        <tr>
                            <th>@Localizer["MyBill_Invoice"]</th>
                            <th>@Localizer["Table_Contract"]</th>
                            <th>@Localizer[nameof(Resource.Status)]</th>
                            <th style="text-align:right">@Localizer["MyBill_Balance"]</th>
                            <th style="text-align:right">@Localizer[nameof(Resource.Total)]</th>
                            <th style="text-align:right">@Localizer["Table_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <GenericList MyList="Bills">
                            <Loading>
                                <tr>
                                    <td colspan="6" class="idx-meta" style="text-align:center">
                                        <span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Table_Loading"]
                                    </td>
                                </tr>
                            </Loading>
                            <NoRecords>
                                <tr>
                                    <td colspan="6" class="idx-meta" style="text-align:center">@Localizer["Table_NoRecords"]</td>
                                </tr>
                            </NoRecords>
                            <Body>
                                @foreach (var item in Bills!)
                                {
                                    <tr>
                                        <td>
                                            <div class="idx-name">@item.InvoiceNumber</div>
                                            <div class="idx-meta">@item.DateSell.ToString("dd/MM/yyyy")</div>
                                        </td>
                                        <td>@item.ControlContrato</td>
                                        <td>
                                            @if (item.Paid)
                                            {
                                                <span class="idx-pill is-on">@Localizer["Sell_Paid"]</span>
                                                @if (item.DatePaid.HasValue)
                                                {
                                                    <div class="idx-meta">@item.DatePaid.Value.ToString("dd/MM/yyyy")</div>
                                                }
                                            }
                                            else
                                            {
                                                <span class="idx-pill is-off">@Localizer["Sell_Pending"]</span>
                                            }
                                        </td>
                                        <td style="text-align:right">
                                            @if (item.Balance > 0)
                                            {
                                                <strong class="mb-due">@item.Balance.ToString("N2")</strong>
                                            }
                                            else
                                            {
                                                <span class="idx-meta">0.00</span>
                                            }
                                        </td>
                                        <td style="text-align:right">@item.Total.ToString("N2")</td>
                                        <td style="text-align:right">
                                            <div class="idx-actions">
                                                <ButtonGeneric OnClick="() => ShowDetailsAsync(item.SellId)"
                                                               TooTip="@Localizer["MyBill_Details"]"
                                                               Icon="fa fa-receipt" />
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </Body>
                        </GenericList>
                    </tbody>
                </table>
            </div>

            @if (Bills is not null && Bills.Count > 0)
            {
                <div class="idx-panel-foot">
                    <Pagination CurrentPage="CurrentPage"
                                SelectedPage="SelectedPage"
                                TotalPages="TotalPages" />
                </div>
            }
        </section>
    </div>
</div>
