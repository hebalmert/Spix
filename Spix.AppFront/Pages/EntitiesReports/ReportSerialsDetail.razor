@page "/reports/serials-detail"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator")]

@using Spix.Domain.EntitiesInven
@using Spix.DomainLogic.EnumTypes

@* El DETALLE de los seriales: uno por fila, no los totales.
   Se arma con las clases globales del sistema, sin hoja aislada propia. *@
<div class="container-fluid pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">

        <div class="idx-head">
            <span class="idx-glifo"><i class="fa fa-barcode"></i></span>
            <div class="idx-head-text">
                <h3>@Localizer["Report_SerialDetailTitle"]</h3>
                <p>@Localizer["Report_SerialDetailSubtitle"]</p>
            </div>
        </div>

        @* Los totales de lo que trajo el filtro: cambian con cada busqueda *@
        @if (Serials is not null)
        {
            <div class="idx-board">
                <div class="idx-tile is-blue">
                    <div class="idx-tile-label">@Localizer[nameof(Resource.Total)]</div>
                    <div class="idx-tile-value">@Serials.Count.ToString("N0")</div>
                </div>
                <div class="idx-tile is-green">
                    <div class="idx-tile-label">@Localizer["Report_SerialsAvailable"]</div>
                    <div class="idx-tile-value">@Serials.Count(x => x.StatusName == "Disponible").ToString("N0")</div>
                </div>
                <div class="idx-tile is-cyan">
                    <div class="idx-tile-label">@Localizer["Report_SerialsOperative"]</div>
                    <div class="idx-tile-value">@Serials.Count(x => x.StatusName == "Instalado").ToString("N0")</div>
                </div>
                <div class="idx-tile is-red">
                    <div class="idx-tile-label">@Localizer["Report_SerialsDamaged"]</div>
                    <div class="idx-tile-value">@Serials.Count(x => x.StatusName == "Averiado").ToString("N0")</div>
                </div>
            </div>
        }

        @* Filtros: estado y bodega *@
        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <GenericSelectWrapper Tmodel="IntItemModel" Items="States">
                    <Body>
                        <div class="input-group">
                            <span class="input-group-text" style="white-space:nowrap">@Localizer[nameof(Resource.Status)]</span>
                            <select class="form-select" value="@StateValue" @onchange="StateChanged">
                                @foreach (var item in States!)
                                {
                                    <option value="@item.Value">@item.Name</option>
                                }
                            </select>
                        </div>
                    </Body>
                </GenericSelectWrapper>
            </div>
            <div class="col-md-5">
                <GenericSelectWrapper Tmodel="ProductStorage" Items="Storages">
                    <Body>
                        <div class="input-group">
                            <span class="input-group-text" style="white-space:nowrap">@Localizer[nameof(Resource.Storage)]</span>
                            <select class="form-select" value="@StorageId" @onchange="StorageChanged">
                                @foreach (var item in Storages!)
                                {
                                    <option value="@item.ProductStorageId">@item.StorageName</option>
                                }
                            </select>
                        </div>
                    </Body>
                </GenericSelectWrapper>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <ButtonFormBlue OnClick="Cargar" Icon="fa fa-magnifying-glass" TooTip="@Localizer["Report_Search"]" Style="width:100%" />
                @* La hoja la arma el backend con los [Display] del DTO *@
                <ButtonFormGreen OnClick="DescargarExcel" Icon="fa fa-file-excel" TooTip="Excel" Style="width:100%" />
            </div>
        </div>

        <section class="idx-panel">
            <div class="table-responsive">
                <table class="idx-table">
                    <thead>
                        <tr>
                            <th>MAC / Serial</th>
                            <th>@Localizer["Report_Product"]</th>
                            <th>@Localizer[nameof(Resource.Storage)]</th>
                            <th>@Localizer[nameof(Resource.Status)]</th>
                            <th>@Localizer[nameof(Resource.Client)]</th>
                            <th>@Localizer[nameof(Resource.ContractNumber)]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <GenericList MyList="Serials">
                            <Loading>
                                <tr>
                                    <td colspan="6" class="idx-meta" style="text-align:center">
                                        <span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Table_Loading"]
                                    </td>
                                </tr>
                            </Loading>
                            <NoRecords>
                                <tr>
                                    <td colspan="6" class="idx-meta" style="text-align:center">@Localizer["Table_NoRecords"]</td>
                                </tr>
                            </NoRecords>
                            <Body>
                                @foreach (var item in Serials!)
                                {
                                    <tr>
                                        <td><div class="idx-name">@item.MacWlan</div></td>
                                        <td>@item.ProductName</td>
                                        <td>@item.StorageName</td>
                                        @* Verde disponible, azul instalado, rojo averiado *@
                                        <td>
                                            <span class="badge" style="background-color:@ColorEstado(item.StatusName)">
                                                @item.StatusName
                                            </span>
                                        </td>
                                        <td>@item.ClientName</td>
                                        <td>@item.ContractNumber</td>
                                    </tr>
                                }
                            </Body>
                        </GenericList>
                    </tbody>
                </table>
            </div>

            @if (Serials is not null)
            {
                <div class="idx-panel-foot">
                    <span class="idx-meta">@Serials.Count.ToString("N0") @Localizer["Report_SerialDetailCount"]</span>
                </div>
            }
        </section>
    </div>
</div>
