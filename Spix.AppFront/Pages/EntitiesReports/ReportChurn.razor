@page "/reports/churn"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator")]

@using Spix.Domain.EntitiesContratos

<div class="container-fluid pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">

        @* Encabezado: el unico titulo de la pantalla *@
        <div class="idx-head">
            <span class="idx-glifo"><i class="fa fa-user-minus"></i></span>
            <div class="idx-head-text">
                <h3>@Localizer["Report_ChurnTitle"]</h3>
                <p>@Localizer["Report_ChurnSubtitle"]</p>
            </div>
        </div>

        @* Lo que hoy no esta dando servicio *@
        @if (Summary is not null)
        {
            <div class="rp-board">
                <div class="rp-tile is-bad">
                    <div class="rp-tile-label">@Localizer["Report_ChurnTerminated"]</div>
                    <div class="rp-tile-value">@Summary.Terminated.ToString("N0")</div>
                    <div class="rp-tile-foot">@Summary.TerminatedAmount.ToString("N2")</div>
                </div>
                <div class="rp-tile is-discount">
                    <div class="rp-tile-label">@Localizer["Report_ChurnCancelled"]</div>
                    <div class="rp-tile-value">@Summary.Cancelled.ToString("N0")</div>
                    <div class="rp-tile-foot">@Summary.CancelledAmount.ToString("N2")</div>
                </div>
                <div class="rp-tile is-warm">
                    <div class="rp-tile-label">@Localizer["Report_ChurnSuspended"]</div>
                    <div class="rp-tile-value">@Summary.Suspended.ToString("N0")</div>
                    <div class="rp-tile-foot">@Summary.SuspendedAmount.ToString("N2")</div>
                </div>
                <div class="rp-tile">
                    <div class="rp-tile-label">@Localizer["Report_ChurnLost"]</div>
                    <div class="rp-tile-value">@Lost.ToString("N2")</div>
                </div>
            </div>

            @* La fecha del retiro no se guarda: por eso esto es una foto de hoy, no de un periodo *@
            <div class="rp-note"><i class="fa fa-circle-info me-2"></i>@Localizer["Report_ChurnNote"]</div>
        }

        @* En que zonas se esta yendo la gente *@
        <div class="rp-section"><i class="fa fa-location-dot"></i> @Localizer["Report_ChurnZones"]</div>
        <section class="idx-panel">
            <div class="table-responsive">
                <table class="idx-table">
                    <thead>
                        <tr>
                            <th>@Localizer["Report_ZoneName"]</th>
                            <th style="text-align:right">@Localizer["Report_Contracts"]</th>
                            <th style="text-align:right">@Localizer["Report_Amount"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <GenericList MyList="Zones">
                            <Loading>
                                <tr>
                                    <td colspan="3" class="idx-meta" style="text-align:center">
                                        <span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Table_Loading"]
                                    </td>
                                </tr>
                            </Loading>
                            <NoRecords>
                                <tr>
                                    <td colspan="3" class="idx-meta" style="text-align:center">@Localizer["Table_NoRecords"]</td>
                                </tr>
                            </NoRecords>
                            <Body>
                                @foreach (var item in Zones!)
                                {
                                    <tr>
                                        <td><div class="idx-name">@item.Name</div></td>
                                        <td style="text-align:right">@item.Contracts.ToString("N0")</td>
                                        <td style="text-align:right"><strong>@item.Amount.ToString("N2")</strong></td>
                                    </tr>
                                }
                                <tr class="rp-total">
                                    <td>@Localizer[nameof(Resource.Total)]</td>
                                    <td style="text-align:right">@Zones!.Sum(x => x.Contracts).ToString("N0")</td>
                                    <td style="text-align:right">@Zones!.Sum(x => x.Amount).ToString("N2")</td>
                                </tr>
                            </Body>
                        </GenericList>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
