@page "/systemsettings"
@layout MainLayout
@attribute [Authorize(Roles = "Admin")]

<PageTitle>System settings</PageTitle>

<div class="container pt-4">
    <div class="card shadow-lg p-4 mb-5" style="border-radius: 12px;">
        <h3 class="mb-1">
            <span class="fa fa-key me-2"></span>
            System settings
        </h3>

        <p class="text-muted">
            Platform credentials are encrypted in the database.
            Secret values are write-only; leave them empty to preserve the current value.
        </p>

        @if (IsLoading)
        {
            <Loading />
        }
        else if (Items is null || Items.Count == 0)
        {
            <div class="text-muted">
                No settings are available.
            </div>
        }
        else
        {
            @foreach (var group in Items.GroupBy(item => item.Category))
            {
                <div class="border rounded p-3 mb-3">
                    <h5 class="mb-3">
                        @group.Key
                    </h5>

                    <div class="row g-3">
                        @foreach (var item in group)
                        {
                            <div class="col-md-6">
                                <label class="form-label">
                                    @item.Label

                                    @if (item.IsSecret)
                                    {
                                        <span class="badge bg-secondary ms-1">
                                            Secret
                                        </span>

                                        @if (item.HasValue)
                                        {
                                            <span class="badge bg-success ms-1">
                                                Configured
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark ms-1">
                                                Not configured
                                            </span>
                                        }
                                    }
                                </label>

                                @if (item.IsSecret)
                                {
                                    <input type="password"
                                           class="form-control"
                                           placeholder="@(item.HasValue ? "Leave empty to preserve" : "Enter value")"
                                           @bind="item.Value" />
                                }
                                else
                                {
                                    <input type="text"
                                           class="form-control"
                                           @bind="item.Value" />
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="d-flex justify-content-end">
                <button type="button"
                        class="btn btn-gradient-primary"
                        @onclick="SaveAsync"
                        disabled="@IsSaving">
                    @if (IsSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2"
                              role="status"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span class="fa fa-save me-2"></span>
                        <span>Save</span>
                    }
                </button>
            </div>
        }
    </div>
</div>
