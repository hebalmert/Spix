@if (Latitude is null || Longitude is null)
{
    <div class="alert alert-warning mb-0">@Localizer["Map_NoCoordinates"]</div>
}
else
{
    <div id="@MapId" style="width:100%; height:@($"{Height}px"); border-radius:8px; overflow:hidden;"></div>
    @if (DistanceKm.HasValue)
    {
        <div class="text-center mt-2">
            <strong>@Localizer["Map_Distance"]:</strong> @DistanceKm.Value.ToString("N2") Km
        </div>
    }
}
