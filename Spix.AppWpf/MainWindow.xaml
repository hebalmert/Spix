<Window x:Class="Spix.AppWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
        xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
        Title="Spix"
        Height="820"
        Width="1440"
        MinHeight="640"
        MinWidth="1024"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource BrushShellContent}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource SharedSidebar}">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" Background="#FFFFFF" CornerRadius="6">
                        <Image Margin="7"
                               Source="/Assets/Images/LogoNexxtplanetIcon.png"
                               Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="19" FontWeight="Bold" Foreground="White" Text="SPIX" />
                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#AFC8F4" Text="NexxtPlanet Desktop" />
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button Click="ShowDashboardClick" Style="{StaticResource ShellMenuItemActive}">
                            <StackPanel Orientation="Horizontal">
                                <fa:FontAwesomeImage Width="18" Height="18" Foreground="White"
                                                     Icon="{x:Static icons:FontAwesomeIcon.House}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                <TextBlock Margin="14,0,0,0" FontSize="16" FontWeight="SemiBold" Text="Home" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource ShellMenuItem}">
                            <StackPanel Orientation="Horizontal">
                                <fa:FontAwesomeImage Width="18" Height="18" Foreground="White"
                                                     Icon="{x:Static icons:FontAwesomeIcon.CreditCard}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                <TextBlock Margin="14,0,0,0" FontSize="16" FontWeight="SemiBold" Text="Mi suscripcion" />
                            </StackPanel>
                        </Button>

                        <Button Click="ToggleMenuClick" Tag="ConfigurationMenu" Style="{StaticResource ShellMenuItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <fa:FontAwesomeImage Width="18" Height="18" Foreground="White"
                                                     Icon="{x:Static icons:FontAwesomeIcon.Gears}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                <TextBlock Grid.Column="1" Margin="14,0,0,0" FontSize="16" FontWeight="SemiBold" Text="Configuracion" />
                                <fa:FontAwesomeImage Grid.Column="2" Width="14" Height="14" Foreground="White"
                                                     Icon="{x:Static icons:FontAwesomeIcon.ChevronDown}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                            </Grid>
                        </Button>

                        <StackPanel x:Name="ConfigurationMenu" Margin="30,0,14,8" Visibility="Collapsed">
                            <Button Click="ShowZonesClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Zonas" />
                            </Button>
                            <Button Click="ShowDocumentTypesClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Tipos de documento" />
                            </Button>
                            <Button Click="ShowTaxesClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Impuestos" />
                            </Button>
                            <Button Click="ShowEstratosSocialesClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Estratos sociales" />
                            </Button>
                            <Button Click="ShowRegistersClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Consecutivos" />
                            </Button>
                            <Button Click="ShowContractDocumentTemplatesClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Plantillas PDF" />
                            </Button>
                            <Button Click="ShowEmailProvidersClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Correo" />
                            </Button>
                        </StackPanel>

                        <Button Click="ToggleMenuClick" Tag="CatalogMenu" Style="{StaticResource ShellMenuItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <fa:FontAwesomeImage Width="18" Height="18" Foreground="White"
                                                     Icon="{x:Static icons:FontAwesomeIcon.LayerGroup}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                <TextBlock Grid.Column="1" Margin="14,0,0,0" FontSize="16" FontWeight="SemiBold" Text="Catalogo" />
                                <fa:FontAwesomeImage Grid.Column="2" Width="14" Height="14" Foreground="White"
                                                     Icon="{x:Static icons:FontAwesomeIcon.ChevronDown}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                            </Grid>
                        </Button>

                        <StackPanel x:Name="CatalogMenu" Margin="30,0,14,8" Visibility="Collapsed">
                            <Button Click="ShowPlansClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Categorias de planes" />
                            </Button>
                            <Button Click="ShowServicesClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Categorias de servicios" />
                            </Button>
                            <Button Click="ShowProductsClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Categorias de productos" />
                            </Button>
                            <Button Click="ShowMarksClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Marcas y modelos" />
                            </Button>
                        </StackPanel>

                        <Button Click="ToggleMenuClick" Tag="InventoryMenu" Style="{StaticResource ShellMenuItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <fa:FontAwesomeImage Width="18" Height="18" Foreground="White"
                                                     Icon="{x:Static icons:FontAwesomeIcon.BoxesStacked}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                <TextBlock Grid.Column="1" Margin="14,0,0,0" FontSize="16" FontWeight="SemiBold" Text="Inventario" />
                                <fa:FontAwesomeImage Grid.Column="2" Width="14" Height="14" Foreground="White"
                                                     Icon="{x:Static icons:FontAwesomeIcon.ChevronDown}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                            </Grid>
                        </Button>

                        <StackPanel x:Name="InventoryMenu" Margin="30,0,14,8" Visibility="Collapsed">
                            <Button Click="ShowSuppliersClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Proveedores" />
                            </Button>
                            <Button Click="ShowStoragesClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Bodegas" />
                            </Button>
                            <Button Click="ShowPurchasesClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Compras" />
                            </Button>
                            <Button Click="ShowCarguesClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Cargue de seriales" />
                            </Button>
                        </StackPanel>

                        <Button Click="ToggleMenuClick" Tag="NetworkMenu" Style="{StaticResource ShellMenuItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <fa:FontAwesomeImage Width="18" Height="18" Foreground="White"
                                                     Icon="{x:Static icons:FontAwesomeIcon.NetworkWired}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                <TextBlock Grid.Column="1" Margin="14,0,0,0" FontSize="16" FontWeight="SemiBold" Text="Network" />
                                <fa:FontAwesomeImage Grid.Column="2" Width="14" Height="14" Foreground="White"
                                                     Icon="{x:Static icons:FontAwesomeIcon.ChevronDown}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                            </Grid>
                        </Button>

                        <StackPanel x:Name="NetworkMenu" Margin="30,0,14,8" Visibility="Collapsed">
                            <Button Click="ShowIpNetsClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="IP de clientes" />
                            </Button>
                            <Button Click="ShowIpNetworksClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="IP de red" />
                            </Button>
                            <Button Click="ShowConnectionMikrotikControlsClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Control Mikrotik" />
                            </Button>
                            <Button Click="ShowQueueTypesClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Queue Types" />
                            </Button>
                            <Button Click="ShowServersClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Servidores" />
                            </Button>
                            <Button Click="ShowNodesClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Nodos" />
                            </Button>
                            <Button Click="ShowNodeMapClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Mapa de nodos" />
                            </Button>
                        </StackPanel>

                        <Button Click="ToggleMenuClick" Tag="OperationsMenu" Style="{StaticResource ShellMenuItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <fa:FontAwesomeImage Width="18" Height="18" Foreground="White"
                                                     Icon="{x:Static icons:FontAwesomeIcon.Briefcase}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                <TextBlock Grid.Column="1" Margin="14,0,0,0" FontSize="16" FontWeight="SemiBold" Text="Operaciones" />
                                <fa:FontAwesomeImage Grid.Column="2" Width="14" Height="14" Foreground="White"
                                                     Icon="{x:Static icons:FontAwesomeIcon.ChevronDown}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                            </Grid>
                        </Button>

                        <StackPanel x:Name="OperationsMenu" Margin="30,0,14,8" Visibility="Collapsed">
                            <Button Click="ShowClientsClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Clientes" />
                            </Button>
                            <Button Click="ShowContractsClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Contratos" />
                            </Button>
                            <Button Click="ShowContractControlClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Control de contratos" />
                            </Button>
                            <Button Click="ShowServiceRequestsClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Solicitudes de servicio" />
                            </Button>
                            <Button Click="ShowScheduleClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Agenda" />
                            </Button>
                            <Button Click="ShowContractSuspendedClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Contratos suspendidos" />
                            </Button>
                            <Button Click="ShowActivationClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Reactivacion" />
                            </Button>
                            <Button Click="ShowContractSuspendedAuditClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Auditoria de activaciones" />
                            </Button>
                        </StackPanel>

                        <Button Click="ToggleMenuClick" Tag="FinanceMenu" Style="{StaticResource ShellMenuItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <fa:FontAwesomeImage Width="18" Height="18" Foreground="White"
                                                     Icon="{x:Static icons:FontAwesomeIcon.FileInvoiceDollar}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                <TextBlock Grid.Column="1" Margin="14,0,0,0" FontSize="16" FontWeight="SemiBold" Text="Finanzas" />
                                <fa:FontAwesomeImage Grid.Column="2" Width="14" Height="14" Foreground="White"
                                                     Icon="{x:Static icons:FontAwesomeIcon.ChevronDown}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                            </Grid>
                        </Button>

                        <StackPanel x:Name="FinanceMenu" Margin="30,0,14,8" Visibility="Collapsed">
                            <Button Click="ShowBillingNotesClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Notas de cobro" />
                            </Button>
                            <Button Click="ShowBillingNoteOnesClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Nota individual" />
                            </Button>
                            <Button Click="ShowPrePaymentsClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Pagos adelantados" />
                            </Button>
                            <Button Click="ShowContractExemptClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Exoneracion fija" />
                            </Button>
                            <Button Click="ShowContractExoneratedClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Exoneracion del mes" />
                            </Button>
                            <Button Click="ShowSellsClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Facturas" />
                            </Button>
                            <Button Click="ShowCxCBillsClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Cuentas por cobrar" />
                            </Button>
                            <Button Click="ShowTechnicianCollectionsClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Cobro tecnico" />
                            </Button>
                            <Button Click="ShowRunSuspendedClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Corte general" />
                            </Button>
                            <Button Click="ShowContractorCxCClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Pagos a contratistas" />
                            </Button>
                        </StackPanel>

                        <Button Click="ToggleMenuClick" Tag="ReportsMenu" Style="{StaticResource ShellMenuItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <fa:FontAwesomeImage Width="18" Height="18" Foreground="White"
                                                     Icon="{x:Static icons:FontAwesomeIcon.ChartColumn}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                <TextBlock Grid.Column="1" Margin="14,0,0,0" FontSize="16" FontWeight="SemiBold" Text="Reportes" />
                                <fa:FontAwesomeImage Grid.Column="2" Width="14" Height="14" Foreground="White"
                                                     Icon="{x:Static icons:FontAwesomeIcon.ChevronDown}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                            </Grid>
                        </Button>

                        <StackPanel x:Name="ReportsMenu" Margin="30,0,14,8" Visibility="Collapsed">
                            <Button Click="ShowReportCollectionsClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Recaudo del periodo" />
                            </Button>
                            <Button Click="ShowReportAgingClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Cartera por antiguedad" />
                            </Button>
                            <Button Click="ShowReportCommissionsClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Comisiones de contratistas" />
                            </Button>
                            <Button Click="ShowReportAuditClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Bitacora del dinero" />
                            </Button>
                            <Button Click="ShowReportContractsClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Contratos del periodo" />
                            </Button>
                            <Button Click="ShowReportServicesClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Servicios del periodo" />
                            </Button>
                            <Button Click="ShowReportCutOffClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Efectividad del corte" />
                            </Button>
                            <Button Click="ShowReportChurnClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Fuera de servicio" />
                            </Button>
                            <Button Click="ShowReportActiveContractsClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Contratos activos" />
                            </Button>
                            <Button Click="ShowReportByZoneClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Contratos por zona" />
                            </Button>
                            <Button Click="ShowReportByNodeClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Contratos por AP" />
                            </Button>
                            <Button Click="ShowReportByServerClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Contratos por servidor" />
                            </Button>
                            <Button Click="ShowReportSerialsClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Inventario de seriales" />
                            </Button>
                        </StackPanel>

                        <Button Click="ToggleMenuClick" Tag="SystemMenu" Style="{StaticResource ShellMenuItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <fa:FontAwesomeImage Width="18" Height="18" Foreground="White"
                                                     Icon="{x:Static icons:FontAwesomeIcon.Sliders}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                <TextBlock Grid.Column="1" Margin="14,0,0,0" FontSize="16" FontWeight="SemiBold" Text="Sistema" />
                                <fa:FontAwesomeImage Grid.Column="2" Width="14" Height="14" Foreground="White"
                                                     Icon="{x:Static icons:FontAwesomeIcon.ChevronDown}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                            </Grid>
                        </Button>

                        <StackPanel x:Name="SystemMenu" Margin="30,0,14,8" Visibility="Collapsed">
                            <Button Click="ShowUsuariosClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Usuarios" />
                            </Button>
                            <Button Click="ShowContractorsClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Contratistas" />
                            </Button>
                            <Button Click="ShowTechnitiansClick" Style="{StaticResource ShellSubMenuItem}">
                                <TextBlock FontSize="14" Text="Tecnicos" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource SharedTopBar}">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- El glifo del modulo: le pone cara a cada pantalla -->
                        <Border Width="40" Height="40"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource BrushIndexIconRest}"
                                CornerRadius="10">
                            <fa:FontAwesomeImage x:Name="PageGlyph"
                                                 Width="17" Height="17"
                                                 Foreground="{DynamicResource BrushIndexAccent}"
                                                 Icon="{x:Static icons:FontAwesomeIcon.House}"
                                                 IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitleText" FontSize="{StaticResource FontSizeSection}" FontWeight="SemiBold" Foreground="White" Text="Home" />
                            <TextBlock x:Name="PageSubtitleText" Margin="0,2,0,0" FontSize="{StaticResource FontSizeCaption}" Foreground="#AAB7C9" Text="Panel principal" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Aspecto: tema claro/oscuro y que tan apretadas van las tablas -->
                        <!-- El idioma en que responde el Backend: EN por defecto -->
                        <Button x:Name="LanguageButton"
                                Width="36" Height="36"
                                Margin="0,0,4,0"
                                Click="ToggleLanguageClick"
                                Style="{StaticResource ShellIconButton}"
                                ToolTip="Cambiar entre espanol e ingles">
                            <TextBlock x:Name="LanguageText"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#AAB7C9"
                                       Text="EN" />
                        </Button>

                        <Button x:Name="ThemeButton"
                                Width="36" Height="36"
                                Margin="0,0,4,0"
                                Click="ToggleThemeClick"
                                Style="{StaticResource ShellIconButton}"
                                ToolTip="Cambiar entre tema claro y oscuro">
                            <fa:FontAwesomeImage x:Name="ThemeIcon"
                                                 Width="15" Height="15"
                                                 Foreground="#AAB7C9"
                                                 Icon="{x:Static icons:FontAwesomeIcon.Moon}"
                                                 IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                        </Button>

                        <Button x:Name="DensityButton"
                                Width="36" Height="36"
                                Margin="0,0,14,0"
                                Click="ToggleDensityClick"
                                Style="{StaticResource ShellIconButton}"
                                ToolTip="Filas comodas o compactas">
                            <fa:FontAwesomeImage x:Name="DensityIcon"
                                                 Width="15" Height="15"
                                                 Foreground="#AAB7C9"
                                                 Icon="{x:Static icons:FontAwesomeIcon.BarsStaggered}"
                                                 IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                        </Button>

                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="White" Text="{Binding FullName}" />
                            <TextBlock HorizontalAlignment="Right" Margin="0,2,0,0" FontSize="11" Foreground="#AAB7C9" Text="{Binding Role}" />
                        </StackPanel>
                        <Button x:Name="AccountButton"
                                Command="{Binding ToggleAccountMenuCommand}"
                                Style="{StaticResource ShellIconButton}">
                            <Border Width="34" Height="34" Background="#36A4E9" CornerRadius="17">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="White" Text="{Binding Initials}" />
                            </Border>
                        </Button>
                        <Popup AllowsTransparency="True"
                               IsOpen="{Binding IsAccountMenuOpen}"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=AccountButton}"
                               StaysOpen="False">
                            <Border Width="290" Margin="0,8,0,0" Padding="18" Background="#303640" BorderBrush="#4A5565" BorderThickness="1" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#9DB4D2" Text="SESION ACTIVA" />
                                    <TextBlock Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold" Foreground="White" Text="{Binding FullName}" />
                                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#B9C8DD" Text="{Binding CorporationName}" TextTrimming="CharacterEllipsis" />
                                    <Separator Margin="0,16,0,12" Background="#4A5565" />
                                    <Button Command="{Binding ChangePasswordCommand}" Style="{StaticResource ShellMenuItem}">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:FontAwesomeImage Width="16" Height="16" Foreground="White"
                                                                 Icon="{x:Static icons:FontAwesomeIcon.Key}"
                                                                 IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                            <TextBlock Margin="12,0,0,0" FontSize="14" Text="Cambiar clave" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding LogoutCommand}" Style="{StaticResource ShellMenuItem}">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:FontAwesomeImage Width="16" Height="16" Foreground="#FF8FA3"
                                                                 Icon="{x:Static icons:FontAwesomeIcon.RightFromBracket}"
                                                                 IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                            <TextBlock Margin="12,0,0,0" FontSize="14" Foreground="#FFD2DA" Text="Cerrar sesion" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="MainContent" Grid.Row="1">
                <ScrollViewer x:Name="DashboardContent" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32">
                    <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="White" Text="Dashboard" />
                    <TextBlock Margin="0,8,0,28" FontSize="14" Foreground="#B9C8DD" Text="Accesos principales de la operacion SPIX." />

                    <UniformGrid Columns="4" HorizontalAlignment="Left">
                        <Border Width="220" Margin="0,0,14,0" BorderBrush="{DynamicResource BrushDashSetup}" Style="{StaticResource ShellQuickCard}">
                            <StackPanel>
                                <Border Style="{StaticResource ShellQuickCardIcon}">
                                    <fa:FontAwesomeImage Width="19" Height="19"
                                                         Foreground="{DynamicResource BrushDashSetup}"
                                                         Icon="{x:Static icons:FontAwesomeIcon.Gears}"
                                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                </Border>
                                <TextBlock Style="{StaticResource ShellQuickCardTitle}" Text="Configuracion" />
                                <TextBlock Style="{StaticResource ShellQuickCardText}" Text="Parametros del sistema." />
                            </StackPanel>
                        </Border>
                        <Border Width="220" Margin="0,0,14,0" BorderBrush="{DynamicResource BrushDashInventory}" Style="{StaticResource ShellQuickCard}">
                            <StackPanel>
                                <Border Style="{StaticResource ShellQuickCardIcon}">
                                    <fa:FontAwesomeImage Width="19" Height="19"
                                                         Foreground="{DynamicResource BrushDashInventory}"
                                                         Icon="{x:Static icons:FontAwesomeIcon.BoxesStacked}"
                                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                </Border>
                                <TextBlock Style="{StaticResource ShellQuickCardTitle}" Text="Inventario" />
                                <TextBlock Style="{StaticResource ShellQuickCardText}" Text="Productos y existencias." />
                            </StackPanel>
                        </Border>
                        <Border Width="220" Margin="0,0,14,0" BorderBrush="{DynamicResource BrushDashNetwork}" Style="{StaticResource ShellQuickCard}">
                            <StackPanel>
                                <Border Style="{StaticResource ShellQuickCardIcon}">
                                    <fa:FontAwesomeImage Width="19" Height="19"
                                                         Foreground="{DynamicResource BrushDashNetwork}"
                                                         Icon="{x:Static icons:FontAwesomeIcon.NetworkWired}"
                                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                </Border>
                                <TextBlock Style="{StaticResource ShellQuickCardTitle}" Text="Network" />
                                <TextBlock Style="{StaticResource ShellQuickCardText}" Text="Nodos, servidores y MikroTik." />
                            </StackPanel>
                        </Border>
                        <Border Width="220" BorderBrush="{DynamicResource BrushDashOperations}" Style="{StaticResource ShellQuickCard}">
                            <StackPanel>
                                <Border Style="{StaticResource ShellQuickCardIcon}">
                                    <fa:FontAwesomeImage Width="19" Height="19"
                                                         Foreground="{DynamicResource BrushDashOperations}"
                                                         Icon="{x:Static icons:FontAwesomeIcon.Briefcase}"
                                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                </Border>
                                <TextBlock Style="{StaticResource ShellQuickCardTitle}" Text="Operaciones" />
                                <TextBlock Style="{StaticResource ShellQuickCardText}" Text="Contratos y servicio al cliente." />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
                </ScrollViewer>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
