<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- La pantalla de acceso. Aqui NO se escribe ni un color: todos salen de Colors.xaml -->

    <!-- La tarjeta: ancho fijo para que no se estire cuando la ventana se maximiza -->
    <Style x:Key="SharedLoginCard" TargetType="Border">
        <Setter Property="Width" Value="440" />
        <Setter Property="Padding" Value="36,34" />
        <Setter Property="Background" Value="{StaticResource BrushLoginCard}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="34"
                                  ShadowDepth="10"
                                  Opacity="0.30"
                                  Color="#06132B" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SharedLoginTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushLoginTitle}" />
    </Style>

    <Style x:Key="SharedLoginSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource BrushLoginMeta}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- El nombre del campo, encima de la caja -->
    <Style x:Key="SharedLoginLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="2,0,0,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushLoginMeta}" />
    </Style>

    <!-- La caja del campo: el icono va adentro, no en un bloque gris aparte -->
    <Style x:Key="SharedLoginField" TargetType="Border">
        <Setter Property="Height" Value="46" />
        <Setter Property="Margin" Value="0,0,0,18" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{StaticResource BrushLoginField}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushLoginFieldBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="SharedLoginTextInput" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource BrushLoginTitle}" />
        <Setter Property="CaretBrush" Value="{StaticResource BrushLoginTitle}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SharedLoginPasswordInput" TargetType="PasswordBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource BrushLoginTitle}" />
        <Setter Property="CaretBrush" Value="{StaticResource BrushLoginTitle}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SharedLoginFieldIcon" TargetType="Control">
        <Setter Property="Foreground" Value="{StaticResource BrushLoginIcon}" />
    </Style>

    <!-- El ojo de la clave: un icono plano dentro de la caja -->
    <Style x:Key="SharedLoginPasswordToggle" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="Mostrar contraseña" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource BrushLoginFieldHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SharedLoginLink" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource BrushLoginLink}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- El boton de entrar: ancho completo y del azul de la casa -->
    <Style x:Key="SharedLoginButton" TargetType="Button">
        <Setter Property="Height" Value="48" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource BrushWhite}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{StaticResource BrushLoginButton}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- El aviso de error: una franja, no un texto suelto -->
    <Style x:Key="SharedLoginError" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Background" Value="{StaticResource BrushLoginErrorBack}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushLoginErrorLine}" />
        <Setter Property="BorderThickness" Value="4,0,0,0" />
    </Style>

    <Style x:Key="SharedLoginErrorText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource BrushLoginErrorText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="300" />
    </Style>

    <!-- Lo que se cuenta del software en el panel azul -->
    <Style x:Key="SharedLoginBrandTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource BrushWhite}" />
    </Style>

    <Style x:Key="SharedLoginBrandText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource BrushLoginBrandText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SharedLoginFeature" TargetType="TextBlock">
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource BrushLoginBrandText}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SharedLoginBrandMeta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource BrushLoginBrandMeta}" />
    </Style>
</ResourceDictionary>
