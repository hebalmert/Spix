<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="SharedSidebar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushSidebarBackground}" />
        <Setter Property="BorderBrush" Value="#31517F" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style x:Key="SharedTopBar" TargetType="Border">
        <Setter Property="Height" Value="64" />
        <Setter Property="Background" Value="{StaticResource BrushShellTopBar}" />
        <Setter Property="BorderBrush" Value="#3C4654" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="SharedDataGridTextCell" TargetType="DataGridCell">
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
