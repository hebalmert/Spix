<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ShellMenuGroup" TargetType="TextBlock">
        <Setter Property="Margin" Value="18,22,18,8" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#87A8D8" />
    </Style>

    <Style x:Key="ShellMenuItem" TargetType="Button">
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="10,2" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#E5ECF7" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="MenuBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MenuBorder"
                                    Property="Background"
                                    Value="#313C4E" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="MenuBorder" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShellMenuItemActive" TargetType="Button" BasedOn="{StaticResource ShellMenuItem}">
        <Setter Property="Background" Value="#35465C" />
    </Style>

    <Style x:Key="ShellSubMenuItem" TargetType="Button">
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#F5F8FC" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="SubMenuBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4" />
                        <Border x:Name="SubMenuIndicator"
                                Width="3"
                                HorizontalAlignment="Left"
                                Background="#52698D" />
                        <ContentPresenter Margin="22,0,12,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SubMenuBackground"
                                    Property="Background"
                                    Value="#243A63" />
                            <Setter TargetName="SubMenuIndicator"
                                    Property="Background"
                                    Value="#23BCE6" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="SubMenuBackground" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShellSubMenuSeparator" TargetType="Separator">
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="#93A6C5" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>

    <Style x:Key="ShellIconButton" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="IconBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="20">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="IconBorder" Property="Background" Value="#E3EDF9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShellQuickCard" TargetType="Border">
        <Setter Property="Padding" Value="20" />
        <Setter Property="Background" Value="{StaticResource BrushShellCard}" />
        <Setter Property="BorderBrush" Value="#3C4451" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
</ResourceDictionary>
