<Application x:Class="Spix.AppWpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Spix.AppWpf"
             ThemeMode="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Converters.xaml" />
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Typography.xaml" />
                <ResourceDictionary Source="Resources/Styles/Effects.xaml" />
                <ResourceDictionary Source="Resources/Styles/SharedLayout.xaml" />
                <ResourceDictionary Source="Resources/Styles/SharedLogin.xaml" />
                <ResourceDictionary Source="Resources/Styles/SharedButtonForm.xaml" />
                <ResourceDictionary Source="Resources/Styles/SharedIndex.xaml" />
                <ResourceDictionary Source="Resources/Styles/SharedCatalog.xaml" />
                <ResourceDictionary Source="Resources/Styles/SharedButtonTableRow.xaml" />
                <ResourceDictionary Source="Resources/Styles/SharedShell.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
