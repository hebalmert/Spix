<UserControl x:Class="Spix.AppWpf.Views.EntitiesOper.Client.ClientIndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Command="{Binding NewCommand}" Style="{StaticResource SharedButtonFormPrimary}">
                <StackPanel Orientation="Horizontal">
                    <fa:FontAwesomeImage Width="16" Height="16" Icon="{x:Static icons:FontAwesomeIcon.CirclePlus}" IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                    <TextBlock Margin="10,0,0,0" Text="Nuevo" />
                </StackPanel>
            </Button>
            <shared:SharedSearchFilter Grid.Column="2"
                                       VerticalAlignment="Bottom"
                                       SearchText="{Binding Filter}"
                                       SearchCommand="{Binding SearchCommand}"
                                       ClearCommand="{Binding ClearSearchCommand}" />
        </Grid>

        <TextBlock Grid.Row="2"
                   FontSize="13"
                   Foreground="#FF9AAE"
                   Text="{Binding Message}"
                   Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid Grid.Row="4">
            <DataGrid ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      Background="#303640"
                      Foreground="White"
                      BorderBrush="#455160"
                      BorderThickness="1"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowBackground="#303640"
                      AlternatingRowBackground="#2B303A"
                      AlternationCount="2"
                      RowHeight="62"
                      FontSize="14">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#102A4C" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="14,10" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="78" Header="Foto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="42" Height="42" HorizontalAlignment="Center" Background="#E9EEF5" CornerRadius="21" ClipToBounds="True">
                                    <Image Source="{Binding ImageFullPath}" Stretch="UniformToFill" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Width="*" Header="Nombre" Binding="{Binding FirstName}" CellStyle="{StaticResource SharedDataGridTextCell}" />
                    <DataGridTextColumn Width="160" Header="Apellido" Binding="{Binding LastName}" CellStyle="{StaticResource SharedDataGridTextCell}" />
                    <DataGridTextColumn Width="150" Header="Telefono" Binding="{Binding PhoneNumber}" CellStyle="{StaticResource SharedDataGridTextCell}" />
                    <DataGridTextColumn Width="240" Header="Correo" Binding="{Binding Email}" CellStyle="{StaticResource SharedDataGridTextCell}" />
                    <DataGridCheckBoxColumn Width="90" Header="Activo" Binding="{Binding Active}" />
                    <DataGridTemplateColumn Width="48" Header="">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ResendActivationEmailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource SharedButtonTableRowEdit}"
                                        ToolTip="Reenviar correo de activacion"
                                        Visibility="{Binding CreateAccount, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <fa:FontAwesomeImage Width="16" Height="16" Style="{StaticResource SharedButtonTableRowIcon}" Icon="{x:Static icons:FontAwesomeIcon.Envelope}" IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="48" Header="">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SharedButtonTableRowEdit}" ToolTip="Editar">
                                    <fa:FontAwesomeImage Width="16" Height="16" Style="{StaticResource SharedButtonTableRowIcon}" Icon="{x:Static icons:FontAwesomeIcon.PenToSquare}" IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="48" Header="">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SharedButtonTableRowDelete}" ToolTip="Eliminar">
                                    <fa:FontAwesomeImage Width="16" Height="16" Style="{StaticResource SharedButtonTableRowIcon}" Icon="{x:Static icons:FontAwesomeIcon.TrashCan}" IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <shared:SharedLoading IsLoading="{Binding IsLoading}" />
        </Grid>

        <shared:SharedPagination Grid.Row="6"
                                 HorizontalAlignment="Left"
                                 CurrentPage="{Binding CurrentPage}"
                                 TotalPages="{Binding TotalPages}"
                                 PageCommand="{Binding GoToPageCommand}" />
    </Grid>
</UserControl>
