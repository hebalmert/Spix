<UserControl x:Class="Spix.AppWpf.Views.EntitiesOper.Client.ClientFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             Width="850"
             MinWidth="850">
    <ScrollViewer MaxHeight="500" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,24,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Width="156" Height="156" HorizontalAlignment="Center" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1" CornerRadius="78" ClipToBounds="True">
                        <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" />
                    </Border>
                    <Button Margin="16,14,16,0" Click="SelectPhotoClick" Style="{StaticResource SharedButtonFormPrimary}">
                        <StackPanel Orientation="Horizontal"><fa:FontAwesomeImage Width="15" Height="15" Icon="{x:Static icons:FontAwesomeIcon.Image}" IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" /><TextBlock Margin="8,0,0,0" Text="Seleccionar foto" /></StackPanel>
                    </Button>
                </StackPanel>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Nombre" /></Border><TextBox Grid.Column="1" MinHeight="42" MaxLength="50" Padding="12,8" Background="White" BorderBrush="#566273" Text="{Binding Entity.FirstName, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Apellido" /></Border><TextBox Grid.Column="1" MinHeight="42" MaxLength="50" Padding="12,8" Background="White" BorderBrush="#566273" Text="{Binding Entity.LastName, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Tipo documento" /></Border><ComboBox Grid.Column="1" MinHeight="42" Padding="10,6" ItemsSource="{Binding DocumentTypes}" DisplayMemberPath="DocumentName" SelectedValuePath="DocumentTypeId" SelectedValue="{Binding Entity.DocumentTypeId, Mode=TwoWay}" /></Grid>
                    <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Documento" /></Border><TextBox Grid.Column="1" MinHeight="42" MaxLength="25" Padding="12,8" Background="White" BorderBrush="#566273" Text="{Binding Entity.Document, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                    <Grid Grid.Row="8"><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Telefono" /></Border><TextBox Grid.Column="1" MinHeight="42" MaxLength="25" Padding="12,8" Background="White" BorderBrush="#566273" Text="{Binding Entity.PhoneNumber, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                </Grid>
            </Grid>

            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Direccion" /></Border><TextBox Grid.Column="1" MinHeight="72" MaxLength="256" Padding="12,8" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="White" BorderBrush="#566273" Text="{Binding Entity.Address, UpdateSourceTrigger=PropertyChanged}" /></Grid>

            <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Correo" /></Border><TextBox Grid.Column="1" MinHeight="42" MaxLength="256" Padding="12,8" Background="White" BorderBrush="#566273" Text="{Binding Entity.Email, UpdateSourceTrigger=PropertyChanged}" /><Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Usuario" /></Border><TextBox Grid.Column="4" MinHeight="42" MaxLength="24" Padding="12,8" Background="White" BorderBrush="#566273" Text="{Binding Entity.UserName, UpdateSourceTrigger=PropertyChanged}" /></Grid>

            <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Activo" /></Border><Border Grid.Column="1" MinHeight="42" Background="White" BorderBrush="#566273" BorderThickness="1"><CheckBox Margin="14,0" VerticalAlignment="Center" IsChecked="{Binding Entity.Active}" Checked="ActiveChanged" Unchecked="ActiveChanged" Content="Activo" /></Border><Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Crear cuenta" /></Border><Border Grid.Column="4" MinHeight="42" Background="White" BorderBrush="#566273" BorderThickness="1" CornerRadius="0,6,6,0"><CheckBox Margin="14,0" VerticalAlignment="Center" IsEnabled="{Binding CanCreateAccount}" IsChecked="{Binding Entity.CreateAccount}" Content="Crear cuenta" /></Border></Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
