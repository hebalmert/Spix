<UserControl x:Class="Spix.AppWpf.Views.EntitiesMK.ConnectionMikrotikControl.CreateConnectionMikrotikControlDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:control="clr-namespace:Spix.AppWpf.Views.EntitiesMK.ConnectionMikrotikControl"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="28" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <control:ConnectionMikrotikControlFormView />
        <shared:SharedModalActions Grid.Row="2" CancelCommand="{Binding CancelCommand}" SaveCommand="{Binding SaveCommand}" />
        <shared:SharedLoading Grid.RowSpan="3" IsLoading="{Binding IsLoading}" />
    </Grid>
</UserControl>
