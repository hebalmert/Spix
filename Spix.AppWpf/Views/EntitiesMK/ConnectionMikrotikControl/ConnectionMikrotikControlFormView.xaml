<UserControl x:Class="Spix.AppWpf.Views.EntitiesMK.ConnectionMikrotikControl.ConnectionMikrotikControlFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="620">
    <Grid Margin="0,24,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Tipo control" /></Border>
        <ComboBox Grid.Column="1" MinHeight="42" Padding="12,6" ItemsSource="{Binding ControlTypes}" SelectedItem="{Binding Entity.MikrotikControlType, Mode=TwoWay}" />
    </Grid>
</UserControl>
