<UserControl x:Class="Spix.AppWpf.Views.EntitiesBilling.Sell.SellIndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:catalog="clr-namespace:Spix.AppWpf.SharedComponents.SharedCatalog"
             xmlns:rowbtn="clr-namespace:Spix.AppWpf.SharedComponents.SharedButtonRow"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents">

    <!-- Facturas: lo que se le facturo a cada cliente, plan mensual y solicitudes de servicio.

         Es de SOLA CONSULTA. La factura nace en el lanzamiento de la facturacion, no aqui:
         por eso no hay crear, editar, anular ni imprimir.

         El tablero es del MES EN CURSO y la tabla es TODO el historico: los numeros de
         arriba no tienen por que cuadrar con los de abajo. -->
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <Border Style="{StaticResource SharedIndexShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <UniformGrid Columns="4"
                         Margin="0,0,0,14"
                         Visibility="{Binding HasSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="Facturas del mes"
                                          Value="{Binding MonthCount}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="Facturado del mes"
                                          Value="{Binding MonthTotal, StringFormat=N2}"
                                          Accent="{DynamicResource BrushCatalogKpiOk}"
                                          ValueBrush="{DynamicResource BrushCatalogKpiOk}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="Pagadas"
                                          Value="{Binding MonthPaid}" />
                <catalog:SharedCatalogKpi Label="Anuladas"
                                          Value="{Binding MonthCancelled}"
                                          Accent="{DynamicResource BrushCatalogKpiBad}"
                                          ValueBrush="{DynamicResource BrushCatalogKpiBadText}" />
            </UniformGrid>

            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Width="38" Height="38"
                            Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SharedIndexIconButtonEdit}"
                            ToolTip="Actualizar (F5)">
                        <fa:FontAwesomeImage Width="14" Height="14"
                                             Foreground="{DynamicResource BrushIndexIconEdit}"
                                             Icon="{x:Static icons:FontAwesomeIcon.ArrowsRotate}"
                                             IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                    </Button>

                    <shared:SharedSearchFilter SearchText="{Binding Filter}"
                                               SearchCommand="{Binding SearchCommand}"
                                               ClearCommand="{Binding ClearSearchCommand}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource SharedIndexPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Border Style="{StaticResource SharedIndexHeaderBand}" />

                        <DataGrid x:Name="ItemsGrid"
                                  ItemsSource="{Binding Rows}"
                                  Style="{StaticResource SharedIndexGrid}"
                                  ColumnHeaderStyle="{StaticResource SharedIndexHeader}"
                                  RowStyle="{StaticResource SharedIndexRow}"
                                  CellStyle="{StaticResource SharedIndexCell}">

                            <DataGrid.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding DetailCommand}"
                                              CommandParameter="{Binding SelectedItem, ElementName=ItemsGrid}" />
                            </DataGrid.InputBindings>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="160" Header="Factura" SortMemberPath="InvoiceNumber">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding InvoiceNumber}" />
                                                <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding DateSellText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*" MinWidth="220" Header="Cliente" SortMemberPath="ClientFullName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding ClientFullName}" />
                                                <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding ContractText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="120" Header="Sub total" SortMemberPath="SubTotal">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Right"
                                                       Style="{StaticResource SharedIndexMeta}"
                                                       Text="{Binding SubTotal, StringFormat=N2}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="110" Header="Tax" SortMemberPath="TotalTax">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Right"
                                                       Style="{StaticResource SharedIndexMeta}"
                                                       Text="{Binding TotalTax, StringFormat=N2}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="130" Header="Total" SortMemberPath="Total">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Right"
                                                       Style="{StaticResource SharedIndexName}"
                                                       Text="{Binding Total, StringFormat=N2}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="120" Header="Estado" SortMemberPath="StatusText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Left"
                                                    Padding="10,4"
                                                    CornerRadius="6"
                                                    Background="{Binding StatusColor}">
                                                <TextBlock FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           Text="{Binding StatusText}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="Auto" MinWidth="90" Header="" CanUserSort="False" CellStyle="{StaticResource SharedIndexCellActions}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,6,0">
                                                <!-- El unico boton de fila, y siempre visible: tambien en las anuladas -->
                                                <rowbtn:SharedButtonRowEdit Command="{Binding DataContext.DetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}"
                                                                            Icon="{x:Static icons:FontAwesomeIcon.Receipt}"
                                                                            ToolTip="Detalle de la factura" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Rows, Converter={StaticResource CountToVisibilityConverter}}">
                            <fa:FontAwesomeImage Width="26" Height="26"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource BrushIndexMeta}"
                                                 Icon="{x:Static icons:FontAwesomeIcon.FileInvoiceDollar}"
                                                 IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource SharedIndexEmpty}"
                                       Text="No hay facturas para mostrar" />
                        </StackPanel>

                        <shared:SharedLoading IsLoading="{Binding IsLoading}" />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource SharedIndexPanelFoot}">
                        <shared:SharedPagination Foreground="{DynamicResource BrushCatalogMeta}"
                                                 CurrentPage="{Binding CurrentPage}"
                                                 TotalPages="{Binding TotalPages}"
                                                 PageCommand="{Binding GoToPageCommand}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
