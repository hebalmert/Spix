<UserControl x:Class="Spix.AppWpf.Views.EntitiesBilling.BillingNoteOne.BillingNoteOneFormDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             MinWidth="760">

    <!-- Crear o editar la nota: la fecha, el contrato ACTIVO y el periodo que se le cobra.

         Los datos del contrato (numero, direccion, ciudad, zona, telefono, plan y precio) son
         de solo lectura: salen del contrato elegido y no se escriben a mano.

         Guardar aqui NO mueve dinero: la nota queda Pendiente hasta que se lance. -->
    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="10" />
            <RowDefinition Height="Auto" /><RowDefinition Height="14" />
            <RowDefinition Height="Auto" /><RowDefinition Height="10" />
            <RowDefinition Height="Auto" /><RowDefinition Height="10" />
            <RowDefinition Height="Auto" /><RowDefinition Height="10" />
            <RowDefinition Height="Auto" /><RowDefinition Height="10" />
            <RowDefinition Height="Auto" /><RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" MinWidth="380" />
        </Grid.ColumnDefinitions>

        <!-- Fila 0: el buscador de contratos -->
        <Border Grid.Row="0" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Cliente" />
        </Border>
        <shared:SharedSearchPicker Grid.Row="0" Grid.Column="1"
                                   Text="{Binding SearchText, Mode=TwoWay}"
                                   Items="{Binding Candidates}"
                                   SearchCommand="{Binding SearchCommand}"
                                   SelectCommand="{Binding SelectCommand}">
            <shared:SharedSearchPicker.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding ClientFullName}" />
                            <TextBlock Style="{StaticResource SharedIndexMeta}">
                                <Run Text="Contrato " /><Run Text="{Binding ControlContrato, Mode=OneWay}" />
                                <Run Text=" · " /><Run Text="{Binding ZoneName, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock HorizontalAlignment="Right"
                                       Style="{StaticResource SharedIndexMeta}"
                                       Text="{Binding PlanName}" />
                            <TextBlock HorizontalAlignment="Right"
                                       Style="{StaticResource SharedIndexName}"
                                       Text="{Binding PlanPrice, StringFormat=N2}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </shared:SharedSearchPicker.ItemTemplate>
        </shared:SharedSearchPicker>

        <!-- Que este buscando, o que no haya ninguno, hay que DECIRLO: en silencio se ve
             igual que un buscador que no funciona -->
        <TextBlock Grid.Row="1" Grid.Column="1"
                   Margin="2,6,0,0"
                   Style="{StaticResource SharedIndexMeta}"
                   Text="Buscando..."
                   Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <TextBlock Grid.Row="1" Grid.Column="1"
                   Margin="2,6,0,0"
                   Style="{StaticResource SharedIndexMeta}"
                   Text="No hay contratos activos que coincidan."
                   Visibility="{Binding NoResults, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- La ficha del contrato elegido es la que manda: escribir en el buscador no la
             cambia, solo elegir de la lista -->
        <Border Grid.Row="3" Grid.ColumnSpan="2"
                Padding="14,10"
                CornerRadius="10"
                Background="{DynamicResource BrushCatalogCard}"
                BorderBrush="{DynamicResource BrushCatalogKpiBorder}"
                BorderThickness="1"
                Visibility="{Binding HasSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <fa:FontAwesomeImage Grid.RowSpan="3"
                                     Width="14" Height="14"
                                     Margin="0,4,12,0"
                                     VerticalAlignment="Top"
                                     Foreground="{DynamicResource BrushCatalogKpiAccent}"
                                     Icon="{x:Static icons:FontAwesomeIcon.CircleCheck}"
                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />

                <TextBlock Grid.Column="1"
                           Style="{StaticResource SharedIndexName}"
                           Text="{Binding SelectedText}" />

                <TextBlock Grid.Row="1" Grid.Column="1"
                           Style="{StaticResource SharedIndexMeta}"
                           TextWrapping="Wrap"
                           Text="{Binding AddressText}" />

                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource SharedIndexMeta}">
                    <Run Text="{Binding CityText, Mode=OneWay}" />
                    <Run Text=" · " /><Run Text="{Binding ZoneText, Mode=OneWay}" />
                    <Run Text=" · " /><Run Text="{Binding PhoneText, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Grid.Column="2"
                           Margin="12,0,0,0"
                           HorizontalAlignment="Right"
                           Style="{StaticResource SharedIndexMeta}"
                           Text="{Binding PlanText}" />

                <TextBlock Grid.Row="1" Grid.Column="2"
                           Margin="12,0,0,0"
                           HorizontalAlignment="Right"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource BrushCatalogKpiAccent}"
                           Text="{Binding PriceText}" />
            </Grid>
        </Border>

        <!-- Fila 5: la fecha de emision. Al cambiarla se reescriben el ano y el mes -->
        <Border Grid.Row="5" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Fecha" />
        </Border>
        <DatePicker Grid.Row="5" Grid.Column="1"
                    HorizontalAlignment="Left"
                    Width="180"
                    MinHeight="42"
                    SelectedDate="{Binding DateBill, Mode=TwoWay}"
                    SelectedDateFormat="Short" />

        <Border Grid.Row="7" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Ano" />
        </Border>
        <TextBox Grid.Row="7" Grid.Column="1"
                 HorizontalAlignment="Left"
                 Width="180"
                 MaxLength="4"
                 Style="{StaticResource SharedFormBox}"
                 Text="{Binding YearNumber, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

        <Border Grid.Row="9" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Mes" />
        </Border>
        <ComboBox Grid.Row="9" Grid.Column="1"
                  Style="{StaticResource SharedFormCombo}"
                  ItemsSource="{Binding Months}"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Value"
                  SelectedValue="{Binding SelectedMonth, Mode=TwoWay}" />

        <!-- Solo en la edicion: el estado de la nota se ve pero no se toca -->
        <Border Grid.Row="11" Style="{StaticResource SharedFormLabel}"
                Visibility="{Binding ShowCreated, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Creado" />
        </Border>
        <StackPanel Grid.Row="11" Grid.Column="1"
                    Orientation="Horizontal"
                    Visibility="{Binding ShowCreated, Converter={StaticResource BooleanToVisibilityConverter}}">
            <CheckBox VerticalAlignment="Center"
                      IsChecked="{Binding Created, Mode=OneWay}"
                      IsEnabled="False" />
            <TextBlock Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource SharedIndexMeta}"
                       Text="{Binding CreatedDateText}" />
        </StackPanel>

        <shared:SharedModalActions Grid.Row="13" Grid.ColumnSpan="2"
                                   SaveCommand="{Binding SaveCommand}"
                                   CancelCommand="{Binding CancelCommand}" />

        <shared:SharedLoading Grid.RowSpan="14" Grid.ColumnSpan="2" IsLoading="{Binding IsLoading}" />
    </Grid>
</UserControl>
