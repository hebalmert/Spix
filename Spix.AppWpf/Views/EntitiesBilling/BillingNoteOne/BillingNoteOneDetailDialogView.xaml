<UserControl x:Class="Spix.AppWpf.Views.EntitiesBilling.BillingNoteOne.BillingNoteOneDetailDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:catalog="clr-namespace:Spix.AppWpf.SharedComponents.SharedCatalog"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             MinWidth="780">

    <!-- El detalle de la nota y el sitio donde se LANZA.

         Mientras la nota esta pendiente se pide al servidor que se le va a cobrar y que le
         falta al contrato. Si falta algo se pintan las etiquetas rojas y el boton de lanzar
         ni siquiera aparece: no hay forma de forzarlo desde la pantalla.

         Una nota ya lanzada no consulta nada: solo se ve la ficha. -->
    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- La ficha: de quien es la nota y por que periodo -->
        <Border Margin="0,0,0,14"
                Padding="14,10"
                CornerRadius="12"
                Background="{DynamicResource BrushCatalogCard}"
                BorderBrush="{DynamicResource BrushCatalogKpiBorder}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding ClientName}" />

                <TextBlock Grid.Row="1" Style="{StaticResource SharedIndexMeta}">
                    <Run Text="{Binding ContractText, Mode=OneWay}" />
                    <Run Text=" · " /><Run Text="{Binding DateBillText, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Grid.Row="2"
                           Style="{StaticResource SharedIndexMeta}"
                           TextWrapping="Wrap">
                    <Run Text="{Binding AddressText, Mode=OneWay}" />
                    <Run Text=" · " /><Run Text="{Binding PlaceText, Mode=OneWay}" />
                    <Run Text=" · " /><Run Text="{Binding PhoneText, Mode=OneWay}" />
                </TextBlock>

                <StackPanel Grid.Column="1" Grid.RowSpan="3" Margin="16,0,0,0">
                    <Border HorizontalAlignment="Right"
                            Padding="11,3"
                            CornerRadius="999"
                            Background="{DynamicResource BrushIndexPillOnBack}">
                        <TextBlock FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushIndexPillOnText}"
                                   Text="{Binding PeriodText}" />
                    </Border>

                    <TextBlock Margin="0,8,0,0"
                               HorizontalAlignment="Right"
                               Style="{StaticResource SharedIndexMeta}"
                               Text="{Binding PlanText}" />

                    <TextBlock HorizontalAlignment="Right"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushCatalogKpiAccent}"
                               Text="{Binding PriceText}" />

                    <!-- Solo cuando la nota ya se lanzo: cuando quedo cerrada -->
                    <TextBlock Margin="0,8,0,0"
                               HorizontalAlignment="Right"
                               Style="{StaticResource SharedIndexMeta}"
                               Visibility="{Binding Created, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Run Text="Lanzada el " /><Run Text="{Binding CreatedDateText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Lo que se le va a cobrar: solo existe mientras la nota este pendiente -->
        <Grid Grid.Row="1"
              Margin="0,0,0,8"
              Visibility="{Binding HasCheck, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <fa:FontAwesomeImage Width="14" Height="14"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource BrushCatalogKpiAccent}"
                                     Icon="{x:Static icons:FontAwesomeIcon.Receipt}"
                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />

                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource SharedIndexName}"
                           Text="Lo que se le va a cobrar" />
            </StackPanel>

            <!-- Lo que le falta al contrato, cada falta en su etiqueta -->
            <ItemsControl Grid.Column="1"
                          Margin="16,0,0,0"
                          HorizontalAlignment="Right"
                          ItemsSource="{Binding Blocks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Right" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="6,3,0,3"
                                Padding="10,2"
                                CornerRadius="999"
                                Background="{DynamicResource BrushCatalogKpiBad}">
                            <TextBlock FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Text="{Binding}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Border Grid.Row="2" MinHeight="120"
                Style="{StaticResource SharedIndexPanel}"
                Visibility="{Binding HasCheck, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Border Style="{StaticResource SharedIndexHeaderBand}" />

                <DataGrid ItemsSource="{Binding Lines}"
                          Style="{StaticResource SharedIndexGrid}"
                          ColumnHeaderStyle="{StaticResource SharedIndexHeader}"
                          RowStyle="{StaticResource SharedIndexRow}"
                          CellStyle="{StaticResource SharedIndexCell}">

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="*" MinWidth="280" Header="Concepto" SortMemberPath="Concept">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SharedIndexName}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Concept}" />
                                        <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding OriginName}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="140" Header="Total" SortMemberPath="Price">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Right"
                                               Style="{StaticResource SharedIndexName}"
                                               Text="{Binding Price, StringFormat=N2}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- El cruce: lo que suma, lo que ya pago, lo que se le exonera y lo que queda -->
        <UniformGrid Grid.Row="3" Columns="4"
                     Margin="0,14,0,0"
                     Visibility="{Binding HasCheck, Converter={StaticResource BooleanToVisibilityConverter}}">
            <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                      Label="Total"
                                      Value="{Binding Total, StringFormat=N2}" />
            <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                      Label="Pago adelantado"
                                      Value="{Binding PrePayment, StringFormat=N2}"
                                      Accent="{DynamicResource BrushCatalogKpiOk}"
                                      ValueBrush="{DynamicResource BrushCatalogKpiOk}" />
            <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                      Label="Exoneracion"
                                      Value="{Binding Exonerated, StringFormat=N2}" />
            <catalog:SharedCatalogKpi Label="Saldo"
                                      Value="{Binding Balance, StringFormat=N2}"
                                      Accent="{DynamicResource BrushCatalogKpiWarn}"
                                      ValueBrush="{DynamicResource BrushCatalogKpiWarnText}" />
        </UniformGrid>

        <!-- Si hay algo que la bloquee hay que decirlo: el boton de lanzar simplemente no
             esta, y sin este aviso la pantalla parece rota -->
        <Border Grid.Row="4"
                Margin="0,12,0,0"
                Padding="10,8"
                CornerRadius="8"
                Background="{DynamicResource BrushCatalogKpiBad}"
                Visibility="{Binding HasBlocks, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <fa:FontAwesomeImage Width="14" Height="14"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center"
                                     Foreground="White"
                                     Icon="{x:Static icons:FontAwesomeIcon.TriangleExclamation}"
                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />

                <TextBlock VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Text="Esta nota todavia no se puede lanzar." />
            </StackPanel>
        </Border>

        <shared:SharedModalActions Grid.Row="5"
                                   Margin="0,20,0,0"
                                   ShowSave="{Binding CanLaunch}"
                                   SaveText="Nota de Cobro Individual"
                                   SaveIcon="{x:Static icons:FontAwesomeIcon.ClipboardCheck}"
                                   SaveCommand="{Binding LaunchCommand}"
                                   CancelCommand="{Binding CancelCommand}" />

        <shared:SharedLoading Grid.RowSpan="6" IsLoading="{Binding IsLoading}" />
    </Grid>
</UserControl>
