<UserControl x:Class="Spix.AppWpf.Views.EntitiesBilling.BillingNote.BillingNoteDetailDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             MinWidth="760">

    <!-- El detalle de la nota general y, sobre todo, su LANZAMIENTO.

         La revision y la barra de avance no estan al abrir: aparecen al pulsar Lanzar. La
         revision dice que contratos activos quedan fuera por estar incompletos, y la barra
         avanza de a LOTE de 25, no de a contrato, porque cada lote es un viaje al servidor.

         Si la nota ya fue lanzada solo queda Volver. -->
    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Periodo" />
        </Border>
        <TextBox Grid.Column="1"
                 IsEnabled="False"
                 Style="{StaticResource SharedFormBox}"
                 Text="{Binding PeriodText, Mode=OneWay}" />

        <Border Grid.Row="2" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Fecha" />
        </Border>
        <TextBox Grid.Row="2" Grid.Column="1"
                 IsEnabled="False"
                 Style="{StaticResource SharedFormBox}"
                 Text="{Binding DateBillText, Mode=OneWay}" />

        <Border Grid.Row="4" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Lanzada" />
        </Border>
        <Grid Grid.Row="4" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox IsEnabled="False"
                     Style="{StaticResource SharedFormBox}"
                     Text="{Binding CreatedText, Mode=OneWay}" />

            <TextBox Grid.Column="2"
                     IsEnabled="False"
                     Style="{StaticResource SharedFormBox}"
                     Text="{Binding DateCreatedText, Mode=OneWay}" />
        </Grid>

        <!-- La revision de los contratos: solo despues de pulsar Lanzar -->
        <Border Grid.Row="6" Grid.ColumnSpan="2"
                Margin="0,8,0,0"
                Padding="14,12"
                CornerRadius="12"
                Background="{DynamicResource BrushCatalogCard}"
                BorderBrush="{DynamicResource BrushCatalogKpiBorder}"
                BorderThickness="1"
                Visibility="{Binding HasChecks, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <fa:FontAwesomeImage Width="14" Height="14"
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource BrushCatalogKpiAccent}"
                                         Icon="{x:Static icons:FontAwesomeIcon.ClipboardCheck}"
                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />

                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource SharedIndexName}"
                               Text="Revision de contratos" />
                </StackPanel>

                <TextBlock Margin="24,4,0,0"
                           Style="{StaticResource SharedIndexMeta}"
                           Text="{Binding CheckSummaryText}" />

                <StackPanel Margin="24,10,0,0"
                            Orientation="Horizontal"
                            Visibility="{Binding AllGood, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <fa:FontAwesomeImage Width="13" Height="13"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource BrushCatalogKpiOk}"
                                         Icon="{x:Static icons:FontAwesomeIcon.CircleCheck}"
                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />

                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource SharedIndexMeta}"
                               Text="Todos los contratos activos estan listos para cobrar." />
                </StackPanel>

                <!-- La lista puede ser larga: se le pone techo y se deja rodar -->
                <ScrollViewer Margin="24,10,0,0"
                              MaxHeight="220"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Incomplete}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding Title}" />
                                    <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding ZoneName}" />
                                    <TextBlock Style="{StaticResource SharedIndexMeta}"
                                               Foreground="{DynamicResource BrushCatalogKpiBadText}"
                                               TextWrapping="Wrap"
                                               Text="{Binding MissingText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- El avance del lanzamiento -->
        <Grid Grid.Row="7" Grid.ColumnSpan="2"
              Margin="0,14,0,0"
              Visibility="{Binding ShowProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock HorizontalAlignment="Left"
                       Style="{StaticResource SharedIndexMeta}"
                       Text="{Binding ProgressText}" />

            <TextBlock HorizontalAlignment="Right"
                       Style="{StaticResource SharedIndexName}"
                       Text="{Binding PercentText}" />

            <ProgressBar Grid.Row="1"
                         Height="10"
                         Margin="0,8,0,0"
                         Maximum="100"
                         Style="{StaticResource SharedIndexProgress}"
                         Value="{Binding Percent, Mode=OneWay}" />
        </Grid>

        <shared:SharedModalActions Grid.Row="10" Grid.ColumnSpan="2"
                                   SaveText="Lanzar"
                                   SaveIcon="{x:Static icons:FontAwesomeIcon.PaperPlane}"
                                   SaveCommand="{Binding LaunchCommand}"
                                   CancelCommand="{Binding CancelCommand}"
                                   ShowSave="{Binding CanLaunch}" />

        <shared:SharedLoading Grid.RowSpan="11" Grid.ColumnSpan="2" IsLoading="{Binding IsLoading}" />
    </Grid>
</UserControl>
