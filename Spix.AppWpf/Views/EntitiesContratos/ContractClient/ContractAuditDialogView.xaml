<UserControl x:Class="Spix.AppWpf.Views.EntitiesContratos.ContractClient.ContractAuditDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             MinWidth="760">

    <!-- La bitacora del contrato: creacion, estados, firmas, suspensiones y exoneraciones,
         en una sola linea de tiempo. Solo se consulta. -->
    <Grid Margin="0,16,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- De cual contrato es -->
        <Border Style="{StaticResource SharedIndexShell}"
                Padding="16,12"
                Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SharedIndexName}" FontSize="16" Text="{Binding Header}" />
                <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding SubHeader}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SharedIndexShell}" Padding="16,14">
            <Grid>
                <ScrollViewer MaxHeight="380"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Events}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- El punto de la linea de tiempo -->
                                    <Ellipse Width="10" Height="10"
                                             Margin="0,6,12,0"
                                             VerticalAlignment="Top"
                                             Fill="{DynamicResource BrushCatalogKpiAccent}" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding When}" />
                                        <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding What}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource SharedIndexMeta}"
                                                   Text="{Binding Detail}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Style="{StaticResource SharedIndexMeta}"
                                                   Text="{Binding Who}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource SharedIndexEmpty}"
                           Text="Este contrato todavia no tiene movimientos"
                           Visibility="{Binding HasEvents, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                <shared:SharedLoading IsLoading="{Binding IsLoading}" />
            </Grid>
        </Border>

        <shared:SharedModalActions Grid.Row="4"
                                   ShowSave="False"
                                   CancelCommand="{Binding CloseCommand}" />
    </Grid>
</UserControl>
