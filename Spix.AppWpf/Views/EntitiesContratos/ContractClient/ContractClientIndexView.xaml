<UserControl x:Class="Spix.AppWpf.Views.EntitiesContratos.ContractClient.ContractClientIndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Spix.AppWpf.SharedServices"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:rowbtn="clr-namespace:Spix.AppWpf.SharedComponents.SharedButtonRow"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents">

    <!-- Contratos de los clientes, replicado del index de Blazor.
         El contrato no es un registro suelto: es un expediente. De cada fila cuelgan las
         fotos del documento, el Consentimiento, el Contrato y su bitacora, y por eso la
         fila tiene siete botones. Cuatro de ellos solo salen cuando toca: aprobar, pedir
         la firma, y el de las fotos cambia de crear a editar.

         El filtro de estado SOLO ofrece los tres en que el contrato se esta armando
         (Borrador, Pendiente de aprobacion, En proceso), igual que la web: los demas se
         ven desde Control de contratos. -->
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <Border Style="{StaticResource SharedIndexShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Margin="0,0,12,0"
                            Command="{Binding NewCommand}"
                            Style="{StaticResource SharedIndexNewButton}"
                            ToolTip="Crear un contrato (Ctrl+N)"
                            svc:FormButton.Icon="{x:Static icons:FontAwesomeIcon.Plus}"
                            Content="Nuevo" />

                    <!-- Filtro por estado: la lista la arma el ViewModel con los nombres
                         del archivo de traducciones compartido -->
                    <fa:FontAwesomeImage Width="14" Height="14"
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource BrushIndexIconEdit}"
                                         Icon="{x:Static icons:FontAwesomeIcon.Filter}"
                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />

                    <ComboBox Width="230"
                              Style="{StaticResource SharedFormCombo}"
                              ItemsSource="{Binding Statuses}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding StatusFilter, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Width="38" Height="38"
                            Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SharedIndexIconButtonEdit}"
                            ToolTip="Actualizar (F5)">
                        <fa:FontAwesomeImage Width="14" Height="14"
                                             Foreground="{DynamicResource BrushIndexIconEdit}"
                                             Icon="{x:Static icons:FontAwesomeIcon.ArrowsRotate}"
                                             IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                    </Button>

                    <shared:SharedSearchFilter SearchText="{Binding Filter}"
                                               SearchCommand="{Binding SearchCommand}"
                                               ClearCommand="{Binding ClearSearchCommand}" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1"
                       Margin="0,0,0,10"
                       Style="{StaticResource SharedCatalogMessage}"
                       Text="{Binding Message}"
                       Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Border Grid.Row="2" Style="{StaticResource SharedIndexPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Border Style="{StaticResource SharedIndexHeaderBand}" />

                        <DataGrid x:Name="ItemsGrid"
                                  ItemsSource="{Binding Rows}"
                                  Style="{StaticResource SharedIndexGrid}"
                                  ColumnHeaderStyle="{StaticResource SharedIndexHeader}"
                                  RowStyle="{StaticResource SharedIndexRow}"
                                  CellStyle="{StaticResource SharedIndexCell}">

                            <DataGrid.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding EditCommand}"
                                              CommandParameter="{Binding SelectedItem, ElementName=ItemsGrid}" />
                            </DataGrid.InputBindings>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="110" Header="Contrato" SortMemberPath="Number">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding Number}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*" Header="Cliente" SortMemberPath="ClientName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding ClientName}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="200" Header="Contratista" SortMemberPath="ContractorName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexMeta}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding ContractorName}"
                                                       ToolTip="{Binding ContractorName}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="90" Header="Estrato" SortMemberPath="Stratum">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center"
                                                       Style="{StaticResource SharedIndexMeta}"
                                                       Text="{Binding Stratum}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="90" Header="Equipo" SortMemberPath="HasEquipment">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <shared:SharedFlag HorizontalAlignment="Center" IsOn="{Binding HasEquipment}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="90" Header="Factura" SortMemberPath="HasInvoice">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <shared:SharedFlag HorizontalAlignment="Center" IsOn="{Binding HasInvoice}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="170" Header="Estado" SortMemberPath="StatusText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Left"
                                                    Padding="10,4"
                                                    CornerRadius="6"
                                                    Background="{Binding StatusColor}">
                                                <TextBlock FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           Text="{Binding StatusText}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="Auto" MinWidth="290" Header="" CanUserSort="False" CellStyle="{StaticResource SharedIndexCellActions}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,6,0">
                                                <!-- La bitacora no ocupa columna: se consulta aqui -->
                                                <rowbtn:SharedButtonRowEdit Command="{Binding DataContext.AuditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}"
                                                                            Icon="{x:Static icons:FontAwesomeIcon.ClockRotateLeft}"
                                                                            ToolTip="Bitacora del contrato" />

                                                <!-- Solo con fotos, Consentimiento y Contrato firmados -->
                                                <rowbtn:SharedButtonRowSuccess Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                               CommandParameter="{Binding}"
                                                                               Icon="{x:Static icons:FontAwesomeIcon.CircleCheck}"
                                                                               ToolTip="Aprobar: pasar a En proceso"
                                                                               Visibility="{Binding CanApprove, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                <!-- Solo mientras falte firmar algo -->
                                                <rowbtn:SharedButtonRowEdit Command="{Binding DataContext.RequestSignatureCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}"
                                                                            Icon="{x:Static icons:FontAwesomeIcon.PaperPlane}"
                                                                            ToolTip="Enviar la solicitud de firma al cliente"
                                                                            Visibility="{Binding CanRequestSignature, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                <!-- El mismo boton crea o edita, segun si ya tiene fotos -->
                                                <rowbtn:SharedButtonRowEdit Command="{Binding DataContext.IdPicsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}"
                                                                            Icon="{x:Static icons:FontAwesomeIcon.IdCard}"
                                                                            ToolTip="{Binding IdPicsTooltip}" />

                                                <rowbtn:SharedButtonRowSuccess Command="{Binding DataContext.ConsentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                               CommandParameter="{Binding}"
                                                                               Icon="{x:Static icons:FontAwesomeIcon.FileSignature}"
                                                                               ToolTip="Consentimiento" />

                                                <rowbtn:SharedButtonRowEdit Command="{Binding DataContext.ContractCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}"
                                                                            Icon="{x:Static icons:FontAwesomeIcon.FileContract}"
                                                                            ToolTip="Contrato" />

                                                <rowbtn:SharedButtonRowEdit Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="Editar" />

                                                <rowbtn:SharedButtonRowDelete Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                              CommandParameter="{Binding}"
                                                                              ToolTip="Eliminar" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Rows, Converter={StaticResource CountToVisibilityConverter}}">
                            <fa:FontAwesomeImage Width="26" Height="26"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource BrushIndexMeta}"
                                                 Icon="{x:Static icons:FontAwesomeIcon.FileContract}"
                                                 IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource SharedIndexEmpty}"
                                       Text="No hay contratos con este filtro" />
                            <Button Margin="0,14,0,0"
                                    HorizontalAlignment="Center"
                                    Command="{Binding NewCommand}"
                                    Style="{StaticResource SharedIndexNewButton}"
                                    ToolTip="Crear el primero"
                                    svc:FormButton.Icon="{x:Static icons:FontAwesomeIcon.Plus}"
                                    Content="Crear un contrato" />
                        </StackPanel>

                        <shared:SharedLoading IsLoading="{Binding IsLoading}" />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource SharedIndexPanelFoot}">
                        <shared:SharedPagination Foreground="{DynamicResource BrushCatalogMeta}"
                                                 CurrentPage="{Binding CurrentPage}"
                                                 TotalPages="{Binding TotalPages}"
                                                 TotalRecords="{Binding TotalRecords}"
                                                 PageCommand="{Binding GoToPageCommand}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
