<UserControl x:Class="Spix.AppWpf.Views.EntitiesContratos.ContractClient.ContractClientFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             MinWidth="960">

    <!-- El formulario del contrato, replicado del FormContractClient de la web.
         Al elegir el cliente se copian su telefono y su direccion: el contrato nace con
         los datos del cliente. El correo NO se edita, es el del cliente y es a donde le
         llega la solicitud de firma. -->
    <Grid Margin="0,20,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" MinWidth="230" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" MinWidth="230" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Se escribe y caen los clientes que coinciden -->
        <Border Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Cliente" />
        </Border>
        <shared:SharedSearchPicker Grid.Column="1"
                                   Text="{Binding ClientFilter, Mode=TwoWay}"
                                   Items="{Binding Clients}"
                                   SearchCommand="{Binding SearchClientsCommand}"
                                   SelectCommand="{Binding SelectClientCommand}">
            <shared:SharedSearchPicker.ItemTemplate>
                <DataTemplate>
                    <TextBlock Margin="4" Style="{StaticResource SharedIndexName}" Text="{Binding Name}" />
                </DataTemplate>
            </shared:SharedSearchPicker.ItemTemplate>
        </shared:SharedSearchPicker>

        <Border Grid.Column="3" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Contratista" />
        </Border>
        <ComboBox Grid.Column="4"
                  Style="{StaticResource SharedFormCombo}"
                  ItemsSource="{Binding Contractors}"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Value"
                  SelectedValue="{Binding Entity.ContractorId, Mode=TwoWay}" />

        <!-- El plan, en cascada: primero la categoria y despues el plan de esa categoria.
             Mode=OneWay + SelectionChanged porque al recargar la lista de planes WPF
             dispara el evento solo, y con TwoWay se borraria el valor guardado. -->
        <Border Grid.Row="2" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Categoria Plan" />
        </Border>
        <ComboBox Grid.Row="2" Grid.Column="1"
                  Style="{StaticResource SharedFormCombo}"
                  ItemsSource="{Binding PlanCategories}"
                  DisplayMemberPath="PlanCategoryName"
                  SelectedValuePath="PlanCategoryId"
                  SelectedValue="{Binding Entity.PlanCategoryId, Mode=OneWay}"
                  SelectionChanged="PlanCategorySelectionChanged" />

        <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Plan" />
        </Border>
        <ComboBox Grid.Row="2" Grid.Column="4"
                  Style="{StaticResource SharedFormCombo}"
                  ItemsSource="{Binding Plans}"
                  DisplayMemberPath="PlanName"
                  SelectedValuePath="PlanId"
                  SelectedValue="{Binding Entity.PlanId, Mode=OneWay}"
                  SelectionChanged="PlanSelectionChanged" />

        <!-- Los datos del plan elegido: velocidad, precio y tasa de rehuso, igual que la web -->
        <Border Grid.Row="4" Grid.ColumnSpan="5"
                Padding="12,8"
                CornerRadius="8"
                Background="#E9F0FB"
                BorderBrush="#CFDCEF"
                BorderThickness="1"
                Visibility="{Binding HasPlan, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <fa:FontAwesomeImage Width="13" Height="13" VerticalAlignment="Center"
                                     Foreground="#33456B"
                                     Icon="{x:Static icons:FontAwesomeIcon.GaugeHigh}"
                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                <TextBlock Margin="7,0,18,0" VerticalAlignment="Center" Foreground="#33456B" FontSize="13"
                           Text="{Binding SelectedPlan.VelocidadTotal}" />

                <fa:FontAwesomeImage Width="13" Height="13" VerticalAlignment="Center"
                                     Foreground="#33456B"
                                     Icon="{x:Static icons:FontAwesomeIcon.MoneyBill}"
                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                <TextBlock Margin="7,0,18,0" VerticalAlignment="Center" Foreground="#33456B" FontSize="13"
                           Text="{Binding SelectedPlan.PrecioconImpuesto, StringFormat=N2}" />

                <fa:FontAwesomeImage Width="13" Height="13" VerticalAlignment="Center"
                                     Foreground="#33456B"
                                     Icon="{x:Static icons:FontAwesomeIcon.Users}"
                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Foreground="#33456B" FontSize="13"
                           Text="{Binding SelectedPlan.TasaReuso, StringFormat=Tasa de rehuso {0}}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="6" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Telefono" />
        </Border>
        <!-- El telefono en sus tres partes: pais, operador y numero. Van en un Grid
             anidado para ocupar la misma celda que ocupaba la caja unica. -->
        <Grid Grid.Row="6" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox MaxLength="6"
                     Style="{StaticResource SharedFormBox}"
                     ToolTip="Indicativo del pais, por ejemplo +57"
                     Text="{Binding Entity.CodeCountry, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Grid.Column="1"
                     MaxLength="6"
                     Style="{StaticResource SharedFormBox}"
                     ToolTip="Indicativo del operador, por ejemplo 300"
                     Text="{Binding Entity.CodeNumber, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Grid.Column="2"
                     MaxLength="25"
                     Style="{StaticResource SharedFormBox}"
                     ToolTip="Numero, por ejemplo 3675815"
                     Text="{Binding Entity.PhoneNumber, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Border Grid.Row="6" Grid.Column="3" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Telefono 2" />
        </Border>
        <!-- El telefono en sus tres partes: pais, operador y numero. Van en un Grid
             anidado para ocupar la misma celda que ocupaba la caja unica. -->
        <Grid Grid.Row="6" Grid.Column="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox MaxLength="6"
                     Style="{StaticResource SharedFormBox}"
                     ToolTip="Indicativo del pais, por ejemplo +57"
                     Text="{Binding Entity.CodeCountry2, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Grid.Column="1"
                     MaxLength="6"
                     Style="{StaticResource SharedFormBox}"
                     ToolTip="Indicativo del operador, por ejemplo 300"
                     Text="{Binding Entity.CodeNumber2, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Grid.Column="2"
                     MaxLength="25"
                     Style="{StaticResource SharedFormBox}"
                     ToolTip="Numero, por ejemplo 3675815"
                     Text="{Binding Entity.PhoneNumber2, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- El correo es el del cliente: aqui solo se ve -->
        <Border Grid.Row="8" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Correo" />
        </Border>
        <StackPanel Grid.Row="8" Grid.Column="1">
            <TextBox IsEnabled="False"
                     Style="{StaticResource SharedFormBox}"
                     Text="{Binding ClientEmail, Mode=OneWay}" />
            <TextBlock Margin="2,4,0,0"
                       Style="{StaticResource SharedIndexMeta}"
                       Text="Es a donde le llega la solicitud de firma"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="8" Grid.Column="3" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Direccion" />
        </Border>
        <TextBox Grid.Row="8" Grid.Column="4"
                 MinHeight="72"
                 MaxLength="256"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 VerticalAlignment="Top"
                 Style="{StaticResource SharedFormBox}"
                 Text="{Binding Entity.Address, UpdateSourceTrigger=PropertyChanged}" />

        <!-- Estado, ciudad y zona van en cascada -->
        <Border Grid.Row="10" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Estado" />
        </Border>
        <ComboBox Grid.Row="10" Grid.Column="1"
                  Style="{StaticResource SharedFormCombo}"
                  ItemsSource="{Binding States}"
                  DisplayMemberPath="Name"
                  SelectedValuePath="StateId"
                  SelectedValue="{Binding Entity.StateId, Mode=OneWay}"
                  SelectionChanged="StateSelectionChanged" />

        <Border Grid.Row="10" Grid.Column="3" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Ciudad" />
        </Border>
        <ComboBox Grid.Row="10" Grid.Column="4"
                  Style="{StaticResource SharedFormCombo}"
                  ItemsSource="{Binding Cities}"
                  DisplayMemberPath="Name"
                  SelectedValuePath="CityId"
                  SelectedValue="{Binding Entity.CityId, Mode=OneWay}"
                  SelectionChanged="CitySelectionChanged" />

        <Border Grid.Row="12" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Zona" />
        </Border>
        <ComboBox Grid.Row="12" Grid.Column="1"
                  Style="{StaticResource SharedFormCombo}"
                  ItemsSource="{Binding Zones}"
                  DisplayMemberPath="ZoneName"
                  SelectedValuePath="ZoneId"
                  SelectedValue="{Binding Entity.ZoneId, Mode=TwoWay}" />

        <Border Grid.Row="12" Grid.Column="3" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Estrato" />
        </Border>
        <ComboBox Grid.Row="12" Grid.Column="4"
                  Style="{StaticResource SharedFormCombo}"
                  ItemsSource="{Binding Stratums}"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Value"
                  SelectedValue="{Binding Entity.EstratoSocialId, Mode=TwoWay}" />

        <!-- El estado del contrato solo se toca mientras se esta armando -->
        <Border Grid.Row="14" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Estado del contrato" />
        </Border>
        <Grid Grid.Row="14" Grid.Column="1">
            <ComboBox Style="{StaticResource SharedFormCombo}"
                      ItemsSource="{Binding Statuses}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding StatusValue, Mode=TwoWay}"
                      Visibility="{Binding StatusEditable, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <StackPanel Visibility="{Binding StatusReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border MinHeight="42"
                        Padding="14,0"
                        Style="{StaticResource SharedFormBoxBorder}">
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource SharedIndexName}"
                               Text="{Binding StatusText}" />
                </Border>
                <TextBlock Margin="2,4,0,0"
                           Style="{StaticResource SharedIndexMeta}"
                           Text="Ya esta operativo: el estado se cambia desde Control de contratos"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="14" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Top">
            <Border MinHeight="42" Margin="0,0,12,0" Padding="14,0" Style="{StaticResource SharedFormBoxBorder}">
                <CheckBox VerticalAlignment="Center"
                          IsChecked="{Binding Entity.EquipoEmpres}"
                          Content="Equipo de la empresa" />
            </Border>
            <Border MinHeight="42" Padding="14,0" Style="{StaticResource SharedFormBoxBorder}">
                <CheckBox VerticalAlignment="Center"
                          IsChecked="{Binding Entity.EnvoiceClient}"
                          Content="Factura al cliente" />
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
