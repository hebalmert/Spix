<UserControl x:Class="Spix.AppWpf.Views.EntitiesContratos.ContractControl.ContractChangeStateDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             MinWidth="680">

    <!-- El unico punto donde se cambia el estado del contrato, porque esta pantalla es la
         que administra el MikroTik: no puede quedar suspendido y con servicio.
         Las transiciones permitidas las decide el BACKEND segun el estado actual: aqui no
         se arma ninguna regla. -->
    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Estado actual" />
        </Border>
        <TextBox Grid.Column="1"
                 IsEnabled="False"
                 Style="{StaticResource SharedFormBox}"
                 Text="{Binding CurrentStateText, Mode=OneWay}" />

        <Border Grid.Row="2" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Estado nuevo" />
        </Border>
        <Grid Grid.Row="2" Grid.Column="1">
            <ComboBox Style="{StaticResource SharedFormCombo}"
                      ItemsSource="{Binding States}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding NewState, Mode=TwoWay}"
                      Visibility="{Binding HasTransitions, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource SharedIndexMeta}"
                       Text="Desde este estado no hay ningun cambio permitido."
                       TextWrapping="Wrap"
                       Visibility="{Binding HasNoTransitions, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Motivo" />
        </Border>
        <TextBox Grid.Row="4" Grid.Column="1"
                 MinHeight="72"
                 MaxLength="256"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Style="{StaticResource SharedFormBox}"
                 Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />

        <shared:SharedModalActions Grid.Row="6" Grid.ColumnSpan="2"
                                   SaveText="Cambiar el estado"
                                   SaveCommand="{Binding SaveCommand}"
                                   CancelCommand="{Binding CancelCommand}"
                                   ShowSave="{Binding HasTransitions}" />

        <shared:SharedLoading Grid.RowSpan="7" Grid.ColumnSpan="2" IsLoading="{Binding IsLoading}" />
    </Grid>
</UserControl>
