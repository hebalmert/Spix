<UserControl x:Class="Spix.AppWpf.Views.EntitiesContratos.ContractControl.ContractServerDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             MinWidth="620">

    <!-- El servidor Gateway: se elige uno de la lista y se guarda.
         La lista la arma el backend; aqui solo se pinta. -->
    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SharedFormLabel}">
                <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Servidor" />
            </Border>
            <ComboBox Grid.Column="1"
                      Style="{StaticResource SharedFormCombo}"
                      ItemsSource="{Binding Options}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedValue, Mode=TwoWay}" />
        </Grid>

        <shared:SharedModalActions Grid.Row="2"
                                   SaveCommand="{Binding SaveCommand}"
                                   CancelCommand="{Binding CancelCommand}" />

        <shared:SharedLoading Grid.RowSpan="3" IsLoading="{Binding IsLoading}" />
    </Grid>
</UserControl>
