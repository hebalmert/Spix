<UserControl x:Class="Spix.AppWpf.Views.EntitiesContratos.ContractControl.ContractMacDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             MinWidth="620">

    <!-- La MAC del equipo, en cascada: Categoria equipo -> Equipo -> MAC.
         Las tres listas las arma el backend y solo traen lo que tiene seriales disponibles.
         Los combos van en OneWay + SelectionChanged, NO en TwoWay: con TwoWay el enlace
         escribe el valor antes de que llegue el evento y el hijo nunca se recarga. -->
    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SharedFormLabel}">
                <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Categoria equipo" />
            </Border>
            <ComboBox Grid.Column="1"
                      Style="{StaticResource SharedFormCombo}"
                      ItemsSource="{Binding Categories}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedCategoryId, Mode=OneWay}"
                      SelectionChanged="CategorySelectionChanged" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SharedFormLabel}">
                <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Equipo" />
            </Border>
            <ComboBox Grid.Column="1"
                      Style="{StaticResource SharedFormCombo}"
                      IsEnabled="{Binding CanChooseProduct}"
                      ItemsSource="{Binding Products}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedProductId, Mode=OneWay}"
                      SelectionChanged="ProductSelectionChanged" />
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SharedFormLabel}">
                <TextBlock Style="{StaticResource SharedFormLabelText}" Text="MAC" />
            </Border>
            <ComboBox Grid.Column="1"
                      Style="{StaticResource SharedFormCombo}"
                      IsEnabled="{Binding CanChooseMac}"
                      ItemsSource="{Binding Macs}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedMacId, Mode=OneWay}"
                      SelectionChanged="MacSelectionChanged" />
        </Grid>

        <shared:SharedModalActions Grid.Row="6"
                                   SaveCommand="{Binding SaveCommand}"
                                   CancelCommand="{Binding CancelCommand}" />

        <shared:SharedLoading Grid.RowSpan="7" IsLoading="{Binding IsLoading}" />
    </Grid>
</UserControl>
