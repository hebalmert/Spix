<UserControl x:Class="Spix.AppWpf.Views.EntitiesContratos.ContractControl.ContractPlanDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             MinWidth="680">

    <!-- El plan del cliente: primero la categoria y luego el plan de esa categoria. -->
    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Categoria" />
        </Border>
        <ComboBox Grid.Column="1"
                  Style="{StaticResource SharedFormCombo}"
                  ItemsSource="{Binding Categories}"
                  DisplayMemberPath="PlanCategoryName"
                  SelectedValuePath="PlanCategoryId"
                  SelectedValue="{Binding SelectedCategoryId, Mode=OneWay}"
                  SelectionChanged="CategorySelectionChanged" />

        <Border Grid.Row="2" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Plan" />
        </Border>
        <ComboBox Grid.Row="2" Grid.Column="1"
                  Style="{StaticResource SharedFormCombo}"
                  ItemsSource="{Binding Plans}"
                  DisplayMemberPath="PlanName"
                  SelectedValuePath="PlanId"
                  SelectedValue="{Binding SelectedPlanId, Mode=TwoWay}" />

        <shared:SharedModalActions Grid.Row="4" Grid.ColumnSpan="2"
                                   SaveCommand="{Binding SaveCommand}"
                                   CancelCommand="{Binding CancelCommand}" />

        <shared:SharedLoading Grid.RowSpan="5" Grid.ColumnSpan="2" IsLoading="{Binding IsLoading}" />
    </Grid>
</UserControl>
