<UserControl x:Class="Spix.AppWpf.Views.EntitiesContratos.ContractControl.ContractBindDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             MinWidth="680">

    <!-- El IpBinding tampoco se elige: se arma con lo ya configurado. Lo unico que se
         decide aqui es el tipo de acceso del HotSpot. -->
    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="12" />
            <RowDefinition Height="Auto" /><RowDefinition Height="12" />
            <RowDefinition Height="Auto" /><RowDefinition Height="12" />
            <RowDefinition Height="Auto" /><RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Servidor" />
        </Border>
        <TextBox Grid.Row="0" Grid.Column="1"
                 IsEnabled="False"
                 Style="{StaticResource SharedFormBox}"
                 Text="{Binding Entity.ServerName, Mode=OneWay}" />
        <Border Grid.Row="2" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="IP del cliente" />
        </Border>
        <TextBox Grid.Row="2" Grid.Column="1"
                 IsEnabled="False"
                 Style="{StaticResource SharedFormBox}"
                 Text="{Binding Entity.IpCliente, Mode=OneWay}" />
        <Border Grid.Row="4" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="MAC del equipo" />
        </Border>
        <TextBox Grid.Row="4" Grid.Column="1"
                 IsEnabled="False"
                 Style="{StaticResource SharedFormBox}"
                 Text="{Binding Entity.MacCliente, Mode=OneWay}" />

        <Border Grid.Row="6" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Tipo de acceso" />
        </Border>
        <ComboBox Grid.Row="6" Grid.Column="1"
                  Style="{StaticResource SharedFormCombo}"
                  ItemsSource="{Binding Types}"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Value"
                  SelectedValue="{Binding Entity.HotSpotTypeId, Mode=TwoWay}" />

        <shared:SharedModalActions Grid.Row="8" Grid.ColumnSpan="2"
                                   SaveText="{Binding SaveText}"
                                   SaveCommand="{Binding SaveCommand}"
                                   CancelCommand="{Binding CancelCommand}" />

        <shared:SharedLoading Grid.RowSpan="9" Grid.ColumnSpan="2" IsLoading="{Binding IsLoading}" />
    </Grid>
</UserControl>
