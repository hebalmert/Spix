<UserControl x:Class="Spix.AppWpf.Views.EntitiesContratos.RunSuspended.RunSuspendedFormDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             MinWidth="520">

    <!-- El corte solo tiene periodo: ano y mes. Es una etiqueta, NO filtra la deuda por
         mes; el corte toma cualquier nota con saldo, del mes que sea. -->
    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="12" />
            <RowDefinition Height="Auto" /><RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Ano" />
        </Border>
        <TextBox Grid.Row="0" Grid.Column="1"
                 Style="{StaticResource SharedFormBox}"
                 Text="{Binding YearNumber, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

        <Border Grid.Row="2" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Mes" />
        </Border>
        <ComboBox Grid.Row="2" Grid.Column="1"
                  Style="{StaticResource SharedFormCombo}"
                  ItemsSource="{Binding Months}"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Value"
                  SelectedValue="{Binding MonthValue, Mode=TwoWay}" />

        <shared:SharedModalActions Grid.Row="4" Grid.ColumnSpan="2"
                                   SaveText="{Binding SaveText}"
                                   SaveCommand="{Binding SaveCommand}"
                                   CancelCommand="{Binding CancelCommand}" />
    </Grid>
</UserControl>
