<UserControl x:Class="Spix.AppWpf.Views.EntitiesContratos.RunSuspended.RunSuspendedDetailDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Spix.AppWpf.SharedServices"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:catalog="clr-namespace:Spix.AppWpf.SharedComponents.SharedCatalog"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             MinWidth="860">

    <!-- El detalle del corte: la revision previa y la EJECUCION.

         Mientras el corte esta pendiente se ve la revision; cuando ya se ejecuto se ve a
         quienes corto.

         La ejecucion le quita el acceso en el MikroTik, y la hace el ESCRITORIO por la red
         LAN. Va equipo por equipo: si uno no responde, lo ya cortado queda cortado y el
         corte sigue abierto para continuarlo. -->
    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Margin="0,0,0,14"
                Padding="14,10"
                CornerRadius="12"
                Background="{DynamicResource BrushCatalogCard}"
                BorderBrush="{DynamicResource BrushCatalogKpiBorder}"
                BorderThickness="1">
            <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding PeriodText}" />
        </Border>

        <!-- La revision previa: solo mientras el corte esta pendiente -->
        <UniformGrid Grid.Row="1"
                     Columns="4"
                     Margin="0,0,0,12"
                     Visibility="{Binding HasCheck, Converter={StaticResource BooleanToVisibilityConverter}}">
            <catalog:SharedCatalogKpi Margin="0,0,10,0"
                                      Label="Con deuda"
                                      Value="{Binding Debtors}" />
            <catalog:SharedCatalogKpi Margin="0,0,10,0"
                                      Label="Se les corta"
                                      Value="{Binding ToSuspend}"
                                      Accent="{DynamicResource BrushCatalogKpiBad}"
                                      ValueBrush="{DynamicResource BrushCatalogKpiBadText}" />
            <catalog:SharedCatalogKpi Margin="0,0,10,0"
                                      Label="Ya suspendidos"
                                      Value="{Binding AlreadySuspended}"
                                      Accent="{DynamicResource BrushCatalogKpiOk}" />
            <catalog:SharedCatalogKpi Label="Deuda total"
                                      Value="{Binding DebtTotal, StringFormat=N2}"
                                      Accent="{DynamicResource BrushCatalogKpiOk}"
                                      ValueBrush="{DynamicResource BrushCatalogKpiOk}" />
        </UniformGrid>

        <StackPanel Grid.Row="2">
            <!-- Como quedan repartidos por equipo -->
            <ItemsControl Margin="0,0,0,10" ItemsSource="{Binding Servers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,8,8"
                                Padding="10,5"
                                CornerRadius="8"
                                Background="{DynamicResource BrushCatalogCard}"
                                BorderBrush="{DynamicResource BrushCatalogKpiBorder}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <fa:FontAwesomeImage Width="12" Height="12"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource BrushCatalogKpiAccent}"
                                                     Icon="{x:Static icons:FontAwesomeIcon.Server}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                <TextBlock Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SharedIndexMeta}"
                                           Text="{Binding ServerName}" />
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource SharedIndexName}"
                                           Text="{Binding Contracts}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Los que no se pueden tocar porque no tienen IpBinding -->
            <Border Margin="0,0,0,10"
                    Padding="12,8"
                    CornerRadius="8"
                    Background="{DynamicResource BrushCatalogCard}"
                    BorderBrush="{DynamicResource BrushCatalogKpiWarn}"
                    BorderThickness="1"
                    Visibility="{Binding HasBlocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <fa:FontAwesomeImage Width="14" Height="14"
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource BrushCatalogKpiWarn}"
                                         Icon="{x:Static icons:FontAwesomeIcon.TriangleExclamation}"
                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource SharedIndexMeta}"
                               Text="{Binding BlockedText}" />
                </StackPanel>
            </Border>

            <!-- El avance real: cada equipo que termina mueve la barra -->
            <StackPanel Margin="0,0,0,10"
                        Visibility="{Binding HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="0,0,0,6">
                    <TextBlock HorizontalAlignment="Left"
                               Style="{StaticResource SharedIndexMeta}"
                               Text="{Binding CurrentServer}" />
                    <TextBlock HorizontalAlignment="Right"
                               Style="{StaticResource SharedIndexMeta}"
                               Text="{Binding ProgressText}" />
                </Grid>

                <ProgressBar Height="8"
                             Maximum="100"
                             Style="{StaticResource SharedIndexProgress}"
                             Value="{Binding Percent, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>

        <Button Grid.Row="3"
                Margin="0,0,0,12"
                HorizontalAlignment="Left"
                Command="{Binding RunCommand}"
                IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                Style="{StaticResource SharedIndexNewButton}"
                ToolTip="Ejecutar el corte"
                svc:FormButton.Icon="{x:Static icons:FontAwesomeIcon.Ban}"
                Content="Ejecutar corte"
                Visibility="{Binding CanRun, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- A quienes corto: solo cuando el corte ya se ejecuto -->
        <Border Grid.Row="4"
                MinHeight="140"
                Style="{StaticResource SharedIndexPanel}"
                Visibility="{Binding Executed, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Border Style="{StaticResource SharedIndexHeaderBand}" />

                    <DataGrid ItemsSource="{Binding Details}"
                              Style="{StaticResource SharedIndexGrid}"
                              ColumnHeaderStyle="{StaticResource SharedIndexHeader}"
                              RowStyle="{StaticResource SharedIndexRow}"
                              CellStyle="{StaticResource SharedIndexCell}">

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="110" Header="Contrato" SortMemberPath="ControlContrato">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding ControlContrato}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="*" MinWidth="200" Header="Cliente" SortMemberPath="ClientFullName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding ClientFullName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="180" Header="Nota mas vieja" SortMemberPath="CollectionNote">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding CollectionNote}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="130" Header="Deuda" SortMemberPath="Debt">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right"
                                                   Style="{StaticResource SharedIndexName}"
                                                   Text="{Binding Debt, StringFormat=N2}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="130" Header="Plan" SortMemberPath="PlanAmount">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right"
                                                   Style="{StaticResource SharedIndexMeta}"
                                                   Text="{Binding PlanAmount, StringFormat=N2}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource SharedIndexPanelFoot}">
                    <shared:SharedPagination Foreground="{DynamicResource BrushCatalogMeta}"
                                             CurrentPage="{Binding CurrentPage}"
                                             TotalPages="{Binding TotalPages}"
                                             PageCommand="{Binding GoToPageCommand}" />
                </Border>
            </Grid>
        </Border>

        <shared:SharedModalActions Grid.Row="5"
                                   Margin="0,20,0,0"
                                   ShowSave="False"
                                   CancelCommand="{Binding CancelCommand}" />

        <shared:SharedLoading Grid.RowSpan="6" IsLoading="{Binding IsLoading}" />
    </Grid>
</UserControl>
