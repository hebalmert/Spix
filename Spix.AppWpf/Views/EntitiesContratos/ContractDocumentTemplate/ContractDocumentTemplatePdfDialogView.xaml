<UserControl x:Class="Spix.AppWpf.Views.EntitiesContratos.ContractDocumentTemplate.ContractDocumentTemplatePdfDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             MinWidth="1000">

    <!-- El visor del PDF de la plantilla: el original o el de prueba que arma el servidor.
         Aqui solo se mira, por eso el pie no lleva Guardar. -->
    <Grid Margin="0,16,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border MinHeight="520"
                CornerRadius="10"
                Background="{DynamicResource BrushAvatarBack}"
                BorderBrush="{DynamicResource BrushCatalogKpiBorder}"
                BorderThickness="1"
                ClipToBounds="True">
            <wv2:WebView2 x:Name="DocumentBrowser" />
        </Border>

        <shared:SharedModalActions Grid.Row="2"
                                   ShowSave="False"
                                   CancelCommand="{Binding CancelCommand}" />

        <shared:SharedLoading Grid.RowSpan="3" IsLoading="{Binding IsLoading}" />
    </Grid>
</UserControl>
