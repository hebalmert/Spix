<UserControl x:Class="Spix.AppWpf.Views.EntitiesContratos.ContractExempt.ContractExemptIndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Spix.AppWpf.SharedServices"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:rowbtn="clr-namespace:Spix.AppWpf.SharedComponents.SharedButtonRow"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents">

    <!-- Exoneracion fija: contratos que mantienen el servicio sin que se les cobre, con el
         monto del plan al momento de exonerar.

         No es la exoneracion de un mes: aqui no hay vencimiento. El contrato pasa a
         Exonerado y con eso queda fuera de toda facturacion.

         La lista NO pagina: el servidor manda hasta 300 filas y los totales del filtro
         completo. Es asi tambien en la web. -->
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <Border Style="{StaticResource SharedIndexShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Margin="0,0,14,0"
                            Command="{Binding NewCommand}"
                            Style="{StaticResource SharedIndexNewButton}"
                            ToolTip="Exonerar un contrato (Ctrl+N)"
                            svc:FormButton.Icon="{x:Static icons:FontAwesomeIcon.HandHoldingDollar}"
                            Content="Exonerar" />

                    <!-- El rango mira la FECHA DE EXONERACION -->
                    <fa:FontAwesomeImage Width="14" Height="14"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource BrushIndexIconEdit}"
                                         Icon="{x:Static icons:FontAwesomeIcon.CalendarDay}"
                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />

                    <DatePicker Width="130"
                                MinHeight="38"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                SelectedDate="{Binding Desde, Mode=TwoWay}"
                                SelectedDateFormat="Short"
                                ToolTip="Desde" />

                    <fa:FontAwesomeImage Width="14" Height="14"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource BrushIndexIconEdit}"
                                         Icon="{x:Static icons:FontAwesomeIcon.CalendarCheck}"
                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />

                    <DatePicker Width="130"
                                MinHeight="38"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center"
                                SelectedDate="{Binding Hasta, Mode=TwoWay}"
                                SelectedDateFormat="Short"
                                ToolTip="Hasta" />

                    <CheckBox VerticalAlignment="Center"
                              Content="Solo exonerados"
                              Foreground="{DynamicResource BrushIndexText}"
                              IsChecked="{Binding SoloAbiertas, Mode=TwoWay}"
                              ToolTip="Sin marcar se ve todo el historico" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Border Margin="0,0,10,0"
                            Padding="12,6"
                            VerticalAlignment="Center"
                            CornerRadius="8"
                            Background="{DynamicResource BrushCatalogCard}"
                            BorderBrush="{DynamicResource BrushCatalogKpiBorder}"
                            BorderThickness="1">
                        <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding OpenText}" />
                    </Border>

                    <Button Width="38" Height="38"
                            Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SharedIndexIconButtonEdit}"
                            ToolTip="Actualizar (F5)">
                        <fa:FontAwesomeImage Width="14" Height="14"
                                             Foreground="{DynamicResource BrushIndexIconEdit}"
                                             Icon="{x:Static icons:FontAwesomeIcon.ArrowsRotate}"
                                             IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                    </Button>

                    <shared:SharedSearchFilter SearchText="{Binding Filter}"
                                               SearchCommand="{Binding SearchCommand}"
                                               ClearCommand="{Binding ClearSearchCommand}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource SharedIndexPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Border Style="{StaticResource SharedIndexHeaderBand}" />

                        <DataGrid ItemsSource="{Binding Rows}"
                                  Style="{StaticResource SharedIndexGrid}"
                                  ColumnHeaderStyle="{StaticResource SharedIndexHeader}"
                                  RowStyle="{StaticResource SharedIndexRow}"
                                  CellStyle="{StaticResource SharedIndexCell}">

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="100" Header="Contrato" SortMemberPath="ControlContrato">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding ControlContrato}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*" MinWidth="180" Header="Cliente" SortMemberPath="ClientName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding ClientName}" />
                                                <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding ClientDocument}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*" MinWidth="170" Header="Direccion" SortMemberPath="ContractAddress">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SharedIndexMeta}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding ContractAddress}"
                                                           ToolTip="{Binding ContractAddress}" />
                                                <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding Place}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="130" Header="Plan" SortMemberPath="PlanName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding PlanName}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="110" Header="Monto" SortMemberPath="PlanAmount">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Right"
                                                       Style="{StaticResource SharedIndexName}"
                                                       Text="{Binding PlanAmount, StringFormat=N2}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="120" Header="Exonerado el" SortMemberPath="DateExempt">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding DateExemptText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="120" Header="Estado" SortMemberPath="IsOpen">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <shared:SharedStatePill IsOn="{Binding IsOpen}"
                                                                    OnText="Exonerado"
                                                                    OffText="Retirado" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="Auto" MinWidth="150" Header="" CanUserSort="False" CellStyle="{StaticResource SharedIndexCellActions}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,6,0">
                                                <rowbtn:SharedButtonRowEdit Command="{Binding DataContext.AuditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}"
                                                                            Icon="{x:Static icons:FontAwesomeIcon.ClockRotateLeft}"
                                                                            ToolTip="Auditoria del registro" />

                                                <rowbtn:SharedButtonRowEdit Command="{Binding DataContext.ReasonCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}"
                                                                            Icon="{x:Static icons:FontAwesomeIcon.CommentDots}"
                                                                            ToolTip="{Binding Motivo}"
                                                                            Visibility="{Binding HasReason, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                <!-- Retirar solo mientras siga exonerado -->
                                                <rowbtn:SharedButtonRowSuccess Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                               CommandParameter="{Binding}"
                                                                               Icon="{x:Static icons:FontAwesomeIcon.CirclePlay}"
                                                                               ToolTip="Retirar la exoneracion"
                                                                               Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Rows, Converter={StaticResource CountToVisibilityConverter}}">
                            <fa:FontAwesomeImage Width="26" Height="26"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource BrushIndexMeta}"
                                                 Icon="{x:Static icons:FontAwesomeIcon.HandHoldingDollar}"
                                                 IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource SharedIndexEmpty}"
                                       Text="No hay exoneraciones con este filtro" />
                        </StackPanel>

                        <shared:SharedLoading IsLoading="{Binding IsLoading}" />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource SharedIndexPanelFoot}">
                        <Grid>
                            <TextBlock HorizontalAlignment="Left"
                                       Style="{StaticResource SharedIndexMeta}"
                                       Text="{Binding CountText}" />

                            <TextBlock HorizontalAlignment="Right"
                                       Style="{StaticResource SharedIndexName}"
                                       Text="{Binding TotalText}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
