<UserControl x:Class="Spix.AppWpf.Views.EntitiesContratos.ContractExempt.ContractExemptDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             MinWidth="640">

    <!-- Exonerar un contrato: se escribe el nombre o la cedula y se elige de la lista.
         Solo aparecen contratos ACTIVOS.

         El servicio del cliente NO se toca: solo deja de cobrarsele. Por eso aqui no hay
         nada de MikroTik. -->
    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="10" />
            <RowDefinition Height="Auto" /><RowDefinition Height="10" />
            <RowDefinition Height="Auto" /><RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Cliente" />
        </Border>
        <shared:SharedSearchPicker Grid.Row="0" Grid.Column="1"
                                   Text="{Binding SearchText, Mode=TwoWay}"
                                   Items="{Binding Candidates}"
                                   SearchCommand="{Binding SearchCommand}"
                                   SelectCommand="{Binding SelectCommand}">
            <shared:SharedSearchPicker.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource SharedIndexName}">
                                <Run Text="#" /><Run Text="{Binding ControlContrato, Mode=OneWay}" />
                                <Run Text=" · " /><Run Text="{Binding ClientName, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource SharedIndexMeta}">
                                <Run Text="{Binding ClientDocument, Mode=OneWay}" />
                                <Run Text=" · " /><Run Text="{Binding Address, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock HorizontalAlignment="Right"
                                       Style="{StaticResource SharedIndexMeta}"
                                       Text="{Binding PlanName}" />
                            <TextBlock HorizontalAlignment="Right"
                                       Style="{StaticResource SharedIndexName}"
                                       Text="{Binding PlanAmount, StringFormat=N2}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </shared:SharedSearchPicker.ItemTemplate>
        </shared:SharedSearchPicker>

        <!-- Que este buscando, o que no haya ninguno, hay que DECIRLO: en silencio se ve
             igual que un buscador que no funciona -->
        <TextBlock Grid.Row="1" Grid.Column="1"
                   Margin="2,6,0,0"
                   Style="{StaticResource SharedIndexMeta}"
                   Text="Buscando..."
                   Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <TextBlock Grid.Row="1" Grid.Column="1"
                   Margin="2,6,0,0"
                   Style="{StaticResource SharedIndexMeta}"
                   Text="No hay contratos activos que coincidan."
                   Visibility="{Binding NoResults, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- Lo elegido queda a la vista: exonerar no es una accion para dudar de a quien -->
        <Border Grid.Row="3" Grid.ColumnSpan="2"
                Padding="12,10"
                CornerRadius="8"
                Background="{DynamicResource BrushCatalogCard}"
                BorderBrush="{DynamicResource BrushCatalogKpiBorder}"
                BorderThickness="1"
                Visibility="{Binding HasSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <fa:FontAwesomeImage Width="14" Height="14"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource BrushCatalogKpiAccent}"
                                     Icon="{x:Static icons:FontAwesomeIcon.CircleCheck}"
                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />

                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource SharedIndexName}"
                           Text="{Binding SelectedText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource SharedFormLabel}"
                Visibility="{Binding HasSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Motivo" />
        </Border>
        <TextBox Grid.Row="5" Grid.Column="1"
                 MinHeight="70"
                 AcceptsReturn="True"
                 MaxLength="200"
                 Style="{StaticResource SharedFormBox}"
                 Text="{Binding Motivo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 Visibility="{Binding HasSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <shared:SharedModalActions Grid.Row="7" Grid.ColumnSpan="2"
                                   SaveText="Exonerar"
                                   SaveCommand="{Binding SaveCommand}"
                                   CancelCommand="{Binding CancelCommand}" />
    </Grid>
</UserControl>
