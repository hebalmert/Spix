<UserControl x:Class="Spix.AppWpf.Views.EntitiesContratos.Activation.ActivationIndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Spix.AppWpf.SharedServices"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:catalog="clr-namespace:Spix.AppWpf.SharedComponents.SharedCatalog"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents">

    <!-- Reactivacion: le devuelve el servicio a los que se cortaron y ya pagaron.
         Es el proceso inverso del corte, y solo entran los que quedaron suspendidos POR EL
         CORTE con el pago recibido: el resto se levantan a mano desde Contratos suspendidos.

         Va equipo por equipo, una conexion por equipo. Cada uno se confirma solo: si uno
         falla, lo de los anteriores queda hecho y se puede volver a lanzar.

         La tabla es informativa: no tiene botones de fila ni doble clic. -->
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <Border Style="{StaticResource SharedIndexShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- El tablero: lo cuenta la base -->
            <UniformGrid Columns="4" Margin="0,0,0,12">
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="Pagaron y esperan"
                                          Value="{Binding Ready}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="Listos para activar"
                                          Value="{Binding ToActivate}"
                                          Accent="{DynamicResource BrushCatalogKpiOk}"
                                          ValueBrush="{DynamicResource BrushCatalogKpiOk}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="Sin IpBinding"
                                          Value="{Binding NoBinding}"
                                          Accent="{DynamicResource BrushCatalogKpiBad}"
                                          ValueBrush="{DynamicResource BrushCatalogKpiBadText}" />
                <catalog:SharedCatalogKpi Label="Sin Queue"
                                          Value="{Binding NoQueue}"
                                          Accent="{DynamicResource BrushCatalogKpiBad}"
                                          ValueBrush="{DynamicResource BrushCatalogKpiBadText}" />
            </UniformGrid>

            <!-- Como quedan repartidos por equipo: la reactivacion va uno por uno -->
            <ItemsControl Grid.Row="1" Margin="0,0,0,10" ItemsSource="{Binding Servers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,8,8"
                                Padding="10,5"
                                CornerRadius="8"
                                Background="{DynamicResource BrushCatalogCard}"
                                BorderBrush="{DynamicResource BrushCatalogKpiBorder}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <fa:FontAwesomeImage Width="12" Height="12"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource BrushCatalogKpiAccent}"
                                                     Icon="{x:Static icons:FontAwesomeIcon.Server}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                <TextBlock Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SharedIndexMeta}"
                                           Text="{Binding ServerName}" />
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource SharedIndexName}"
                                           Text="{Binding Contracts}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Row="2">
                <!-- El aviso de los que no se pueden tocar hasta que les completen la configuracion -->
                <Border Margin="0,0,0,10"
                        Padding="12,8"
                        CornerRadius="8"
                        Background="{DynamicResource BrushCatalogCard}"
                        BorderBrush="{DynamicResource BrushCatalogKpiWarn}"
                        BorderThickness="1"
                        Visibility="{Binding HasBlocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <fa:FontAwesomeImage Width="14" Height="14"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource BrushCatalogKpiWarn}"
                                             Icon="{x:Static icons:FontAwesomeIcon.TriangleExclamation}"
                                             IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource SharedIndexMeta}"
                                   Text="{Binding BlockedText}" />
                    </StackPanel>
                </Border>

                <!-- El avance real: cada equipo que termina mueve la barra -->
                <StackPanel Margin="0,0,0,10"
                            Visibility="{Binding HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="0,0,0,6">
                        <TextBlock HorizontalAlignment="Left"
                                   Style="{StaticResource SharedIndexMeta}"
                                   Text="{Binding CurrentServer}" />
                        <TextBlock HorizontalAlignment="Right"
                                   Style="{StaticResource SharedIndexMeta}"
                                   Text="{Binding ProgressText}" />
                    </Grid>

                    <ProgressBar Height="8"
                                 Maximum="100"
                                 Style="{StaticResource SharedIndexProgress}"
                                 Value="{Binding Percent, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <!-- Un solo boton, y solo si hay alguien listo -->
            <Grid Grid.Row="3" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Command="{Binding RunCommand}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                        Style="{StaticResource SharedIndexNewButton}"
                        ToolTip="Reactivar"
                        svc:FormButton.Icon="{x:Static icons:FontAwesomeIcon.PlugCircleCheck}"
                        Content="Reactivar"
                        Visibility="{Binding CanRun, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Button Grid.Column="2"
                        Width="38" Height="38"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SharedIndexIconButtonEdit}"
                        ToolTip="Actualizar (F5)">
                    <fa:FontAwesomeImage Width="14" Height="14"
                                         Foreground="{DynamicResource BrushIndexIconEdit}"
                                         Icon="{x:Static icons:FontAwesomeIcon.ArrowsRotate}"
                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                </Button>
            </Grid>

            <Border Grid.Row="4" Style="{StaticResource SharedIndexPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Border Style="{StaticResource SharedIndexHeaderBand}" />

                        <DataGrid x:Name="ItemsGrid"
                                  ItemsSource="{Binding Rows}"
                                  Style="{StaticResource SharedIndexGrid}"
                                  ColumnHeaderStyle="{StaticResource SharedIndexHeader}"
                                  RowStyle="{StaticResource SharedIndexRow}"
                                  CellStyle="{StaticResource SharedIndexCell}">

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="*" MinWidth="260" Header="Cliente" SortMemberPath="ClienteText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding ClienteText}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Margin="0,0,8,0"
                                                               Style="{StaticResource SharedIndexMeta}"
                                                               Text="{Binding ZoneName}" />

                                                    <!-- Lo que le falta para poder reactivarse -->
                                                    <Border Margin="0,0,6,0"
                                                            Padding="7,1"
                                                            CornerRadius="6"
                                                            Background="{DynamicResource BrushCatalogKpiBad}"
                                                            Visibility="{Binding FaltaBinding, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   Text="IpBinding" />
                                                    </Border>

                                                    <Border Padding="7,1"
                                                            CornerRadius="6"
                                                            Background="{DynamicResource BrushCatalogKpiBad}"
                                                            Visibility="{Binding FaltaQueue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   Text="Queue" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="190" Header="Equipo" SortMemberPath="ServerName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding ServerName}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="120" Header="Cortado el" SortMemberPath="DateSuspendedText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding DateSuspendedText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="120" Header="Pago el" SortMemberPath="DatePaymentReceivedText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding DatePaymentReceivedText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Rows, Converter={StaticResource CountToVisibilityConverter}}">
                            <fa:FontAwesomeImage Width="26" Height="26"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource BrushIndexMeta}"
                                                 Icon="{x:Static icons:FontAwesomeIcon.PlugCircleCheck}"
                                                 IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource SharedIndexEmpty}"
                                       Text="No hay nadie esperando reactivacion." />
                        </StackPanel>

                        <shared:SharedLoading IsLoading="{Binding IsLoading}" />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource SharedIndexPanelFoot}">
                        <shared:SharedPagination Foreground="{DynamicResource BrushCatalogMeta}"
                                                 CurrentPage="{Binding CurrentPage}"
                                                 TotalPages="{Binding TotalPages}"
                                                 PageCommand="{Binding GoToPageCommand}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
