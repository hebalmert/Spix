<UserControl x:Class="Spix.AppWpf.Views.EntitiesGen.DocumentType.EditDocumentTypeDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:documentType="clr-namespace:Spix.AppWpf.Views.EntitiesGen.DocumentType"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="28" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <documentType:DocumentTypeFormView />

        <shared:SharedModalActions Grid.Row="2"
                                   SaveCommand="{Binding SaveCommand}"
                                   CancelCommand="{Binding CancelCommand}" />

        <shared:SharedLoading Grid.RowSpan="3" IsLoading="{Binding IsLoading}" />
    </Grid>
</UserControl>
