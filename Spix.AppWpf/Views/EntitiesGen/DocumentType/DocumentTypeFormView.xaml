<UserControl x:Class="Spix.AppWpf.Views.EntitiesGen.DocumentType.DocumentTypeFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             MinWidth="620">
    <Grid Margin="0,24,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="28" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#F2F4F7"
                    BorderBrush="#566273"
                    BorderThickness="1,1,0,1"
                    CornerRadius="6,0,0,6">
                <TextBlock Margin="14,0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="#1E2B3C"
                           Text="Tipo documento" />
            </Border>
            <TextBox Grid.Column="1"
                     MinHeight="42"
                     Padding="12,8"
                     Background="White"
                     BorderBrush="#566273"
                     BorderThickness="1"
                     FontSize="14"
                     Foreground="#1E2B3C"
                     MaxLength="10"
                     Text="{Binding DocumentType.DocumentName, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#F2F4F7"
                    BorderBrush="#566273"
                    BorderThickness="1,1,0,1"
                    CornerRadius="6,0,0,6">
                <TextBlock Margin="14,0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="#1E2B3C"
                           Text="Descripcion" />
            </Border>
            <TextBox Grid.Column="1"
                     MinHeight="72"
                     MaxLength="100"
                     Padding="12,8"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="White"
                     BorderBrush="#566273"
                     BorderThickness="1"
                     FontSize="14"
                     Foreground="#1E2B3C"
                     Text="{Binding DocumentType.Descripcion, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#F2F4F7"
                    BorderBrush="#566273"
                    BorderThickness="1,1,0,1"
                    CornerRadius="6,0,0,6">
                <TextBlock Margin="14,0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="#1E2B3C"
                           Text="Activo" />
            </Border>
            <Border Grid.Column="1"
                    MinHeight="42"
                    Background="White"
                    BorderBrush="#566273"
                    BorderThickness="1"
                    CornerRadius="0,6,6,0">
                <CheckBox Margin="14,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding DocumentType.Active}"
                          Content="Activo" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
