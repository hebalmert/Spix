<UserControl x:Class="Spix.AppWpf.Views.EntitiesGen.Zone.ZoneFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="620">
    <Grid Margin="0,24,0,0">
        <Grid.RowDefinitions>
            <!-- La separacion entre campos es la MISMA para todos: 16 -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                <TextBlock Margin="14,0" VerticalAlignment="Center" FontSize="14" Foreground="#1E2B3C" Text="Estado" />
            </Border>
            <ComboBox Grid.Column="1"
                      MinHeight="42"
                      Padding="12,8"
                      FontSize="14"
                      ItemsSource="{Binding States}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="StateId"
                      SelectedValue="{Binding Entity.StateId, Mode=OneWay}"
                      SelectionChanged="StateSelectionChanged" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                <TextBlock Margin="14,0" VerticalAlignment="Center" FontSize="14" Foreground="#1E2B3C" Text="Ciudad" />
            </Border>
            <ComboBox Grid.Column="1"
                      MinHeight="42"
                      Padding="12,8"
                      FontSize="14"
                      ItemsSource="{Binding Cities}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="CityId"
                      SelectedValue="{Binding Entity.CityId, Mode=TwoWay}" />
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                <TextBlock Margin="14,0" VerticalAlignment="Center" FontSize="14" Foreground="#1E2B3C" Text="Zona" />
            </Border>
            <TextBox Grid.Column="1"
                     MinHeight="42"
                     Padding="12,8"
                     Background="White"
                     BorderBrush="#566273"
                     BorderThickness="1"
                     FontSize="14"
                     Foreground="#1E2B3C"
                     MaxLength="50"
                     Text="{Binding Entity.ZoneName, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                <TextBlock Margin="14,0" VerticalAlignment="Center" FontSize="14" Foreground="#1E2B3C" Text="Activo" />
            </Border>
            <Border Grid.Column="1"
                    MinHeight="42"
                    Background="White"
                    BorderBrush="#566273"
                    BorderThickness="1"
                    CornerRadius="0,6,6,0">
                <CheckBox Margin="14,0" VerticalAlignment="Center" IsChecked="{Binding Entity.Active}" Content="Activo" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
