<UserControl x:Class="Spix.AppWpf.Views.EntitiesGen.Plan.PlanFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="620">
    <Grid Margin="0,24,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                <TextBlock Margin="14,0" VerticalAlignment="Center" FontSize="14" Foreground="#1E2B3C" Text="Plan" />
            </Border>
            <TextBox Grid.Column="1" MinHeight="42" MaxLength="50" Padding="12,8" Background="White" BorderBrush="#566273" BorderThickness="1" FontSize="14" Foreground="#1E2B3C" Text="{Binding Entity.PlanName, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                    <TextBlock Margin="14,0" VerticalAlignment="Center" FontSize="14" Foreground="#1E2B3C" Text="Unidad subida" />
                </Border>
                <ComboBox Grid.Column="1" MinHeight="42" Padding="10,6" ItemsSource="{Binding SpeedUnits}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding SelectedSpeedUpType, Mode=TwoWay}" />
            </Grid>
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                    <TextBlock Margin="14,0" VerticalAlignment="Center" FontSize="14" Foreground="#1E2B3C" Text="Velocidad subida" />
                </Border>
                <TextBox Grid.Column="1" MinHeight="42" Padding="12,8" Background="White" BorderBrush="#566273" BorderThickness="1" FontSize="14" Foreground="#1E2B3C" Text="{Binding Entity.SpeedUp, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                    <TextBlock Margin="14,0" VerticalAlignment="Center" FontSize="14" Foreground="#1E2B3C" Text="Unidad bajada" />
                </Border>
                <ComboBox Grid.Column="1" MinHeight="42" Padding="10,6" ItemsSource="{Binding SpeedUnits}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding SelectedSpeedDownType, Mode=TwoWay}" />
            </Grid>
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                    <TextBlock Margin="14,0" VerticalAlignment="Center" FontSize="14" Foreground="#1E2B3C" Text="Velocidad bajada" />
                </Border>
                <TextBox Grid.Column="1" MinHeight="42" Padding="12,8" Background="White" BorderBrush="#566273" BorderThickness="1" FontSize="14" Foreground="#1E2B3C" Text="{Binding Entity.SpeedDown, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Grid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                        <TextBlock Margin="14,0" VerticalAlignment="Center" FontSize="14" Foreground="#1E2B3C" Text="Tasa reuso" />
                    </Border>
                    <TextBox Grid.Column="1" MinHeight="42" Padding="12,8" Background="White" BorderBrush="#566273" BorderThickness="1" FontSize="14" Foreground="#1E2B3C" Text="{Binding Entity.TasaReuso, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                        <TextBlock Margin="14,0" VerticalAlignment="Center" FontSize="14" Foreground="#1E2B3C" Text="Activo" />
                    </Border>
                    <Border Grid.Column="1" MinHeight="42" Background="White" BorderBrush="#566273" BorderThickness="1" CornerRadius="0,6,6,0">
                        <CheckBox Margin="14,0" VerticalAlignment="Center" Content="Activo" IsChecked="{Binding Entity.Active}" />
                    </Border>
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                        <TextBlock Margin="14,0" VerticalAlignment="Center" FontSize="14" Foreground="#1E2B3C" Text="Impuesto" />
                    </Border>
                    <ComboBox Grid.Column="1" MinHeight="42" Padding="10,6" ItemsSource="{Binding Taxes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Entity.TaxId, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                        <TextBlock Margin="14,0" VerticalAlignment="Center" FontSize="14" Foreground="#1E2B3C" Text="Precio" />
                    </Border>
                    <TextBox Grid.Column="1" MinHeight="42" Padding="12,8" Background="White" BorderBrush="#566273" BorderThickness="1" FontSize="14" Foreground="#1E2B3C" Text="{Binding Entity.Price, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
