<UserControl x:Class="Spix.AppWpf.Views.EntitiesGen.Service.ServiceIndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Spix.AppWpf.SharedServices"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             xmlns:catalog="clr-namespace:Spix.AppWpf.SharedComponents.SharedCatalog"
             xmlns:rowbtn="clr-namespace:Spix.AppWpf.SharedComponents.SharedButtonRow">

    <!-- Servicios: el mismo maestro-detalle de la web. Las categorias a la izquierda,
         los servicios de la elegida a la derecha, y cuatro numeros arriba.
         Los estilos salen de SharedCatalog.xaml; aqui no se escribe ni un color. -->
    <Border Style="{StaticResource SharedCatalogCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- El titulo lo pone la barra de arriba del shell; aqui solo va la indicacion -->
            <TextBlock Style="{StaticResource SharedCatalogSubtitle}"
                       Text="Elija una categoria a la izquierda y trabaje sus servicios a la derecha." />

            <!-- Los cuatro numeros -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,8">
                <catalog:SharedCatalogKpi Margin="0,0,12,0" Label="Categorias" Value="{Binding CategoriesCount}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0" Label="Servicios" Value="{Binding ChildrenCount}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0" Label="Activos" Value="{Binding ActiveCount}"
                                          Accent="{DynamicResource BrushCatalogKpiOk}" />
                <catalog:SharedCatalogKpi Label="Inactivos" Value="{Binding InactiveCount}"
                                          Accent="{DynamicResource BrushCatalogKpiWarn}"
                                          ValueBrush="{DynamicResource BrushCatalogKpiWarnText}" />
            </UniformGrid>

            <TextBlock Grid.Row="2"
                       Margin="0,0,0,10"
                       Style="{StaticResource SharedCatalogMessage}"
                       Text="{Binding Message}"
                       Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ================= Las categorias ================= -->
                <Border Style="{StaticResource SharedCatalogPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource SharedCatalogPanelHead}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SharedCatalogPanelHeadText}" Text="Categorias" />
                                <Button Grid.Column="1"
                                        Command="{Binding NewCommand}"
                                        Style="{StaticResource SharedIndexNewButton}"
                                        ToolTip="Crear categoria"
                                        svc:FormButton.Icon="{x:Static icons:FontAwesomeIcon.Plus}"
                                        Content="Nuevo" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource SharedCatalogSearchBar}">
                            <TextBox Style="{StaticResource SharedCatalogSearchBox}"
                                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Escriba y pulse Enter">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </Border>

                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                 Style="{StaticResource SharedCatalogList}"
                                 ItemContainerStyle="{StaticResource SharedCatalogCategoryItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SharedCatalogCategoryName}" Text="{Binding Name}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Style="{StaticResource SharedCatalogCategoryMeta}">
                                                    <Run Text="{Binding ServicesNumer, Mode=OneWay}" />
                                                    <Run Text="servicios" />
                                                </TextBlock>
                                                <catalog:SharedCatalogPill Margin="8,0,0,0" IsOn="{Binding Active}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <rowbtn:SharedButtonRowEdit Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="Editar categoria" />
                                            <rowbtn:SharedButtonRowDelete Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                          CommandParameter="{Binding}"
                                                                          ToolTip="Eliminar categoria" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="3" Style="{StaticResource SharedCatalogPanelFoot}">
                            <shared:SharedPagination Foreground="{DynamicResource BrushCatalogMeta}"
                                                     CurrentPage="{Binding CurrentPage}"
                                                     TotalPages="{Binding TotalPages}"
                                                     PageCommand="{Binding GoToPageCommand}" />
                        </Border>

                        <shared:SharedLoading Grid.RowSpan="4" IsLoading="{Binding IsLoading}" />
                    </Grid>
                </Border>

                <!-- ================= Los servicios de la categoria ================= -->
                <Border Grid.Column="2" Style="{StaticResource SharedCatalogPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource SharedCatalogPanelHead}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <fa:FontAwesomeImage Width="14" Height="14"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource BrushCatalogHeadText}"
                                                         Icon="{x:Static icons:FontAwesomeIcon.BellConcierge}"
                                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                    <TextBlock Style="{StaticResource SharedCatalogPanelHeadText}"
                                               Text="{Binding SelectedCategoryName}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding NewChildCommand}"
                                        Style="{StaticResource SharedIndexNewButton}"
                                        ToolTip="Crear servicio"
                                        Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        svc:FormButton.Icon="{x:Static icons:FontAwesomeIcon.Plus}"
                                        Content="Nuevo servicio" />
                            </Grid>
                        </Border>

                        <!-- Los chips filtran lo que ya se bajo; el buscador va al servidor -->
                        <Border Grid.Row="1"
                                Style="{StaticResource SharedCatalogToolbar}"
                                Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <WrapPanel VerticalAlignment="Center">
                                    <catalog:SharedCatalogChip Text="Todos"
                                                               Value="all"
                                                               Command="{Binding SetChipCommand}"
                                                               IsOn="{Binding Chip, Converter={StaticResource EqualsToBooleanConverter}, ConverterParameter=all}" />
                                    <catalog:SharedCatalogChip Text="Activo"
                                                               Value="active"
                                                               Command="{Binding SetChipCommand}"
                                                               IsOn="{Binding Chip, Converter={StaticResource EqualsToBooleanConverter}, ConverterParameter=active}" />
                                    <catalog:SharedCatalogChip Text="Inactivo"
                                                               Value="inactive"
                                                               Command="{Binding SetChipCommand}"
                                                               IsOn="{Binding Chip, Converter={StaticResource EqualsToBooleanConverter}, ConverterParameter=inactive}" />
                                </WrapPanel>

                                <TextBox Grid.Column="1"
                                         Width="260"
                                         Style="{StaticResource SharedCatalogSearchBox}"
                                         Text="{Binding ChildFilter, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Escriba y pulse Enter">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SearchChildrenCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <DataGrid ItemsSource="{Binding FilteredChildren}"
                                      Style="{StaticResource SharedCatalogGrid}"
                                      ColumnHeaderStyle="{StaticResource SharedCatalogHeader}"
                                      RowStyle="{StaticResource SharedCatalogRow}"
                                      CellStyle="{StaticResource SharedCatalogCell}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="*" Header="Servicio">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource SharedCatalogItemName}" Text="{Binding ServiceName}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="128" Header="Costo">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource SharedCatalogItemName}" Text="{Binding Costo, StringFormat=N2}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="128" Header="Precio">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource SharedCatalogItemName}" Text="{Binding Price, StringFormat=N2}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="112" Header="Activo">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <catalog:SharedCatalogPill IsOn="{Binding Active}" OnText="Activo" OffText="Inactivo" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="Auto" MinWidth="96" Header="" CanUserSort="False" CellStyle="{StaticResource SharedCatalogCellActions}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                                                    <rowbtn:SharedButtonRowEdit Command="{Binding DataContext.EditChildCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip="Editar servicio" />
                                                    <rowbtn:SharedButtonRowDelete Command="{Binding DataContext.DeleteChildCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                                  CommandParameter="{Binding}"
                                                                                  ToolTip="Eliminar servicio" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Sin categoria elegida no hay nada que mostrar -->
                            <StackPanel VerticalAlignment="Center"
                                        Visibility="{Binding HasSelection, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <fa:FontAwesomeImage Width="26" Height="26"
                                                     HorizontalAlignment="Center"
                                                     Foreground="{DynamicResource BrushCatalogEmptyGlyph}"
                                                     Icon="{x:Static icons:FontAwesomeIcon.HandPointer}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                <TextBlock Style="{StaticResource SharedCatalogEmptyTitle}" Text="Elija una categoria" />
                                <TextBlock Style="{StaticResource SharedCatalogEmptyText}"
                                           Text="Al elegir una categoria se muestran sus servicios." />
                            </StackPanel>

                            <StackPanel VerticalAlignment="Center"
                                        Visibility="{Binding ShowChildrenEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <fa:FontAwesomeImage Width="26" Height="26"
                                                     HorizontalAlignment="Center"
                                                     Foreground="{DynamicResource BrushCatalogEmptyGlyph}"
                                                     Icon="{x:Static icons:FontAwesomeIcon.BellConcierge}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                <TextBlock Style="{StaticResource SharedCatalogEmptyTitle}" Text="No hay registros" />
                                <TextBlock Style="{StaticResource SharedCatalogEmptyText}"
                                           Text="Esta categoria todavia no tiene servicios." />
                            </StackPanel>

                            <shared:SharedLoading IsLoading="{Binding IsChildrenLoading}" />
                        </Grid>

                        <Border Grid.Row="3" Style="{StaticResource SharedCatalogPanelFoot}">
                            <TextBlock Style="{StaticResource SharedCatalogFootText}">
                                <Run Text="{Binding FilteredChildrenCount, Mode=OneWay}" />
                                <Run Text="/" />
                                <Run Text="{Binding ChildrenCount, Mode=OneWay}" />
                                <Run Text="servicios" />
                            </TextBlock>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
