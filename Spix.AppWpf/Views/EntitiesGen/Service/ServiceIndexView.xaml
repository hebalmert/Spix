<UserControl x:Class="Spix.AppWpf.Views.EntitiesGen.Service.ServiceIndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" VerticalAlignment="Bottom" Command="{Binding NewCommand}" Style="{StaticResource SharedButtonFormPrimary}">
                <StackPanel Orientation="Horizontal">
                    <fa:FontAwesomeImage Width="16" Height="16" Icon="{x:Static icons:FontAwesomeIcon.CirclePlus}" IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                    <TextBlock Margin="10,0,0,0" Text="Nuevo" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="2">
                <TextBlock FontSize="25" FontWeight="SemiBold" Foreground="White" Text="Servicios" />
                <TextBlock Margin="0,5,0,0" FontSize="13" Foreground="#B9C8DD" Text="Configuracion / Categorias de servicios" />
            </StackPanel>
            <shared:SharedSearchFilter Grid.Column="3" VerticalAlignment="Bottom" SearchText="{Binding Filter}" SearchCommand="{Binding SearchCommand}" ClearCommand="{Binding ClearSearchCommand}" />
        </Grid>

        <TextBlock Grid.Row="2" FontSize="13" Foreground="#FF9AAE" Text="{Binding Message}" Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid Grid.Row="4">
            <Border Background="#303640" BorderBrush="#455160" BorderThickness="1" CornerRadius="4">
                <Grid Margin="0,0,0,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#102A4C">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Margin="14,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" Text="Categoria" />
                        <TextBlock Grid.Column="2" Margin="14,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" Text="Servicios" />
                        <TextBlock Grid.Column="3" Margin="14,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" Text="Activo" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#3B4452" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="42" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Background="#303640">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="48" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Command="{Binding DataContext.ToggleServicesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SharedButtonTableRowDetails}" ToolTip="Ver servicios">
                                                    <fa:FontAwesomeImage Width="16" Height="16" Icon="{x:Static icons:FontAwesomeIcon.ChevronRight}" IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}">
                                                        <fa:FontAwesomeImage.Style>
                                                            <Style TargetType="fa:FontAwesomeImage" BasedOn="{StaticResource SharedButtonTableRowIcon}">
                                                                <Setter Property="Icon" Value="{x:Static icons:FontAwesomeIcon.ChevronRight}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                        <Setter Property="Icon" Value="{x:Static icons:FontAwesomeIcon.ChevronDown}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </fa:FontAwesomeImage.Style>
                                                    </fa:FontAwesomeImage>
                                                </Button>
                                                <TextBlock Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Foreground="White" Text="{Binding Name}" />
                                                <TextBlock Grid.Column="2" Margin="14,0" VerticalAlignment="Center" Foreground="White" Text="{Binding ServicesNumer}" />
                                                <CheckBox Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Active}" IsHitTestVisible="False" />
                                                <Button Grid.Column="4" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SharedButtonTableRowEdit}" ToolTip="Editar categoria">
                                                    <fa:FontAwesomeImage Width="16" Height="16" Style="{StaticResource SharedButtonTableRowIcon}" Icon="{x:Static icons:FontAwesomeIcon.PenToSquare}" IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                                </Button>
                                                <Button Grid.Column="5" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SharedButtonTableRowDelete}" ToolTip="Eliminar categoria">
                                                    <fa:FontAwesomeImage Width="16" Height="16" Style="{StaticResource SharedButtonTableRowIcon}" Icon="{x:Static icons:FontAwesomeIcon.TrashCan}" IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                                </Button>
                                            </Grid>
                                            <Border Grid.Row="1" Margin="26,0,16,14" Padding="16" Background="#252B35" BorderBrush="#526176" BorderThickness="1" CornerRadius="6" Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="12" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="12" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Button HorizontalAlignment="Left" Command="{Binding DataContext.NewServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SharedButtonFormPrimary}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <fa:FontAwesomeImage Width="14" Height="14" Icon="{x:Static icons:FontAwesomeIcon.CirclePlus}" IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                                            <TextBlock Margin="8,0,0,0" Text="Nuevo servicio" />
                                                        </StackPanel>
                                                    </Button>
                                                    <StackPanel Grid.Row="2" Visibility="{Binding IsServicesLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <ProgressBar Height="4" IsIndeterminate="True" />
                                                        <TextBlock Margin="0,10,0,0" Foreground="#B9C8DD" Text="Cargando servicios..." />
                                                    </StackPanel>
                                                    <Grid Grid.Row="4" Visibility="{Binding HasServices, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="34" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid Background="#17202D">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="100" />
                                                                <ColumnDefinition Width="96" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" Text="Servicio" />
                                                            <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" Text="Activo" />
                                                        </Grid>
                                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Services}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid MinHeight="38" Background="#2E3641">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="100" />
                                                                            <ColumnDefinition Width="48" />
                                                                            <ColumnDefinition Width="48" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Margin="12,0" VerticalAlignment="Center" Foreground="White" Text="{Binding ServiceName}" />
                                                                        <CheckBox Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Active}" IsHitTestVisible="False" />
                                                                        <Button Grid.Column="2" Command="{Binding DataContext.EditServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SharedButtonTableRowEdit}" ToolTip="Editar servicio">
                                                                            <fa:FontAwesomeImage Width="16" Height="16" Style="{StaticResource SharedButtonTableRowIcon}" Icon="{x:Static icons:FontAwesomeIcon.PenToSquare}" IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                                                        </Button>
                                                                        <Button Grid.Column="3" Command="{Binding DataContext.DeleteServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SharedButtonTableRowDelete}" ToolTip="Eliminar servicio">
                                                                            <fa:FontAwesomeImage Width="16" Height="16" Style="{StaticResource SharedButtonTableRowIcon}" Icon="{x:Static icons:FontAwesomeIcon.TrashCan}" IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                                                        </Button>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                    <TextBlock Grid.Row="4" HorizontalAlignment="Center" Foreground="#B9C8DD" Text="{Binding ServicesMessage}" Visibility="{Binding HasServicesMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
            <shared:SharedLoading IsLoading="{Binding IsLoading}" />
        </Grid>

        <shared:SharedPagination Grid.Row="6" HorizontalAlignment="Left" CurrentPage="{Binding CurrentPage}" TotalPages="{Binding TotalPages}" PageCommand="{Binding GoToPageCommand}" />
    </Grid>
</UserControl>
