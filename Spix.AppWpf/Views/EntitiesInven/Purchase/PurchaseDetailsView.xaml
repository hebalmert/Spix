<UserControl x:Class="Spix.AppWpf.Views.EntitiesInven.Purchase.PurchaseDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="25" FontWeight="SemiBold" Foreground="White" Text="Detalle de la compra" />
                <TextBlock Margin="0,5,0,0" FontSize="13" Foreground="#B9C8DD" Text="Inventario / Compras / Detalle" />
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding BackCommand}" Style="{StaticResource SharedButtonFormSecondary}" Content="Volver" />
            <Button Grid.Column="3"
                    Command="{Binding CloseCommand}"
                    IsEnabled="{Binding CanManageDetails}"
                    Style="{StaticResource SharedButtonFormSuccess}"
                    Content="Cerrar compra" />
        </Grid>

        <Grid Grid.Row="2" DataContext="{Binding Purchase}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Padding="16" Background="#303640" BorderBrush="#455160" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Foreground="#B9C8DD" Text="Proveedor" />
                    <TextBlock Grid.Row="2" Foreground="White" Text="{Binding Supplier.Name}" />
                    <TextBlock Grid.Row="4" FontWeight="SemiBold" Foreground="#B9C8DD" Text="Factura" />
                    <TextBlock Grid.Row="6" Foreground="White" Text="{Binding NroFactura}" />
                </Grid>
            </Border>
            <Border Grid.Column="2" Padding="16" Background="#303640" BorderBrush="#455160" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Foreground="#B9C8DD" Text="Bodega" />
                    <TextBlock Grid.Row="2" Foreground="White" Text="{Binding ProductStorage.StorageName}" />
                    <TextBlock Grid.Row="4" FontWeight="SemiBold" Foreground="#B9C8DD" Text="Total compra" />
                    <TextBlock Grid.Row="6" FontSize="16" FontWeight="SemiBold" Foreground="#4ADE80" Text="{Binding TotalCompra, StringFormat={}{0:N2}}" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Command="{Binding NewDetailCommand}"
                    IsEnabled="{Binding CanManageDetails}"
                    Style="{StaticResource SharedButtonFormPrimary}"
                    Content="Producto" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Foreground="White" Text="Productos de la compra" />
            <shared:SharedSearchFilter Grid.Column="3"
                                       SearchText="{Binding Filter}"
                                       SearchCommand="{Binding SearchCommand}"
                                       ClearCommand="{Binding ClearSearchCommand}" />
        </Grid>

        <TextBlock Grid.Row="6"
                   Margin="0,0,0,12"
                   VerticalAlignment="Top"
                   Foreground="#FF9AAE"
                   Text="{Binding Message}"
                   Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <DataGrid Grid.Row="6"
                  Margin="0,30,0,0"
                  ItemsSource="{Binding Details}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="#303640"
                  Foreground="White"
                  BorderBrush="#455160"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Producto" Binding="{Binding Product.ProductName}" Width="*" />
                <DataGridTextColumn Header="Impuesto %" Binding="{Binding RateTax, StringFormat={}{0:N2}}" Width="110" />
                <DataGridTextColumn Header="Unitario" Binding="{Binding UnitCost, StringFormat={}{0:N2}}" Width="120" />
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="110" />
                <DataGridTextColumn Header="Subtotal" Binding="{Binding SubTotal, StringFormat={}{0:N2}}" Width="120" />
                <DataGridTextColumn Header="Impuesto" Binding="{Binding Impuesto, StringFormat={}{0:N2}}" Width="120" />
                <DataGridTextColumn Header="Total" Binding="{Binding TotalGeneral, StringFormat={}{0:N2}}" Width="120" />
                <DataGridTemplateColumn Width="96">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding DataContext.EditDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding DataContext.CanManageDetails, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="Editar"
                                        Style="{StaticResource SharedButtonTableRowEdit}">
                                    <fa:FontAwesomeImage Width="16" Height="16" Style="{StaticResource SharedButtonTableRowIcon}"
                                                         Icon="{x:Static icons:FontAwesomeIcon.PenToSquare}"
                                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                </Button>
                                <Button Command="{Binding DataContext.DeleteDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding DataContext.CanManageDetails, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="Eliminar"
                                        Style="{StaticResource SharedButtonTableRowDelete}">
                                    <fa:FontAwesomeImage Width="16" Height="16" Style="{StaticResource SharedButtonTableRowIcon}"
                                                         Icon="{x:Static icons:FontAwesomeIcon.TrashCan}"
                                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <shared:SharedLoading Grid.Row="6" IsLoading="{Binding IsLoading}" />
        <shared:SharedPagination Grid.Row="8"
                                 CurrentPage="{Binding CurrentPage}"
                                 TotalPages="{Binding TotalPages}"
                                 PageCommand="{Binding GoToPageCommand}" />
    </Grid>
</UserControl>
