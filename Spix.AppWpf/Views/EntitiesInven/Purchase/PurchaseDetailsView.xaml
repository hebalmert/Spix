<UserControl x:Class="Spix.AppWpf.Views.EntitiesInven.Purchase.PurchaseDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Spix.AppWpf.SharedServices"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:catalog="clr-namespace:Spix.AppWpf.SharedComponents.SharedCatalog"
             xmlns:rowbtn="clr-namespace:Spix.AppWpf.SharedComponents.SharedButtonRow"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents">

    <!-- El detalle de una compra, igual que en la web: arriba de que factura se trata y
         cuanto suma, y abajo sus productos.
         Mientras la compra este abierta se le agregan productos y se puede cerrar. Al
         cerrarla mueve el inventario, y desde ahi ya no se toca. -->
    <Border Style="{StaticResource SharedIndexShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- De que factura estamos hablando -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SharedCatalogTitle}">
                        <Run Text="Compra" />
                        <Run Text="{Binding Purchase.NroPurchase, Mode=OneWay}" />
                        <Run Text="&#183;" />
                        <Run Text="{Binding Purchase.Supplier.Name, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource SharedCatalogFootText}">
                        <Run Text="Factura" />
                        <Run Text="{Binding Purchase.NroFactura, Mode=OneWay}" />
                        <Run Text="&#183;" />
                        <Run Text="{Binding Purchase.FacuraDate, StringFormat=dd/MM/yyyy, Mode=OneWay}" />
                        <Run Text="&#183;" />
                        <Run Text="Bodega" />
                        <Run Text="{Binding Purchase.ProductStorage.StorageName, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <catalog:SharedCatalogPill Grid.Column="1"
                                           VerticalAlignment="Center"
                                           IsOn="{Binding Purchase.Status, Converter={StaticResource EqualsToBooleanConverter}, ConverterParameter=Completado}"
                                           OnText="Cerrada"
                                           OffText="Abierta" />
            </Grid>

            <!-- Lo que suma la factura -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,14">
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="Subtotal"
                                          Value="{Binding Purchase.SubTotalCompra, StringFormat=N2}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="Impuesto"
                                          Value="{Binding Purchase.ImpuestoTotalCompra, StringFormat=N2}"
                                          Accent="{DynamicResource BrushCatalogKpiWarn}" />
                <catalog:SharedCatalogKpi Label="Total"
                                          Value="{Binding Purchase.TotalCompra, StringFormat=N2}"
                                          Accent="{DynamicResource BrushCatalogKpiOk}" />
            </UniformGrid>

            <!-- Lo que se puede hacer con ella -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Command="{Binding BackCommand}"
                        Style="{StaticResource SharedIndexGhostButton}"
                        ToolTip="Volver a las compras"
                        svc:FormButton.Icon="{x:Static icons:FontAwesomeIcon.ArrowLeft}"
                        Content="Volver" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Visibility="{Binding CanManageDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Margin="0,0,10,0"
                            Command="{Binding NewDetailCommand}"
                            Style="{StaticResource SharedIndexNewButton}"
                            ToolTip="Agregar un producto a la compra"
                            svc:FormButton.Icon="{x:Static icons:FontAwesomeIcon.Plus}"
                            Content="Producto" />

                    <!-- Cerrar mueve el inventario y ya no se puede deshacer -->
                    <Button Command="{Binding CloseCommand}"
                            Style="{StaticResource SharedIndexGhostButton}"
                            ToolTip="Cerrar la compra y mover el inventario"
                            svc:FormButton.Icon="{x:Static icons:FontAwesomeIcon.Lock}"
                            Content="Cerrar compra" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="3"
                       Margin="0,0,0,10"
                       Style="{StaticResource SharedCatalogMessage}"
                       Text="{Binding Message}"
                       Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Border Grid.Row="4" Style="{StaticResource SharedIndexPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Border Style="{StaticResource SharedIndexHeaderBand}" />

                        <DataGrid ItemsSource="{Binding Details}"
                                  Style="{StaticResource SharedIndexGrid}"
                                  ColumnHeaderStyle="{StaticResource SharedIndexHeader}"
                                  RowStyle="{StaticResource SharedIndexRow}"
                                  CellStyle="{StaticResource SharedIndexCell}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="*" Header="Producto" SortMemberPath="Product.ProductName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding Product.ProductName}" />
                                                <!-- Aviso de que este producto entra por seriales -->
                                                <TextBlock Style="{StaticResource SharedIndexMeta}"
                                                           Text="Entra por seriales"
                                                           Visibility="{Binding Product.WithSerials, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="120" Header="Cantidad" SortMemberPath="Quantity"
                                                        HeaderStyle="{StaticResource SharedIndexHeaderRight}"
                                                        CellStyle="{StaticResource SharedIndexCellRight}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding Quantity, StringFormat=N2}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="130" Header="Unitario" SortMemberPath="UnitCost"
                                                        HeaderStyle="{StaticResource SharedIndexHeaderRight}"
                                                        CellStyle="{StaticResource SharedIndexCellRight}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding UnitCost, StringFormat=N2}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="110" Header="Impuesto %" SortMemberPath="RateTax"
                                                        HeaderStyle="{StaticResource SharedIndexHeaderRight}"
                                                        CellStyle="{StaticResource SharedIndexCellRight}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding RateTax, StringFormat=N2}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="130" Header="Subtotal" SortMemberPath="SubTotal"
                                                        HeaderStyle="{StaticResource SharedIndexHeaderRight}"
                                                        CellStyle="{StaticResource SharedIndexCellRight}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding SubTotal, StringFormat=N2}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="130" Header="Impuesto" SortMemberPath="Impuesto"
                                                        HeaderStyle="{StaticResource SharedIndexHeaderRight}"
                                                        CellStyle="{StaticResource SharedIndexCellRight}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding Impuesto, StringFormat=N2}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="140" Header="Total" SortMemberPath="TotalGeneral"
                                                        HeaderStyle="{StaticResource SharedIndexHeaderRight}"
                                                        CellStyle="{StaticResource SharedIndexCellRight}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding TotalGeneral, StringFormat=N2}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="Auto" MinWidth="96" Header="" CanUserSort="False" CellStyle="{StaticResource SharedIndexCellActions}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- Con la compra cerrada los renglones no se tocan -->
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,0,6,0"
                                                        Visibility="{Binding DataContext.CanManageDetails, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <rowbtn:SharedButtonRowEdit Command="{Binding DataContext.EditDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="Editar" />

                                                <rowbtn:SharedButtonRowDelete Command="{Binding DataContext.DeleteDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                              CommandParameter="{Binding}"
                                                                              ToolTip="Eliminar" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Details, Converter={StaticResource CountToVisibilityConverter}}">
                            <fa:FontAwesomeImage Width="26" Height="26"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource BrushIndexMeta}"
                                                 Icon="{x:Static icons:FontAwesomeIcon.BoxOpen}"
                                                 IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource SharedIndexEmpty}"
                                       Text="Esta compra todavia no tiene productos" />
                        </StackPanel>

                        <shared:SharedLoading IsLoading="{Binding IsLoading}" />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource SharedIndexPanelFoot}">
                        <shared:SharedPagination Foreground="{DynamicResource BrushCatalogMeta}"
                                                 CurrentPage="{Binding CurrentPage}"
                                                 TotalPages="{Binding TotalPages}"
                                                 PageCommand="{Binding GoToPageCommand}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
