<UserControl x:Class="Spix.AppWpf.Views.EntitiesInven.Serial.SerialIndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="25" FontWeight="SemiBold" Foreground="White" Text="Cargue seriales" />
                <TextBlock Margin="0,5,0,0" FontSize="13" Foreground="#B9C8DD" Text="Inventario / Cargue seriales" />
            </StackPanel>
            <shared:SharedSearchFilter Grid.Column="1"
                                       VerticalAlignment="Bottom"
                                       SearchText="{Binding Filter}"
                                       SearchCommand="{Binding SearchCommand}"
                                       ClearCommand="{Binding ClearSearchCommand}" />
        </Grid>
        <TextBlock Grid.Row="2"
                   Foreground="#FF9AAE"
                   Text="{Binding Message}"
                   Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="#303640"
                  Foreground="White"
                  BorderBrush="#455160"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="MAC" Binding="{Binding MacWlan}" Width="220" />
                <DataGridTextColumn Header="Comentario" Binding="{Binding Comment}" Width="*" />
                <DataGridTemplateColumn Header="Status" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding Status}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#F97316" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Averiado">
                                                <Setter Property="Foreground" Value="#F43F5E" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Operativo">
                                                <Setter Property="Foreground" Value="#4ADE80" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="52">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Editar">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SharedButtonTableRowEdit}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Operativo">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <fa:FontAwesomeImage Width="16" Height="16" Style="{StaticResource SharedButtonTableRowIcon}"
                                                     Icon="{x:Static icons:FontAwesomeIcon.PenToSquare}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <shared:SharedLoading Grid.Row="4" IsLoading="{Binding IsLoading}" />
        <shared:SharedPagination Grid.Row="6"
                                 CurrentPage="{Binding CurrentPage}"
                                 TotalPages="{Binding TotalPages}"
                                 PageCommand="{Binding GoToPageCommand}" />
    </Grid>
</UserControl>
