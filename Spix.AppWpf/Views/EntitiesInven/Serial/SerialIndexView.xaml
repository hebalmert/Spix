<UserControl x:Class="Spix.AppWpf.Views.EntitiesInven.Serial.SerialIndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Spix.AppWpf.SharedServices"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:rowbtn="clr-namespace:Spix.AppWpf.SharedComponents.SharedButtonRow"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents">

    <!-- Inventario de seriales: el molde de los listados. Todo dentro de una sola tarjeta blanca.
         Las reglas de negocio son las mismas de la web; estan comentadas donde aplican. -->
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <Border Style="{StaticResource SharedIndexShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Width="38" Height="38"
                            Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SharedIndexIconButtonEdit}"
                            ToolTip="Actualizar (F5)">
                        <fa:FontAwesomeImage Width="14" Height="14"
                                             Foreground="{DynamicResource BrushIndexIconEdit}"
                                             Icon="{x:Static icons:FontAwesomeIcon.ArrowsRotate}"
                                             IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                    </Button>

                    <shared:SharedExportButton Margin="0,0,10,0"
                                               Items="{Binding Items}"
                                               FileName="seriales" />

                    <shared:SharedSearchFilter SearchText="{Binding Filter}"
                                               SearchCommand="{Binding SearchCommand}"
                                               ClearCommand="{Binding ClearSearchCommand}" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="2"
                       Margin="0,0,0,10"
                       Style="{StaticResource SharedCatalogMessage}"
                       Text="{Binding Message}"
                       Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Border Grid.Row="3" Style="{StaticResource SharedIndexPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <!-- La franja azul del encabezado: va detras de la tabla para que sus
                             esquinas de arriba sigan la curva del panel -->
                        <Border Style="{StaticResource SharedIndexHeaderBand}" />

                        <DataGrid x:Name="ItemsGrid"
                                  ItemsSource="{Binding Items}"
                                  Style="{StaticResource SharedIndexGrid}"
                                  ColumnHeaderStyle="{StaticResource SharedIndexHeader}"
                                  RowStyle="{StaticResource SharedIndexRow}"
                                  CellStyle="{StaticResource SharedIndexCell}">

                            <DataGrid.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding EditCommand}"
                                              CommandParameter="{Binding SelectedItem, ElementName=ItemsGrid}" />
                            </DataGrid.InputBindings>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="240" Header="MAC" SortMemberPath="MacWlan">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding MacWlan}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*" Header="Comentario" SortMemberPath="Comment">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding Comment}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- El estado con el color de siempre de la casa: verde lo que sirve,
                                     ambar lo que esta en bodega sin usar, rojo lo averiado -->
                                <DataGridTemplateColumn Width="170" Header="Estado" SortMemberPath="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Status}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushCatalogStockLow}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Averiado">
                                                                <Setter Property="Foreground" Value="{DynamicResource BrushCatalogStockNone}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Operativo">
                                                                <Setter Property="Foreground" Value="{DynamicResource BrushCatalogStockOk}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="Auto" MinWidth="96" Header="" CanUserSort="False" CellStyle="{StaticResource SharedIndexCellActions}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,6,0">
                                                <!-- Un serial ya Operativo no se edita: la misma regla de la web -->
                                                <rowbtn:SharedButtonRowEdit Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="Editar"
                                                                            Visibility="{Binding Status, Converter={StaticResource NotEqualsToVisibilityConverter}, ConverterParameter=Operativo}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Items, Converter={StaticResource CountToVisibilityConverter}}">
                            <fa:FontAwesomeImage Width="26" Height="26"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource BrushIndexMeta}"
                                                 Icon="{x:Static icons:FontAwesomeIcon.Barcode}"
                                                 IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource SharedIndexEmpty}"
                                       Text="Todavia no hay seriales cargados" />

                        </StackPanel>

                        <shared:SharedLoading IsLoading="{Binding IsLoading}" />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource SharedIndexPanelFoot}">
                        <shared:SharedPagination Foreground="{DynamicResource BrushCatalogMeta}"
                                                 CurrentPage="{Binding CurrentPage}"
                                                 TotalPages="{Binding TotalPages}"
                                                 TotalRecords="{Binding TotalRecords}"
                                                 PageCommand="{Binding GoToPageCommand}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
