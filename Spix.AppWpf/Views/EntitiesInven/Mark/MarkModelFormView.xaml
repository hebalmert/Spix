<UserControl x:Class="Spix.AppWpf.Views.EntitiesInven.Mark.MarkModelFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="620">
    <Grid Margin="0,24,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
            <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Modelo" />
        </Border>
        <TextBox Grid.Column="1" MinHeight="42" MaxLength="50" Padding="12,8" Background="White" BorderBrush="#566273" Text="{Binding Entity.MarkModelName, UpdateSourceTrigger=PropertyChanged}" />
    </Grid>
</UserControl>
