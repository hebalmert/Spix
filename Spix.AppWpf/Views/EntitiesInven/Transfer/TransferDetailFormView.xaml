<UserControl x:Class="Spix.AppWpf.Views.EntitiesInven.Transfer.TransferDetailFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="720">
    <!-- Una linea del traslado. La cantidad esta topada por lo que hay en la bodega de
         origen: ese dato lo entrega el Backend al elegir el producto. -->
    <Grid Margin="0,24,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1">
                <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Categoria" />
            </Border>
            <ComboBox Grid.Column="1"
                      MinHeight="42"
                      ItemsSource="{Binding Categories}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="ProductCategoryId"
                      SelectedValue="{Binding ProductCategoryId, Mode=OneWay}"
                      SelectionChanged="CategorySelectionChanged" />
            <Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1">
                <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Producto" />
            </Border>
            <ComboBox Grid.Column="4"
                      MinHeight="42"
                      ItemsSource="{Binding Products}"
                      DisplayMemberPath="ProductName"
                      SelectedValuePath="ProductId"
                      SelectedValue="{Binding Entity.ProductId, Mode=OneWay}"
                      SelectionChanged="ProductSelectionChanged" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1">
                <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Disponible" />
            </Border>
            <TextBox Grid.Column="1" MinHeight="42" Padding="12,8" IsReadOnly="True"
                     Text="{Binding StockAvailable, StringFormat={}{0:N2}}" />
            <Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1">
                <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Cantidad" />
            </Border>
            <!-- Con serial la cantidad NO se escribe: la cuentan los equipos marcados -->
            <TextBox Grid.Column="4" MinHeight="42" Padding="12,8"
                     IsReadOnly="{Binding ProductWithSerials}"
                     Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Los equipos que se mueven. Solo para los productos con serial: el equipo es
             la unidad, asi que se marcan uno por uno y la cantidad los cuenta. -->
        <StackPanel Grid.Row="4"
                    Margin="0,12,0,0"
                    Visibility="{Binding ProductWithSerials, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Foreground="#FFFFFF" FontSize="12" Text="Elija los equipos que se mueven" />

            <!-- La caja va BLANCA, igual que en la web: asi las casillas y las MAC se leen
                 con los colores normales y no hay que pintar cada CheckBox a mano sobre el
                 azul. Pintarlos uno a uno peleaba con el tema y terminaba tapando el texto. -->
            <Border Margin="0,6,0,0"
                    MaxHeight="190"
                    Padding="10"
                    CornerRadius="10"
                    Background="#FFFFFF"
                    BorderBrush="#E6ECF6"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AvailableSerials}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="0,3"
                                          Foreground="#102A43"
                                          FontSize="13"
                                          Content="{Binding MacWlan}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
