<UserControl x:Class="Spix.AppWpf.Views.EntitiesInven.Transfer.TransferFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="760">
    <!-- El encabezado del traslado: la fecha y las dos bodegas.
         Las dos listas son la misma consulta, igual que en la web: una bodega puede ser
         origen o destino. Que no sean la misma lo valida el ViewModel. -->
    <Grid Margin="0,24,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1">
                <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Fecha" />
            </Border>
            <DatePicker Grid.Column="1" MinHeight="42" SelectedDate="{Binding Entity.DateTransfer, Mode=TwoWay}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1">
                <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Desde bodega" />
            </Border>
            <ComboBox Grid.Column="1" MinHeight="42"
                      ItemsSource="{Binding ProductStorages}"
                      DisplayMemberPath="StorageName"
                      SelectedValuePath="ProductStorageId"
                      SelectedValue="{Binding Entity.FromProductStorageId, Mode=TwoWay}" />
            <Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1">
                <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Hacia bodega" />
            </Border>
            <ComboBox Grid.Column="4" MinHeight="42"
                      ItemsSource="{Binding ProductStorages}"
                      DisplayMemberPath="StorageName"
                      SelectedValuePath="ProductStorageId"
                      SelectedValue="{Binding Entity.ToProductStorageId, Mode=TwoWay}" />
        </Grid>
    </Grid>
</UserControl>
