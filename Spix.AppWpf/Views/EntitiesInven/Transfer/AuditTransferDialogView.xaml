<UserControl x:Class="Spix.AppWpf.Views.EntitiesInven.Transfer.AuditTransferDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="520">
    <!-- El historial del traslado: quien lo creo, quien lo cerro y quien recibio.
         No pide nada al servidor: esos datos viajan en la propia fila del traslado.

         Mismo diseño que la web: etiqueta chica arriba, el nombre grande, la fecha
         debajo, y la barra lateral de color que dice de que se trata.

         OJO: en WPF un Border NO recorta a sus esquinas redondeadas, solo al rectangulo.
         Por eso la barra lleva SU PROPIO redondeo a la izquierda (11 = los 12 de la
         tarjeta menos el borde de 1). -->
    <UserControl.Resources>
        <Style x:Key="TarjetaHistorial" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource BrushCatalogCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushCatalogKpiBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0,24,0,0">

        <Border Style="{StaticResource TarjetaHistorial}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border CornerRadius="11,0,0,11" Background="#0D6EFD" />
                <StackPanel Grid.Column="1" Margin="14,12">
                    <TextBlock Style="{StaticResource SharedIndexMeta}" Text="Creado por" />
                    <TextBlock Margin="0,2,0,0" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushCatalogName}"
                               Text="{Binding Creador}" />
                    <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding FechaCreado}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource TarjetaHistorial}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border CornerRadius="11,0,0,11" Background="{Binding AcentoCierre}" />
                <StackPanel Grid.Column="1" Margin="14,12">
                    <TextBlock Style="{StaticResource SharedIndexMeta}" Text="Cerrado por" />
                    <TextBlock Margin="0,2,0,0" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushCatalogName}"
                               Text="{Binding Cerrador}" />
                    <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding FechaCerrado}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource TarjetaHistorial}" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border CornerRadius="11,0,0,11" Background="#0DCAF0" />
                <StackPanel Grid.Column="1" Margin="14,12">
                    <TextBlock Style="{StaticResource SharedIndexMeta}" Text="Recibe" />
                    <TextBlock Margin="0,2,0,0" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushCatalogName}"
                               Text="{Binding Recibe}" />
                </StackPanel>
            </Grid>
        </Border>

    </StackPanel>
</UserControl>
