<UserControl x:Class="Spix.AppWpf.Views.EntitiesInven.Cargue.CargueIndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="25" FontWeight="SemiBold" Foreground="White" Text="Cargue de seriales" />
                <TextBlock Margin="0,5,0,0" FontSize="13" Foreground="#B9C8DD" Text="Inventario / Cargue seriales" />
            </StackPanel>
            <shared:SharedSearchFilter Grid.Column="1"
                                       VerticalAlignment="Bottom"
                                       SearchText="{Binding Filter}"
                                       SearchCommand="{Binding SearchCommand}"
                                       ClearCommand="{Binding ClearSearchCommand}" />
        </Grid>
        <TextBlock Grid.Row="2"
                   Foreground="#FF9AAE"
                   Text="{Binding Message}"
                   Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="#303640"
                  Foreground="White"
                  BorderBrush="#455160"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding DateCargue, StringFormat={}{0:dd/MM/yyyy}}" Width="125" />
                <DataGridTextColumn Header="Control" Binding="{Binding ControlCargue}" Width="110" />
                <DataGridTextColumn Header="Factura" Binding="{Binding PurchaseDetail.Purchase.NroFactura}" Width="160" />
                <DataGridTextColumn Header="A subir" Binding="{Binding CantToUp, StringFormat={}{0:N0}}" Width="100" />
                <DataGridTextColumn Header="Subidos" Binding="{Binding TotalSeriales, StringFormat={}{0:N0}}" Width="100" />
                <DataGridTemplateColumn Header="Carga" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="{Binding Converter={StaticResource CargueSerialUploadStatusConverter}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#F97316" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Completado">
                                                <Setter Property="Foreground" Value="#4ADE80" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="144">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding DataContext.DetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Ver detalle"
                                        Style="{StaticResource SharedButtonTableRowDetails}">
                                    <fa:FontAwesomeImage Width="16" Height="16" Style="{StaticResource SharedButtonTableRowIcon}"
                                                         Icon="{x:Static icons:FontAwesomeIcon.List}"
                                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                </Button>
                                 <Button Command="{Binding DataContext.UploadSerialsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         CommandParameter="{Binding}"
                                         ToolTip="Subir seriales"
                                         Visibility="{Binding Converter={StaticResource CargueCanUploadSerialConverter}}"
                                         Style="{StaticResource SharedButtonTableRowDetails}">
                                    <fa:FontAwesomeImage Width="16" Height="16" Style="{StaticResource SharedButtonTableRowIcon}"
                                                         Icon="{x:Static icons:FontAwesomeIcon.Upload}"
                                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                </Button>
                                <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Eliminar">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SharedButtonTableRowDelete}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Completado">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <fa:FontAwesomeImage Width="16" Height="16" Style="{StaticResource SharedButtonTableRowIcon}"
                                                         Icon="{x:Static icons:FontAwesomeIcon.TrashCan}"
                                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <shared:SharedLoading Grid.Row="4" IsLoading="{Binding IsLoading}" />
        <shared:SharedPagination Grid.Row="6"
                                 CurrentPage="{Binding CurrentPage}"
                                 TotalPages="{Binding TotalPages}"
                                 PageCommand="{Binding GoToPageCommand}" />
    </Grid>
</UserControl>
