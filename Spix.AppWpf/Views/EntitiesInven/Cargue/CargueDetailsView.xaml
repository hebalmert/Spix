<UserControl x:Class="Spix.AppWpf.Views.EntitiesInven.Cargue.CargueDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="25" FontWeight="SemiBold" Foreground="White" Text="Detalle cargue seriales" />
                <TextBlock Margin="0,5,0,0" FontSize="13" Foreground="#B9C8DD" Text="Inventario / Cargue seriales / Detalle" />
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding BackCommand}" Style="{StaticResource SharedButtonFormSecondary}" Content="Volver" />
            <Button Grid.Column="3"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource SharedButtonFormSuccess}"
                    Visibility="{Binding CanCloseCargue, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Content="Cerrar cargue" />
        </Grid>
        <Grid Grid.Row="2" DataContext="{Binding Cargue}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Padding="16" Background="#303640" BorderBrush="#455160" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Foreground="#B9C8DD" Text="Producto" />
                    <TextBlock Grid.Row="2" Foreground="White" Text="{Binding Product.ProductName}" />
                    <TextBlock Grid.Row="4" FontWeight="SemiBold" Foreground="#B9C8DD" Text="Factura" />
                    <TextBlock Grid.Row="6" Foreground="White" Text="{Binding PurchaseDetail.Purchase.NroFactura}" />
                </Grid>
            </Border>
            <Border Grid.Column="2" Padding="16" Background="#303640" BorderBrush="#455160" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Foreground="#B9C8DD" Text="Seriales" />
                    <TextBlock Grid.Row="2" Foreground="White" Text="{Binding TotalSeriales, StringFormat={}{0:N0}}" />
                    <TextBlock Grid.Row="4" FontWeight="SemiBold" Foreground="#B9C8DD" Text="Seriales requeridos" />
                    <TextBlock Grid.Row="6" FontSize="16" FontWeight="SemiBold" Foreground="#F97316" Text="{Binding CantToUp, StringFormat={}{0:N0}}" />
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Command="{Binding UploadSerialCommand}"
                    Style="{StaticResource SharedButtonFormPrimary}"
                    Visibility="{Binding CanUploadSerials, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Content="Subir serial" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Foreground="White" Text="Seriales cargados" />
            <shared:SharedSearchFilter Grid.Column="3" SearchText="{Binding Filter}" SearchCommand="{Binding SearchCommand}" ClearCommand="{Binding ClearSearchCommand}" />
        </Grid>
        <TextBlock Grid.Row="6" Margin="0,0,0,12" VerticalAlignment="Top" Foreground="#FF9AAE" Text="{Binding Message}" Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <DataGrid Grid.Row="6" Margin="0,30,0,0" ItemsSource="{Binding Details}" AutoGenerateColumns="False" IsReadOnly="True" Background="#303640" Foreground="White" BorderBrush="#455160" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="MAC" Binding="{Binding MacWlan}" Width="260" />
                <DataGridTextColumn Header="Comentario" Binding="{Binding Comment}" Width="*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" />
                <DataGridTemplateColumn Width="96">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding DataContext.EditSerialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Editar"
                                        Style="{StaticResource SharedButtonTableRowEdit}"
                                        Visibility="{Binding DataContext.CanManageSerials, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <fa:FontAwesomeImage Width="16" Height="16" Style="{StaticResource SharedButtonTableRowIcon}" Icon="{x:Static icons:FontAwesomeIcon.PenToSquare}" IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                </Button>
                                <Button Command="{Binding DataContext.DeleteSerialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Eliminar"
                                        Style="{StaticResource SharedButtonTableRowDelete}"
                                        Visibility="{Binding DataContext.CanManageSerials, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <fa:FontAwesomeImage Width="16" Height="16" Style="{StaticResource SharedButtonTableRowIcon}" Icon="{x:Static icons:FontAwesomeIcon.TrashCan}" IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <shared:SharedLoading Grid.Row="6" IsLoading="{Binding IsLoading}" />
        <shared:SharedPagination Grid.Row="8" CurrentPage="{Binding CurrentPage}" TotalPages="{Binding TotalPages}" PageCommand="{Binding GoToPageCommand}" />
    </Grid>
</UserControl>
