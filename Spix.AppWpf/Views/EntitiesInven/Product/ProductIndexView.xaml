<UserControl x:Class="Spix.AppWpf.Views.EntitiesInven.Product.ProductIndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" VerticalAlignment="Bottom" Command="{Binding NewCommand}" Style="{StaticResource SharedButtonFormPrimary}">
                <StackPanel Orientation="Horizontal">
                    <fa:FontAwesomeImage Width="16" Height="16" Icon="{x:Static icons:FontAwesomeIcon.CirclePlus}" IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                    <TextBlock Margin="10,0,0,0" Text="Nuevo" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="2">
                <TextBlock FontSize="25" FontWeight="SemiBold" Foreground="White" Text="Categoria/Productos" />
                <TextBlock Margin="0,5,0,0" FontSize="13" Foreground="#B9C8DD" Text="Inventario / Categoria y productos" />
            </StackPanel>
            <shared:SharedSearchFilter Grid.Column="3" VerticalAlignment="Bottom" SearchText="{Binding Filter}" SearchCommand="{Binding SearchCommand}" ClearCommand="{Binding ClearSearchCommand}" />
        </Grid>
        <TextBlock Grid.Row="2" FontSize="13" Foreground="#FF9AAE" Text="{Binding Message}" Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <Border Grid.Row="4" Background="#303640" BorderBrush="#455160" BorderThickness="1" CornerRadius="4">
            <Grid Margin="0,0,0,2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Background="#102A4C">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Margin="14,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" Text="Categoria" />
                    <TextBlock Grid.Column="2" Margin="14,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" Text="Productos" />
                    <TextBlock Grid.Column="3" Margin="14,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" Text="Activo" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#3B4452" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="42" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Background="#303640">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="48" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Command="{Binding DataContext.ToggleProductsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SharedButtonTableRowDetails}">
                                                <fa:FontAwesomeImage Width="16" Height="16" Style="{StaticResource SharedButtonTableRowIcon}" Icon="{x:Static icons:FontAwesomeIcon.ChevronRight}" IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                            </Button>
                                            <TextBlock Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Foreground="White" Text="{Binding Name}" />
                                            <TextBlock Grid.Column="2" Margin="14,0" VerticalAlignment="Center" Foreground="White" Text="{Binding ProductsNumer}" />
                                            <CheckBox Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Active}" IsHitTestVisible="False" />
                                            <Button Grid.Column="4" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SharedButtonTableRowEdit}">
                                                <fa:FontAwesomeImage Width="16" Height="16" Style="{StaticResource SharedButtonTableRowIcon}" Icon="{x:Static icons:FontAwesomeIcon.PenToSquare}" IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                            </Button>
                                            <Button Grid.Column="5" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SharedButtonTableRowDelete}">
                                                <fa:FontAwesomeImage Width="16" Height="16" Style="{StaticResource SharedButtonTableRowIcon}" Icon="{x:Static icons:FontAwesomeIcon.TrashCan}" IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                            </Button>
                                        </Grid>
                                        <Border Grid.Row="1" Margin="26,0,16,14" Padding="16" Background="#252B35" BorderBrush="#526176" BorderThickness="1" CornerRadius="6" Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="12" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="12" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Button HorizontalAlignment="Left" Command="{Binding DataContext.NewProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SharedButtonFormPrimary}" Content="Nuevo producto" />
                                                <StackPanel Grid.Row="2" Visibility="{Binding IsProductsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <ProgressBar Height="4" IsIndeterminate="True" />
                                                    <TextBlock Margin="0,10,0,0" Foreground="#B9C8DD" Text="Cargando productos..." />
                                                </StackPanel>
                                                <Grid Grid.Row="4" Visibility="{Binding HasProducts, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="34" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Background="#17202D">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="96" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" Text="Producto" />
                                                        <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" Text="Stock" />
                                                        <TextBlock Grid.Column="2" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" Text="Seriales" />
                                                        <TextBlock Grid.Column="3" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" Text="Activo" />
                                                    </Grid>
                                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Products}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid MinHeight="42" Background="#2E3641">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="100" />
                                                                        <ColumnDefinition Width="100" />
                                                                        <ColumnDefinition Width="96" />
                                                                        <ColumnDefinition Width="48" />
                                                                        <ColumnDefinition Width="48" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Margin="12,4" VerticalAlignment="Center">
                                                                        <TextBlock Foreground="White" Text="{Binding ProductName}" />
                                                                        <TextBlock FontSize="11" Foreground="#B9C8DD" Text="{Binding Mark.MarkName}" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Foreground="White" Text="{Binding TotalInventario}" />
                                                                    <CheckBox Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding WithSerials}" IsHitTestVisible="False" />
                                                                    <CheckBox Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Active}" IsHitTestVisible="False" />
                                                                    <Button Grid.Column="4" Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SharedButtonTableRowEdit}">
                                                                        <fa:FontAwesomeImage Width="16" Height="16" Style="{StaticResource SharedButtonTableRowIcon}" Icon="{x:Static icons:FontAwesomeIcon.PenToSquare}" IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                                                    </Button>
                                                                    <Button Grid.Column="5" Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SharedButtonTableRowDelete}">
                                                                        <fa:FontAwesomeImage Width="16" Height="16" Style="{StaticResource SharedButtonTableRowIcon}" Icon="{x:Static icons:FontAwesomeIcon.TrashCan}" IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                                <TextBlock Grid.Row="4" HorizontalAlignment="Center" Foreground="#B9C8DD" Text="{Binding ProductsMessage}" Visibility="{Binding HasProductsMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
        <shared:SharedLoading Grid.Row="4" IsLoading="{Binding IsLoading}" />
        <shared:SharedPagination Grid.Row="6" HorizontalAlignment="Left" CurrentPage="{Binding CurrentPage}" TotalPages="{Binding TotalPages}" PageCommand="{Binding GoToPageCommand}" />
    </Grid>
</UserControl>
