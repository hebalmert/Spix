<UserControl x:Class="Spix.AppWpf.Views.EntitiesInven.Product.ProductFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="780">
    <Grid Margin="0,24,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Producto" />
            </Border>
            <TextBox Grid.Column="1" MinHeight="42" MaxLength="50" Padding="12,8" Background="White" BorderBrush="#566273" Text="{Binding Entity.ProductName, UpdateSourceTrigger=PropertyChanged}" />
            <Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Marca" />
            </Border>
            <ComboBox Grid.Column="4" MinHeight="42" Padding="10,6" ItemsSource="{Binding Marks}" DisplayMemberPath="MarkName" SelectedValuePath="MarkId" SelectedValue="{Binding Entity.MarkId, Mode=TwoWay}" SelectionChanged="MarkSelectionChanged" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Modelo" />
            </Border>
            <ComboBox Grid.Column="1" MinHeight="42" Padding="10,6" ItemsSource="{Binding MarkModels}" DisplayMemberPath="MarkModelName" SelectedValuePath="MarkModelId" SelectedValue="{Binding Entity.MarkModelId, Mode=TwoWay}" />
            <Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Impuesto" />
            </Border>
            <ComboBox Grid.Column="4" MinHeight="42" Padding="10,6" ItemsSource="{Binding Taxes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Entity.TaxId, Mode=TwoWay}" />
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Costo" />
            </Border>
            <TextBox Grid.Column="1" MinHeight="42" Padding="12,8" Background="White" BorderBrush="#566273" Text="{Binding Entity.Costo, UpdateSourceTrigger=PropertyChanged}" />
            <Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Precio" />
            </Border>
            <TextBox Grid.Column="4" MinHeight="42" Padding="12,8" Background="White" BorderBrush="#566273" Text="{Binding Entity.Price, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Con seriales" />
            </Border>
            <Border Grid.Column="1" MinHeight="42" Background="White" BorderBrush="#566273" BorderThickness="1">
                <CheckBox Margin="14,0" VerticalAlignment="Center" Content="Con seriales" IsChecked="{Binding Entity.WithSerials}" />
            </Border>
            <Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Activo" />
            </Border>
            <Border Grid.Column="4" MinHeight="42" Background="White" BorderBrush="#566273" BorderThickness="1" CornerRadius="0,6,6,0">
                <CheckBox Margin="14,0" VerticalAlignment="Center" Content="Activo" IsChecked="{Binding Entity.Active}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
