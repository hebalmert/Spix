<UserControl x:Class="Spix.AppWpf.Views.EntitiesInven.Storage.ProductStorageFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="720">
    <Grid Margin="0,24,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Bodega" /></Border>
            <TextBox Grid.Column="1" MinHeight="42" Padding="12,8" Text="{Binding Entity.StorageName, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Estado" /></Border>
            <ComboBox Grid.Column="1" MinHeight="42" ItemsSource="{Binding States}" DisplayMemberPath="Name" SelectedValuePath="StateId" SelectedValue="{Binding Entity.StateId, Mode=TwoWay}" SelectionChanged="StateSelectionChanged" />
            <Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Ciudad" /></Border>
            <ComboBox Grid.Column="4" MinHeight="42" ItemsSource="{Binding Cities}" DisplayMemberPath="Name" SelectedValuePath="CityId" SelectedValue="{Binding Entity.CityId, Mode=TwoWay}" />
        </Grid>
    </Grid>
</UserControl>
