<UserControl x:Class="Spix.AppWpf.Views.EntitiesPayment.PrePayment.PrePaymentIndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Spix.AppWpf.SharedServices"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:catalog="clr-namespace:Spix.AppWpf.SharedComponents.SharedCatalog"
             xmlns:rowbtn="clr-namespace:Spix.AppWpf.SharedComponents.SharedButtonRow"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents">

    <!-- Pagos adelantados: dinero recibido ANTES de la nota de cobro; alli se cruza.

         La tabla trae solo los que todavia NO se han cruzado: cuando la facturacion aplica
         el adelanto, la fila desaparece de aqui. Si la nota se anula, vuelve a aparecer.

         El tablero se recarga al crear, editar o borrar; buscar y paginar no lo tocan. -->
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <Border Style="{StaticResource SharedIndexShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <UniformGrid Columns="4"
                         Margin="0,0,0,14"
                         Visibility="{Binding HasSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="Pendientes"
                                          Value="{Binding Pending}"
                                          Accent="{DynamicResource BrushCatalogKpiWarn}"
                                          ValueBrush="{DynamicResource BrushCatalogKpiWarnText}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="Monto pendiente"
                                          Value="{Binding PendingTotal, StringFormat=N2}"
                                          Accent="{DynamicResource BrushCatalogKpiOk}"
                                          ValueBrush="{DynamicResource BrushCatalogKpiOk}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="Contratos"
                                          Value="{Binding Contracts}" />
                <catalog:SharedCatalogKpi Label="Cruzado este mes"
                                          Value="{Binding BilledMonthTotal, StringFormat=N2}" />
            </UniformGrid>

            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Command="{Binding NewCommand}"
                        Style="{StaticResource SharedIndexNewButton}"
                        ToolTip="Registrar un pago adelantado (Ctrl+N)"
                        svc:FormButton.Icon="{x:Static icons:FontAwesomeIcon.HandHoldingDollar}"
                        Content="Nuevo" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Width="38" Height="38"
                            Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SharedIndexIconButtonEdit}"
                            ToolTip="Actualizar (F5)">
                        <fa:FontAwesomeImage Width="14" Height="14"
                                             Foreground="{DynamicResource BrushIndexIconEdit}"
                                             Icon="{x:Static icons:FontAwesomeIcon.ArrowsRotate}"
                                             IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                    </Button>

                    <shared:SharedSearchFilter SearchText="{Binding Filter}"
                                               SearchCommand="{Binding SearchCommand}"
                                               ClearCommand="{Binding ClearSearchCommand}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource SharedIndexPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Border Style="{StaticResource SharedIndexHeaderBand}" />

                        <DataGrid ItemsSource="{Binding Rows}"
                                  Style="{StaticResource SharedIndexGrid}"
                                  ColumnHeaderStyle="{StaticResource SharedIndexHeader}"
                                  RowStyle="{StaticResource SharedIndexRow}"
                                  CellStyle="{StaticResource SharedIndexCell}">

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="*" MinWidth="220" Header="Cliente" SortMemberPath="ClientName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding ClientName}" />
                                                <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding ContractText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="150" Header="Periodo" SortMemberPath="PeriodText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Height="22"
                                                    Padding="10,0"
                                                    CornerRadius="11"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource BrushIndexPillOnBack}"
                                                    BorderBrush="{DynamicResource BrushIndexPillOnBorder}"
                                                    BorderThickness="1">
                                                <TextBlock VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrushIndexPillOnText}"
                                                           Text="{Binding PeriodText}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*" MinWidth="160" Header="Plan" SortMemberPath="PlanName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding PlanName}" />

                                                <!-- Los servicios adelantados quedan reservados por este pago -->
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding HasServices, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <fa:FontAwesomeImage Width="11" Height="11"
                                                                         Margin="0,0,6,0"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource BrushIndexMeta}"
                                                                         Icon="{x:Static icons:FontAwesomeIcon.ScrewdriverWrench}"
                                                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                                    <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding ServicesText}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="130" Header="Fecha de pago" SortMemberPath="DatePaymentText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding DatePaymentText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="130" Header="Total" SortMemberPath="PriceWithTax">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Right"
                                                       Style="{StaticResource SharedIndexName}"
                                                       Text="{Binding PriceWithTax, StringFormat=N2}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="Auto" MinWidth="120" Header="" CanUserSort="False" CellStyle="{StaticResource SharedIndexCellActions}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,6,0">
                                                <rowbtn:SharedButtonRowEdit Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}"
                                                                            Icon="{x:Static icons:FontAwesomeIcon.PenToSquare}"
                                                                            ToolTip="Editar el pago adelantado" />

                                                <!-- El bloqueo por facturado vive en el backend: aqui el boton no se esconde -->
                                                <rowbtn:SharedButtonRowDelete Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                              CommandParameter="{Binding}"
                                                                              ToolTip="Borrar el pago adelantado" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Rows, Converter={StaticResource CountToVisibilityConverter}}">
                            <fa:FontAwesomeImage Width="26" Height="26"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource BrushIndexMeta}"
                                                 Icon="{x:Static icons:FontAwesomeIcon.HandHoldingDollar}"
                                                 IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource SharedIndexEmpty}"
                                       Text="No hay registros para mostrar" />
                        </StackPanel>

                        <shared:SharedLoading IsLoading="{Binding IsLoading}" />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource SharedIndexPanelFoot}">
                        <shared:SharedPagination Foreground="{DynamicResource BrushCatalogMeta}"
                                                 CurrentPage="{Binding CurrentPage}"
                                                 TotalPages="{Binding TotalPages}"
                                                 PageCommand="{Binding GoToPageCommand}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
