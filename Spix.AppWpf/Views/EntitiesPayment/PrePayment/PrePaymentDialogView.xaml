<UserControl x:Class="Spix.AppWpf.Views.EntitiesPayment.PrePayment.PrePaymentDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:catalog="clr-namespace:Spix.AppWpf.SharedComponents.SharedCatalog"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             MinWidth="900">

    <!-- Registrar o corregir un pago adelantado.

         Se elige el contrato, se marcan los servicios ya ejecutados que el cliente quiere
         pagar de una vez y se indica el periodo. El plan del mes va SIEMPRE incluido.

         Los montos que se ven son informativos: el backend rearma el dinero con los precios
         frescos de la base al guardar. -->
    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Se escribe y caen los contratos ACTIVOS que coinciden -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SharedFormLabel}">
                <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Cliente" />
            </Border>
            <shared:SharedSearchPicker Grid.Column="1"
                                       Text="{Binding SearchText, Mode=TwoWay}"
                                       Items="{Binding Candidates}"
                                       SearchCommand="{Binding SearchContractsCommand}"
                                       SelectCommand="{Binding SelectContractCommand}">
                <shared:SharedSearchPicker.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding ClientFullName}" />
                                <TextBlock Style="{StaticResource SharedIndexMeta}">
                                    <Run Text="Contrato" /><Run Text=" " /><Run Text="{Binding ControlContrato, Mode=OneWay}" />
                                    <Run Text=" · " /><Run Text="{Binding ZoneName, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource SharedIndexMeta}"
                                           Text="{Binding PlanName}" />
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource SharedIndexName}"
                                           Text="{Binding PlanPriceWithTax, StringFormat=N2}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </shared:SharedSearchPicker.ItemTemplate>
            </shared:SharedSearchPicker>
        </Grid>

        <!-- Que este buscando, o que no haya ninguno, hay que DECIRLO: en silencio se ve
             igual que un buscador que no funciona -->
        <TextBlock Grid.Row="1" Grid.Column="0"
                   Margin="152,6,0,0"
                   Style="{StaticResource SharedIndexMeta}"
                   Text="Buscando..."
                   Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <TextBlock Grid.Row="1" Grid.Column="0"
                   Margin="152,6,0,0"
                   Style="{StaticResource SharedIndexMeta}"
                   Text="No hay contratos activos que coincidan."
                   Visibility="{Binding NoResults, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- Los datos del contrato: solo se consultan -->
        <UniformGrid Grid.Row="3" Columns="4"
                     Visibility="{Binding HasContract, Converter={StaticResource BooleanToVisibilityConverter}}">
            <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                      Label="Contrato"
                                      Value="{Binding SelectedContract.ControlContrato}" />
            <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                      Label="Direccion"
                                      Value="{Binding SelectedContract.Address}" />
            <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                      Label="Ciudad y zona"
                                      Value="{Binding SelectedContract.ZoneName}" />
            <catalog:SharedCatalogKpi Label="Telefono"
                                      Value="{Binding SelectedContract.PhoneNumber}" />
        </UniformGrid>

        <UniformGrid Grid.Row="5" Columns="4"
                     Visibility="{Binding HasContract, Converter={StaticResource BooleanToVisibilityConverter}}">
            <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                      Label="Plan"
                                      Value="{Binding SelectedContract.PlanName}"
                                      Accent="{DynamicResource BrushCatalogKpiOk}" />
            <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                      Label="Tax"
                                      Value="{Binding SelectedContract.TaxRate, StringFormat=N2}" />
            <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                      Label="Sub total del plan"
                                      Value="{Binding SelectedContract.PlanPrice, StringFormat=N2}" />
            <catalog:SharedCatalogKpi Label="Total del plan"
                                      Value="{Binding SelectedContract.PlanPriceWithTax, StringFormat=N2}" />
        </UniformGrid>

        <!-- Servicios ya ejecutados que el cliente decide pagar por adelantado -->
        <Border Grid.Row="7"
                Padding="14,12"
                CornerRadius="12"
                Background="{DynamicResource BrushCatalogCard}"
                BorderBrush="{DynamicResource BrushCatalogKpiBorder}"
                BorderThickness="1"
                Visibility="{Binding HasContract, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <fa:FontAwesomeImage Width="14" Height="14"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource BrushCatalogKpiAccent}"
                                         Icon="{x:Static icons:FontAwesomeIcon.ScrewdriverWrench}"
                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource SharedIndexName}"
                               Text="Servicios por adelantar" />
                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource SharedIndexMeta}"
                               Text="Solicitudes completadas sin facturar. Lo que marque queda reservado para este pago." />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Style="{StaticResource SharedIndexMeta}"
                           Text="Este contrato no tiene servicios pendientes."
                           Visibility="{Binding NoServices, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <ScrollViewer Grid.Row="2" MaxHeight="200" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Services}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Margin="0,0,10,0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding Title}" />
                                        <TextBlock Style="{StaticResource SharedIndexMeta}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Meta}"
                                                   ToolTip="{Binding Meta}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource SharedIndexName}"
                                               Text="{Binding Total, StringFormat=N2}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Lo que se esta recibiendo: el plan del mes mas lo que se marco -->
        <StackPanel Grid.Row="9"
                    HorizontalAlignment="Right"
                    Visibility="{Binding HasContract, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Margin="0,0,12,0" Style="{StaticResource SharedIndexMeta}" Text="Plan" />
                <TextBlock MinWidth="110"
                           TextAlignment="Right"
                           Style="{StaticResource SharedIndexName}"
                           Text="{Binding PlanTotal, StringFormat=N2}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <TextBlock Margin="0,0,12,0" Style="{StaticResource SharedIndexMeta}" Text="Servicios" />
                <TextBlock MinWidth="110"
                           TextAlignment="Right"
                           Style="{StaticResource SharedIndexName}"
                           Text="{Binding ServicesTotal, StringFormat=N2}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <TextBlock Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource SharedIndexMeta}"
                           Text="Total" />
                <TextBlock MinWidth="110"
                           FontSize="18"
                           FontWeight="Bold"
                           TextAlignment="Right"
                           Foreground="{DynamicResource BrushCatalogName}"
                           Text="{Binding Total, StringFormat=N2}" />
            </StackPanel>
        </StackPanel>

        <!-- Fecha del pago y periodo que se esta adelantando -->
        <Grid Grid.Row="11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SharedFormLabel}">
                <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Fecha" />
            </Border>
            <DatePicker Grid.Column="1"
                        MinHeight="42"
                        SelectedDate="{Binding DatePayment, Mode=TwoWay}"
                        SelectedDateFormat="Short" />

            <Border Grid.Column="3" Style="{StaticResource SharedFormLabel}">
                <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Ano" />
            </Border>
            <TextBox Grid.Column="4"
                     MaxLength="4"
                     Style="{StaticResource SharedFormBox}"
                     Text="{Binding YearNumber, Mode=TwoWay}" />

            <Border Grid.Column="6" Style="{StaticResource SharedFormLabel}">
                <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Mes" />
            </Border>
            <ComboBox Grid.Column="7"
                      Style="{StaticResource SharedFormCombo}"
                      ItemsSource="{Binding Months}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding MonthValue, Mode=TwoWay}" />
        </Grid>

        <!-- Solo al corregir: si ya se cruzo con una nota de cobro, el backend no deja tocarlo -->
        <Grid Grid.Row="13"
              Visibility="{Binding IsEdit, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SharedFormLabel}">
                <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Facturado" />
            </Border>
            <CheckBox Grid.Column="1"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      IsEnabled="False"
                      IsChecked="{Binding Billed, Mode=OneWay}" />

            <Border Grid.Column="3" Style="{StaticResource SharedFormLabel}">
                <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Fecha de cruce" />
            </Border>
            <TextBox Grid.Column="4"
                     IsReadOnly="True"
                     Style="{StaticResource SharedFormBox}"
                     Text="{Binding DateBilledText, Mode=OneWay}" />
        </Grid>

        <shared:SharedModalActions Grid.Row="15"
                                   SaveCommand="{Binding SaveCommand}"
                                   CancelCommand="{Binding CancelCommand}" />

        <shared:SharedLoading Grid.RowSpan="16" IsLoading="{Binding IsLoading}" />
    </Grid>
</UserControl>
