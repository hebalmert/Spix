<UserControl x:Class="Spix.AppWpf.Views.EntitiesPayment.ContractorCxC.ContractorCxCCancelDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             MinWidth="560">

    <!-- Anular la cuenta. El aviso amarillo ES la confirmacion: no hay pregunta previa,
         porque lo que se hace no es destructivo y se explica ahi mismo. -->
    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Margin="0,0,0,14"
                Padding="12,8"
                CornerRadius="8"
                Background="{DynamicResource BrushCatalogCard}"
                BorderBrush="{DynamicResource BrushCatalogKpiWarn}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <fa:FontAwesomeImage Width="14" Height="14"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource BrushCatalogKpiWarn}"
                                     Icon="{x:Static icons:FontAwesomeIcon.TriangleExclamation}"
                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />

                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource SharedIndexMeta}"
                           TextWrapping="Wrap"
                           Text="{Binding WarningText}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1">
            <TextBlock Margin="2,0,0,6" Style="{StaticResource SharedIndexMeta}" Text="Descripcion" />

            <TextBox MinHeight="100"
                     AcceptsReturn="True"
                     MaxLength="250"
                     Style="{StaticResource SharedFormBox}"
                     Text="{Binding Motivo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top" />
        </StackPanel>

        <shared:SharedModalActions Grid.Row="2"
                                   Margin="0,20,0,0"
                                   SaveText="Anular cuenta"
                                   SaveCommand="{Binding SaveCommand}"
                                   CancelCommand="{Binding CancelCommand}" />
    </Grid>
</UserControl>
