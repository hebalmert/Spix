<UserControl x:Class="Spix.AppWpf.Views.EntitiesPayment.CxCBill.CxCBillCancelDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             MinWidth="520">

    <!-- Anular la nota. NO se borra: queda como historia, y el pago adelantado y la
         exoneracion vuelven a quedar sin facturar para poder refacturar el periodo.

         El motivo es obligatorio: una anulacion sin explicacion no sirve de nada despues. -->
    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,10">
            <TextBlock Margin="2,0,0,6" Style="{StaticResource SharedIndexMeta}" Text="Motivo" />

            <TextBox MinHeight="120"
                     AcceptsReturn="True"
                     MaxLength="250"
                     Style="{StaticResource SharedFormBox}"
                     Text="{Binding DescriptionCancelled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top" />
        </StackPanel>

        <shared:SharedModalActions Grid.Row="1"
                                   Margin="0,14,0,0"
                                   SaveText="Guardar"
                                   SaveCommand="{Binding SaveCommand}"
                                   CancelCommand="{Binding CancelCommand}" />
    </Grid>
</UserControl>
