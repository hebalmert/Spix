<UserControl x:Class="Spix.AppWpf.Views.EntitiesPayment.CxCBill.CxCBillDetailDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             MinWidth="760">

    <!-- De que se compone la nota y que se le ha recibido.

         Arriba van los renglones de la FACTURA que respalda la nota, y abajo los abonos.
         Es de sola lectura: aqui no se cobra ni se anula. -->
    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Margin="0,0,0,14"
                Padding="14,10"
                CornerRadius="12"
                Background="{DynamicResource BrushCatalogCard}"
                BorderBrush="{DynamicResource BrushCatalogKpiBorder}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding ClientName}" />
                    <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding HeaderText}" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource BrushCatalogKpiAccent}"
                           Text="{Binding CollectionNote}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" MinHeight="120" Style="{StaticResource SharedIndexPanel}">
            <Grid>
                <Border Style="{StaticResource SharedIndexHeaderBand}" />

                <DataGrid ItemsSource="{Binding Lines}"
                          Style="{StaticResource SharedIndexGrid}"
                          ColumnHeaderStyle="{StaticResource SharedIndexHeader}"
                          RowStyle="{StaticResource SharedIndexRow}"
                          CellStyle="{StaticResource SharedIndexCell}">

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="*" MinWidth="240" Header="Concepto" SortMemberPath="Concept">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SharedIndexName}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Concept}" />
                                        <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding OriginName}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="120" Header="Sub total" SortMemberPath="UnitPrice">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Right"
                                               Style="{StaticResource SharedIndexMeta}"
                                               Text="{Binding UnitPrice, StringFormat=N2}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="110" Header="Tax" SortMemberPath="TaxAmount">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Right"
                                               Style="{StaticResource SharedIndexMeta}"
                                               Text="{Binding TaxAmount, StringFormat=N2}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="130" Header="Total" SortMemberPath="Price">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Right"
                                               Style="{StaticResource SharedIndexName}"
                                               Text="{Binding Price, StringFormat=N2}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="2,14,0,6"
                   Style="{StaticResource SharedIndexMeta}"
                   Text="LO QUE SE LE HA RECIBIDO" />

        <Border Grid.Row="3" MinHeight="90" Style="{StaticResource SharedIndexPanel}">
            <Grid>
                <Border Style="{StaticResource SharedIndexHeaderBand}" />

                <DataGrid ItemsSource="{Binding Payments}"
                          Style="{StaticResource SharedIndexGrid}"
                          ColumnHeaderStyle="{StaticResource SharedIndexHeader}"
                          RowStyle="{StaticResource SharedIndexRow}"
                          CellStyle="{StaticResource SharedIndexCell}">

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="120" Header="Fecha" SortMemberPath="DatePaymentText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding DatePaymentText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="150" Header="Modo" SortMemberPath="ModeName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding ModeName}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="*" MinWidth="200" Header="Detalle" SortMemberPath="Detail">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource SharedIndexMeta}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Detail}"
                                               ToolTip="{Binding Detail}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="120" Header="Exoneracion" SortMemberPath="Discount">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Right"
                                               Style="{StaticResource SharedIndexMeta}"
                                               Text="{Binding Discount, StringFormat=N2}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="120" Header="Abono" SortMemberPath="Payment">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Right"
                                               Style="{StaticResource SharedIndexName}"
                                               Text="{Binding Payment, StringFormat=N2}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <TextBlock Margin="0,0,18,0" VerticalAlignment="Center" Style="{StaticResource SharedIndexMeta}">
                <Run Text="Total  " /><Run FontWeight="Bold" Text="{Binding Total, StringFormat=N2, Mode=OneWay}" />
            </TextBlock>

            <TextBlock Margin="0,0,18,0" VerticalAlignment="Center" Style="{StaticResource SharedIndexMeta}">
                <Run Text="Abono  " /><Run FontWeight="Bold" Text="{Binding TotalPayment, StringFormat=N2, Mode=OneWay}" />
            </TextBlock>

            <TextBlock Margin="0,0,18,0" VerticalAlignment="Center" Style="{StaticResource SharedIndexMeta}">
                <Run Text="Exoneracion  " /><Run FontWeight="Bold" Text="{Binding TotalDiscount, StringFormat=N2, Mode=OneWay}" />
            </TextBlock>

            <TextBlock VerticalAlignment="Center"
                       FontSize="15"
                       Foreground="{DynamicResource BrushCatalogKpiAccent}">
                <Run Text="Saldo  " /><Run FontSize="18" FontWeight="Bold" Text="{Binding Balance, StringFormat=N2, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <shared:SharedModalActions Grid.Row="5"
                                   Margin="0,20,0,0"
                                   ShowSave="False"
                                   CancelCommand="{Binding CancelCommand}" />

        <shared:SharedLoading Grid.RowSpan="6" IsLoading="{Binding IsLoading}" />
    </Grid>
</UserControl>
