<Window x:Class="Spix.AppWpf.Views.Auth.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
        xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
        Title="Cambiar clave"
        Width="520"
        Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Border Padding="30" Background="{StaticResource BrushShellContent}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <fa:FontAwesomeImage Width="22" Height="22" Foreground="#22C1E8"
                                         Icon="{x:Static icons:FontAwesomeIcon.Key}"
                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                    <TextBlock Margin="12,0,0,0" FontSize="21" FontWeight="SemiBold" Foreground="White" Text="Cambiar clave" />
                </StackPanel>
                <TextBlock Margin="0,10,0,0" FontSize="13" Foreground="#B9C8DD" Text="Actualiza la clave de acceso de tu cuenta." />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,30,0,20">
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#E5ECF7" Text="Clave actual" />
                <PasswordBox Margin="0,8,0,18" Padding="12,8" Background="#FFFFFF" BorderBrush="#566273" BorderThickness="1"
                             FontSize="15" PasswordChanged="CurrentPasswordChanged" />

                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#E5ECF7" Text="Nueva clave" />
                <PasswordBox Margin="0,8,0,18" Padding="12,8" Background="#FFFFFF" BorderBrush="#566273" BorderThickness="1"
                             FontSize="15" PasswordChanged="NewPasswordChanged" />

                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#E5ECF7" Text="Confirmar nueva clave" />
                <PasswordBox Margin="0,8,0,0" Padding="12,8" Background="#FFFFFF" BorderBrush="#566273" BorderThickness="1"
                             FontSize="15" PasswordChanged="ConfirmPasswordChanged" />

                <TextBlock Margin="0,14,0,0" FontSize="13" Text="{Binding Message}" TextWrapping="Wrap"
                           Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WasSuccess}" Value="True">
                                    <Setter Property="Foreground" Value="#51D88A" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding WasSuccess}" Value="False">
                                    <Setter Property="Foreground" Value="#FF9AAE" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancelar" Click="CancelClick" Style="{StaticResource SharedButtonFormSecondary}" />
                <Button Grid.Column="2" Content="Actualizar clave" Command="{Binding SaveCommand}" Style="{StaticResource SharedButtonFormSuccess}" />
            </Grid>
        </Grid>
    </Border>
</Window>
