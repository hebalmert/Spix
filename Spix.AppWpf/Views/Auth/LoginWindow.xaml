<Window x:Class="Spix.AppWpf.Views.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
        xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
        Title="Spix"
        Width="1360"
        Height="760"
        MinWidth="1100"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32*" />
            <ColumnDefinition Width="68*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BrushSidebarBackground}">
            <Grid Margin="58">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                    <Image Width="190"
                           Height="190"
                           Source="/Assets/Images/LogoNexxtplanetIcon.png"
                           Stretch="Uniform" />
                    <TextBlock Margin="0,28,0,0"
                               HorizontalAlignment="Center"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="SPIX" />
                    <TextBlock Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               FontSize="16"
                               Foreground="#C4D7F6"
                               Text="Software para proveedores de internet" />
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               Foreground="#8EADD7"
                               Text="Versión Desktop" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Border Background="{StaticResource BrushAppBackgroundImage}" />
            <Border Background="{StaticResource BrushAppBackgroundOverlay}" />

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource SharedLoginCard}">
                <StackPanel>
                    <Image Width="286"
                           Height="88"
                           HorizontalAlignment="Center"
                           Source="/Assets/Images/LogoNexxtplanet.png"
                           Stretch="Uniform" />

                    <TextBlock Margin="0,30,0,30"
                               FontSize="24"
                               FontWeight="Normal"
                               Foreground="#5E636B"
                               Text="Accede a tu cuenta" />

                    <Border Style="{StaticResource SharedLoginField}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource SharedLoginFieldLabel}">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <fa:FontAwesomeImage Width="22"
                                                         Height="22"
                                                         Foreground="#212529"
                                                         Icon="{x:Static icons:FontAwesomeIcon.User}"
                                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                    <TextBlock Margin="14,0,0,0"
                                               FontSize="18"
                                               Foreground="#343A40"
                                               Text="Usuario" />
                                </StackPanel>
                            </Border>

                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SharedLoginTextInput}"
                                     Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SharedLoginField}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource SharedLoginFieldLabel}">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <fa:FontAwesomeImage Width="24"
                                                         Height="24"
                                                         Foreground="#212529"
                                                         Icon="{x:Static icons:FontAwesomeIcon.Envelope}"
                                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                    <TextBlock Margin="14,0,0,0"
                                               FontSize="18"
                                               Foreground="#343A40"
                                               Text="Clave" />
                                </StackPanel>
                            </Border>

                            <PasswordBox x:Name="PasswordBox"
                                         Grid.Column="1"
                                         Margin="14,0"
                                         Padding="0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="18"
                                         Foreground="#102A4C"
                                         PasswordChanged="PasswordBoxPasswordChanged"
                                         VerticalContentAlignment="Center" />
                            <TextBox x:Name="PasswordTextBox"
                                     Grid.Column="1"
                                     Margin="14,0"
                                     Padding="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="18"
                                     Foreground="#102A4C"
                                     Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     Visibility="Collapsed" />
                            <Button x:Name="TogglePasswordButton"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Click="TogglePasswordVisibility"
                                    Style="{StaticResource SharedLoginPasswordToggle}">
                                <Grid Width="24" Height="24">
                                    <fa:FontAwesomeImage x:Name="OpenEyeIcon"
                                                         Width="24"
                                                         Height="24"
                                                         Foreground="#737982"
                                                         Icon="{x:Static icons:FontAwesomeIcon.Eye}"
                                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                    <fa:FontAwesomeImage x:Name="ClosedEyeIcon"
                                                         Width="24"
                                                         Height="24"
                                                         Foreground="#737982"
                                                         Icon="{x:Static icons:FontAwesomeIcon.EyeSlash}"
                                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}"
                                                         Visibility="Collapsed" />
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock Margin="0,4,0,32"
                               HorizontalAlignment="Right"
                               FontSize="15"
                               Foreground="#2F6DFF"
                               Text="¿Olvidó su clave?" />

                    <TextBlock Margin="0,-20,0,20"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               Foreground="#C62828"
                               Text="{Binding ErrorMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Button Content="Entrar"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource SharedButtonFormSuccess}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <fa:FontAwesomeImage Width="18"
                                                         Height="18"
                                                         Margin="0,0,12,0"
                                                         Foreground="White"
                                                         Icon="{x:Static icons:FontAwesomeIcon.RightToBracket}"
                                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                    <TextBlock VerticalAlignment="Center" Text="Entrar" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
