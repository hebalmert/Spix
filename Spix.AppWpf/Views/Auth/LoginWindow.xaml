<Window x:Class="Spix.AppWpf.Views.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
        xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
        Title="Spix"
        Width="1180"
        Height="720"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Panel de marca: se esconde solo cuando la ventana queda angosta, y entonces
             la tarjeta se queda sola sobre el fondo -->
        <Border Grid.Column="0"
                Width="420"
                Background="{StaticResource BrushSidebarBackground}"
                Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WidthToVisibilityConverter}, ConverterParameter=980}">
            <Grid Margin="46,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="1">
                    <Image Width="128"
                           Height="128"
                           HorizontalAlignment="Left"
                           Source="/Assets/Images/LogoNexxtplanetIcon.png"
                           Stretch="Uniform" />

                    <TextBlock Margin="0,26,0,0"
                               Style="{StaticResource SharedLoginBrandTitle}"
                               Text="SPIX" />
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource SharedLoginBrandText}"
                               Text="Software para proveedores de internet" />

                    <Border Width="52"
                            Height="3"
                            Margin="0,22,0,22"
                            HorizontalAlignment="Left"
                            Background="{StaticResource BrushLoginAccent}"
                            CornerRadius="2" />

                    <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                        <fa:FontAwesomeImage Width="15" Height="15" Foreground="{StaticResource BrushLoginAccent}"
                                             Icon="{x:Static icons:FontAwesomeIcon.NetworkWired}"
                                             IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                        <TextBlock Style="{StaticResource SharedLoginFeature}" Text="Tu red, tus nodos y tus servidores" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                        <fa:FontAwesomeImage Width="15" Height="15" Foreground="{StaticResource BrushLoginAccent}"
                                             Icon="{x:Static icons:FontAwesomeIcon.MoneyBillTransfer}"
                                             IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                        <TextBlock Style="{StaticResource SharedLoginFeature}" Text="Cobros, cartera y recaudo al dia" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <fa:FontAwesomeImage Width="15" Height="15" Foreground="{StaticResource BrushLoginAccent}"
                                             Icon="{x:Static icons:FontAwesomeIcon.Bolt}"
                                             IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                        <TextBlock Style="{StaticResource SharedLoginFeature}" Text="Cortes y activaciones desde tu red local" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Style="{StaticResource SharedLoginBrandMeta}"
                           Text="Version Desktop · NexxtPlanet" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Border Background="{StaticResource BrushAppBackgroundImage}" />
            <Border Background="{StaticResource BrushAppBackgroundOverlay}" />

            <!-- La tarjeta se desplaza sola si la ventana queda baja -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource SharedLoginCard}">
                    <StackPanel>
                        <Image Width="196"
                               Height="60"
                               HorizontalAlignment="Center"
                               Source="/Assets/Images/LogoNexxtplanet.png"
                               Stretch="Uniform" />

                        <TextBlock Margin="0,26,0,2"
                                   Style="{StaticResource SharedLoginTitle}"
                                   Text="Accede a tu cuenta" />
                        <TextBlock Margin="0,0,0,24"
                                   Style="{StaticResource SharedLoginSubtitle}"
                                   Text="Entra con el usuario que te dieron en tu empresa." />

                        <Border Style="{StaticResource SharedLoginError}"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <fa:FontAwesomeImage Width="14" Height="14" Margin="0,2,10,0"
                                                     VerticalAlignment="Top"
                                                     Foreground="{StaticResource BrushLoginErrorText}"
                                                     Icon="{x:Static icons:FontAwesomeIcon.CircleExclamation}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                <TextBlock Style="{StaticResource SharedLoginErrorText}"
                                           Text="{Binding ErrorMessage}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SharedLoginLabel}" Text="Usuario" />
                        <Border Style="{StaticResource SharedLoginField}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <fa:FontAwesomeImage Grid.Column="0"
                                                     Width="16" Height="16"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource BrushLoginIcon}"
                                                     Icon="{x:Static icons:FontAwesomeIcon.User}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />

                                <TextBox x:Name="UserNameBox"
                                         Grid.Column="1"
                                         Style="{StaticResource SharedLoginTextInput}"
                                         Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource SharedLoginLabel}" Text="Clave" />
                        <Border Style="{StaticResource SharedLoginField}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <fa:FontAwesomeImage Grid.Column="0"
                                                     Width="16" Height="16"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource BrushLoginIcon}"
                                                     Icon="{x:Static icons:FontAwesomeIcon.Lock}"
                                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />

                                <PasswordBox x:Name="PasswordBox"
                                             Grid.Column="1"
                                             Style="{StaticResource SharedLoginPasswordInput}"
                                             PasswordChanged="PasswordBoxPasswordChanged" />
                                <TextBox x:Name="PasswordTextBox"
                                         Grid.Column="1"
                                         Style="{StaticResource SharedLoginTextInput}"
                                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="Collapsed" />

                                <Button x:Name="TogglePasswordButton"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Click="TogglePasswordVisibility"
                                        Style="{StaticResource SharedLoginPasswordToggle}">
                                    <Grid Width="16" Height="16">
                                        <fa:FontAwesomeImage x:Name="OpenEyeIcon"
                                                             Width="16" Height="16"
                                                             Foreground="{StaticResource BrushLoginIcon}"
                                                             Icon="{x:Static icons:FontAwesomeIcon.Eye}"
                                                             IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                        <fa:FontAwesomeImage x:Name="ClosedEyeIcon"
                                                             Width="16" Height="16"
                                                             Foreground="{StaticResource BrushLoginIcon}"
                                                             Icon="{x:Static icons:FontAwesomeIcon.EyeSlash}"
                                                             IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}"
                                                             Visibility="Collapsed" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,2,2,22"
                                   Style="{StaticResource SharedLoginLink}"
                                   Text="¿Olvidó su clave?" />

                        <!-- Entrar tambien responde a la tecla Enter -->
                        <Button IsDefault="True"
                                Command="{Binding LoginCommand}"
                                Style="{StaticResource SharedLoginButton}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <fa:FontAwesomeImage Width="16" Height="16"
                                                         Margin="0,0,10,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="White"
                                                         Icon="{x:Static icons:FontAwesomeIcon.RightToBracket}"
                                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                    <TextBlock x:Name="LoginButtonText" VerticalAlignment="Center" Text="Entrar" />
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <!-- La barra solo aparece mientras el Backend responde -->
                        <ProgressBar Height="3"
                                     Margin="0,10,0,0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource BrushLoginAccent}"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
