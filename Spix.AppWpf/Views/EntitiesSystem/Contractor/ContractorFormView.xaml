<UserControl x:Class="Spix.AppWpf.Views.EntitiesSystem.Contractor.ContractorFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             MinWidth="850">

    <!-- El formulario del contratista, replicado del FormContractor de la web: los mismos
         campos, en el mismo orden. Todas las filas van igual: etiqueta pegada al campo.
         La foto sale con el icono de persona de corbata mientras no haya ninguna, igual
         que el InputImageGeneral de la web con su PlaceholderIcon. -->
    <Grid Margin="0,24,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Del disco o con la camara, igual que la web -->
            <shared:SharedImagePicker VerticalAlignment="Top"
                                      Title="Foto"
                                      ImageUrl="{Binding Entity.ImageFullPath}"
                                      Icon="{x:Static icons:FontAwesomeIcon.UserTie}"
                                      ImageSelected="PhotoSelected" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SharedFormLabel}">
                        <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Nombre" />
                    </Border>
                    <TextBox Grid.Column="1"
                             MaxLength="50"
                             Style="{StaticResource SharedFormBox}"
                             Text="{Binding Entity.FirstName, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SharedFormLabel}">
                        <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Apellido" />
                    </Border>
                    <TextBox Grid.Column="1"
                             MaxLength="50"
                             Style="{StaticResource SharedFormBox}"
                             Text="{Binding Entity.LastName, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- La lista llega armada del backend, con su neutro: aqui solo se pinta -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SharedFormLabel}">
                        <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Tipo documento" />
                    </Border>
                    <ComboBox Grid.Column="1"
                              Style="{StaticResource SharedFormCombo}"
                              ItemsSource="{Binding DocumentTypes}"
                              DisplayMemberPath="DocumentName"
                              SelectedValuePath="DocumentTypeId"
                              SelectedValue="{Binding Entity.DocumentTypeId, Mode=TwoWay}" />
                </Grid>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SharedFormLabel}">
                        <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Nro documento" />
                    </Border>
                    <TextBox Grid.Column="1"
                             MaxLength="15"
                             Style="{StaticResource SharedFormBox}"
                             Text="{Binding Entity.Document, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SharedFormLabel}">
                        <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Telefono" />
                    </Border>
                    <TextBox Grid.Column="1"
                             MaxLength="25"
                             Style="{StaticResource SharedFormBox}"
                             Text="{Binding Entity.PhoneNumber, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SharedFormLabel}">
                <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Direccion" />
            </Border>
            <TextBox Grid.Column="1"
                     MinHeight="72"
                     MaxLength="256"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Style="{StaticResource SharedFormBox}"
                     Text="{Binding Entity.Address, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- El usuario de login no se cambia al editar: Identity busca la cuenta por ese
             nombre y el backend rechaza el cambio -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SharedFormLabel}">
                <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Correo" />
            </Border>
            <TextBox Grid.Column="1"
                     MaxLength="256"
                     Style="{StaticResource SharedFormBox}"
                     Text="{Binding Entity.Email, UpdateSourceTrigger=PropertyChanged}" />

            <Border Grid.Column="3" Style="{StaticResource SharedFormLabel}">
                <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Usuario" />
            </Border>
            <TextBox Grid.Column="4"
                     MaxLength="24"
                     IsReadOnly="{Binding IsEditControl}"
                     Style="{StaticResource SharedFormBox}"
                     Text="{Binding Entity.UserName, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SharedFormLabel}">
                <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Comision" />
            </Border>
            <TextBox Grid.Column="1"
                     Style="{StaticResource SharedFormBox}"
                     Text="{Binding Entity.Rate, UpdateSourceTrigger=PropertyChanged}" />

            <Border Grid.Column="3" Style="{StaticResource SharedFormLabel}">
                <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Guardar pago" />
            </Border>
            <Border Grid.Column="4" Style="{StaticResource SharedFormBoxBorder}">
                <CheckBox Margin="14,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding Entity.GuardarPago}"
                          Content="Guardar pago" />
            </Border>
        </Grid>

        <!-- Sin contratista activo no hay cuenta que crear: la casilla se apaga sola -->
        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SharedFormLabel}">
                <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Activo" />
            </Border>
            <Border Grid.Column="1" Style="{StaticResource SharedFormBoxBorder}">
                <CheckBox Margin="14,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding Entity.Active}"
                          Checked="ActiveChanged"
                          Unchecked="ActiveChanged"
                          Content="Activo" />
            </Border>

            <Border Grid.Column="3" Style="{StaticResource SharedFormLabel}">
                <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Crear cuenta" />
            </Border>
            <Border Grid.Column="4" Style="{StaticResource SharedFormBoxBorder}">
                <CheckBox Margin="14,0"
                          VerticalAlignment="Center"
                          IsEnabled="{Binding CanCreateAccount}"
                          IsChecked="{Binding Entity.CreateAccount}"
                          Content="Crear cuenta" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
