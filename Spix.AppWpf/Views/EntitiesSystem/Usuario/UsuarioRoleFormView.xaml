<UserControl x:Class="Spix.AppWpf.Views.EntitiesSystem.Usuario.UsuarioRoleFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="520">

    <!-- El formulario de un rol es un solo combo. La lista llega armada del backend con
         su neutro en la posicion 0: aqui solo se pinta. -->
    <Grid Margin="0,24,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" MinWidth="200" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource SharedFormLabel}">
            <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Rol" />
        </Border>
        <ComboBox Grid.Column="1"
                  Style="{StaticResource SharedFormCombo}"
                  ItemsSource="{Binding Roles}"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Value"
                  SelectedValue="{Binding SelectedRole, Mode=TwoWay}" />
    </Grid>
</UserControl>
