<UserControl x:Class="Spix.AppWpf.Views.EntitiesReports.byzone.ReportByZoneIndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:catalog="clr-namespace:Spix.AppWpf.SharedComponents.SharedCatalog"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents">

    <!-- Contratos por zona: los contratos de una zona con su plan y lo que factura.

         Es de SOLA LECTURA: no hay crear, editar ni borrar, y las filas no tienen botones.

         No hay boton de Buscar: se baja por estado y ciudad hasta la zona, y elegir la zona
         (o cambiar el estado del contrato) es lo que dispara la consulta. Paginar NO vuelve
         a pedir el tablero: esos numeros son los de toda la zona. -->

    <Border Style="{StaticResource SharedIndexShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Las cuatro listas vienen armadas del backend, con su neutro en la posicion 0 -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="170" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" MinWidth="170" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" MinWidth="170" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" MinWidth="170" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Margin="2,0,0,6" Style="{StaticResource SharedIndexMeta}" Text="Estado" />
                    <ComboBox Style="{StaticResource SharedFormCombo}"
                              ItemsSource="{Binding States}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding StateId, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Margin="2,0,0,6" Style="{StaticResource SharedIndexMeta}" Text="Ciudad" />
                    <ComboBox Style="{StaticResource SharedFormCombo}"
                              ItemsSource="{Binding Cities}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding CityId, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Margin="2,0,0,6" Style="{StaticResource SharedIndexMeta}" Text="Zona" />
                    <ComboBox Style="{StaticResource SharedFormCombo}"
                              ItemsSource="{Binding Zones}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding ZoneId, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Margin="2,0,0,6" Style="{StaticResource SharedIndexMeta}" Text="Contratos" />
                    <ComboBox Style="{StaticResource SharedFormCombo}"
                              ItemsSource="{Binding ContractStates}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding ContractStateId, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <!-- Lo que factura la zona, solo cuando ya hay una zona elegida -->
            <UniformGrid Grid.Row="1"
                         Columns="3"
                         Margin="0,0,0,14"
                         Visibility="{Binding HasSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="Contratos"
                                          Value="{Binding Contracts}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="Facturacion mensual"
                                          Value="{Binding MonthlyTotal, StringFormat=N2}"
                                          Accent="{DynamicResource BrushCatalogKpiOk}"
                                          ValueBrush="{DynamicResource BrushCatalogKpiOk}" />
                <catalog:SharedCatalogKpi Label="Sin plan"
                                          Value="{Binding WithoutPlan}"
                                          Accent="{DynamicResource BrushCatalogKpiBad}"
                                          ValueBrush="{DynamicResource BrushCatalogKpiBadText}" />
            </UniformGrid>

            <Border Grid.Row="2" Style="{StaticResource SharedIndexPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Border Style="{StaticResource SharedIndexHeaderBand}" />

                        <DataGrid ItemsSource="{Binding Rows}"
                                  Style="{StaticResource SharedIndexGrid}"
                                  ColumnHeaderStyle="{StaticResource SharedIndexHeader}"
                                  RowStyle="{StaticResource SharedIndexRow}"
                                  CellStyle="{StaticResource SharedIndexCell}">

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="*" MinWidth="260" Header="Cliente" SortMemberPath="ClientFullName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding ClientFullName}" />

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock VerticalAlignment="Center"
                                                               Style="{StaticResource SharedIndexMeta}"
                                                               Text="{Binding ContractText}" />

                                                    <!-- La pastilla solo aparece cuando el contrato no esta activo -->
                                                    <Border Margin="8,0,0,0"
                                                            Style="{StaticResource SharedIndexPill}"
                                                            Visibility="{Binding Active, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                        <TextBlock Style="{StaticResource SharedIndexPillText}" Text="No activo" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="200" Header="Equipo" SortMemberPath="ServerName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding ServerName}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="200" Header="Plan" SortMemberPath="PlanName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding PlanName}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="140" Header="Monto" SortMemberPath="PlanPrice">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Right"
                                                       Style="{StaticResource SharedIndexName}"
                                                       Text="{Binding PlanPrice, StringFormat=N2}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Rows, Converter={StaticResource CountToVisibilityConverter}}">
                            <fa:FontAwesomeImage Width="26" Height="26"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource BrushIndexMeta}"
                                                 Icon="{x:Static icons:FontAwesomeIcon.LocationDot}"
                                                 IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource SharedIndexEmpty}"
                                       Text="{Binding EmptyText}" />
                        </StackPanel>

                        <shared:SharedLoading IsLoading="{Binding IsLoading}" />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource SharedIndexPanelFoot}">
                        <shared:SharedPagination Foreground="{DynamicResource BrushCatalogMeta}"
                                                 CurrentPage="{Binding CurrentPage}"
                                                 TotalPages="{Binding TotalPages}"
                                                 PageCommand="{Binding GoToPageCommand}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
