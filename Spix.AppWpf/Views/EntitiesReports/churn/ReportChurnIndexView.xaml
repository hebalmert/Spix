<UserControl x:Class="Spix.AppWpf.Views.EntitiesReports.churn.ReportChurnIndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:catalog="clr-namespace:Spix.AppWpf.SharedComponents.SharedCatalog"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents">

    <!-- Contratos fuera de servicio: quien ya no esta pagando y cuanto se dejo de facturar.

         Es de SOLA LECTURA: no hay crear, editar ni borrar, y las filas no tienen botones.

         No lleva filtros ni paginacion porque el contrato no guarda la fecha del retiro:
         lo que se ve es la foto de hoy, entera, no un periodo. -->

    <Border Style="{StaticResource SharedIndexShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Lo que hoy no esta dando servicio. Las tres primeras tarjetas traen los dos
                 numeros juntos, contratos y monto, porque asi se leen en la web -->
            <UniformGrid Columns="4"
                         Margin="0,0,0,14"
                         Visibility="{Binding HasSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="Retirados (contratos - monto)"
                                          Value="{Binding TerminatedText}"
                                          Accent="{DynamicResource BrushCatalogKpiBad}"
                                          ValueBrush="{DynamicResource BrushCatalogKpiBadText}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="Anulados (contratos - monto)"
                                          Value="{Binding CancelledText}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="Suspendidos hoy (contratos - monto)"
                                          Value="{Binding SuspendedText}"
                                          Accent="{DynamicResource BrushCatalogKpiWarn}"
                                          ValueBrush="{DynamicResource BrushCatalogKpiWarnText}" />
                <catalog:SharedCatalogKpi Label="Facturacion perdida"
                                          Value="{Binding LostText}" />
            </UniformGrid>

            <!-- La aclaracion de como se cuenta: sin ella el usuario cree que es del mes -->
            <Border Grid.Row="1"
                    Margin="0,0,0,14"
                    Padding="12,8"
                    BorderThickness="4,0,0,0"
                    BorderBrush="{DynamicResource BrushCatalogKpiAccent}"
                    Visibility="{Binding HasSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <fa:FontAwesomeImage Width="14" Height="14"
                                         Margin="0,2,8,0"
                                         VerticalAlignment="Top"
                                         Foreground="{DynamicResource BrushIndexMeta}"
                                         Icon="{x:Static icons:FontAwesomeIcon.CircleExclamation}"
                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                    <TextBlock MaxWidth="900"
                               Style="{StaticResource SharedIndexMessage}"
                               Text="{Binding NoteText}" />
                </StackPanel>
            </Border>

            <!-- En que zonas se esta yendo la gente -->
            <StackPanel Grid.Row="2" Margin="2,0,0,8" Orientation="Horizontal">
                <fa:FontAwesomeImage Width="13" Height="13"
                                     Margin="0,0,7,0"
                                     Foreground="{DynamicResource BrushIndexMeta}"
                                     Icon="{x:Static icons:FontAwesomeIcon.LocationDot}"
                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                <TextBlock Style="{StaticResource SharedIndexName}" Text="Donde se esta yendo la gente" />
            </StackPanel>

            <Border Grid.Row="3" Style="{StaticResource SharedIndexPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Border Style="{StaticResource SharedIndexHeaderBand}" />

                        <DataGrid ItemsSource="{Binding Rows}"
                                  Style="{StaticResource SharedIndexGrid}"
                                  ColumnHeaderStyle="{StaticResource SharedIndexHeader}"
                                  RowStyle="{StaticResource SharedIndexRow}"
                                  CellStyle="{StaticResource SharedIndexCell}">

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="*" MinWidth="240" Header="Zona" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding Name}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="140" Header="Contratos" SortMemberPath="Contracts">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Right"
                                                       Style="{StaticResource SharedIndexMeta}"
                                                       Text="{Binding Contracts, StringFormat=N0}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="160" Header="Monto" SortMemberPath="Amount">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Right"
                                                       Style="{StaticResource SharedIndexName}"
                                                       Text="{Binding Amount, StringFormat=N2}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Rows, Converter={StaticResource CountToVisibilityConverter}}">
                            <fa:FontAwesomeImage Width="26" Height="26"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource BrushIndexMeta}"
                                                 Icon="{x:Static icons:FontAwesomeIcon.LocationDot}"
                                                 IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource SharedIndexEmpty}"
                                       Text="{Binding EmptyText}" />
                        </StackPanel>

                        <shared:SharedLoading IsLoading="{Binding IsLoading}" />
                    </Grid>

                    <!-- El total de la tabla: en la web es la ultima fila del cuadro -->
                    <Border Grid.Row="1" Style="{StaticResource SharedIndexPanelFoot}">
                        <TextBlock HorizontalAlignment="Right"
                                   Style="{StaticResource SharedIndexName}"
                                   Text="{Binding TotalsText}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
