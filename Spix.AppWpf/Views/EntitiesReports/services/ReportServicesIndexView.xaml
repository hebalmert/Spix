<UserControl x:Class="Spix.AppWpf.Views.EntitiesReports.services.ReportServicesIndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Spix.AppWpf.SharedServices"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:catalog="clr-namespace:Spix.AppWpf.SharedComponents.SharedCatalog"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents">

    <!-- Servicios del periodo: como entraron las solicitudes, como terminaron, cuales se
         repiten y quien las resolvio.

         Es de SOLA LECTURA: no hay crear, editar ni borrar, y las filas no tienen botones.
         Los tres endpoints devuelven el periodo completo, no paginan: por eso el pie de cada
         panel lleva los totales en lugar de la paginacion.

         Las dos listas van lado a lado y no una debajo de la otra: la de tecnicos tiene solo
         dos columnas y apilarlas dejaria a cada tabla con dos filas visibles. -->
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding SearchCommand}" />
    </UserControl.InputBindings>

    <Border Style="{StaticResource SharedIndexShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- El periodo y el boton: no se busca solo al cambiar una fecha -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Margin="2,0,0,6" Style="{StaticResource SharedIndexMeta}" Text="Desde" />
                    <DatePicker Width="140"
                                MinHeight="38"
                                SelectedDate="{Binding DateStart, Mode=TwoWay}"
                                SelectedDateFormat="Short" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Margin="2,0,0,6" Style="{StaticResource SharedIndexMeta}" Text="Hasta" />
                    <DatePicker Width="140"
                                MinHeight="38"
                                SelectedDate="{Binding DateEnd, Mode=TwoWay}"
                                SelectedDateFormat="Short" />
                </StackPanel>

                <Button Grid.Column="4"
                        VerticalAlignment="Bottom"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource SharedIndexNewButton}"
                        ToolTip="Buscar (F5)"
                        svc:FormButton.Icon="{x:Static icons:FontAwesomeIcon.MagnifyingGlass}"
                        Content="Buscar" />
            </Grid>

            <!-- Como entraron y como terminaron -->
            <UniformGrid Grid.Row="1"
                         Columns="6"
                         Margin="0,0,0,14"
                         Visibility="{Binding HasSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="Solicitadas"
                                          Value="{Binding Requested, StringFormat=N0}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="Resueltas por telefono"
                                          Value="{Binding PhoneResolved, StringFormat=N0}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="Agendadas"
                                          Value="{Binding Scheduled, StringFormat=N0}"
                                          Accent="{DynamicResource BrushCatalogKpiWarn}"
                                          ValueBrush="{DynamicResource BrushCatalogKpiWarnText}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="Completadas"
                                          Value="{Binding Completed, StringFormat=N0}"
                                          Accent="{DynamicResource BrushCatalogKpiOk}"
                                          ValueBrush="{DynamicResource BrushCatalogKpiOk}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="Canceladas"
                                          Value="{Binding Cancelled, StringFormat=N0}"
                                          Accent="{DynamicResource BrushCatalogKpiBad}"
                                          ValueBrush="{DynamicResource BrushCatalogKpiBadText}" />
                <catalog:SharedCatalogKpi Label="Facturado"
                                          Value="{Binding Billed, StringFormat=N2}"
                                          Accent="{DynamicResource BrushCatalogKpiOk}"
                                          ValueBrush="{DynamicResource BrushCatalogKpiOk}" />
            </UniformGrid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="420" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" MinWidth="260" />
                </Grid.ColumnDefinitions>

                <!-- Que fue lo que mas se hizo -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Margin="2,0,0,8"
                               Style="{StaticResource SharedIndexCanvasMeta}"
                               Text="Servicios que mas se repiten" />

                    <Border Grid.Row="1" Style="{StaticResource SharedIndexPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Border Style="{StaticResource SharedIndexHeaderBand}" />

                                <DataGrid ItemsSource="{Binding ServiceRows}"
                                          Style="{StaticResource SharedIndexGrid}"
                                          ColumnHeaderStyle="{StaticResource SharedIndexHeader}"
                                          RowStyle="{StaticResource SharedIndexRow}"
                                          CellStyle="{StaticResource SharedIndexCell}">

                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="*" MinWidth="220" Header="Servicio" SortMemberPath="Name">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding Name}" />
                                                        <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding CategoryName}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="110" Header="Veces" SortMemberPath="Times">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock HorizontalAlignment="Right"
                                                               Style="{StaticResource SharedIndexMeta}"
                                                               Text="{Binding Times, StringFormat=N0}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="150" Header="Monto" SortMemberPath="Total">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock HorizontalAlignment="Right"
                                                               Style="{StaticResource SharedIndexName}"
                                                               Text="{Binding Total, StringFormat=N2}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding ServiceRows, Converter={StaticResource CountToVisibilityConverter}}">
                                    <fa:FontAwesomeImage Width="26" Height="26"
                                                         HorizontalAlignment="Center"
                                                         Foreground="{DynamicResource BrushIndexMeta}"
                                                         Icon="{x:Static icons:FontAwesomeIcon.ScrewdriverWrench}"
                                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                    <TextBlock Margin="0,12,0,0"
                                               Style="{StaticResource SharedIndexEmpty}"
                                               Text="No hay servicios en el periodo" />
                                </StackPanel>
                            </Grid>

                            <!-- El total de la web vive aqui y no como ultima fila: una fila de
                                 mas en la tabla se ordenaria junto con los servicios y dejaria
                                 de ser total -->
                            <Border Grid.Row="1" Style="{StaticResource SharedIndexPanelFoot}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="220" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Margin="8,0,0,0" Style="{StaticResource SharedIndexName}" Text="Total" />

                                    <TextBlock Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource SharedIndexName}"
                                               Text="{Binding TotalTimes, StringFormat=N0}" />

                                    <TextBlock Grid.Column="2"
                                               Margin="0,0,8,0"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource SharedIndexName}"
                                               Text="{Binding TotalAmount, StringFormat=N2}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Quien los resolvio -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Margin="2,0,0,8"
                               Style="{StaticResource SharedIndexCanvasMeta}"
                               Text="Tecnicos" />

                    <Border Grid.Row="1" Style="{StaticResource SharedIndexPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Border Style="{StaticResource SharedIndexHeaderBand}" />

                                <DataGrid ItemsSource="{Binding TechnicianRows}"
                                          Style="{StaticResource SharedIndexGrid}"
                                          ColumnHeaderStyle="{StaticResource SharedIndexHeader}"
                                          RowStyle="{StaticResource SharedIndexRow}"
                                          CellStyle="{StaticResource SharedIndexCell}">

                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="*" MinWidth="160" Header="Tecnico" SortMemberPath="Name">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding Name}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="120" Header="Resueltos" SortMemberPath="Services">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock HorizontalAlignment="Right"
                                                               Style="{StaticResource SharedIndexName}"
                                                               Text="{Binding Services, StringFormat=N0}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding TechnicianRows, Converter={StaticResource CountToVisibilityConverter}}">
                                    <fa:FontAwesomeImage Width="26" Height="26"
                                                         HorizontalAlignment="Center"
                                                         Foreground="{DynamicResource BrushIndexMeta}"
                                                         Icon="{x:Static icons:FontAwesomeIcon.User}"
                                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                                    <TextBlock Margin="0,12,0,0"
                                               Style="{StaticResource SharedIndexEmpty}"
                                               Text="No hay tecnicos con servicios en el periodo" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Style="{StaticResource SharedIndexPanelFoot}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="160" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Margin="8,0,0,0" Style="{StaticResource SharedIndexName}" Text="Total" />

                                    <TextBlock Grid.Column="1"
                                               Margin="0,0,8,0"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource SharedIndexName}"
                                               Text="{Binding TotalSolved, StringFormat=N0}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- El spinner tapa las dos listas: las tres peticiones van en la misma busqueda -->
                <shared:SharedLoading Grid.ColumnSpan="3" IsLoading="{Binding IsLoading}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
