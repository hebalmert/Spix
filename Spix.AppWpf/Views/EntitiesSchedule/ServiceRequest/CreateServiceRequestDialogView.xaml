<UserControl x:Class="Spix.AppWpf.Views.EntitiesSchedule.ServiceRequest.CreateServiceRequestDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:catalog="clr-namespace:Spix.AppWpf.SharedComponents.SharedCatalog"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             MinWidth="900">

    <!-- Registrar una solicitud, replicado del CreateServiceRequest de la web: de quien
         es, quien va, para cuando y por que. Los servicios, las fotos y el cierre viven
         en la orden de trabajo, no aqui. -->
    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Se escribe y caen los contratos que coinciden -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SharedFormLabel}">
                <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Cliente" />
            </Border>
            <shared:SharedSearchPicker Grid.Column="1"
                                       Text="{Binding ContractFilter, Mode=TwoWay}"
                                       Items="{Binding Contracts}"
                                       SearchCommand="{Binding SearchContractsCommand}"
                                       SelectCommand="{Binding SelectContractCommand}">
                <shared:SharedSearchPicker.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding ClientFullName}" />
                            <TextBlock Style="{StaticResource SharedIndexMeta}">
                                <Run Text="Contrato" />
                                <Run Text="{Binding ControlContrato, Mode=OneWay}" />
                                <Run Text="·" />
                                <Run Text="{Binding ZoneName, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </shared:SharedSearchPicker.ItemTemplate>
            </shared:SharedSearchPicker>
        </Grid>

        <!-- Los datos del servicio: solo se consultan, salen del contrato elegido -->
        <catalog:SharedCatalogKpi Grid.Row="2"
                                  Label="Direccion del servicio"
                                  Value="{Binding Entity.Address}"
                                  Visibility="{Binding HasContract, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <UniformGrid Grid.Row="4"
                     Columns="3"
                     Visibility="{Binding HasContract, Converter={StaticResource BooleanToVisibilityConverter}}">
            <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                      Label="Telefono" Value="{Binding Entity.PhoneNumber}" />
            <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                      Label="Plan" Value="{Binding Entity.PlanName}"
                                      Accent="{DynamicResource BrushCatalogKpiOk}" />
            <catalog:SharedCatalogKpi Label="Nodo" Value="{Binding Entity.NodeName}" />
        </UniformGrid>

        <!-- Quien va y para cuando -->
        <Grid Grid.Row="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SharedFormLabel}">
                <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Tecnico" />
            </Border>
            <ComboBox Grid.Column="1"
                      Style="{StaticResource SharedFormCombo}"
                      ItemsSource="{Binding Technicians}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding Entity.TechnicianId, Mode=TwoWay}" />

            <Border Grid.Column="3" Style="{StaticResource SharedFormLabel}">
                <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Programada" />
            </Border>
            <Grid Grid.Column="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <DatePicker MinHeight="42"
                            SelectedDate="{Binding ScheduledDate, Mode=TwoWay}"
                            SelectedDateFormat="Short" />
                <TextBox Grid.Column="2"
                         MaxLength="5"
                         Style="{StaticResource SharedFormBox}"
                         ToolTip="Hora en formato HH:mm"
                         Text="{Binding ScheduledTime, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource SharedFormLabel}">
                <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Razon del cliente" />
            </Border>
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
                     MinHeight="82"
                     MaxLength="512"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Style="{StaticResource SharedFormBox}"
                     Text="{Binding Entity.ClientReason, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <shared:SharedModalActions Grid.Row="8"
                                   SaveCommand="{Binding SaveCommand}"
                                   CancelCommand="{Binding CancelCommand}" />

        <shared:SharedLoading Grid.RowSpan="9" IsLoading="{Binding IsLoading}" />
    </Grid>
</UserControl>
