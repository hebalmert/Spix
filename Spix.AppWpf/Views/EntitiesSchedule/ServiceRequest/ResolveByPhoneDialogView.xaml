<UserControl x:Class="Spix.AppWpf.Views.EntitiesSchedule.ServiceRequest.ResolveByPhoneDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             MinWidth="720">

    <!-- Cierra la solicitud sin mandar a nadie. Lo que se escribe aqui es lo UNICO
         que el cliente va a ver de la resolucion, por eso van dos campos separados
         y no un texto suelto. -->
    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SharedFormLabel}">
                <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Como se resolvio" />
            </Border>
            <TextBox Grid.Column="1"
                     MinHeight="92"
                     MaxLength="512"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Style="{StaticResource SharedFormBox}"
                     Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SharedFormLabel}">
                <TextBlock Style="{StaticResource SharedFormLabelText}" Text="Recomendacion" />
            </Border>
            <TextBox Grid.Column="1"
                     MinHeight="72"
                     MaxLength="512"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Style="{StaticResource SharedFormBox}"
                     Text="{Binding Recommendation, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <shared:SharedModalActions Grid.Row="4"
                                   SaveText="Cerrar la solicitud"
                                   SaveCommand="{Binding SaveCommand}"
                                   CancelCommand="{Binding CancelCommand}" />
    </Grid>
</UserControl>
