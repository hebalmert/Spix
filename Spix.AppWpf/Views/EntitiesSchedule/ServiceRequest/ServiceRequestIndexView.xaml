<UserControl x:Class="Spix.AppWpf.Views.EntitiesSchedule.ServiceRequest.ServiceRequestIndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Spix.AppWpf.SharedServices"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:catalog="clr-namespace:Spix.AppWpf.SharedComponents.SharedCatalog"
             xmlns:rowbtn="clr-namespace:Spix.AppWpf.SharedComponents.SharedButtonRow"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents">

    <!-- Solicitudes de servicio: replicado del index de Blazor, con la UI del escritorio.
         Los cinco numeros del tablero y las pildoras de filtro los arma el BACKEND: los
         numeros sobre TODO lo que el usuario puede ver, no sobre la pagina en pantalla, y
         los estados llegan con su "Todas" en la posicion 0 y ya traducidos.
         Una solicitud cerrada no se borra, igual que en la web. -->
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <Border Style="{StaticResource SharedIndexShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- El tablero del dia -->
            <UniformGrid Columns="5"
                         Margin="0,0,0,14"
                         Visibility="{Binding HasSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="Solicitadas" Value="{Binding Summary.Requested, StringFormat=N0}"
                                          Accent="{DynamicResource BrushScheduleRequested}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="Hoy" Value="{Binding Summary.Today, StringFormat=N0}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="Pendientes" Value="{Binding Summary.Pending, StringFormat=N0}"
                                          Accent="{DynamicResource BrushCatalogKpiWarn}"
                                          ValueBrush="{DynamicResource BrushCatalogKpiWarnText}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                          Label="En sitio" Value="{Binding Summary.InProgress, StringFormat=N0}"
                                          Accent="{DynamicResource BrushScheduleInProgress}" />
                <catalog:SharedCatalogKpi Label="Cerradas del mes" Value="{Binding Summary.CompletedMonth, StringFormat=N0}"
                                          Accent="{DynamicResource BrushCatalogKpiOk}" />
            </UniformGrid>

            <!-- Las pildoras de filtro y el buscador -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding Statuses}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <catalog:SharedCatalogChip Margin="0,0,8,6"
                                                       Text="{Binding Text}"
                                                       Value="{Binding Value}"
                                                       IsOn="{Binding IsOn}"
                                                       Command="{Binding DataContext.FilterByStatusCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- El tecnico atiende visitas, no las registra -->
                    <Button Margin="0,0,10,0"
                            Command="{Binding NewCommand}"
                            Style="{StaticResource SharedIndexNewButton}"
                            ToolTip="Registrar una solicitud (Ctrl+N)"
                            svc:FormButton.Icon="{x:Static icons:FontAwesomeIcon.Plus}"
                            Content="Nueva"
                            Visibility="{Binding CanCreate, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Button Width="38" Height="38"
                            Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SharedIndexIconButtonEdit}"
                            ToolTip="Actualizar (F5)">
                        <fa:FontAwesomeImage Width="14" Height="14"
                                             Foreground="{DynamicResource BrushIndexIconEdit}"
                                             Icon="{x:Static icons:FontAwesomeIcon.ArrowsRotate}"
                                             IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                    </Button>

                    <shared:SharedSearchFilter SearchText="{Binding Filter}"
                                               SearchCommand="{Binding SearchCommand}"
                                               ClearCommand="{Binding ClearSearchCommand}" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="2"
                       Margin="0,0,0,10"
                       Style="{StaticResource SharedCatalogMessage}"
                       Text="{Binding Message}"
                       Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Border Grid.Row="3" Style="{StaticResource SharedIndexPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Border Style="{StaticResource SharedIndexHeaderBand}" />

                        <DataGrid x:Name="ItemsGrid"
                                  ItemsSource="{Binding Rows}"
                                  Style="{StaticResource SharedIndexGrid}"
                                  ColumnHeaderStyle="{StaticResource SharedIndexHeader}"
                                  RowStyle="{StaticResource SharedIndexRow}"
                                  CellStyle="{StaticResource SharedIndexCell}">

                            <!-- Doble clic sobre la fila abre su orden de trabajo -->
                            <DataGrid.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding OpenOrderCommand}"
                                              CommandParameter="{Binding SelectedItem, ElementName=ItemsGrid}" />
                            </DataGrid.InputBindings>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="110" Header="#" SortMemberPath="Number">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding Number}" />
                                                <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding CreatedText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*" Header="Cliente" SortMemberPath="ClientName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding ClientName}" />
                                                <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding ClientMeta}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- El motivo no puede romper la fila: se recorta y se lee completo en el globo -->
                                <DataGridTemplateColumn Width="260" Header="Motivo" SortMemberPath="Reason">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" ToolTip="{Binding Reason}">
                                                <TextBlock Style="{StaticResource SharedIndexName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Reason}" />
                                                <TextBlock Style="{StaticResource SharedIndexMeta}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Address}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="160" Header="Tecnico" SortMemberPath="TechnicianName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding TechnicianName}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- La fecha dice que tan urgente es, no solo cuando es -->
                                <DataGridTemplateColumn Width="170" Header="Programada" SortMemberPath="ScheduledText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <Border HorizontalAlignment="Left"
                                                        Padding="11,3"
                                                        CornerRadius="999"
                                                        Background="{Binding WhenBack}">
                                                    <TextBlock FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding WhenForeground}"
                                                               Text="{Binding WhenText}" />
                                                </Border>
                                                <TextBlock Margin="0,3,0,0"
                                                           Style="{StaticResource SharedIndexMeta}"
                                                           Text="{Binding ScheduledText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="150" Header="Estado" SortMemberPath="StatusText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Left"
                                                    Padding="10,4"
                                                    CornerRadius="6"
                                                    Background="{Binding StatusColor}">
                                                <TextBlock FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           Text="{Binding StatusText}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="Auto" MinWidth="180" Header="" CanUserSort="False" CellStyle="{StaticResource SharedIndexCellActions}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,6,0">
                                                <!-- La orden es una pantalla: fotos, servicios y comentarios viven ahi -->
                                                <rowbtn:SharedButtonRowEdit Command="{Binding DataContext.OpenOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}"
                                                                            Icon="{x:Static icons:FontAwesomeIcon.ClipboardList}"
                                                                            ToolTip="Orden de trabajo" />

                                                <!-- Los datos de auditoria no ocupan columna: se consultan aqui -->
                                                <rowbtn:SharedButtonRowEdit Command="{Binding DataContext.AuditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}"
                                                                            Icon="{x:Static icons:FontAwesomeIcon.ClockRotateLeft}"
                                                                            ToolTip="Auditoria" />

                                                <!-- Una solicitud cerrada no se borra -->
                                                <rowbtn:SharedButtonRowDelete Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                              CommandParameter="{Binding}"
                                                                              ToolTip="Eliminar"
                                                                              Visibility="{Binding CanDelete, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Rows, Converter={StaticResource CountToVisibilityConverter}}">
                            <fa:FontAwesomeImage Width="26" Height="26"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource BrushIndexMeta}"
                                                 Icon="{x:Static icons:FontAwesomeIcon.Screwdriver}"
                                                 IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource SharedIndexEmpty}"
                                       Text="No hay solicitudes con este filtro" />
                            <Button Margin="0,14,0,0"
                                    HorizontalAlignment="Center"
                                    Command="{Binding NewCommand}"
                                    Style="{StaticResource SharedIndexNewButton}"
                                    ToolTip="Registrar la primera"
                                    svc:FormButton.Icon="{x:Static icons:FontAwesomeIcon.Plus}"
                                    Content="Registrar una solicitud"
                                    Visibility="{Binding CanCreate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>

                        <shared:SharedLoading IsLoading="{Binding IsLoading}" />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource SharedIndexPanelFoot}">
                        <shared:SharedPagination Foreground="{DynamicResource BrushCatalogMeta}"
                                                 CurrentPage="{Binding CurrentPage}"
                                                 TotalPages="{Binding TotalPages}"
                                                 TotalRecords="{Binding TotalRecords}"
                                                 PageCommand="{Binding GoToPageCommand}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
