<UserControl x:Class="Spix.AppWpf.Views.EntitiesSchedule.ServiceRequestScheduleInfoDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             MinWidth="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="28" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border MinHeight="42" Background="White" BorderBrush="#566273" BorderThickness="1" CornerRadius="6">
            <StackPanel Margin="14,8">
                <TextBlock FontSize="12" Foreground="#6A7A90" Text="Titulo" />
                <TextBlock FontWeight="SemiBold" Foreground="#1E2B3C" Text="{Binding Schedule.Title}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border Grid.Row="2" MinHeight="72" Background="White" BorderBrush="#566273" BorderThickness="1" CornerRadius="6">
            <StackPanel Margin="14,8">
                <TextBlock FontSize="12" Foreground="#6A7A90" Text="Descripcion" />
                <TextBlock Foreground="#1E2B3C" Text="{Binding Schedule.Description}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border MinHeight="60" Background="#EAF4FF" BorderBrush="#9CC7F2" BorderThickness="1" CornerRadius="6">
                <StackPanel Margin="14,8"><TextBlock FontSize="12" Foreground="#42617E" Text="Inicio" /><TextBlock FontWeight="SemiBold" Foreground="#1E2B3C" Text="{Binding StartLocal, StringFormat={}{0:g}}" /></StackPanel>
            </Border>
            <Border Grid.Column="2" MinHeight="60" Background="#EAF4FF" BorderBrush="#9CC7F2" BorderThickness="1" CornerRadius="6">
                <StackPanel Margin="14,8"><TextBlock FontSize="12" Foreground="#42617E" Text="Fin" /><TextBlock FontWeight="SemiBold" Foreground="#1E2B3C" Text="{Binding EndLocal, StringFormat={}{0:g}}" /></StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border MinHeight="60" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1" CornerRadius="6">
                <StackPanel Margin="14,8"><TextBlock FontSize="12" Foreground="#6A7A90" Text="Tecnico" /><TextBlock FontWeight="SemiBold" Foreground="#1E2B3C" Text="{Binding Schedule.TechnicianName}" /></StackPanel>
            </Border>
            <Border Grid.Column="2" MinHeight="60" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1" CornerRadius="6">
                <StackPanel Margin="14,8"><TextBlock FontSize="12" Foreground="#6A7A90" Text="Estado" /><TextBlock FontWeight="SemiBold" Foreground="#1E2B3C" Text="{Binding StatusName}" /></StackPanel>
            </Border>
        </Grid>
        <Button Grid.Row="8" HorizontalAlignment="Center" MinWidth="220" Command="{Binding CloseCommand}" Style="{StaticResource SharedButtonFormSecondary}" Content="Volver" />
        <shared:SharedLoading Grid.RowSpan="9" IsLoading="{Binding IsLoading}" />
    </Grid>
</UserControl>
