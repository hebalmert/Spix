<UserControl x:Class="Spix.AppWpf.Views.EntitiesSchedule.VisitReview.VisitReviewIndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Spix.AppWpf.SharedServices"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:catalog="clr-namespace:Spix.AppWpf.SharedComponents.SharedCatalog"
             xmlns:rowbtn="clr-namespace:Spix.AppWpf.SharedComponents.SharedButtonRow"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents">

    <!-- Bandeja de revision: replicada de /visitreviews de la web.
         Dos pestañas y dos endpoints: Ubicacion (el tecnico marco lejos del sitio) y
         Sin cliente (fue y no habia nadie). El front no filtra nada; cada visita cae
         en UNA sola pestaña. -->
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <Border Style="{StaticResource SharedIndexShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Las dos pestañas con su contador, y el buscador -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <catalog:SharedCatalogChip Margin="0,0,8,0"
                                               Text="{Binding Counters.Location, StringFormat='Ubicacion ({0})'}"
                                               Value="0"
                                               IsOn="{Binding IsLocationTab}"
                                               Command="{Binding ChangeTabCommand}" />
                    <catalog:SharedCatalogChip Text="{Binding Counters.Absent, StringFormat='Sin cliente ({0})'}"
                                               Value="1"
                                               IsOn="{Binding IsAbsentTab}"
                                               Command="{Binding ChangeTabCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Width="38" Height="38"
                            Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SharedIndexIconButtonEdit}"
                            ToolTip="Actualizar (F5)">
                        <fa:FontAwesomeImage Width="14" Height="14"
                                             Foreground="{DynamicResource BrushIndexIconEdit}"
                                             Icon="{x:Static icons:FontAwesomeIcon.ArrowsRotate}"
                                             IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                    </Button>

                    <shared:SharedSearchFilter SearchText="{Binding Filter}"
                                               SearchCommand="{Binding SearchCommand}"
                                               ClearCommand="{Binding ClearSearchCommand}" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1"
                       Margin="0,0,0,10"
                       Style="{StaticResource SharedCatalogMessage}"
                       Text="{Binding Message}"
                       Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Border Grid.Row="2" Style="{StaticResource SharedIndexPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Border Style="{StaticResource SharedIndexHeaderBand}" />

                        <DataGrid x:Name="ItemsGrid"
                                  ItemsSource="{Binding Rows}"
                                  Style="{StaticResource SharedIndexGrid}"
                                  ColumnHeaderStyle="{StaticResource SharedIndexHeader}"
                                  RowStyle="{StaticResource SharedIndexRow}"
                                  CellStyle="{StaticResource SharedIndexCell}">

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="*" Header="Cliente" SortMemberPath="ClientName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding ClientName}" />
                                                <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding ClientMeta}" />
                                                <TextBlock Style="{StaticResource SharedIndexMeta}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding VisitMeta}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Las dos coordenadas juntas: no hay que irse a otra pantalla a comparar -->
                                <DataGridTemplateColumn Width="260" Header="Ubicacion" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource SharedIndexMeta}" Text="Contrato" />
                                                <TextBlock FontFamily="Consolas" FontSize="12"
                                                           Foreground="{DynamicResource BrushIndexText}"
                                                           Text="{Binding ContractCoord}" />
                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource SharedIndexMeta}" Text="Tecnico" />
                                                <TextBlock FontFamily="Consolas" FontSize="12"
                                                           Foreground="{DynamicResource BrushIndexText}"
                                                           Text="{Binding VisitCoord}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- La distancia es el dato que decide -->
                                <DataGridTemplateColumn Width="170" Header="Diferencia" SortMemberPath="DistanceText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Left"
                                                    Padding="10,4"
                                                    CornerRadius="6"
                                                    Background="{Binding DistanceBack}">
                                                <TextBlock FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding DistanceForeground}"
                                                           Text="{Binding DistanceText}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Lo que dejo escrito el tecnico: se recorta y se lee completo en el globo -->
                                <DataGridTemplateColumn Width="200" Header="Comentario" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexMeta}"
                                                       FontStyle="Italic"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Comment}"
                                                       Text="{Binding Comment}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="Auto" MinWidth="200" Header="" CanUserSort="False" CellStyle="{StaticResource SharedIndexCellActions}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,6,0">
                                                <!-- Ubicacion: se aplica al contrato o se deja como esta -->
                                                <rowbtn:SharedButtonRowEdit Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}"
                                                                            Icon="{x:Static icons:FontAwesomeIcon.Check}"
                                                                            ToolTip="Aplicar al contrato"
                                                                            Visibility="{Binding CanApply, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                <rowbtn:SharedButtonRowEdit Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}"
                                                                            Icon="{x:Static icons:FontAwesomeIcon.Xmark}"
                                                                            ToolTip="Dejar como esta"
                                                                            Visibility="{Binding CanApply, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                <!-- Sin cliente: lo que toca es volver a mandar al tecnico -->
                                                <rowbtn:SharedButtonRowEdit Command="{Binding DataContext.RescheduleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}"
                                                                            Icon="{x:Static icons:FontAwesomeIcon.CalendarPlus}"
                                                                            ToolTip="Reagendar"
                                                                            Visibility="{Binding CanReschedule, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                <rowbtn:SharedButtonRowEdit Command="{Binding DataContext.AuditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}"
                                                                            Icon="{x:Static icons:FontAwesomeIcon.ClockRotateLeft}"
                                                                            ToolTip="Auditoria" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Rows, Converter={StaticResource CountToVisibilityConverter}}">
                            <fa:FontAwesomeImage Width="26" Height="26"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource BrushIndexMeta}"
                                                 Icon="{x:Static icons:FontAwesomeIcon.CircleCheck}"
                                                 IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource SharedIndexEmpty}"
                                       Text="No hay nada por revisar" />
                        </StackPanel>

                        <shared:SharedLoading IsLoading="{Binding IsLoading}" />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource SharedIndexPanelFoot}">
                        <shared:SharedPagination Foreground="{DynamicResource BrushCatalogMeta}"
                                                 CurrentPage="{Binding CurrentPage}"
                                                 TotalPages="{Binding TotalPages}"
                                                 TotalRecords="{Binding TotalRecords}"
                                                 PageCommand="{Binding GoToPageCommand}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
