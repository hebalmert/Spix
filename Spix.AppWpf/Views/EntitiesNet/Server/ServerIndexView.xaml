<UserControl x:Class="Spix.AppWpf.Views.EntitiesNet.Server.ServerIndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Spix.AppWpf.SharedServices"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:catalog="clr-namespace:Spix.AppWpf.SharedComponents.SharedCatalog"
             xmlns:rowbtn="clr-namespace:Spix.AppWpf.SharedComponents.SharedButtonRow"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents">

    <!-- Servidores: replicado del index de Blazor, con la UI del escritorio.
         Los cuatro numeros de arriba los cuenta la base sobre todos los equipos.
         Un equipo con clientes colgando NO se borra: solo se inactiva. -->
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <Border Style="{StaticResource SharedIndexShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <UniformGrid Columns="4" Margin="0,0,0,14">
                <catalog:SharedCatalogKpi Margin="0,0,12,0" Label="Servidores" Value="{Binding Summary.Total, StringFormat=N0}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0" Label="Activos" Value="{Binding Summary.Active, StringFormat=N0}"
                                          Accent="{DynamicResource BrushCatalogKpiOk}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0" Label="Inactivos" Value="{Binding Summary.Inactive, StringFormat=N0}"
                                          Accent="{DynamicResource BrushCatalogKpiWarn}"
                                          ValueBrush="{DynamicResource BrushCatalogKpiWarnText}" />
                <catalog:SharedCatalogKpi Label="Clientes" Value="{Binding Summary.Clients, StringFormat=N0}" />
            </UniformGrid>

            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Command="{Binding NewCommand}"
                        Style="{StaticResource SharedIndexNewButton}"
                        ToolTip="Crear un servidor (Ctrl+N)"
                        svc:FormButton.Icon="{x:Static icons:FontAwesomeIcon.Plus}"
                        Content="Nuevo" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Width="38" Height="38"
                            Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SharedIndexIconButtonEdit}"
                            ToolTip="Actualizar (F5)">
                        <fa:FontAwesomeImage Width="14" Height="14"
                                             Foreground="{DynamicResource BrushIndexIconEdit}"
                                             Icon="{x:Static icons:FontAwesomeIcon.ArrowsRotate}"
                                             IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                    </Button>

                    <shared:SharedExportButton Margin="0,0,10,0"
                                               Items="{Binding Items}"
                                               FileName="servidores" />

                    <shared:SharedSearchFilter SearchText="{Binding Filter}"
                                               SearchCommand="{Binding SearchCommand}"
                                               ClearCommand="{Binding ClearSearchCommand}" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="2"
                       Margin="0,0,0,10"
                       Style="{StaticResource SharedCatalogMessage}"
                       Text="{Binding Message}"
                       Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Border Grid.Row="3" Style="{StaticResource SharedIndexPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Border Style="{StaticResource SharedIndexHeaderBand}" />

                        <DataGrid x:Name="ItemsGrid"
                                  ItemsSource="{Binding Items}"
                                  Style="{StaticResource SharedIndexGrid}"
                                  ColumnHeaderStyle="{StaticResource SharedIndexHeader}"
                                  RowStyle="{StaticResource SharedIndexRow}"
                                  CellStyle="{StaticResource SharedIndexCell}">

                            <DataGrid.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding EditCommand}"
                                              CommandParameter="{Binding SelectedItem, ElementName=ItemsGrid}" />
                            </DataGrid.InputBindings>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="*" Header="Servidor" SortMemberPath="ServerName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding ServerName}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="190" Header="Zona" SortMemberPath="ZoneName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding ZoneName}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="170" Header="IP" SortMemberPath="Ip">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexMeta}" Text="{Binding Ip}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="120" Header="Clientes" SortMemberPath="Clients" HeaderStyle="{StaticResource SharedIndexHeaderRight}" CellStyle="{StaticResource SharedIndexCellRight}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SharedIndexName}" Text="{Binding Clients, StringFormat=N0}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="140" Header="Estado" SortMemberPath="Active">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <shared:SharedStatePill IsOn="{Binding Active}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="Auto" MinWidth="180" Header="" CanUserSort="False" CellStyle="{StaticResource SharedIndexCellActions}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,6,0">
                                                <rowbtn:SharedButtonRowEdit Command="{Binding DataContext.CheckMikrotikCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}"
                                                                            Icon="{x:Static icons:FontAwesomeIcon.Server}"
                                                                            ToolTip="Comprobar la conexion MikroTik" />
                                                <rowbtn:SharedButtonRowEdit Command="{Binding DataContext.PingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}"
                                                                            Icon="{x:Static icons:FontAwesomeIcon.Crosshairs}"
                                                                            ToolTip="Probar el ping" />

                                                <rowbtn:SharedButtonRowEdit Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="Editar" />

                                                <!-- Con clientes colgando NO se borra: se inactiva.
                                                     Es la misma regla de la web. -->
                                                <rowbtn:SharedButtonRowDelete Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                              CommandParameter="{Binding}"
                                                                              ToolTip="Eliminar"
                                                                              Visibility="{Binding Clients, Converter={StaticResource NumberToVisibilityConverter}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Items, Converter={StaticResource CountToVisibilityConverter}}">
                            <fa:FontAwesomeImage Width="26" Height="26"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource BrushIndexMeta}"
                                                 Icon="{x:Static icons:FontAwesomeIcon.Server}"
                                                 IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource SharedIndexEmpty}"
                                       Text="Todavia no hay servidores" />
                            <Button Margin="0,14,0,0"
                                    HorizontalAlignment="Center"
                                    Command="{Binding NewCommand}"
                                    Style="{StaticResource SharedIndexNewButton}"
                                    ToolTip="Crear el primero"
                                    svc:FormButton.Icon="{x:Static icons:FontAwesomeIcon.Plus}"
                                    Content="Crear el primero" />
                        </StackPanel>

                        <shared:SharedLoading IsLoading="{Binding IsLoading}" />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource SharedIndexPanelFoot}">
                        <shared:SharedPagination Foreground="{DynamicResource BrushCatalogMeta}"
                                                 CurrentPage="{Binding CurrentPage}"
                                                 TotalPages="{Binding TotalPages}"
                                                 TotalRecords="{Binding TotalRecords}"
                                                 PageCommand="{Binding GoToPageCommand}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
