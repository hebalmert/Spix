<UserControl x:Class="Spix.AppWpf.Views.EntitiesNet.Server.ServerMikrotikDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:catalog="clr-namespace:Spix.AppWpf.SharedComponents.SharedCatalog"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             MinWidth="760">

    <!-- La comprobacion de la conexion con el MikroTik, igual que el MkResultView de la
         web: el estado, el nombre del equipo y cuantos registros hay en IP Binding. -->
    <Grid Width="660" HorizontalAlignment="Center" Margin="0,16,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Las tarjetas van DENTRO de la misma tarjeta blanca del index
             (SharedIndexShell), igual que en los diagnosticos de ping. -->
        <Border Style="{StaticResource SharedIndexShell}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <catalog:SharedCatalogStatusCard IsOk="{Binding HasResult}"
                                                 Title="{Binding ConnectionTitle}"
                                                 Detail="{Binding ErrorMessage}" />

                <UniformGrid Grid.Row="1"
                             Columns="2"
                             Margin="0,14,0,0"
                             Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                              Label="Nombre del MikroTik"
                                              Value="{Binding Result.MikrotikName}" />
                    <catalog:SharedCatalogKpi Label="Registros en IP Binding"
                                              Value="{Binding Result.Value}"
                                              Accent="{DynamicResource BrushCatalogKpiOk}" />
                </UniformGrid>
            </Grid>
        </Border>

        <shared:SharedModalActions Grid.Row="2"
                                   SaveCommand="{Binding RetryCommand}"
                                   SaveText="Reintentar"
                                   SaveIcon="{x:Static icons:FontAwesomeIcon.RotateRight}"
                                   CancelCommand="{Binding CloseCommand}" />

        <shared:SharedLoading Grid.RowSpan="3" IsLoading="{Binding IsLoading}" />
    </Grid>
</UserControl>
