<UserControl x:Class="Spix.AppWpf.Views.EntitiesNet.Server.ServerFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             Width="796"
             MinWidth="796">
    <ScrollViewer MaxHeight="470" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,24,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="1" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="1" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Servidor" /></Border>
                <TextBox Grid.Column="1" MinHeight="42" MaxLength="50" Padding="12,8" Background="White" BorderBrush="#566273" Text="{Binding Entity.ServerName, UpdateSourceTrigger=PropertyChanged}" />
                <Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="IP red" /></Border>
                <ComboBox Grid.Column="4" MinHeight="42" Padding="10,6" ItemsSource="{Binding IpNetworks}" DisplayMemberPath="Ip" SelectedValuePath="IpNetworkId" SelectedValue="{Binding Entity.IpNetworkId, Mode=TwoWay}" />
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Marca" /></Border>
                <ComboBox Grid.Column="1" MinHeight="42" Padding="10,6" ItemsSource="{Binding Marks}" DisplayMemberPath="MarkName" SelectedValuePath="MarkId" SelectedValue="{Binding Entity.MarkId, Mode=TwoWay}" SelectionChanged="MarkSelectionChanged" />
                <Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Modelo" /></Border>
                <ComboBox Grid.Column="4" MinHeight="42" Padding="10,6" ItemsSource="{Binding MarkModels}" DisplayMemberPath="MarkModelName" SelectedValuePath="MarkModelId" SelectedValue="{Binding Entity.MarkModelId, Mode=TwoWay}" />
            </Grid>

            <Grid Grid.Row="4" Background="#566273" />

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Usuario" /></Border>
                <TextBox Grid.Column="1" MinHeight="42" MaxLength="25" Padding="12,8" Background="White" BorderBrush="#566273" Text="{Binding Entity.Usuario, UpdateSourceTrigger=PropertyChanged}" />
                <Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Clave" /></Border>
                <Grid Grid.Column="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="PasswordTextBox" MinHeight="42" MaxLength="25" Padding="12,8" Background="White" BorderBrush="#566273" Text="{Binding Entity.Clave, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style><Style TargetType="TextBox"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsPasswordVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBox.Style>
                    </TextBox>
                    <PasswordBox x:Name="PasswordBox" MinHeight="42" MaxLength="25" Padding="12,8" Background="White" BorderBrush="#566273" PasswordChanged="PasswordChanged">
                        <PasswordBox.Style><Style TargetType="PasswordBox"><Style.Triggers><DataTrigger Binding="{Binding IsPasswordVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></PasswordBox.Style>
                    </PasswordBox>
                    <Button Grid.Column="1" Width="42" Height="42" HorizontalAlignment="Right" Command="{Binding TogglePasswordVisibilityCommand}" Click="TogglePasswordClick" Style="{StaticResource SharedButtonTableRowEdit}" ToolTip="Mostrar u ocultar clave">
                        <fa:FontAwesomeImage Width="16" Height="16" IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}"><fa:FontAwesomeImage.Style><Style TargetType="fa:FontAwesomeImage" BasedOn="{StaticResource SharedButtonTableRowIcon}"><Setter Property="Icon" Value="{x:Static icons:FontAwesomeIcon.Eye}" /><Style.Triggers><DataTrigger Binding="{Binding IsPasswordVisible}" Value="True"><Setter Property="Icon" Value="{x:Static icons:FontAwesomeIcon.EyeSlash}" /></DataTrigger></Style.Triggers></Style></fa:FontAwesomeImage.Style></fa:FontAwesomeImage>
                    </Button>
                </Grid>
            </Grid>

            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="WAN" /></Border>
                <TextBox Grid.Column="1" MinHeight="42" MaxLength="25" Padding="12,8" Background="White" BorderBrush="#566273" Text="{Binding Entity.WanName, UpdateSourceTrigger=PropertyChanged}" />
                <Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Puerto API" /></Border>
                <TextBox Grid.Column="4" MinHeight="42" Padding="12,8" Background="White" BorderBrush="#566273" Text="{Binding Entity.ApiPort, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
            </Grid>

            <Grid Grid.Row="10" Background="#566273" />

            <Grid Grid.Row="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Estado" /></Border>
                <ComboBox Grid.Column="1" MinHeight="42" Padding="10,6" ItemsSource="{Binding States}" DisplayMemberPath="Name" SelectedValuePath="StateId" SelectedValue="{Binding Entity.StateId, Mode=TwoWay}" SelectionChanged="StateSelectionChanged" />
                <Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Ciudad" /></Border>
                <ComboBox Grid.Column="4" MinHeight="42" Padding="10,6" ItemsSource="{Binding Cities}" DisplayMemberPath="Name" SelectedValuePath="CityId" SelectedValue="{Binding Entity.CityId, Mode=TwoWay}" SelectionChanged="CitySelectionChanged" />
            </Grid>

            <Grid Grid.Row="14" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Zona" /></Border>
                <ComboBox Grid.Column="1" MinHeight="42" Padding="10,6" ItemsSource="{Binding Zones}" DisplayMemberPath="ZoneName" SelectedValuePath="ZoneId" SelectedValue="{Binding Entity.ZoneId, Mode=TwoWay}" />
                <Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Activo" /></Border>
                <Border Grid.Column="4" MinHeight="42" Background="White" BorderBrush="#566273" BorderThickness="1" CornerRadius="0,6,6,0"><CheckBox Margin="14,0" VerticalAlignment="Center" Content="Activo" IsChecked="{Binding Entity.Active}" /></Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
