<UserControl x:Class="Spix.AppWpf.Views.EntitiesNet.OltMap.OltMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:catalog="clr-namespace:Spix.AppWpf.SharedComponents.SharedCatalog"
             xmlns:sharedMap="clr-namespace:Spix.AppWpf.SharedComponents.SharedMap"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents">

    <!-- El mapa de OLT, replicado de la pantalla /oltmap de la web.
         Al entrar pinta TODAS las OLT con su nombre y sus clientes; al elegir una, sus
         clientes con la distancia al equipo. No lleva mascara de cobertura: eso es del
         sector inalambrico y en fibra no significa nada.
         Las dos listas llegan armadas del backend; aqui solo se pintan. -->
    <Border Style="{StaticResource SharedIndexShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Los selectores. El neutro del primero NO es "no elegi nada": es la vista
                 de todas las OLT. -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource SharedCatalogFootText}" Text="OLT" />
                    <ComboBox Margin="0,5,0,0"
                              Style="{StaticResource SharedFormCombo}"
                              ItemsSource="{Binding Olts}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedOltId, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource SharedCatalogFootText}" Text="Vista" />
                    <ComboBox Margin="0,5,0,0"
                              Style="{StaticResource SharedFormCombo}"
                              IsEnabled="{Binding HasMap}"
                              ItemsSource="{Binding Views}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedView, Mode=TwoWay}" />
                </StackPanel>

                <!-- Los clientes que solo se sabe que salen por la OLT, sin coordenadas -->
                <StackPanel Grid.Column="4">
                    <TextBlock Style="{StaticResource SharedCatalogFootText}" Text="Sin ubicar" />
                    <ComboBox Margin="0,5,0,0"
                              Style="{StaticResource SharedFormCombo}"
                              IsEnabled="{Binding HasMap}"
                              ItemsSource="{Binding Map.UnlocatedOptions}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedUnlocatedId, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <!-- El tablero de la OLT elegida -->
            <UniformGrid Grid.Row="1"
                         Columns="5"
                         Margin="0,0,0,14"
                         Visibility="{Binding HasMap, Converter={StaticResource BooleanToVisibilityConverter}}">
                <catalog:SharedCatalogKpi Margin="0,0,12,0" Label="Clientes" Value="{Binding Map.Clients, StringFormat=N0}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0" Label="Ubicados" Value="{Binding Map.WithLocation, StringFormat=N0}"
                                          Accent="{DynamicResource BrushCatalogKpiOk}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0" Label="Sin ubicar" Value="{Binding Map.WithoutLocation, StringFormat=N0}"
                                          Accent="{DynamicResource BrushCatalogKpiWarn}"
                                          ValueBrush="{DynamicResource BrushCatalogKpiWarnText}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0" Label="Puertos PON" Value="{Binding Map.PortCount, StringFormat=N0}" />
                <catalog:SharedCatalogKpi Label="El mas lejano (Km)" Value="{Binding Map.FarthestKm, StringFormat=N2}" />
            </UniformGrid>

            <!-- El tablero de la vista de todas -->
            <UniformGrid Grid.Row="1"
                         Columns="4"
                         Margin="0,0,0,14"
                         Visibility="{Binding HasMap, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <catalog:SharedCatalogKpi Margin="0,0,12,0" Label="Todas las OLT" Value="{Binding AllCount, StringFormat=N0}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0" Label="OLT en el mapa" Value="{Binding AllWithPoint, StringFormat=N0}"
                                          Accent="{DynamicResource BrushCatalogKpiOk}" />
                <catalog:SharedCatalogKpi Margin="0,0,12,0" Label="Sin coordenadas" Value="{Binding AllWithoutPoint, StringFormat=N0}"
                                          Accent="{DynamicResource BrushCatalogKpiWarn}"
                                          ValueBrush="{DynamicResource BrushCatalogKpiWarnText}" />
                <catalog:SharedCatalogKpi Label="Clientes" Value="{Binding AllClients, StringFormat=N0}" />
            </UniformGrid>

            <!-- El visor esta SIEMPRE a la vista: al entrar ya pinta todas las OLT -->
            <Grid Grid.Row="2">
                <sharedMap:SharedOltMapViewer x:Name="MapViewer" />

                <TextBlock VerticalAlignment="Top"
                           Style="{StaticResource SharedCatalogMessage}"
                           Text="{Binding Message}"
                           Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <shared:SharedLoading IsLoading="{Binding IsLoading}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
