<UserControl x:Class="Spix.AppWpf.Views.EntitiesNet.IpNetwork.IpNetworkFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="620">
    <Grid Margin="0,24,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="20" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Direccion IP" /></Border><TextBox Grid.Column="1" MinHeight="42" Padding="12,8" MaxLength="50" Text="{Binding Entity.Ip, UpdateSourceTrigger=PropertyChanged}" /></Grid>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6"><TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Descripcion" /></Border><TextBox Grid.Column="1" MinHeight="72" Padding="12,8" MaxLength="250" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Entity.Description, UpdateSourceTrigger=PropertyChanged}" /></Grid>
        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border MinHeight="42" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1" CornerRadius="6"><CheckBox Margin="14,0" VerticalAlignment="Center" Content="Activa" IsChecked="{Binding Entity.Active}" /></Border><Border Grid.Column="2" MinHeight="42" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1" CornerRadius="6"><CheckBox Margin="14,0" VerticalAlignment="Center" Content="Asignada" IsChecked="{Binding Entity.Assigned}" /></Border><Border Grid.Column="4" MinHeight="42" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1" CornerRadius="6"><CheckBox Margin="14,0" VerticalAlignment="Center" Content="Excluida" IsChecked="{Binding Entity.Excluded}" /></Border></Grid>
    </Grid>
</UserControl>
