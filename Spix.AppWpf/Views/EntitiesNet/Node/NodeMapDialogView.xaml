<UserControl x:Class="Spix.AppWpf.Views.EntitiesNet.Node.NodeMapDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             xmlns:sharedMap="clr-namespace:Spix.AppWpf.SharedComponents.SharedMap"
             Width="680"
             MinWidth="680"
             Height="450">

    <!-- El mapa del nodo. Solo se consulta: el unico boton es el de volver. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <sharedMap:SharedMapViewer x:Name="MapViewer" />

        <shared:SharedModalActions Grid.Row="2"
                                   CancelCommand="{Binding CloseCommand}"
                                   ShowSave="False" />
    </Grid>
</UserControl>
