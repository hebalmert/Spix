<UserControl x:Class="Spix.AppWpf.Views.EntitiesNet.Node.NodeMapDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:sharedMap="clr-namespace:Spix.AppWpf.SharedComponents.SharedMap"
              Width="680"
              MinWidth="680"
              Height="450">
    <Grid Margin="0,16,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <sharedMap:SharedMapViewer x:Name="MapViewer" />
        <Button Grid.Row="2" Command="{Binding CloseCommand}" Style="{StaticResource SharedButtonFormSecondary}" Content="Volver" />
    </Grid>
</UserControl>
