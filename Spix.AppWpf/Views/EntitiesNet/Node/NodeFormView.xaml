<UserControl x:Class="Spix.AppWpf.Views.EntitiesNet.Node.NodeFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
              Width="796"
              MinWidth="796">
    <ScrollViewer MaxHeight="470" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,24,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="1" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="1" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="1" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                    <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Nodo SSID" />
                </Border>
                <TextBox Grid.Column="1" MinHeight="42" MaxLength="50" Padding="12,8" Background="White" BorderBrush="#566273" Text="{Binding Entity.NodesName, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                    <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Operacion" />
                </Border>
                <ComboBox Grid.Column="1" MinHeight="42" Padding="10,6" ItemsSource="{Binding Operations}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Entity.OperationId, Mode=TwoWay}" />
                <Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                    <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="IP red" />
                </Border>
                <ComboBox Grid.Column="4" MinHeight="42" Padding="10,6" ItemsSource="{Binding IpNetworks}" DisplayMemberPath="Ip" SelectedValuePath="IpNetworkId" SelectedValue="{Binding Entity.IpNetworkId, Mode=TwoWay}" />
            </Grid>

            <Grid Grid.Row="4" Grid.ColumnSpan="5" Background="#566273" />

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                    <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Usuario" />
                </Border>
                <TextBox Grid.Column="1" MinHeight="42" MaxLength="25" Padding="12,8" Background="White" BorderBrush="#566273" Text="{Binding Entity.Usuario, UpdateSourceTrigger=PropertyChanged}" />
                <Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                    <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Clave" />
                </Border>
                <Grid Grid.Column="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PasswordTextBox" Grid.Column="0" MinHeight="42" MaxLength="25" Padding="12,8" Background="White" BorderBrush="#566273" Text="{Binding Entity.Clave, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <PasswordBox x:Name="PasswordBox" Grid.Column="0" MinHeight="42" MaxLength="25" Padding="12,8" Background="White" BorderBrush="#566273" PasswordChanged="PasswordChanged">
                        <PasswordBox.Style>
                            <Style TargetType="PasswordBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </PasswordBox.Style>
                    </PasswordBox>
                    <Button Grid.Column="1" Width="42" Height="42" HorizontalAlignment="Right" Command="{Binding TogglePasswordVisibilityCommand}" Click="TogglePasswordClick" Style="{StaticResource SharedButtonTableRowEdit}" ToolTip="Mostrar u ocultar clave">
                        <fa:FontAwesomeImage Width="16" Height="16" IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}">
                            <fa:FontAwesomeImage.Style>
                                <Style TargetType="fa:FontAwesomeImage" BasedOn="{StaticResource SharedButtonTableRowIcon}">
                                    <Setter Property="Icon" Value="{x:Static icons:FontAwesomeIcon.Eye}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                            <Setter Property="Icon" Value="{x:Static icons:FontAwesomeIcon.EyeSlash}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </fa:FontAwesomeImage.Style>
                        </fa:FontAwesomeImage>
                    </Button>
                </Grid>
            </Grid>

            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                    <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Marca" />
                </Border>
                <ComboBox Grid.Column="1" MinHeight="42" Padding="10,6" ItemsSource="{Binding Marks}" DisplayMemberPath="MarkName" SelectedValuePath="MarkId" SelectedValue="{Binding Entity.MarkId, Mode=TwoWay}" SelectionChanged="MarkSelectionChanged" />
                <Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                    <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Modelo" />
                </Border>
                <ComboBox Grid.Column="4" MinHeight="42" Padding="10,6" ItemsSource="{Binding MarkModels}" DisplayMemberPath="MarkModelName" SelectedValuePath="MarkModelId" SelectedValue="{Binding Entity.MarkModelId, Mode=TwoWay}" />
            </Grid>

            <Grid Grid.Row="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                    <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Ancho canal" />
                </Border>
                <ComboBox Grid.Column="1" MinHeight="42" Padding="10,6" ItemsSource="{Binding Channels}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Entity.ChannelId, Mode=TwoWay}" />
                <Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                    <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="MAC" />
                </Border>
                <TextBox Grid.Column="4" MinHeight="42" MaxLength="17" Padding="12,8" Background="White" BorderBrush="#566273" Text="{Binding Entity.Mac, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Grid Grid.Row="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                    <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Tipo frecuencia" />
                </Border>
                <ComboBox Grid.Column="1" MinHeight="42" Padding="10,6" ItemsSource="{Binding FrecuencyTypes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Entity.FrecuencyTypeId, Mode=TwoWay}" SelectionChanged="FrecuencyTypeSelectionChanged" />
                <Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                    <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Frecuencia" />
                </Border>
                <ComboBox Grid.Column="4" MinHeight="42" Padding="10,6" ItemsSource="{Binding Frecuencies}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedFrecuency, Mode=TwoWay}" />
            </Grid>

            <Grid Grid.Row="14" Background="#566273" />

            <Grid Grid.Row="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                    <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Seguridad" />
                </Border>
                <ComboBox Grid.Column="1" MinHeight="42" Padding="10,6" ItemsSource="{Binding Securities}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Entity.SecurityId, Mode=TwoWay}" />
                <Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                    <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Frase seguridad" />
                </Border>
                <TextBox Grid.Column="4" MinHeight="42" MaxLength="25" Padding="12,8" Background="White" BorderBrush="#566273" Text="{Binding Entity.FraseSeguridad, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Grid Grid.Row="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                    <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Coordenadas" />
                </Border>
                <TextBox Grid.Column="1" MinHeight="42" Padding="12,8" Background="White" BorderBrush="#566273" Text="{Binding CoordinatesText, UpdateSourceTrigger=PropertyChanged}" LostFocus="CoordinatesLostFocus" ToolTip="Ejemplo: 25.82370270482433, -80.38556718743175" />
            </Grid>

            <Grid Grid.Row="20" Background="#566273" />

            <Grid Grid.Row="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                    <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Latitud" />
                </Border>
                <TextBox Grid.Column="1" MinHeight="42" Padding="12,8" Background="White" BorderBrush="#566273" Text="{Binding Entity.Latitude, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                <Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                    <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Longitud" />
                </Border>
                <TextBox Grid.Column="4" MinHeight="42" Padding="12,8" Background="White" BorderBrush="#566273" Text="{Binding Entity.Longitude, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
            </Grid>

            <Grid Grid.Row="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                    <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Estado" />
                </Border>
                <ComboBox Grid.Column="1" MinHeight="42" Padding="10,6" ItemsSource="{Binding States}" DisplayMemberPath="Name" SelectedValuePath="StateId" SelectedValue="{Binding Entity.StateId, Mode=TwoWay}" SelectionChanged="StateSelectionChanged" />
                <Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                    <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Ciudad" />
                </Border>
                <ComboBox Grid.Column="4" MinHeight="42" Padding="10,6" ItemsSource="{Binding Cities}" DisplayMemberPath="Name" SelectedValuePath="CityId" SelectedValue="{Binding Entity.CityId, Mode=TwoWay}" SelectionChanged="CitySelectionChanged" />
            </Grid>

            <Grid Grid.Row="26" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                    <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Zona" />
                </Border>
                <ComboBox Grid.Column="1" MinHeight="42" Padding="10,6" ItemsSource="{Binding Zones}" DisplayMemberPath="ZoneName" SelectedValuePath="ZoneId" SelectedValue="{Binding Entity.ZoneId, Mode=TwoWay}" />
                <Border Grid.Column="3" Background="#F2F4F7" BorderBrush="#566273" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                    <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#1E2B3C" Text="Activo" />
                </Border>
                <Border Grid.Column="4" MinHeight="42" Background="White" BorderBrush="#566273" BorderThickness="1" CornerRadius="0,6,6,0">
                    <CheckBox Margin="14,0" VerticalAlignment="Center" Content="Activo" IsChecked="{Binding Entity.Active}" />
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
