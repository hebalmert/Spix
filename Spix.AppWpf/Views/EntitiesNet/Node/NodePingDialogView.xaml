<UserControl x:Class="Spix.AppWpf.Views.EntitiesNet.Node.NodePingDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             xmlns:catalog="clr-namespace:Spix.AppWpf.SharedComponents.SharedCatalog"
             xmlns:shared="clr-namespace:Spix.AppWpf.SharedComponents"
             MinWidth="820">

    <!-- El diagnostico del nodo. Es la misma vista de resultado del servidor y del
         PingResultView de la web: se cambia en un solo sitio. -->
    <!-- El modal se pide mas ancho de lo que mide el contenido, y el contenido va
         centrado: asi la barra de desplazamiento no monta sobre las tarjetas. -->
    <Grid Width="720" HorizontalAlignment="Center" Margin="0,16,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Las tarjetas van DENTRO de la misma tarjeta blanca del index
             (SharedIndexShell), igual que en el diagnostico del servidor. -->
        <Border Style="{StaticResource SharedIndexShell}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <UniformGrid Columns="2" Margin="0,0,0,14">
                    <catalog:SharedCatalogKpi Margin="0,0,12,0" Label="Nodo" Value="{Binding NodeName}" />
                    <catalog:SharedCatalogKpi Label="IP" Value="{Binding Host}"
                                              Accent="{DynamicResource BrushCatalogKpiOk}" />
                </UniformGrid>

                <Grid Grid.Row="1">
                    <shared:SharedPingResult Result="{Binding Result}"
                                             Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource SharedCatalogEmptyText}"
                               Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasResult, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                </Grid>
            </Grid>
        </Border>

        <shared:SharedModalActions Grid.Row="2"
                                   SaveCommand="{Binding RunPingCommand}"
                                   SaveText="Reintentar"
                                   SaveIcon="{x:Static icons:FontAwesomeIcon.RotateRight}"
                                   CancelCommand="{Binding CloseCommand}" />

        <shared:SharedLoading Grid.RowSpan="3" IsLoading="{Binding IsLoading}" />
    </Grid>
</UserControl>
