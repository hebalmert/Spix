<UserControl x:Class="Spix.AppWpf.SharedComponents.SharedMap.SharedNodeMapViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">

    <!-- El mapa del nodo. Por dentro corre el mismo JavaScript de la web. -->
    <Border BorderBrush="{DynamicResource BrushCatalogPanelBorder}"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid Background="#293847">
            <wv2:WebView2 x:Name="MapBrowser" />
            <TextBlock x:Name="MapErrorText"
                       Margin="24"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#F8B4B4"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
