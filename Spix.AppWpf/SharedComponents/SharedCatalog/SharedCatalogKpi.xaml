<UserControl x:Class="Spix.AppWpf.SharedComponents.SharedCatalog.SharedCatalogKpi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Raiz">

    <!-- Uno de los cuatro numeros de arriba. La barra de la izquierda dice que es:
         azul lo normal, verde lo activo, ambar el aviso, rojo el problema.

         OJO: en WPF un Border NO recorta a sus esquinas redondeadas, solo al rectangulo.
         Por eso la barra lleva SU PROPIO redondeo a la izquierda (11 = los 12 de la
         tarjeta menos el borde de 1); si fuera un rectangulo liso, asomaria cuadrada
         sobre la esquina y la tarjeta se veria redonda de un lado y cuadrada del otro. -->
    <Border CornerRadius="12"
            Background="{DynamicResource BrushCatalogCard}"
            BorderBrush="{DynamicResource BrushCatalogKpiBorder}"
            BorderThickness="1"
            Effect="{StaticResource SombraCatalogo}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border CornerRadius="11,0,0,11" Background="{Binding Accent, ElementName=Raiz}" />

            <StackPanel Grid.Column="1" Margin="14,12" VerticalAlignment="Center">
                <TextBlock FontSize="{StaticResource FontSizeMeta}"
                           Foreground="{DynamicResource BrushCatalogMeta}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Label, ElementName=Raiz}" />
                <TextBlock Margin="0,2,0,0"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{Binding ValueBrush, ElementName=Raiz}"
                           Text="{Binding Value, ElementName=Raiz}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
