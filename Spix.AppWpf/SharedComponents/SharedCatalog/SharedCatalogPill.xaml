<UserControl x:Class="Spix.AppWpf.SharedComponents.SharedCatalog.SharedCatalogPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Raiz">

    <!-- La pastilla del catalogo: verde cuando si, gris cuando no. Sin punto ni borde,
         igual que la .pc-pill de la web. -->
    <Border x:Name="PillBorder"
            Padding="10,2"
            CornerRadius="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="{DynamicResource BrushCatalogPillOffBack}">
        <TextBlock x:Name="PillText"
                   VerticalAlignment="Center"
                   FontSize="{StaticResource FontSizeCaption}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushCatalogPillOffText}"
                   Text="{Binding OffText, ElementName=Raiz}" />
    </Border>
</UserControl>
