<Window x:Class="Spix.AppWpf.SharedComponents.SharedAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Spix.AppWpf.SharedServices"
        xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
        xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
        Width="500"
        SizeToContent="Height"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <Border Margin="12"
            Padding="30"
            Background="{StaticResource BrushShellContent}"
            BorderBrush="#526176"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <fa:FontAwesomeImage x:Name="AlertIcon"
                                 Width="54"
                                 Height="54"
                                 HorizontalAlignment="Center"
                                 Icon="{x:Static icons:FontAwesomeIcon.CircleCheck}"
                                 IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
            <TextBlock x:Name="AlertTitleText"
                       Grid.Row="1"
                       Margin="0,18,0,0"
                       HorizontalAlignment="Center"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="White"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="AlertMessageText"
                       Grid.Row="2"
                       Margin="0,12,0,0"
                       HorizontalAlignment="Center"
                       FontSize="14"
                       Foreground="#D5DEEB"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <!-- Los botones van del ancho de su texto y centrados, no estirados: estirados
                 pierden la forma del boton de la casa. Y llevan icono para que se les vea
                 la franja de color; sin icono solo sale la barrita de 5px. -->
            <StackPanel Grid.Row="3"
                        Margin="0,28,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Margin="0,0,16,0"
                        Click="CancelClick"
                        Content="Cancelar"
                        Style="{StaticResource SharedButtonFormSecondary}"
                        svc:FormButton.Icon="{x:Static icons:FontAwesomeIcon.Xmark}" />
                <Button x:Name="ConfirmButton"
                        Click="ConfirmClick"
                        Content="OK"
                        Style="{StaticResource SharedButtonFormPrimary}"
                        svc:FormButton.Icon="{x:Static icons:FontAwesomeIcon.Check}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
