<UserControl x:Class="Spix.AppWpf.SharedComponents.SharedPingResult"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:catalog="clr-namespace:Spix.AppWpf.SharedComponents.SharedCatalog"
             x:Name="Raiz">

    <!-- El resultado de un ping, igual que el PingResultView de la web: el estado, las
         cifras y el detalle de CADA intento.
         El ping son 4 intentos y el promedio sale de ellos, asi que sin verlos uno a uno
         no se sabe si el promedio esconde un pico o un timeout. Por eso van listados.

         Es un componente aparte porque lo usan los dos diagnosticos: el del servidor y el
         del nodo, igual que en la web.

         Las tarjetas son las MISMAS del index (SharedCatalogKpi) y van con la MISMA
         separacion del index: 12 entre columnas y 14 entre filas. -->
    <Grid DataContext="{Binding Result, ElementName=Raiz}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Lo primero que hay que leer: respondio o no -->
        <catalog:SharedCatalogStatusCard Margin="0,0,0,14"
                                         IsOk="{Binding Success}"
                                         Title="{Binding Host}"
                                         Detail="{Binding Message}" />

        <!-- Las cifras que resumen los cuatro intentos -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,14">
            <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                      Label="Promedio" Value="{Binding AverageTime, StringFormat={}{0} ms}" />
            <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                      Label="Minimo" Value="{Binding MinTime, StringFormat={}{0} ms}"
                                      Accent="{DynamicResource BrushCatalogKpiOk}" />
            <catalog:SharedCatalogKpi Label="Maximo" Value="{Binding MaxTime, StringFormat={}{0} ms}"
                                      Accent="{DynamicResource BrushCatalogKpiBad}"
                                      ValueBrush="{DynamicResource BrushCatalogKpiBadText}" />
        </UniformGrid>

        <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,14">
            <catalog:SharedCatalogKpi Margin="0,0,12,0"
                                      Label="Perdidos" Value="{Binding Converter={StaticResource PingLossConverter}}"
                                      Accent="{DynamicResource BrushCatalogKpiWarn}"
                                      ValueBrush="{DynamicResource BrushCatalogKpiWarnText}" />
            <catalog:SharedCatalogKpi Label="Jitter" Value="{Binding Jitter, StringFormat={}{0} ms}" />
        </UniformGrid>

        <!-- Los cuatro intentos, en la misma tarjeta del index -->
        <Border Grid.Row="3"
                CornerRadius="12"
                Background="{DynamicResource BrushCatalogCard}"
                BorderBrush="{DynamicResource BrushCatalogKpiBorder}"
                BorderThickness="1"
                Effect="{StaticResource SombraCatalogo}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border CornerRadius="11,0,0,11" Background="{DynamicResource BrushCatalogKpiAccent}" />

                <StackPanel Grid.Column="1" Margin="14,12">
                    <TextBlock FontSize="{StaticResource FontSizeMeta}"
                               Foreground="{DynamicResource BrushCatalogMeta}"
                               Text="Intentos" />

                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Times}" AlternationCount="32">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,10,0"
                                        Padding="6,8"
                                        CornerRadius="10"
                                        BorderThickness="1"
                                        Background="{Binding Converter={StaticResource PingAttemptConverter}, ConverterParameter=fondo}"
                                        BorderBrush="{Binding Converter={StaticResource PingAttemptConverter}, ConverterParameter=borde}">
                                    <StackPanel>
                                        <TextBlock HorizontalAlignment="Center"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushCatalogMeta}"
                                                   Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource IndexToNumberConverter}}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="{StaticResource FontSizeName}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Converter={StaticResource PingAttemptConverter}, ConverterParameter=color}"
                                                   Text="{Binding Converter={StaticResource PingAttemptConverter}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
