<UserControl x:Class="Spix.AppWpf.SharedComponents.SharedFlag"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators">

    <!-- El si o no de una columna, como en la web: un chulo verde cuando si, una raya
         gris cuando no. Se lee de un vistazo en una columna estrecha, mucho mejor que
         una casilla que ademas parece que se pudiera marcar. -->
    <fa:FontAwesomeImage x:Name="Glifo"
                         Width="14" Height="14"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Icon="{x:Static icons:FontAwesomeIcon.Minus}"
                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
</UserControl>
