<UserControl x:Class="Spix.AppWpf.SharedComponents.SharedStatePill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- La pastilla de estado de las tablas: un puntico y una palabra.
         Se le pasa el booleano y los dos textos, asi sirve para Activo/Inactivo, para
         Aplica/No aplica o para lo que sea, sin duplicar estilos. -->
    <Border x:Name="PillBorder"
            Height="22"
            Padding="10,0"
            CornerRadius="11"
            BorderThickness="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="{DynamicResource BrushIndexPillOffBack}"
            BorderBrush="{DynamicResource BrushIndexPillOffBorder}">
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="PillDot"
                     Width="6" Height="6"
                     Margin="0,0,7,0"
                     VerticalAlignment="Center"
                     Fill="{DynamicResource BrushIndexPillOffText}" />
            <TextBlock x:Name="PillText"
                       VerticalAlignment="Center"
                       FontSize="{StaticResource FontSizeCaption}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushIndexPillOffText}" />
        </StackPanel>
    </Border>
</UserControl>
