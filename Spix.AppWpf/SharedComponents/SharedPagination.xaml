<UserControl x:Class="Spix.AppWpf.SharedComponents.SharedPagination"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="40">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Margin="0,0,6,0" Padding="10,5" Content="&lt;&lt;" Command="{Binding PageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="1" IsEnabled="{Binding CanGoPrevious, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <Button Margin="0,0,10,0" Padding="10,5" Content="&lt;" Command="{Binding PageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding PreviousPage, RelativeSource={RelativeSource AncestorType=UserControl}}" IsEnabled="{Binding CanGoPrevious, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <ItemsControl ItemsSource="{Binding PageLinks, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Margin="0,0,6,0" Padding="10,5" Content="{Binding Number}" Command="{Binding DataContext.PageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Number}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#36465D" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderBrush" Value="#53647B" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="Background" Value="#0D6EFD" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Margin="4,0,6,0" Padding="10,5" Content="&gt;" Command="{Binding PageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding NextPage, RelativeSource={RelativeSource AncestorType=UserControl}}" IsEnabled="{Binding CanGoNext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <Button Padding="10,5" Content="&gt;&gt;" Command="{Binding PageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding TotalPages, RelativeSource={RelativeSource AncestorType=UserControl}}" IsEnabled="{Binding CanGoNext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    </StackPanel>
</UserControl>
