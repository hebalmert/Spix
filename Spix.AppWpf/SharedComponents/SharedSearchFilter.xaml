<UserControl x:Class="Spix.AppWpf.SharedComponents.SharedSearchFilter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Spix.AppWpf.SharedServices"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             MinWidth="320">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- La caja de busqueda vive dentro del tablero oscuro, no en blanco -->
        <Border Height="38"
                Background="{StaticResource BrushIndexField}"
                BorderBrush="{StaticResource BrushIndexFieldBorder}"
                BorderThickness="1"
                CornerRadius="9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <fa:FontAwesomeImage Width="14" Height="14"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Foreground="{StaticResource BrushIndexIcon}"
                                     Icon="{x:Static icons:FontAwesomeIcon.MagnifyingGlass}"
                                     IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />

                <!-- Enter busca: no hay que ir hasta el boton -->
                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         Margin="0,1,6,1"
                         MinWidth="180"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="{StaticResource BrushIndexText}"
                         FontSize="13"
                         Foreground="{StaticResource BrushIndexText}"
                         VerticalContentAlignment="Center"
                         ToolTip="Buscar"
                         KeyDown="SearchBoxKeyDown"
                         Text="{Binding SearchText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- La X solo aparece cuando hay algo escrito -->
                <Button Grid.Column="2"
                        Width="26" Height="26"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        Command="{Binding ClearCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource SharedIndexIconButton}"
                        ToolTip="Limpiar">
                    <Button.Visibility>
                        <Binding Path="SearchText"
                                 RelativeSource="{RelativeSource AncestorType=UserControl}"
                                 Converter="{StaticResource TextToVisibilityConverter}" />
                    </Button.Visibility>
                    <fa:FontAwesomeImage Width="12" Height="12"
                                         Foreground="{StaticResource BrushIndexIcon}"
                                         Icon="{x:Static icons:FontAwesomeIcon.Xmark}"
                                         IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
                </Button>
            </Grid>
        </Border>

        <Button Grid.Column="2"
                Command="{Binding SearchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource SharedIndexGhostButton}"
                ToolTip="Buscar"
                svc:FormButton.Icon="{x:Static icons:FontAwesomeIcon.MagnifyingGlass}"
                Content="Buscar" />
    </Grid>
</UserControl>
