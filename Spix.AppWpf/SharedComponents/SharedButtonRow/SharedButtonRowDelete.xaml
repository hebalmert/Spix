<UserControl x:Class="Spix.AppWpf.SharedComponents.SharedButtonRow.SharedButtonRowDelete"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Net.Wpf;assembly=FontAwesome.Net.Wpf"
             xmlns:icons="clr-namespace:FontAwesome.Net.Generators"
             x:Name="Raiz">

    <!-- El boton rojo de la fila: borrar. Es la unica accion que no se puede deshacer. -->
    <Button Command="{Binding Command, ElementName=Raiz}"
            CommandParameter="{Binding CommandParameter, ElementName=Raiz}"
            IsEnabled="{Binding IsEnabled, ElementName=Raiz}"
            Style="{StaticResource SharedIndexIconButtonDanger}"
            ToolTip="{Binding ToolTip, ElementName=Raiz}">
        <fa:FontAwesomeImage Width="14" Height="14"
                             Foreground="{DynamicResource BrushIndexIconDanger}"
                             Icon="{Binding Icon, ElementName=Raiz}"
                             IconStyle="{x:Static icons:FontAwesomeIconStyle.Solid}" />
    </Button>
</UserControl>
