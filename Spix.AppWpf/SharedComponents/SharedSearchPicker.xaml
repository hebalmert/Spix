<UserControl x:Class="Spix.AppWpf.SharedComponents.SharedSearchPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Raiz">

    <!-- Se escribe y debajo caen los resultados; al elegir uno se cierra la lista.
         Es lo que la web hace con el buscador de contratos del formulario.

         Quien lo usa decide QUE se busca y desde cuantas letras: aqui solo se avisa de
         cada tecla con SearchCommand y se entrega el elegido con SelectCommand. -->
    <Grid>
        <TextBox x:Name="Caja"
                 Style="{StaticResource SharedFormBox}"
                 Text="{Binding Text, ElementName=Raiz, UpdateSourceTrigger=PropertyChanged}"
                 TextChanged="CajaCambio" />

        <!-- La lista va sobre lo demas: dentro de un modal no puede empujar los campos -->
        <Popup x:Name="Lista"
               AllowsTransparency="True"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=Caja}"
               StaysOpen="False"
               Width="{Binding ActualWidth, ElementName=Caja}">
            <Border MaxHeight="260"
                    CornerRadius="8"
                    Background="{DynamicResource BrushCatalogCard}"
                    BorderBrush="{DynamicResource BrushCatalogPanelBorder}"
                    BorderThickness="1"
                    Effect="{StaticResource SombraCatalogo}">
                <ListBox x:Name="Resultados"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding Items, ElementName=Raiz}"
                         ItemTemplate="{Binding ItemTemplate, ElementName=Raiz}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ResultadoElegido" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
