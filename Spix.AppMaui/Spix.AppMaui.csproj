<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Solo Android: la app es para el telefono del tecnico -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Spix.AppMaui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>Spix Tecnico</ApplicationTitle>
		<ApplicationId>net.nexxtplanet.spix.tecnico</ApplicationId>

		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0E2A5E" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0A1A3F" BaseSize="128,128" />

		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.3" Condition="'$(Configuration)' == 'Debug'" />
	</ItemGroup>

	<!-- Los DTO y el cliente HTTP se reusan tal cual de la solucion: la app no copia
	     modelos a mano, por eso vive dentro de Spix-NetCore -->
	<ItemGroup>
		<ProjectReference Include="..\Spix.Domain\Spix.Domain.csproj" />
		<ProjectReference Include="..\Spix.DomainLogic\Spix.DomainLogic.csproj" />
		<ProjectReference Include="..\Spix.xHttpService\Spix.xHttpService.csproj" />
	</ItemGroup>

</Project>
